% GameHack MVP Level: smallest meaningful world
% Two companions and one enemy in a room, a wet pool next door. Frost holds the only skill (chilled):
% the player lures gob into the pool, frost chills it there. One plan.

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, frost).
type(agent, gob).

% Locations (named positions in the world)
type(location, room).
type(location, pool).

% Skills (abilities)
type(skill, frostSkill).

% === Agents ===
companion(player).
companion(frost).
enemy(gob).

% === Positions ===
location(room).
location(pool).
at(player, room).
at(frost, room).
at(gob, room).

% === Location tags ===
locationCanApplyTag(pool, wet).

% === Skills ===
hasSkill(frost, frostSkill).
skillAppliesTag(frostSkill, chilled).

% === What defeats whom ===
vulnerableToLocationCombo(gob, wet, chilled).

% === Level Goal ===
goals(defeat(gob)).
