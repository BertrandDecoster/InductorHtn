% Sync: The Drawbridge (one crosses and lowers the bridge for the rest)
%
% A sentinel machine stands on a ledge beyond a gulf. The drawbridge over
% the gulf is raised, and its winch is on the far pier. Three companions:
% the player and the mage pick one skill each from eight; the porter only
% knows rainCall. Nobody can do the job from the dock - the ledge is out of
% sight - so one companion crosses on its own and lowers the bridge, and
% the others walk over and finish it.
%
%   dock (player, mage, porter) ~~ gulf ~~ pier (barrel) [winch] --- ledge (sentinel) ~~ cliff
%      \                                /      |
%       ------- drawbridge (door) -----       stair --- overlook (across the cliff)
%
% Obstacles and every method:
%   the gulf       nobody walks over it, and the bridge is up. Leap it:
%                  pounce, charge or shadowStep onto the pier (a dash), or
%                  translocate with the barrel standing there (a swap).
%                  Arriving on the pier works the winch: the drawbridge
%                  comes down for good, and the others walk over.
%   the sentinel   drop it off the ledge: gust it from the pier (a push
%                  into the cliff), or from the overlook drag it across the
%                  cliff with magnetize or taunt (it falls in on the way);
%                  or short it: the porter soaks it with rain, and zap
%                  jolts it (a jolt alone only stuns a machine).
%
% Traps:
%   - no line of sight from the dock to the ledge: nothing is done from
%     the near side;
%   - the crossing skills move only their caster, and none of them drops
%     or shorts the sentinel (a charge's push comes after its dash);
%   - there is no anchor on the pier, so magnetize can't hook anyone over;
%   - the porter's rain soaks, it never kills; a dry jolt only stuns.
%
% Hypothesis (design.md): no single skill wins; 32 of 64 assignments win
% (each crossing skill with each job skill, either seat).

% === Regions ===
region(dock).
region(gulf).
region(pier).
region(drawbridge).
region(ledge).
region(cliff).
region(stair).
region(overlook).
connected(dock, gulf).
connected(gulf, dock).
connected(gulf, pier).
connected(pier, gulf).
connected(dock, drawbridge).
connected(drawbridge, dock).
connected(drawbridge, pier).
connected(pier, drawbridge).
connected(pier, ledge).
connected(ledge, pier).
connected(ledge, cliff).
connected(cliff, ledge).
connected(pier, stair).
connected(stair, pier).
connected(stair, overlook).
connected(overlook, stair).

lineOfSight(dock, pier).
lineOfSight(pier, dock).
lineOfSight(pier, ledge).
lineOfSight(overlook, ledge).

% The route over the gulf, for leaps: only forward.
progress(dock, 0).
progress(gulf, 1).
progress(drawbridge, 1).
progress(pier, 2).
progress(ledge, 3).
progress(stair, 3).
progress(overlook, 4).

% A push from the pier on the ledge lands in the cliff; from the overlook,
% the cliff lies between it and the ledge.
beyond(pier, ledge, cliff).
beyond(overlook, cliff, ledge).

% === Terrain ===
onEnter(gulf, chasm).
onEnter(cliff, chasm).
door(drawbridge).
onEnter(pier, winch).
effect(winch, target, open(drawbridge)).

% === Companions ===
role(player, player).
role(mage, companion).
role(porter, companion).
at(player, dock).
at(mage, dock).
at(porter, dock).
mana(player, 4).
mana(mage, 4).
knows(porter, rainCall).

% === Things ===
role(sentinel, enemy).
at(sentinel, ledge).
trait(sentinel, machine).

role(barrel, object).
at(barrel, pier).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, pounce).
knows(mage, gust).

% === Victory ===
% Someone gets onto the pier (the bridge comes down), then the sentinel goes.
win :- if(), do(lowerBridge, neutralize(sentinel)).

lowerBridge :- if(canAct(?a)), do(reach(?a, pier), opened(drawbridge)).
opened(?d) :- if(open(?d)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
% The porter keeps rainCall.
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(pounce).
comboPool(charge).
comboPool(shadowStep).
comboPool(translocate).
comboPool(gust).
comboPool(magnetize).
comboPool(taunt).
comboPool(zap).
comboMinWins(8).
comboMinMethods(4).

goals(win).
