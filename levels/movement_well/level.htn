% The Well (pure movement)
%
% A lock gate opens only while two plates are weighed down at once: a step
% on the quay, and the floor of a well. The Golem is heavy and knows
% nothing: he is the counterweight on the step, and walks out once the lock
% is open. The well is the problem: it lies down a shaft from the brink,
% its floor is mud under a hand of water, and whoever lands in it is stuck.
% The lock opens on the brink and, through a grate, on the well floor.
% Lost Vikings: one companion is the weight, one goes down, one hauls out.
%
%   quay (player, mage, golem; step) --- brink (crate) ~~ well (floor; mud)
%                                           |               |
%                                           +---- exit -----+  (the lock)
%
% Victory: all three companions reach the exit. The player and the mage
% pick one skill each from six, with mana for one costly cast each.
%
%   down    leap the shaft (a lightning flash - one, with no mana for the
%           way back); or knock the crate into the shaft to fill it (a
%           fireball, a shield bash, a tidal wave on the brink) and walk
%   out     the mud roots whoever lands: a friend at the exit hooks them out
%           through the grate; or the one below hooks the Golem once he
%           stands at the exit, and swings out on him
%
% Traps: without a hook, whoever goes down stays down, even over a filled
% shaft; the bash's shield would take the mud, but the water breaks it
% first; a vortex on the floor has nothing to draw - the well is empty.
% Blink is left out of the pool: disjoint as it lands, the mud never takes.

% === Map: four areas ===
region(quay).
region(brink).
region(well).
region(exit).
connected(quay, brink).
% The shaft: a short drop between the brink and the well floor.
gap(brink, well).
% The lock gate opens on the brink and, through a grate, on the well floor.
doorway(brink, exit, lock).
doorway(well, exit, lock).
door(lock).

lineOfSight(quay, brink).
lineOfSight(quay, well).
lineOfSight(brink, well).
lineOfSight(brink, quay).
lineOfSight(exit, well).
lineOfSight(exit, brink).

% The route, for leaps: only forward.
progress(quay, 0).
progress(brink, 1).
progress(well, 2).
progress(exit, 3).

% === Terrain ===
% Two plates hold the lock open only together: the step on the quay, and
% the floor of the well. The floor is sucking mud: whoever lands in it is
% stuck.
feature(quay, step, weigh).
plate(step).
plateFor(step, lock).
feature(well, floor, weigh).
plate(floor).
plateFor(floor, lock).
effect(weigh, target, openWhenHeld(lock)).
onEnter(well, puddle).
onEnter(well, mud).
effect(mud, target, grant(rooted)).

% === Companions ===
role(player, player).
role(mage, companion).
role(golem, companion).
at(player, quay).
at(mage, quay).
at(golem, quay).
mana(player, 2).
mana(mage, 2).
tag(golem, heavy).

% === Things ===
% A crate on the brink.
role(crate, object).
at(crate, brink).
tag(crate, filler).

% === Default kit (a winning pair; combos strips these) ===
knows(player, lightningFlash).
knows(mage, hook).

% === Victory: all three reach the exit ===
win :- if(), do(escape).

escape :-
    if(),
    do(stepOn(golem, step), weighFloor, confirmOpen(lock),
       leave(golem), leave(mage), leave(player)).

% The floor: someone drops in; the shaft is filled with the crate and
% someone walks down; or the stone toad, misted, is knocked onto it.
weighFloor :-
    if(canAct(?a), \==(?a, golem), first(leap(?a, ?ab, ?from, ?aim, well))),
    do(castFrom(?a, ?ab, ?aim, ?from), stepOn(?a, floor)).
weighFloor :-
    if(at(crate, brink)),
    do(knockOn(crate, gap(well), none), confirmBridged(brink, well), goDown(floor)).
goDown(?p) :-
    if(feature(?r, ?p, ?ab), canAct(?a), \==(?a, golem), canReachNow(?a, ?r)),
    do(walkTo(?a, ?r), stepOn(?a, ?p)).

% Out: walk; or, stuck in the mud, be hauled out by a friend at the exit.
leave(?a) :- if(canWalk(?a, exit)), do(walkTo(?a, exit)).
leave(?a) :-
    if(not(canWalk(?a, exit)), at(?a, ?r), canAct(?b), \==(?b, ?a), knows(?b, ?ab), pulls(?ab),
       canWalk(?b, exit)),
    do(walkTo(?b, exit), castFrom(?b, ?ab, ?a, exit), onSpot(?a, exit)).
leave(?a) :-
    if(not(canWalk(?a, exit)), at(?a, ?r), dashEdge(?r, exit), knows(?a, ?ab),
       effect(?ab, target, hook), at(?x, exit), anchoredAgainst(?x), ready(?a, ?ab, ?x)),
    do(castFrom(?a, ?ab, ?x, ?r), onSpot(?a, exit)).
canWalk(?a, ?r) :- not(forbidden(?a, move)), canReachNow(?a, ?r).
onSpot(?e, ?r) :- if(at(?e, ?r)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(lightningFlash).
comboPool(hook).
comboPool(fireball).
comboPool(shieldBash).
comboPool(tidalWave).
comboPool(vortex).

goals(win).
