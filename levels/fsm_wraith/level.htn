% The Soulfire Wraith (enemy state machines)
%
% A Wraith haunts the crypt, stealthed: nothing can be aimed at it, only
% areas and zones reach it. It is a boss (no stuns), it flies, and it is
% bound to its crypt (nothing moves it). Its state machine is tags and
% three behaviours:
%   wet or electrocuted -> flinch: the rain or the jolt shows its outline
%                          (it loses stealth), nothing more
%   blinded or taunted  -> soulfire: a telegraphed MAGIC heavy spell on its
%                          own crypt. The team gets one cast; then the crypt
%                          bursts into flames and the Wraith spends itself:
%                          out of hiding, exhausted, sunk to the floor (no
%                          longer flying)
%   exhausted           -> the window: its binding lapses (it can be moved),
%                          and a jolt stops it (dead)
% The spell is interruptible (hook, shieldBash) - which saves whoever
% stands in the crypt, and wastes the window.
%
%   gate --- nave --- mist --- crypt (Wraith) --- ossuary
%              |                 :
%           balcony . . . . .  well (a shaft beside the crypt)
%   (the balcony overlooks the crypt across the well)
%
% The mist is a shadows zone: whoever stands there is stealthed.
%
% Methods:
%   flash and ...     blindingFlash next to it (the flash reaches the unseen)
%                     sets off the soulfire; the flash made its caster
%                     disjoint, so the blow passes through them. In the
%                     window the partner drops it into the well (tidalWave or
%                     fireball from the mist, vortex into the well, hook or
%                     taunt across the well from the balcony) or jolts it
%                     (lightningFlash)
%   reveal and taunt  a jolt through the crypt (lightningFlash from the mist
%                     to the ossuary) or a wave (tidalWave) shows it; now it
%                     can be taunted, and the taunt sets off the soulfire;
%                     the revealer then jolts it or washes it into the well
%
% Traps:
%   - taunt, hook and lightningFlash cannot be aimed at it while it hides;
%   - a jolt or a wave before the soulfire only reveals it: it is bound and
%     not spent;
%   - fire does nothing to it: flames on the crypt just burn;
%   - flash twice: the second soulfire finds the crypt already ablaze, and
%     nobody is left to finish it;
%   - interrupt the soulfire and it is never spent.

% === Regions ===
region(gate).
region(nave).
region(balcony).
region(mist).
region(crypt).
region(ossuary).
region(well).
connected(gate, nave).
connected(nave, gate).
connected(nave, balcony).
connected(balcony, nave).
connected(nave, mist).
connected(mist, nave).
connected(mist, crypt).
connected(crypt, mist).
connected(crypt, ossuary).
connected(ossuary, crypt).
connected(crypt, well).
connected(well, crypt).
lineOfSight(gate, nave).
lineOfSight(nave, gate).
lineOfSight(nave, mist).
lineOfSight(nave, balcony).
lineOfSight(balcony, nave).
lineOfSight(balcony, crypt).
lineOfSight(balcony, well).
lineOfSight(mist, crypt).
lineOfSight(mist, well).
lineOfSight(mist, ossuary).
lineOfSight(crypt, mist).
lineOfSight(crypt, ossuary).
lineOfSight(ossuary, crypt).

% Lines: from the mist, the crypt lies between it and the ossuary (a jolt
% flies through), and a push over the crypt drops into the well; from the
% balcony, the well lies between it and the crypt.
beyond(mist, crypt, well).
beyond(ossuary, crypt, well).
beyond(balcony, well, crypt).
beyond(mist, crypt, ossuary).

onEnter(mist, shadows).
onEnter(well, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gate).
at(mage, gate).
mana(player, 4).
mana(mage, 4).

% === The Wraith ===
role(wraith, enemy).
at(wraith, crypt).
rank(wraith, boss).
tag(wraith, flying).
tag(wraith, stealthed).
% Bound to its crypt: nothing drags or pushes it (not even a taunt's pull)
% - until it is spent.
immune(wraith, forcedMove).
suspends(exhausted, forcedMove).

% Soaked or jolted, it flinches out of hiding.
behavior(wraith, wet, flinch, self).
behavior(wraith, electrocuted, flinch, self).
reach(flinch, self).
effect(flinch, self, remove(stealthed)).

% Blinded or taunted, it pours itself into soulfire on its crypt: heavy,
% magic (interruptible).
behavior(wraith, blinded, soulfire, here).
behavior(wraith, taunted, soulfire, here).
heavy(soulfire).
kind(soulfire, magic).
effect(soulfire, target, spill(flames)).
effect(soulfire, self, remove(stealthed)).
effect(soulfire, self, grant(exhausted)).
effect(soulfire, self, remove(flying)).

% Spent, it is open to a jolt.
weakness(wraith, electrocuted, exhausted, dead).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, blindingFlash).
knows(mage, lightningFlash).

% === Victory ===
% Set off the soulfire (revealing it first if the trigger must be aimed),
% see it spent, then the standard recipes finish it; nobody may be lost.
win :- if(), do(spend(wraith), stepBack(crypt, mist), neutralize(wraith), teamStanding()).
win :-
    if(tag(wraith, stealthed)),
    do(reveal(wraith), spend(wraith), stepBack(crypt, mist), neutralize(wraith), teamStanding()).

% Someone lands a tag it answers with its heavy spell.
spend(?e) :-
    if(behavior(?e, ?t, ?ab, ?aim), heavy(?ab), canAct(?p), knows(?p, ?sk), grants(?sk, ?t),
       aimFor(?e, ?sk, ?x)),
    do(cast(?p, ?sk, ?x), confirmTag(?e, exhausted)).

% Someone lands a tag it flinches from.
reveal(?e) :-
    if(behavior(?e, ?t, ?ab, self), effect(?ab, self, remove(stealthed)), canAct(?p),
       knows(?p, ?sk), grants(?sk, ?t)),
    do(unveil(?p, ?sk, ?e), confirmOff(?e, stealthed)).

% A cast that reaches it while it hides: a wave from next door, or a bolt
% through its region.
unveil(?p, ?sk, ?e) :-
    if(effect(?sk, around, ?x), at(?e, ?r), connected(?from, ?r), canReachNow(?p, ?from),
       ready(?p, ?sk, ?p)),
    do(castFrom(?p, ?sk, ?p, ?from)).
unveil(?p, ?sk, ?e) :-
    if(effect(?sk, path, ?x), at(?e, ?r), beyond(?from, ?r, ?to), not(onEnter(?to, chasm)),
       reach(?sk, ?k), inRange(?k, ?from, ?to), canReachNow(?p, ?from), ready(?p, ?sk, ?to)),
    do(castFrom(?p, ?sk, ?to, ?from)).

% What it is aimed at: itself, or the caster for a wave or a flash around.
aimFor(?e, ?sk, ?e) :- receptive(?e, targeted).
aimFor(?e, ?sk, ?e) :- not(receptive(?e, targeted)), effect(?sk, around, ?x).

confirmTag(?e, ?t) :- if(tag(?e, ?t)), do().
confirmOff(?e, ?t) :- if(not(tag(?e, ?t))), do().
teamStanding() :- if(not(first(and(canAct(?a), gone(?a))))), do().

% After the spell, whoever stands in the crypt steps back out of it.
stepBack(?r, ?to) :- if(not(first(and(canAct(?a), at(?a, ?r))))), do().
stepBack(?r, ?to) :- if(first(and(canAct(?a), at(?a, ?r)))), do(stepAll(?r, ?to)).
stepAll(?r, ?to) :- allOf, if(canAct(?a), at(?a, ?r)), do(walkTo(?a, ?to)).

funExpect(single_actor_plans, atMost, 0).
% The intent: every plan plays the Wraith's soulfire.
funIntended(opProvoked).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blindingFlash).
comboPool(taunt).
comboPool(lightningFlash).
comboPool(tidalWave).
comboPool(fireball).
comboPool(vortex).
comboPool(hook).
comboMinWins(8).
comboMinMethods(4).

goals(win).
