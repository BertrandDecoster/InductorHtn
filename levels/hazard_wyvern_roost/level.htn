% The Wyvern Roost (hazard terrain and physics objects)
%
% A wyvern roosts on a crag above a sheer cliff. A short chasm cuts the
% crag off from the ledge; the only walkable way round is a channel of
% lava. On the ledge itself bubbles a lava pool. While it flies, neither the
% lava, the chasm nor the cliff can take it. Nobody can hurt it: the
% mountain can, once it is on the ground - and the mountain itself can be
% reshaped. Two companions, one skill each, from eight.
%
%   camp --- ledge (lava pool) :gap: crag (wyvern; the cliff)
%              \                     /
%               +--- flow (lava) ---+
%
% Its wings fail it (level-local reactions, each a remove(flying) plus the
% tag that came in): soaked (wet), frosted (chilled), or struck by
% lightning (electrocuted).
%
% Methods, always by two companions:
%   fetch it, then wash it into the fire
%               hook it across the chasm from the ledge (a flyer is brought
%               over, it does not fall), or taunt it (it flies after you over
%               the lava); then a wave on the ledge (tidalWave) soaks its
%               wings and knocks it into the lava pool or back into the gap.
%   ground it, then let the mountain have it
%               frost the crag (blizzard) or strike it (lightningFlash, which
%               also leaps the caster onto the crag); then knock it off the
%               cliff or into the chasm (fireball, shieldBash across the gap,
%               vortex on the cliff), or drag it across the chasm from the
%               ledge (hook): grounded, it falls in.
%   cool the lava, then wade out
%               a blizzard on the lava channel leaves cooled rock (lava
%               meeting an ice sheet leaves no zone). Walk out over it onto
%               the crag, and a wave (tidalWave) soaks the wyvern and washes
%               it over the cliff.
% Traps: flying, it is knocked over the cliff or dragged over the chasm and
% simply hovers; grounded, it will not walk over the lava after a taunter;
% whoever stands on the ledge when the wave comes is washed in with it; the
% crag is reached only by a leap, or over cooled rock.
region(camp).
region(ledge).
region(flow).
region(crag).
connected(camp, ledge).
connected(ledge, flow).
connected(flow, crag).
gap(ledge, crag).
lineOfSight(camp, ledge).
lineOfSight(ledge, crag).
lineOfSight(ledge, flow).
lineOfSight(flow, crag).

% === Terrain ===
onEnter(flow, lava).
feature(ledge, lavaPool, lava).
feature(crag, cliff, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 4).
mana(mage, 4).

% === The wyvern ===
role(wyvern, enemy).
at(wyvern, crag).
tag(wyvern, living).
tag(wyvern, flying).
% Taunted, it flies after its taunter and breathes fire on it (the
% catalogue's meteor: telegraphed, magic - a hook or a shield bash
% interrupts it; the struck area catches fire).
behavior(wyvern, taunted, meteor, source).
% What brings it down: soaked, frosted or struck wings.
reaction(flying, wet, sodden).
effect(sodden, target, remove(flying)).
effect(sodden, target, grant(wet)).
reaction(flying, chilled, frosted).
effect(frosted, target, remove(flying)).
effect(frosted, target, grant(chilled)).
reaction(flying, electrocuted, struck).
effect(struck, target, remove(flying)).
effect(struck, target, grant(electrocuted)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, tidalWave).

% === Victory ===
% A knock that also grounds it (a wave), wherever it is brought to.
win :- if(), do(sendDown(wyvern, none), confirmStopped(wyvern)).
% Grounded first; then someone else knocks it or drags it down.
win :- if(canAct(?p)), do(ground(wyvern, ?p), sendDown(wyvern, ?p), confirmStopped(wyvern)).
% The lava channel cooled into rock, someone else walks out and knocks it.
win :-
    if(onEnter(?r, ?z), zoneReaction(?z, ?in, none), canAct(?c)),
    do(cool(?r, ?c), sendDown(wyvern, ?c), confirmStopped(wyvern)).

% Ground it: land something its wings answer by failing.
ground(?e, ?p) :-
    if(tag(?e, flying), reaction(flying, ?t, ?rab), effect(?rab, target, remove(flying)),
       canInflict(?p, ?ab, ?t, ?e)),
    do(cast(?p, ?ab, ?e), ensureOff(flying, ?e)).

% Cool a hazard area: spill on it the zone that leaves nothing there.
cool(?r, ?a) :-
    if(onEnter(?r, ?z), zoneReaction(?z, ?in, none), canAct(?a), knows(?a, ?ab),
       effect(?ab, target, spill(?in)), ready(?a, ?ab, ?r)),
    do(cast(?a, ?ab, ?r), confirmCooled(?r, ?z)).
confirmCooled(?r, ?z) :- if(not(onEnter(?r, ?z))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(tidalWave).
comboPool(blizzard).
comboPool(lightningFlash).
comboPool(fireball).
comboPool(shieldBash).
comboPool(vortex).
comboMinWins(12).
comboMinMethods(5).

goals(win).
