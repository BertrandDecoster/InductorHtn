% The Wyvern Roost (hazard terrain and physics objects)
%
% A wyvern roosts on a crag across a channel of lava, above a sheer cliff.
% While it flies, neither the lava nor the drop can take it. Nobody can hurt
% it: the mountain can, once it is on the ground - and the mountain itself
% can be reshaped. Two companions, one skill each, from six.
%
%   camp --- ledge ~~ lava ~~ crag (wyvern) ::: cliff
%              |                 :
%             path --- overlook -'   (the overlook looks down on the crag)
%
% Its wings fail it (level-local reactions, each a remove(flying) plus the
% tag that came in): soaked (wet), frosted (chilled), or struck by lightning
% (electrocuted).
%
% Methods, always by two companions:
%   bring it down, then let the mountain have it
%               ground it - freeze the crag (blizzard) or strike it
%               (lightningFlash, which also dashes the caster onto the crag) -
%               then pull it across the lava from the ledge (hook, taunt) or
%               blast it off the crag into the cliff from the overlook
%               (fireball: a frozen crag melts into a puddle under it, and the
%               soaked, chilled wyvern freezes solid as it goes over).
%   fetch it, then drown it in fire
%               hook or taunt the flyer across the lava onto the ledge (it
%               just flies over), step aside, and a wave from the camp
%               (tidalWave) soaks its wings and washes it back into the lava.
%   cool the lava, then wade out
%               a blizzard on the lava channel leaves cooled rock (terrain:
%               lava meeting an ice sheet leaves no zone). Walk out onto it,
%               next to the crag, and a wave (tidalWave) soaks the wyvern and
%               washes it over the cliff.
% Traps: flying, it is pulled over the lava or pushed over the drop and
% simply hovers there; cool the lava and nobody can drop it in any more;
% whoever stands on the ledge when the wave comes goes into the lava with it.
region(camp).
region(ledge).
region(lava).
region(crag).
region(cliff).
region(path).
region(overlook).
connected(camp, ledge).
connected(ledge, camp).
connected(ledge, path).
connected(path, ledge).
connected(path, overlook).
connected(overlook, path).
connected(ledge, lava).
connected(lava, ledge).
connected(lava, crag).
connected(crag, lava).
lineOfSight(camp, ledge).
lineOfSight(ledge, lava).
lineOfSight(ledge, crag).
lineOfSight(overlook, crag).

% Push lines (and what lies between): a pull from the ledge on the crag
% crosses the lava; a push from the overlook, or from the lava channel once
% it is rock, throws the crag's occupant over the cliff; a push from the camp
% throws whoever is on the ledge into the lava.
beyond(ledge, lava, crag).
beyond(overlook, crag, cliff).
beyond(lava, crag, cliff).
beyond(camp, ledge, lava).

% === Terrain ===
onEnter(lava, lava).
onEnter(cliff, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).

% === The wyvern ===
role(wyvern, enemy).
at(wyvern, crag).
tag(wyvern, living).
tag(wyvern, flying).
blocker(wyvern).
% What brings it down: soaked, frosted or struck wings.
reaction(flying, wet, sodden).
effect(sodden, target, remove(flying)).
effect(sodden, target, grant(wet)).
reaction(flying, chilled, frosted).
effect(frosted, target, remove(flying)).
effect(frosted, target, grant(chilled)).
reaction(flying, electrocuted, struck).
effect(struck, target, remove(flying)).
effect(struck, target, grant(electrocuted)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, blizzard).
knows(mage, hook).

% === Victory ===
win :- if(), do(neutralize(wyvern), standing()).
win :- if(), do(ground(wyvern), neutralize(wyvern), standing()).
win :- if(), do(fetch(wyvern), neutralize(wyvern), standing()).
win :- if(), do(cool(), neutralize(wyvern), standing()).

% Ground it: land something its wings answer by failing.
ground(?e) :-
    if(tag(?e, flying), reaction(flying, ?t, ?rab), effect(?rab, target, remove(flying)),
       canInflict(?a, ?ab, ?t, ?e)),
    do(cast(?a, ?ab, ?e), ensureOff(flying, ?e)).

% Fetch it across a hazard it flies over, and step off the landing spot.
fetch(?e) :-
    if(at(?e, ?re), beyond(?from, ?m, ?re), puller(?a, ?ab, ?e), reach(?ab, ?k),
       inRange(?k, ?from, ?re), canReachNow(?a, ?from)),
    do(castFrom(?a, ?ab, ?e, ?from), confirmAt(?e, ?from), stepAside(?a, ?from)).
stepAside(?a, ?r) :- if(connected(?r, ?s), passable(?a, ?s)), do(walkTo(?a, ?s)).
confirmAt(?x, ?r) :- if(at(?x, ?r)), do().

% Cool a hazard: spill on it the zone that leaves nothing there.
cool() :-
    if(onEnter(?r, ?z), zoneReaction(?z, ?in, none), canAct(?a), knows(?a, ?ab),
       effect(?ab, target, spill(?in)), ready(?a, ?ab, ?r)),
    do(cast(?a, ?ab, ?r), confirmCooled(?r, ?z)).
confirmCooled(?r, ?z) :- if(not(onEnter(?r, ?z))), do().

% Nobody the team needs is lost on the way.
standing() :- if(not(first(and(canAct(?a), gone(?a))))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blizzard).
comboPool(lightningFlash).
comboPool(tidalWave).
comboPool(fireball).
comboPool(hook).
comboPool(taunt).
comboMinWins(10).
comboMinMethods(4).

goals(win).
