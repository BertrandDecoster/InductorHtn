% The Crossing (ability catalogue)
%
% A gate opens on a hall. Off the hall, a crypt whose floor has broken open
% onto the abyss, and the rotten, holed brink of the same abyss; across it,
% a flooded ledge with a stone pillar. Nothing dies in general here: each
% enemy has its own weakness, or a drop, and the team has to find it. A
% knockback never leaves its area: each enemy goes into what is beside it.
%
%   gate --- hall --- crypt (bramble; shadows; rift)
%             |
%           brink (brute; sinkhole) ~~ abyss ~~ ledge (sentry, pillar; flooded)
%
%   sentry   a heavy machine standing in the water. It is soaked: a jolt
%            short-circuits it (lightning flash from the brink, which also
%            carries the caster over). Or the Warden mists it from the brink
%            and, while it lasts, someone knocks it into the abyss (shield
%            bash over the gap, fireball) or drags it across (hook). Only
%            the brink sees the ledge.
%   bramble  a wooden thing hiding in the crypt's shadows. It cannot be
%            aimed at: fire on the whole crypt takes it (a fireball at the
%            area), a tidal wave in the crypt washes it into the rift, or a
%            vortex on the rift draws it in.
%   brute    a boss, heavy, on the brink. The Warden mists it and someone
%            knocks it into the sinkhole or the abyss (fireball, shield
%            bash, a wave on the brink, a vortex on the sinkhole), or a
%            hooker swings over on the pillar and hauls it across. Set
%            alight, it stamps: a heavy blow that caves the brink in under
%            it - and under anyone still there.
%
% The Warden only knows turnToMist; the player and the mage pick one skill
% each from six, with mana for one costly cast each.
%
% Traps: fire on the brute before the sentry is down caves in the brink
% and cuts the way to the ledge; a flash and a fireball are two costly
% casts for three enemies; a vortex on the sinkhole takes friends on the
% brink; ice, a flash or a hook never reach the bramble.

% === Map: five areas ===
region(gate).
region(hall).
region(crypt).
region(brink).
region(ledge).
connected(gate, hall).
connected(hall, crypt).
connected(hall, brink).
% The abyss: a short drop between the brink and the flooded ledge.
gap(brink, ledge).

lineOfSight(gate, hall).
lineOfSight(hall, gate).
lineOfSight(hall, crypt).
lineOfSight(hall, brink).
lineOfSight(brink, hall).
lineOfSight(brink, ledge).
lineOfSight(ledge, brink).

% The route, for leaps: only forward.
progress(gate, 0).
progress(hall, 1).
progress(crypt, 2).
progress(brink, 2).
progress(ledge, 3).

% === Terrain ===
onEnter(crypt, shadows).
onEnter(ledge, puddle).
% The crypt's floor has broken open onto the abyss; the brink is rotten
% and holed.
feature(crypt, rift, chasm).
feature(brink, sinkhole, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
role(warden, companion).
at(player, gate).
at(mage, gate).
at(warden, gate).
mana(player, 2).
mana(mage, 2).
knows(warden, turnToMist).

% === Enemies ===
role(sentry, enemy).
at(sentry, ledge).
tag(sentry, machine).
tag(sentry, heavy).
tag(sentry, wet).

role(bramble, enemy).
at(bramble, crypt).
tag(bramble, wooden).
tag(bramble, stealthed).

role(brute, enemy).
at(brute, brink).
rank(brute, boss).
tag(brute, living).
tag(brute, heavy).
behavior(brute, burning, caveIn, here).

role(pillar, object).
at(pillar, ledge).
tag(pillar, heavy).

% === Default kit (a winning pair; combos strips these) ===
knows(player, fireball).
knows(mage, shieldBash).

% === The encounter ===
clearCrossing :- if(), do(beat(sentry), beat(bramble), beat(brute)).

% The recipes (neutralize); fire on a whole region; and the haul across
% the abyss.
beat(?e) :- if(), do(neutralize(?e)).
beat(?e) :- if(not(neutralized(?e))), do(scorch(?e)).
beat(?e) :- if(not(neutralized(?e))), do(haul(?e)).

% It cannot be aimed at: whatever lands on its whole region takes it.
scorch(?e) :-
    if(at(?e, ?r), lethalWeakness(?e, ?in, none), canAct(?a), knows(?a, ?ab),
       grants(?ab, ?in), ready(?a, ?ab, ?r)),
    do(cast(?a, ?ab, ?r), confirmStopped(?e)).

% Swing across on the pillar, then - the target misted - drag it back over
% the abyss.
haul(?e) :-
    if(at(?e, ?r), edge(?r, ?far, gap), has(?e, heavy), canUnset(?w, ?mab, heavy, ?e, ?aim),
       puller(?a, ?ab, ?e), \==(?a, ?w), at(?a, ?cur), \==(?cur, ?far),
       first(leap(?a, ?hab, ?from, ?x, ?far))),
    do(castFrom(?a, ?hab, ?x, ?from), cast(?w, ?mab, ?aim), ensureOff(heavy, ?e),
       castFrom(?a, ?ab, ?e, ?far), confirmStopped(?e)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(tidalWave).
comboPool(vortex).
comboPool(lightningFlash).
comboPool(hook).
comboPool(shieldBash).

goals(clearCrossing).
