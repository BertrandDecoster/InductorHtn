% The Shellback (enemy state machines)
%
% A giant tortoise sits on the causeway over a chasm. It is a boss (no
% stuns), heavy (nothing moves it) and wears an energy shield that eats the
% next hostile tag. Its state machine:
%   shielded   -> any hostile tag only pops the shield (a guard: it comes
%                 off first)
%   burning    -> withdraw: it curls into its shell - the shell closes again
%                 (shielded), but it lets go of the stone (heavy no more): a
%                 ball that rolls
%   taunted    -> it lumbers after its taunter, and snaps: its head lunges
%                 at the taunter (rooted) and it is left exhausted
%   exhausted  -> the window: its head lies out of the shell, and the cold or
%                 a jolt stops it (dead)
% Its defence becomes its weakness: the fire that shuts it in makes it roll.
% And the mist (turnToMist) takes weight and shield off it for a moment.
%
%   strand ------ islet
%     |             :  (gap: the chasm between the islet and the causeway)
%   shore ------ causeway (Shellback; the abyss, a pit at its side)
%
% Map: four areas. The causeway and the islet face each other across the
% chasm (a gap); the causeway's open side is the abyss (a chasm feature).
% The shore sees the causeway and the islet sees it across the chasm.
%
% Methods:
%   curl and roll    a popper takes the shield (taunt, tidalWave from the
%                    causeway, lightningFlash, vortex); fireball sets it
%                    burning, it curls, and the same blast knocks the ball
%                    into the abyss or over the edge into the chasm
%   taunt and strike taunt pops the shield, a second taunt makes it follow
%                    and snap and spend itself; blizzard or lightningFlash on
%                    its head (or the jolt pops the shield first, and a
%                    second jolt ends it)
%   mist and roll    turnToMist lifts shield and weight for a moment; in that
%                    moment a knock (fireball; tidalWave on the causeway; a
%                    vortex into the abyss) or a hook across the chasm from
%                    the islet drops it
%
% Traps:
%   - the first hostile tag is always lost on the shield: a fire that pops it
%     leaves flames that will not burn it twice;
%   - frost then fire: the flames only melt the ice sheet into a puddle, and
%     it is soaked, not burning;
%   - curled, the shell is up again: a tag after that is lost too;
%   - a knock, a hook or a vortex on the heavy shell does nothing (a hook
%     from the islet only drags its caster onto the causeway);
%   - taunted, it walks - around by the strand, never across the chasm;
%   - the mist lasts one more cast: the knock must come at once.

% === Areas ===
region(shore).
region(causeway).
region(strand).
region(islet).
connected(shore, causeway).
connected(shore, strand).
connected(strand, islet).
gap(causeway, islet).
feature(causeway, abyss, chasm).
lineOfSight(shore, causeway).
lineOfSight(causeway, shore).
lineOfSight(islet, causeway).
lineOfSight(causeway, islet).
lineOfSight(shore, strand).
lineOfSight(strand, shore).
lineOfSight(strand, islet).
lineOfSight(islet, strand).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, shore).
at(mage, shore).
mana(player, 4).
mana(mage, 4).

% === The Shellback ===
role(shellback, enemy).
at(shellback, causeway).
rank(shellback, boss).
tag(shellback, living).
tag(shellback, heavy).
tag(shellback, shielded).

% Burning, it withdraws into its shell: the shell closes (shielded again),
% but it has let go of the stone - heavy no more, a ball that rolls.
behavior(shellback, burning, withdraw, self).
reach(withdraw, self).
effect(withdraw, self, remove(heavy)).
effect(withdraw, self, grant(shielded)).

% Taunted, it follows its taunter and snaps at it (pinned), and is spent.
behavior(shellback, taunted, snap, source).
reach(snap, ranged).
effect(snap, target, grant(rooted)).
effect(snap, self, grant(exhausted)).
% Spent, its head lies out of the shell: the cold or a jolt stops it.
weakness(shellback, chilled, exhausted, dead).
weakness(shellback, electrocuted, exhausted, dead).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, fireball).

% === Victory ===
% The standard recipes (the guard off first; a mist that lifts shield and
% weight for a moment, then a knock or a hook) ...
win :- if(), do(neutralize(shellback)).
% ... or: the shield off, a transition set off, then the standard recipes
% in the state it is left in.
win :- if(), do(popShield(shellback), setOff(shellback), neutralize(shellback)).

% Any hostile tag pops the shield: cast, area or spilled zone.
popShield(?e) :- if(not(tag(?e, shielded))), do().
popShield(?e) :-
    if(tag(?e, shielded), canAct(?a), knows(?a, ?sk), lands(?sk, ?t), hostile(?t),
       ready(?a, ?sk, ?e)),
    do(cast(?a, ?sk, ?e), confirmOff(?e, shielded)).
% What a skill lands on the NPCs where it is aimed: what grants/2 sees, and
% a vortex's moment of roots (grants/2 does not read `foes`).
lands(?sk, ?t) :- grants(?sk, ?t).
lands(?sk, ?t) :- reach(?sk, ?k), effect(?sk, foes, moment(grant(?t))).

% Someone lands a tag it answers with a behaviour.
setOff(?e) :-
    if(behavior(?e, ?t, ?ab, ?aim), canAct(?a), knows(?a, ?sk), grants(?sk, ?t),
       ready(?a, ?sk, ?e)),
    do(cast(?a, ?sk, ?e), confirmTag(?e, ?t)).

confirmTag(?e, ?t) :- if(tag(?e, ?t)), do().
confirmOff(?e, ?t) :- if(not(tag(?e, ?t))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(tidalWave).
comboPool(hook).
comboPool(taunt).
comboPool(blizzard).
comboPool(lightningFlash).
comboPool(turnToMist).
comboPool(vortex).
comboMinWins(8).
comboMinMethods(4).

goals(win).
