% The Shellback (enemy state machines)
%
% A giant tortoise holds the causeway over a chasm. It is a boss (no stuns),
% heavy (nothing moves it), blocks the way, and wears an energy shield that
% eats the next hostile tag. Its state machine:
%   shielded   -> any hostile tag only pops the shield (a guard: it comes
%                 off first)
%   burning    -> withdraw: it curls into its shell - the shell closes again
%                 (shielded), but it lets go of the stone (heavy no more): a
%                 ball that rolls
%   taunted    -> snap: its head lunges at the taunter (rooted) and it is left
%                 exhausted
%   exhausted  -> the window: its head lies out of the shell, and the cold or
%                 a jolt stops it (dead)
% Its defence becomes its weakness: the fire that shuts it in makes it roll.
% And the mist (turnToMist) takes weight and shield off it for a moment.
%
%   strand --- islet          (the islet faces the causeway across the chasm)
%     |
%   shore --- causeway (Shellback) --- far
%                 |
%               chasm (below)
%
% Methods:
%   curl and roll    a popper takes the shield (taunt, tidalWave, lightning-
%                    Flash); fireball sets it burning, it curls, and the same
%                    blast rolls it off the causeway into the chasm
%   taunt and strike taunt pops the shield, a second taunt makes it snap and
%                    spend itself; then blizzard or lightningFlash on its head
%   mist and roll    turnToMist lifts shield and weight for a moment; in that
%                    moment a push from the shore (fireball, tidalWave), a pull
%                    across the chasm from the islet (hook, a taunt's drag), or
%                    a vortex into the chasm drops it
%
% Traps:
%   - the first hostile tag is always lost on the shield: a fire that pops it
%     leaves flames that will not burn it twice;
%   - frost and fire undo each other: blizzard then fireball only thaws it;
%   - curled, the shell is up again: the next tag is lost too;
%   - a push, a hook or a vortex on the heavy shell does nothing (a hook
%     drags its caster onto the causeway);
%   - a vortex on the causeway sucks the partner onto it, rooted;
%   - the mist lasts one more cast: the push must come at once.

% === Regions ===
region(shore).
region(causeway).
region(far).
region(chasm).
region(strand).
region(islet).
connected(shore, causeway).
connected(causeway, shore).
connected(causeway, far).
connected(far, causeway).
connected(shore, strand).
connected(strand, shore).
connected(strand, islet).
connected(islet, strand).
connected(causeway, chasm).
connected(chasm, causeway).
lineOfSight(shore, causeway).
lineOfSight(causeway, shore).
lineOfSight(far, causeway).
lineOfSight(islet, causeway).
lineOfSight(shore, strand).
lineOfSight(strand, shore).
lineOfSight(strand, islet).
lineOfSight(islet, strand).
lineOfSight(shore, chasm).
lineOfSight(islet, chasm).

% A push from the shore rolls it off into the chasm; from the islet, the
% chasm lies between, so a pull drops it in; a vortex on the chasm draws
% the causeway in.
beyond(shore, causeway, chasm).
beyond(islet, chasm, causeway).
onEnter(chasm, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, shore).
at(mage, shore).
mana(player, 4).
mana(mage, 4).

% === The Shellback ===
role(shellback, enemy).
at(shellback, causeway).
rank(shellback, boss).
tag(shellback, living).
tag(shellback, heavy).
tag(shellback, shielded).
blocker(shellback).

% Burning, it withdraws into its shell: the shell closes (shielded again),
% but it has let go of the stone - heavy no more, a ball that rolls.
behavior(shellback, burning, withdraw, self).
reach(withdraw, self).
effect(withdraw, self, remove(heavy)).
effect(withdraw, self, grant(shielded)).

% Taunted, it snaps at its taunter (pinned) and is spent.
behavior(shellback, taunted, snap, source).
reach(snap, ranged).
effect(snap, target, grant(rooted)).
effect(snap, self, grant(exhausted)).
% Spent, its head lies out of the shell: the cold or a jolt stops it.
weakness(shellback, chilled, exhausted, dead).
weakness(shellback, electrocuted, exhausted, dead).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, fireball).

% === Victory ===
% The standard recipes (the guard off first; a mist that lifts shield and
% weight for a moment, then a push or a pull) ...
win :- if(), do(neutralize(shellback), teamStanding()).
% ... or: the shield off, a transition set off, then the standard recipes
% in the state it is left in.
win :- if(), do(popShield(shellback), setOff(shellback), neutralize(shellback), teamStanding()).

% Any hostile tag pops the shield: cast, area or spilled zone.
popShield(?e) :- if(not(tag(?e, shielded))), do().
popShield(?e) :-
    if(tag(?e, shielded), canAct(?a), knows(?a, ?sk), grants(?sk, ?t), hostile(?t),
       ready(?a, ?sk, ?e)),
    do(cast(?a, ?sk, ?e), confirmOff(?e, shielded)).

% Someone lands a tag it answers with a behaviour.
setOff(?e) :-
    if(behavior(?e, ?t, ?ab, ?aim), canAct(?a), knows(?a, ?sk), grants(?sk, ?t),
       ready(?a, ?sk, ?e)),
    do(cast(?a, ?sk, ?e), confirmTag(?e, ?t)).

confirmTag(?e, ?t) :- if(tag(?e, ?t)), do().
confirmOff(?e, ?t) :- if(not(tag(?e, ?t))), do().
teamStanding() :- if(not(first(and(canAct(?a), gone(?a))))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(tidalWave).
comboPool(hook).
comboPool(taunt).
comboPool(blizzard).
comboPool(lightningFlash).
comboPool(turnToMist).
comboPool(vortex).
comboMinWins(8).
comboMinMethods(4).

goals(win).
