% The Drowned Knight (hazard terrain and physics objects)
%
% A knight in full plate holds a keep on a spit of rock. At the keep's
% foot runs the moat (a pit); across a short drop stands the old tower.
% Between the gate and the causeway lies a dry lock basin, and behind the
% gatehouse wall the sluice that floods it. Nobody can hurt the knight: the
% water and the drop can. Its plate is the puzzle - it is heavy: no
% knockback moves it, no hook drags it (a hook drags the caster to it),
% and in deep water it sinks. Two companions, one skill each, from eight.
%
%             sluice (plate, counterweight)
%            #wall      :gap
%   tower --- gate --- lock --- causeway --- keep (knight; the moat)
%     :                                        :
%     :................... gap ................:
%
% Two ways, opposite in kind:
%   drown it   keep it heavy and make it walk: taunted, the knight walks
%              after its taunter into the lock (only a taunt moves it).
%              Then someone opens the sluice and the lock floods with deep
%              water: the heavy sink. The sluice is a pressure plate behind
%              the wall, pressed by the counterweight knocked onto it
%              (fireball, shieldBash across the gap, vortex on the plate) or
%              by a companion who leaps in and steps on it (blink,
%              lightningFlash).
%   drop it    turn it to mist (turnToMist): for a moment it is not heavy,
%              and the very next cast can knock it into the moat or the drop
%              by the tower (fireball, shieldBash, vortex on the moat), or
%              hook it across the drop from the tower (it falls in).
% Traps: misted, it no longer drowns (and the mist lasts one cast only);
% the flood is wasted if the knight is not yet in the lock (it will never
% wade into deep water); the counterweight can be knocked into the gap
% instead of onto the plate; hooked while heavy, the knight drags you onto
% the keep instead; nobody walks to the sluice.
region(gate).
region(lock).
region(causeway).
region(keep).
region(tower).
region(sluice).
connected(gate, lock).
connected(lock, causeway).
connected(causeway, keep).
connected(gate, tower).
gap(tower, keep).
gap(lock, sluice).
wall(gate, sluice).
lineOfSight(gate, lock).
lineOfSight(gate, sluice).
lineOfSight(lock, sluice).
lineOfSight(lock, keep).
lineOfSight(causeway, keep).
lineOfSight(tower, keep).

% === Terrain ===
% The moat, at the keep's foot: a pit.
feature(keep, moat, chasm).
% The sluice: a plate; pressed, the lock floods with deep water.
feature(sluice, sluiceGate, flood).
plate(sluiceGate).
effect(flood, target, spill(deepWater, lock)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gate).
at(mage, gate).
mana(player, 4).
mana(mage, 4).

% === The knight ===
% Heavy: nothing knocks it or drags it, and the catalogue sinks the heavy
% in deep water.
role(knight, enemy).
at(knight, keep).
tag(knight, living).
tag(knight, heavy).
% Taunted, it walks up to its taunter and slams (telegraphed, physical):
% everyone in that area but the knight is stunned and knocked back.
behavior(knight, taunted, groundSlam, source).

% === The counterweight, by the sluice ===
role(counterweight, object).
at(counterweight, sluice).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, fireball).

% === Victory ===
win :- if(), do(drown(knight)).
win :- if(), do(dropIt(knight)).

% Drown: bring the heavy one into the basin the sluice floods, then open
% the sluice.
drown(?e) :-
    if(has(?e, heavy), feature(?s, ?p, ?ab), plate(?p), effect(?ab, target, spill(deepWater, ?r))),
    do(bringTo(?e, ?r, none), flood(?p, ?r), confirmStopped(?e)).

% The basin floods - unless it already did (opened in the knight's wind-up).
flood(?p, ?r) :- if(onEnter(?r, deepWater)), do().
flood(?p, ?r) :- if(not(onEnter(?r, deepWater))), do(openSluice(?p), confirmFlooded(?r)).

% The plate is pressed: something there is knocked onto it, or a companion
% leaps in (or already leapt in) and steps on it.
openSluice(?p) :-
    if(feature(?r, ?p, ?ab), canAct(?a), at(?a, ?r)), do(stepOn(?a, ?p)).
openSluice(?p) :-
    if(feature(?r, ?p, ?ab), at(?x, ?r), not(canAct(?x))),
    do(knockOn(?x, feature(?p), none)).
openSluice(?p) :-
    if(feature(?r, ?p, ?ab), canAct(?a), knows(?a, ?sk), leaps(?sk), first(spot(?a, ?sk, ?r, ?from))),
    do(castFrom(?a, ?sk, ?r, ?from), stepOn(?a, ?p)).
leaps(?sk) :- effect(?sk, target, dash).
leaps(?sk) :- effect(?sk, target, teleport).
confirmFlooded(?r) :- if(onEnter(?r, deepWater)), do().

% Drop: take its weight away for a moment, and someone else sends it down
% while the moment lasts.
dropIt(?e) :-
    if(has(?e, heavy), canUnset(?p, ?ab, heavy, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(heavy, ?e), sendDown(?e, ?p), confirmStopped(?e)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(turnToMist).
comboPool(fireball).
comboPool(shieldBash).
comboPool(vortex).
comboPool(hook).
comboPool(blink).
comboPool(lightningFlash).
comboMinWins(12).
comboMinMethods(5).

goals(win).
