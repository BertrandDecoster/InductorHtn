% Lightning Rod (ability catalogue; category: enemies' powers used against them)
%
% A sentry robot guards the hall of a ruined foundry. Next door, in the
% forge, a storm golem idles. Nobody in the party can make lightning - but
% the golem can. Taunted, it is dragged to whoever taunted it; blinded, it
% lashes out where it stands. Either way it winds up a discharge (a heavy
% blow) on the region it stands in, and it lands on everyone there but the
% golem: electrocuted.
%
%                           vent   chimney
%                              \   /
%   gallery - hall (robot) - forge (golem)
%              |
%           fountain (a pool: whoever arrives is soaked)
%
% The robot is a machine: jolted dry it is only stunned; soaked, then
% jolted, it short-circuits. It has no temper (it cannot be taunted).
% Three things must meet: a wet robot, the golem in the same region, and
% the golem set off there - with no companion left inside when it lands.
%
% Soak the robot:
%   tidalWave  in the hall, or washed from the gallery into the fountain
%   hook       dragged into the fountain from the fountain
%   vortex     drawn into the fountain
% Bring them together:
%   hook       the golem to the robot, or the robot to the golem
%   vortex     draw them both into one region
%   tidalWave  wash the golem out of the forge from the vent (to the hall)
%              or the chimney (to the fountain)
% Set the golem off:
%   blindingFlash  where it stands; the flash's disjoint makes the blow
%              pass through the flasher, so it can be cast from inside
%   taunt      from the robot's region: the golem is dragged there - and
%              the taunter is inside the struck region. It gets one cast
%              from a friend: a hook drags it out.
% Traps:
%   - setting the golem off before the robot is wet only stuns the robot,
%     and a golem already taunted (or blinded) will not answer again;
%   - a wave cast to save the taunter washes the robot out too;
%   - fire dries: a fireball on the soaked robot is steam, and a fireball
%     that sends it into the fountain puts its own fire out instead.
% The golem's discharge jolts nobody of the party: a plan that leaves a
% companion in the struck region has no plan.

% === Regions ===
region(gallery).
region(hall).
region(forge).
region(vent).
region(fountain).
region(chimney).
connected(gallery, hall).
connected(hall, gallery).
connected(hall, forge).
connected(forge, hall).
connected(hall, fountain).
connected(fountain, hall).
connected(forge, vent).
connected(vent, forge).
connected(forge, chimney).
connected(chimney, forge).
lineOfSight(gallery, hall).
lineOfSight(hall, gallery).
lineOfSight(hall, forge).
lineOfSight(forge, hall).
lineOfSight(hall, fountain).
lineOfSight(fountain, hall).
lineOfSight(fountain, forge).
lineOfSight(forge, fountain).
lineOfSight(vent, forge).
lineOfSight(chimney, forge).

% Push lines: from the gallery, a blow on the hall lands in the fountain;
% from the vent, whatever is washed out of the forge lands in the hall;
% from the chimney, down the sluice into the fountain.
beyond(gallery, hall, fountain).
beyond(vent, forge, hall).
beyond(chimney, forge, fountain).

onEnter(fountain, puddle).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gallery).
at(mage, gallery).
mana(player, 4).
mana(mage, 4).

% === Enemies ===
role(robot, enemy).
at(robot, hall).
tag(robot, machine).
immune(robot, taunted).

% The storm golem: taunted or blinded, it winds up a discharge where it
% stands (after the taunt has dragged it).
role(golem, enemy).
at(golem, forge).
behavior(golem, taunted, discharge, here).
behavior(golem, blinded, discharge, here).
heavy(discharge).
effect(discharge, area, grant(electrocuted)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, taunt).

% === Recipes (level-local: the golem's power, turned) ===

% ?e ends up in ?r: already there, pulled there by someone standing in ?r,
% or pushed, washed or drawn there.
bring(?e, ?r) :- if(at(?e, ?r)), do().
bring(?e, ?r) :-
    if(at(?e, ?er), \==(?er, ?r), puller(?p, ?ab, ?e), reach(?ab, ?k), inRange(?k, ?r, ?er),
       canReachNow(?p, ?r)),
    do(castFrom(?p, ?ab, ?e, ?r), arrived(?e, ?r)).
bring(?e, ?r) :-
    if(not(at(?e, ?r)), canAct(?p), first(placement(?p, ?ab, ?from, ?aim, ?e, ?r))),
    do(castFrom(?p, ?ab, ?aim, ?from), arrived(?e, ?r)).
arrived(?e, ?r) :- if(at(?e, ?r)), do().

% Soak ?v: a cast that wets it where it stands, or bring it into a pool.
soak(?v) :- if(holds(?v, wet)), do().
soak(?v) :- if(not(holds(?v, wet)), canAct(?p), first(canInflict(?p, ?ab, wet, ?v))), do(inflictAs(?p, wet, ?v)).
soak(?v) :- if(not(holds(?v, wet)), zoneFor(?r, wet)), do(bring(?v, ?r), wetNow(?v)).
wetNow(?v) :- if(holds(?v, wet)), do().

% Set ?npc off in ?r: a trigger whose own movement drags it into ?r, given
% from ?r; or, standing in ?r already, any trigger that does not move it.
trigger(?npc, ?r) :-
    if(behavior(?npc, ?t, ?b, here), onGrant(?t, pull), at(?npc, ?nr),
       canAct(?a), knows(?a, ?ab), grants(?ab, ?t), ready(?a, ?ab, ?npc),
       reach(?ab, ?k), inRange(?k, ?r, ?nr), canReachNow(?a, ?r)),
    do(stepAside(?r, ?a), castFrom(?a, ?ab, ?npc, ?r)).
trigger(?npc, ?r) :-
    if(at(?npc, ?r), behavior(?npc, ?t, ?b, here), not(hasOnGrant(?t)),
       canAct(?a), first(canInflict(?a, ?ab, ?t, ?npc))),
    do(stepAside(?r, ?a), inflictAs(?a, ?t, ?npc)).

% Everyone but ?a steps out of ?r, to a next region that still sees it.
stepAside(?r, ?a) :- if(not(first(and(at(?c, ?r), canAct(?c), \==(?c, ?a))))), do().
stepAside(?r, ?a) :-
    if(at(?c, ?r), canAct(?c), \==(?c, ?a), connected(?r, ?n), lineOfSight(?n, ?r)),
    do(walkTo(?c, ?n)).

% The golem's discharge on the robot: lured to it, brought to it, or the
% robot brought to the golem - then set off there.
setOff(?npc, ?v) :- if(at(?v, ?r)), do(trigger(?npc, ?r)).
setOff(?npc, ?v) :- if(at(?v, ?r), not(at(?npc, ?r))), do(bring(?npc, ?r), trigger(?npc, ?r)).
setOff(?npc, ?v) :- if(at(?npc, ?r), not(at(?v, ?r))), do(bring(?v, ?r), wetNow(?v), trigger(?npc, ?r)).
setOff(?npc, ?v) :-
    if(at(?npc, ?nr), at(?v, ?vr), \==(?nr, ?vr), region(?r), \==(?r, ?nr), \==(?r, ?vr)),
    do(bring(?npc, ?r), bring(?v, ?r), wetNow(?v), trigger(?npc, ?r)).

win :- if(), do(soak(robot), setOff(golem, robot), confirmStopped(robot)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(blindingFlash).
comboPool(hook).
comboPool(vortex).
comboPool(tidalWave).
comboPool(fireball).
comboMinWins(6).
comboMinMethods(3).

goals(win).
