% Lightning Rod (ability catalogue; category: enemies' powers used against them)
%
% A sentry robot guards the hall of a ruined foundry; next door, in the
% forge, a storm golem idles. Nobody in the party makes lightning - but the
% golem does. Taunted, or soaked, it winds up a discharge (a heavy blow) on
% the area it stands in, which lands on everyone there but the golem:
% electrocuted. It has one charge: the discharge spends it (silenced).
%
%              pumps (the valve: a plate)
%             //    \\               // = wall (teleport only)
%   gallery --- hall (robot; fountain) --- forge (golem)
%
% Sight: gallery-hall, hall-forge. The fountain is a pool in the hall
% (knocked in: wet); the valve in the walled pump room floods the hall
% (spill(puddle, hall): everyone there, and whoever walks in, is wet).
% The robot is a machine: jolted dry it is only stunned; soaked, then
% jolted, it short-circuits. It has no temper (no taunt lands).
% Two companions, one skill each from seven. Three things must meet: a wet
% robot, the golem in its area, and the golem set off there.
%   soak the robot   tidalWave (in the hall), vortex (into the fountain),
%                    shieldBash (knocked into the fountain), blink (into
%                    the pump room, onto the valve: the hall floods)
%   bring them       hook (the golem into the hall), taunt (it walks in)
%   set it off       taunt (on arrival); water on the golem: a wave or a
%                    vortex with both in the hall, or the flooded hall it
%                    is hooked or walks into
% Traps:
%   - one charge: set off before the robot is wet, it only stuns it;
%   - fire dries: a fireball's flames on the robot meet the fountain's
%     water (extinguish) - though a second fireball finds the hall already
%     alight, and its knock alone soaks the robot;
%   - a shield bash on the golem stuns it (silenced: no discharge);
%   - water on the golem in its own forge spends the charge there.
% Whoever stands in the hall when it discharges is jolted too (harmless
% to the party): the team may answer in the window, or take it.

% === Map ===
region(gallery).
region(hall).
region(forge).
region(pumps).
connected(gallery, hall).
connected(hall, forge).
wall(gallery, pumps).
wall(hall, pumps).
lineOfSight(gallery, hall).
lineOfSight(hall, gallery).
lineOfSight(hall, forge).
lineOfSight(forge, hall).
feature(hall, fountain, puddle).
feature(pumps, valve, flood).
plate(valve).
effect(flood, target, spill(puddle, hall)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gallery).
at(mage, gallery).
mana(player, 4).
mana(mage, 4).

% === Enemies ===
role(robot, enemy).
at(robot, hall).
tag(robot, machine).
immune(robot, taunted).

% The storm golem: taunted or soaked, it discharges where it stands, once.
role(golem, enemy).
at(golem, forge).
immune(golem, electrocuted).
behavior(golem, taunted, discharge, here).
behavior(golem, wet, discharge, here).
heavy(discharge).
effect(discharge, target, grant(electrocuted)).
effect(discharge, self, grant(silenced)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, tidalWave).

% === Recipes (level-local: the golem's power, turned) ===

% A companion gets to ?r: walks, or teleports next door.
getTo(?a, ?r) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r) :-
    if(not(canReachNow(?a, ?r)), knows(?a, ?ab), effect(?ab, target, teleport), region(?from),
       blinkEdge(?from, ?r), canReachNow(?a, ?from)),
    do(castFrom(?a, ?ab, ?r, ?from), settled(?a, ?r)).
settled(?e, ?r) :- if(at(?e, ?r)), do().

% Soak ?v: a cast that wets it, a knock into a pool, or a plate that
% floods its area.
soak(?v) :- if(holds(?v, wet)), do().
soak(?v) :- if(neutralized(?v)), do().
soak(?v) :- if(not(holds(?v, wet)), not(neutralized(?v))), do(inflict(wet, ?v, nobody)).
soak(?v) :-
    if(not(holds(?v, wet)), not(neutralized(?v)), featureFor(?f, wet),
       not(first(and(canAct(?p), canInflict(?p, ?ab, wet, ?v))))),
    do(knockOn(?v, feature(?f), nobody)).
soak(?v) :-
    if(not(holds(?v, wet)), not(neutralized(?v)), at(?v, ?r), plate(?p), feature(?pr, ?p, ?ab),
       effect(?ab, target, spill(?z, ?r)), effect(?z, target, grant(wet)), canAct(?a)),
    do(getTo(?a, ?pr), stepOn(?a, ?p)).

% ?npc and ?v in one area: one brought to the other.
meet(?npc, ?v) :- if(at(?npc, ?r), at(?v, ?r)), do().
meet(?npc, ?v) :- if(at(?v, ?r), not(at(?npc, ?r))), do(bringTo(?npc, ?r, nobody), together(?npc, ?v)).
meet(?npc, ?v) :- if(at(?npc, ?r), not(at(?v, ?r))), do(bringTo(?v, ?r, nobody), together(?npc, ?v)).
together(?npc, ?v) :- if(at(?npc, ?r), at(?v, ?r)), do().

% Set ?npc off, unless ?v is already out.
fire(?npc, ?v) :- if(neutralized(?v)), do().
fire(?npc, ?v) :-
    if(not(neutralized(?v)), behavior(?npc, ?t, ?ab, here)), do(inflict(?t, ?npc, nobody)).

% Soak first, or bring them together first.
win :- if(), do(soak(robot), meet(golem, robot), fire(golem, robot), confirmStopped(robot)).
win :- if(), do(meet(golem, robot), soak(robot), fire(golem, robot), confirmStopped(robot)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(tidalWave).
comboPool(vortex).
comboPool(shieldBash).
comboPool(fireball).
comboPool(blink).
comboMinWins(6).
comboMinMethods(3).

goals(win).
