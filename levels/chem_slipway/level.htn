% Slipway (elemental chemistry)
%
% A clockwork crab, a heavy machine, squats on the slipway above the
% flooded dock. It is too heavy to shift, and a dry jolt only stuns it. It
% cannot swim (this level: weakness(crab, deepWater, none, fell)). Two
% companions, one skill each, from a pool of seven.
%
%   quay (player, mage) --- slipway (crab) --- berth
%     |                        |
%   stairs                    dock    (deepWater)
%     |
%   gantry     (across the dock, facing the slipway)
%
% Obstacles:
%   heavy      no push or pull moves it (Hook drags the caster to it)
%   machine    a jolt on a dry machine only stuns it
%
% Methods (each needs two different companions):
%   short it   soak it (tidalWave), then jolt it (lightningFlash): a wet
%              machine short-circuits (dead)
%   sink it    turn it to mist (turnToMist: for a moment it is not heavy),
%              and on the very next cast move it into the dock: a push from
%              the quay (tidalWave, fireball), a pull-in on the dock
%              (vortex), or a drag across the dock from the gantry (hook,
%              taunt): it falls in (fell)
%
% Traps:
%   the mist lasts one cast: any other cast before the move, and it is
%   heavy again. A jolt first only stuns it. Fire, then water: the water
%   only puts the fire out (extinguish), it is not soaked; water, then
%   fire: the fire only dries it (steam). A hook or a taunt from the quay
%   drags the misted crab to the quay, not into the water.

% === Regions ===
region(quay).
region(slipway).
region(berth).
region(dock).
region(stairs).
region(gantry).
connected(quay, slipway).
connected(slipway, quay).
connected(slipway, berth).
connected(berth, slipway).
connected(slipway, dock).
connected(dock, slipway).
connected(quay, stairs).
connected(stairs, quay).
connected(stairs, gantry).
connected(gantry, stairs).
lineOfSight(quay, slipway).
lineOfSight(quay, dock).
lineOfSight(gantry, slipway).
lineOfSight(gantry, dock).

% Push lines: from the quay, the slipway falls into the dock; from the
% gantry, the dock lies between it and the slipway.
beyond(quay, slipway, dock).
beyond(gantry, dock, slipway).

% === Zones ===
onEnter(dock, deepWater).


% === Companions ===
role(player, player).
role(mage, companion).
at(player, quay).
at(mage, quay).
mana(player, 4).
mana(mage, 4).

% === Enemy: a clockwork crab; it cannot swim ===
role(crab, enemy).
at(crab, slipway).
tag(crab, machine).
tag(crab, heavy).
weakness(crab, deepWater, none, fell).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, lightningFlash).

win :- if(), do(neutralize(crab)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(lightningFlash).
comboPool(turnToMist).
comboPool(fireball).
comboPool(hook).
comboPool(vortex).
comboPool(taunt).
comboMinWins(4).
comboMinMethods(3).

goals(win).
