% The Sinkhole (ability catalogue)
%
% A ledge above a collapsing floor. On the rim stands a stone golem, by a
% hole where the floor has already fallen in. Beside the rim, a pump
% automaton wades in a flooded pool that drains into the sinkhole, and a
% wicker tender minds an oil slick. Two companions, one skill each, from
% six.
%
%            ledge (player, mage)
%              |
%   slick --- rim (golem; the hole) --- pool (wader; the drain)
%
%   golem    a boss: heavy (nothing knocks it), no stun. It will not be
%            baited. Pin it (rooted: a vortex) or jolt it (electrocuted: a
%            lightning flash) and it stamps: a telegraphed cave-in on its
%            own rim (the catalogue's caveIn, physical, unstoppable). The
%            whole rim becomes a chasm, and everything on it falls - the
%            golem, any mook brought there, any companion still standing
%            there. Or turn it to mist and knock it into the hole.
%   wader    a machine, soaked: a jolt kills it; knocked into the drain,
%            it falls; brought onto the rim, it goes down with it.
%   tender   wooden and oiled: fire kills it (the oil blazes); brought
%            onto the rim, it goes down with it.
%
% Methods:
%   the sinkhole   bring both mooks onto the rim - hook them in from the
%                  rim, or taunt them from it (they walk after the
%                  taunter) - then make the golem stamp from the ledge
%                  (vortex, lightningFlash): one cave-in takes all three
%                  (hook + vortex, hook + lightningFlash, taunt + vortex,
%                  taunt + lightningFlash)
%   one by one     the fireball burns the tender and knocks the wader into
%                  the drain; the golem is made to stamp on its empty rim
%                  (fireball + vortex, fireball + lightningFlash), or is
%                  misted and knocked into the hole (fireball + turnToMist)
%   mixed          the vortex on the drain and the flash in the pool take
%                  the wader where it stands; the tender still has to be
%                  brought onto the rim for the cave-in
%
% Traps:
%   - making the golem stamp first cuts the rim: nobody can stand on it
%     to bring the tender in, and nothing else reaches it but fire;
%   - the taunted mooks follow their taunter: if it walks off the rim,
%     they walk off with it - the taunter stays and goes down with the
%     rim (a sacrifice), a hooker can walk away;
%   - the cave-in and a vortex on the hole take friends too;
%   - fire on the soaked wader only makes steam (the blast still knocks).
%
% Hypothesis (design.md): no single skill wins; 14 of 36 assignments do
% (7 pairs, either way round), by 7 methods of three kinds; the golem's
% cave-in is both the weapon and the danger.

% === Map: four areas; features inside the rim and the pool ===
region(ledge).
region(rim).
region(pool).
region(slick).
connected(ledge, rim).
connected(rim, pool).
connected(rim, slick).
lineOfSight(ledge, rim).
lineOfSight(ledge, pool).
lineOfSight(ledge, slick).
lineOfSight(rim, pool).
lineOfSight(rim, slick).
lineOfSight(pool, rim).
lineOfSight(slick, rim).

feature(rim, hole, chasm).
feature(pool, drain, chasm).
onEnter(pool, puddle).
onEnter(slick, slick).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, ledge).
at(mage, ledge).
mana(player, 6).
mana(mage, 6).

% === Enemies ===
role(golem, enemy).
at(golem, rim).
rank(golem, boss).
tag(golem, heavy).
tag(golem, living).
immune(golem, taunted).
behavior(golem, rooted, caveIn, here).
behavior(golem, electrocuted, caveIn, here).

role(wader, enemy).
at(wader, pool).
tag(wader, machine).
tag(wader, wet).

role(tender, enemy).
at(tender, slick).
tag(tender, wooden).
tag(tender, oiled).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, vortex).

% === The encounter ===
% Each mook is brought onto the rim for the cave-in, or taken where it
% stands; whoever stands on the rim may walk off it (or stay); then the
% golem goes down - its own stamp, or the mist and the hole.
clearSinkhole :-
    if(),
    do(mook(wader), mook(tender), stepOff(), golemDown(golem),
       confirmStopped(wader), confirmStopped(tender)).

mook(?e) :- if(not(gone(?e))), do(bringTo(?e, rim, none)).
mook(?e) :- if(), do(neutralize(?e)).

% Before the stamp, the companions on the rim walk back to the ledge - or
% stay, and go down with it (sacrifice is allowed). A taunted mook follows
% its taunter off the rim.
onRim(?a) :- canAct(?a), at(?a, rim), not(gone(?a)).
stepOff() :- if(not(first(onRim(?a)))), do().
stepOff() :- if(first(onRim(?a))), do(leaveRim()).
stepOff() :- if(first(onRim(?a))), do().
leaveRim() :- allOf, if(onRim(?a)), do(walkTo(?a, ledge)).

% The golem goes down: made to stamp (anyone casts a skill that lands a
% tag it answers with its cave-in - on it, on its area, or on the NPCs
% there, as a vortex's pin does), or by the recipes (mist, then a knock
% into the hole).
golemDown(?g) :- if(not(gone(?g))), do(provoke(?g), confirmStopped(?g)).
golemDown(?g) :- if(), do(neutralize(?g)).
landsOn(?ab, ?t) :- effect(?ab, ?w, grant(?t)).
landsOn(?ab, ?t) :- effect(?ab, ?w, moment(grant(?t))).
provoke(?g) :-
    if(behavior(?g, ?t, caveIn, here), canAct(?a), knows(?a, ?ab), landsOn(?ab, ?t),
       ready(?a, ?ab, ?g)),
    do(cast(?a, ?ab, ?g)).

funBlocker(golem).
funBlocker(wader).
funBlocker(tender).
funBlockerGoal(golem, neutralize(golem)).
funBlockerGoal(wader, neutralize(wader)).
funBlockerGoal(tender, neutralize(tender)).
funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(vortex).
comboPool(lightningFlash).
comboPool(fireball).
comboPool(turnToMist).
comboMinWins(10).
comboMinMethods(5).

goals(clearSinkhole).
