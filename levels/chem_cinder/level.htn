% Cinder (elemental chemistry)
%
% A fire imp, wreathed in flame, holds the cloister yard. Things of fire
% die of the cold (catalogue: fireElemental, chilled -> dead) - but cold on
% a burning thing only quenches the flame, and cold on a wet thing only
% freezes it (stunned). Every chill is spent on a layer: burning or wet
% absorbs one, and only a chill on a dry, unlit imp kills. The yard keeps a
% fountain (a pool feature: what is knocked in is soaked); the frozen pond
% next door is ice all over (an iceSheet zone). Two companions, one skill
% each, from a pool of seven.
%
%   court (player, mage) ---- yard (imp; fountain) ---- pond (iceSheet)
%     |                                                   |
%     +-------------------- cloister --------------------+
%
%   sight: court->yard, cloister->pond, pond->yard
%
% Obstacles:
%   burning   cold on it only quenches it; water on it only puts it out
%   wet       cold on it only freezes it (stunned, not dead)
%   a spilled zone does not land again where it already lies: a second
%   blizzard on the same ice does nothing
%
% Methods (one companion puts the fire out, the other lands the cold):
%   douse, then chill   put the fire out: a wave in the yard (tidalWave), a
%                       knock into the fountain (fireball, shieldBash, or a
%                       vortex on the fountain), or a blizzard (a quench);
%                       then chill it dry: a blizzard on the yard, or bring
%                       it onto the pond (a hook from the pond; a taunt, and
%                       it walks onto the ice after you)
%   light, then ice     fireball on the yard itself leaves flames; a
%                       blizzard melts them to a puddle (the fire goes out),
%                       a second blizzard freezes the puddle over (a dry
%                       chill: zone reactions do the whole combo)
%
% Traps:
%   the wave's own knockback, aimed into the fountain, soaks the doused imp
%   again: the next chill only freezes it. A fireball at the imp leaves
%   flames in the yard: a blizzard there melts them to a puddle and soaks
%   it - only the pond still kills. Shield Bash stuns it: a stunned imp
%   cannot follow a taunt. The vortex roots it for a moment: taunted on the
%   next cast, it cannot follow either. Dragged onto the pond while
%   burning, it is only quenched, and the pond takes it once.

% === Areas ===
region(court).
region(yard).
region(pond).
region(cloister).
connected(court, yard).
connected(yard, pond).
connected(court, cloister).
connected(cloister, pond).
lineOfSight(court, yard).
lineOfSight(cloister, pond).
lineOfSight(pond, yard).

% === Terrain ===
feature(yard, fountain, puddle).
onEnter(pond, iceSheet).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, court).
at(mage, court).
mana(player, 4).
mana(mage, 4).

% === Enemy: a thing of fire, alight ===
role(imp, enemy).
at(imp, yard).
tag(imp, fireElemental).
tag(imp, burning).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, blizzard).

% === The goal: the imp dies of the cold ===
win :- if(), do(douseThenChill(imp)).
win :- if(), do(lightThenIce(imp)).

% One companion puts the fire out; another lands the cold.
douseThenChill(?e) :-
    if(holds(?e, burning), canAct(?p)),
    do(putOut(?p, ?e), ensureOff(burning, ?e), chill(?e, ?p), confirmStopped(?e)).

% Water or cold on it: a cast (a wave, a blizzard), or a knock into water.
putOut(?p, ?e) :- if(), do(inflictAs(?p, wet, ?e)).
putOut(?p, ?e) :- if(), do(inflictAs(?p, chilled, ?e)).
putOut(?p, ?e) :-
    if(at(?e, ?r), feature(?r, ?f, ?ab), featureFor(?f, wet),
       first(knocks(?p, ?kab, ?from, ?aim, ?e, feature(?f)))),
    do(castFrom(?p, ?kab, ?aim, ?from)).

% Cold on it, by anyone but ?not: a cast on its ground, or brought onto ice.
chill(?e, ?not) :- if(), do(inflict(chilled, ?e, ?not)).
chill(?e, ?not) :- if(zoneFor(?r, chilled)), do(bringTo(?e, ?r, ?not)).

% Fire on its ground, then ice twice: the ice melts the flames into a
% puddle (the fire goes out), and the puddle freezes over.
lightThenIce(?e) :-
    if(holds(?e, burning), at(?e, ?r), not(hasZone(?r)), canAct(?p)),
    do(spillOn(?p, flames, ?r), iceOver(?r, ?p), iceOver(?r, ?p), confirmStopped(?e)).

% ?p leaves zone ?z on area ?r; anyone but ?not ices ?r over.
spillOn(?p, ?z, ?r) :-
    if(canAct(?p), knows(?p, ?ab), effect(?ab, target, spill(?z)), ready(?p, ?ab, ?r),
       first(spot(?p, ?ab, ?r, ?from))),
    do(castFrom(?p, ?ab, ?r, ?from)).
iceOver(?r, ?not) :- if(canAct(?a), \==(?a, ?not)), do(spillOn(?a, iceSheet, ?r)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(blizzard).
comboPool(fireball).
comboPool(shieldBash).
comboPool(vortex).
comboPool(hook).
comboPool(taunt).
comboMinWins(4).
comboMinMethods(3).

goals(win).
