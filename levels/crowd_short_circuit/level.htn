% Short Circuit (ability catalogue, crowd control)
%
% Three clockwork drones guard the yard of an old foundry. A drone is a
% machine: a jolt on a dry one only stuns it, a jolt on a wet one
% short-circuits it (dead). A jolt is an area effect - a flash of lightning
% into the yard, or a blinding flash among the drones - so one jolt catches
% the whole crowd, once it is soaked. Or leave the jolts alone: the forge
% floor is rotten, and the ogre who works it stamps it through (caveIn, a
% telegraphed physical heavy attack) when it is dazzled (blinded) or jolted
% (electrocuted). Whatever is in its area then falls - the ogre, and any
% companion who stayed (sacrifice is allowed). The forge also has a slag
% pit: whatever is knocked into it is lost.
%
%                  sump (puddle)
%                     |
%   gate (player, mage) --- yard (cog1 cog2 cog3; coolant pool)
%                     |
%                  forge (ogre; slag pit)
%
% Four areas; the yard is the hub (every link walkable). The coolant pool in
% the yard soaks whatever is knocked into it; the sump is flooded (whoever
% walks in is soaked); the slag pit in the forge is lava. The gate sees the
% yard; the yard, the sump and the forge see each other.
%
% Two companions, one skill each, from seven. Each has mana for one wave or
% one flash of lightning.
%
% Obstacles:
%   - the drones are dry: a jolt only stuns them;
%   - a flash of lightning costs all of a companion's mana: one each;
%   - the pit and the ogre are in the forge, the drones in the yard: only a
%     hook or a taunt moves a drone (or the ogre) to another area.
%
% Methods:
%   short them (a weakness): soak the crowd, then jolt it
%     soak   tidalWave among the drones; vortex on the coolant pool (the
%            whole yard knocked in); shieldBash each into the pool; herd them
%            into the sump (taunt: they walk after you; hook: one at a time)
%     jolt   lightningFlash into their area; blindingFlash among them
%   drop them (a hazard)
%     pit    bring them into the forge (taunt, hook), then knock them into
%            the slag: vortex (the whole forge), tidalWave (everyone around
%            you), shieldBash (one at a time)
%     floor  bring the drones and the ogre together - herd the drones into
%            the forge, or hook the ogre into the yard - and set the ogre
%            off: a blinding flash among them, or a flash of lightning into
%            their area. The floor gives way under everyone there.
% So vortex, tidalWave and shieldBash each soak in one plan and knock into
% the slag in another; taunt and hook herd to the water or to the forge;
% the two flashes jolt the soaked crowd or set the ogre off.
%
% Traps:
%   - a flash of lightning first: dry drones are only stunned, and there
%     is no second;
%   - two soaks, two herders, two jolts: each half alone does nothing;
%   - jolting the ogre alone in its forge: the floor gives way under nobody
%     that matters.

% === Areas ===
region(gate).
region(yard).
region(sump).
region(forge).
connected(gate, yard).
connected(yard, sump).
connected(yard, forge).
lineOfSight(gate, yard).
lineOfSight(yard, sump).
lineOfSight(yard, forge).
lineOfSight(sump, yard).
lineOfSight(forge, yard).

onEnter(sump, puddle).
feature(yard, coolant, puddle).
feature(forge, slag, lava).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gate).
at(mage, gate).
mana(player, 2).
mana(mage, 2).

% === The ogre ===
role(ogre, enemy).
at(ogre, forge).
tag(ogre, living).
behavior(ogre, blinded, caveIn, here).
behavior(ogre, electrocuted, caveIn, here).

% === The crowd ===
role(cog1, enemy).
role(cog2, enemy).
role(cog3, enemy).
at(cog1, yard).
at(cog2, yard).
at(cog3, yard).
tag(cog1, machine).
tag(cog2, machine).
tag(cog3, machine).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, vortex).
knows(mage, lightningFlash).

% === The crowd, as a group ===
% The need: every drone out of the fight. Take the first still standing and
% take it out - an area effect takes the rest with it: short it (lay what
% its lethal weakness needs, then deliver the jolt), drop it into a pit it
% is weak to, or bring a heavy blow down on it.

crowd(?e) :- tag(?e, machine).
standing(?e) :- crowd(?e), not(neutralized(?e)).
cleared :- not(first(standing(?e))).
% What kills ?e once it carries ?have.
lethalCombo(?e, ?have, ?in) :- weakness(?e, ?in, ?have, dead), \==(?have, none).
% A striker: an enemy whose heavy blow lays a zone that takes ?e, set off by
% ?t.
striker(?npc, ?t, ?e) :-
    behavior(?npc, ?t, ?blow, here), heavy(?blow), effect(?blow, target, spill(?z)),
    effect(?z, target, hazard(?h)), weakness(?e, ?h, none, ?out).

win :- if(), do(clearCrowd).

clearCrowd :- if(cleared), do().
clearCrowd :- if(first(standing(?e))), do(takeOut(?e), confirmStopped(?e), clearCrowd).

% Short it: soak the whole crowd, then jolt it.
takeOut(?e) :-
    if(lethalCombo(?e, ?have, ?in)), do(primeCrowd(?have), lay(?in, ?e)).
% Drop it into a pit it is weak to: the crowd brought to the pit's area,
% then knocked in.
takeOut(?e) :-
    if(dropFor(?f, ?e), feature(?r, ?f, ?ab)), do(herdCrowd(?r), knockOn(?e, feature(?f), none)).
% Bring a heavy blow down on it: the striker to the crowd, or the crowd to
% the striker.
takeOut(?e) :-
    if(striker(?npc, ?t, ?e), at(?e, ?r), not(at(?npc, ?r))),
    do(herdCrowd(?r), herd(?npc, ?r), setOff(?t, ?npc)).
takeOut(?e) :-
    if(striker(?npc, ?t, ?e), at(?npc, ?r), not(at(?e, ?r))), do(herdCrowd(?r), setOff(?t, ?npc)).

% Every standing drone carries ?t: take the first that does not, and lay it.
primeCrowd(?t) :- if(not(first(and(standing(?x), not(holds(?x, ?t)))))), do().
primeCrowd(?t) :-
    if(first(and(standing(?x), not(holds(?x, ?t))))),
    do(lay(?t, ?x), confirmHas(?x, ?t), primeCrowd(?t)).

% Every standing drone in ?r: take the first that is not, and bring it.
herdCrowd(?r) :- if(not(first(and(standing(?x), not(at(?x, ?r)))))), do().
herdCrowd(?r) :-
    if(first(and(standing(?x), not(at(?x, ?r))))), do(herd(?x, ?r), herdCrowd(?r)).

% ?e takes ?t: a skill that gives ?t, cast on it (or its area, or everyone
% around the caster); brought into an area whose zone gives ?t; or knocked
% into a feature of its area that gives ?t.
lay(?t, ?e) :- if(canInflict(?a, ?ab, ?t, ?e)), do(cast(?a, ?ab, ?e)).
lay(?t, ?e) :- if(zoneFor(?r, ?t), not(at(?e, ?r))), do(herd(?e, ?r)).
lay(?t, ?e) :-
    if(featureFor(?f, ?t), at(?e, ?r), feature(?r, ?f, ?ab)), do(knockOn(?e, feature(?f), none)).

% ?e ends up in ?r: it is there; it follows its taunter, who walks there; or
% a hook or a taunt brings it.
herd(?e, ?r) :- if(at(?e, ?r)), do().
herd(?e, ?r) :-
    if(not(at(?e, ?r)), follows(?e, ?a), tag(?e, taunted), canAct(?a)),
    do(walkTo(?a, ?r), ensureAt(?e, ?r)).
herd(?e, ?r) :-
    if(not(at(?e, ?r)), not(first(and(follows(?e, ?x), tag(?e, taunted))))),
    do(bringTo(?e, ?r, none), ensureAt(?e, ?r)).

ensureAt(?e, ?r) :- if(at(?e, ?r)), do().

% Set ?npc off with ?t, where it stands.
setOff(?t, ?npc) :- if(canInflict(?a, ?ab, ?t, ?npc)), do(cast(?a, ?ab, ?npc)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(vortex).
comboPool(shieldBash).
comboPool(taunt).
comboPool(hook).
comboPool(lightningFlash).
comboPool(blindingFlash).
comboMinWins(24).
comboMinMethods(12).

goals(win).
