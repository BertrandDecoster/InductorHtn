% Sync: The Decoy (one baits the golem's slam, the other pulls it clear)
%
% A golem stands in the arch to the switch room, and nobody gets past it.
% Up on the balcony, a stone eye - a heavy machine - watches the hall in
% front of the arch: nobody walks into the hall under its gaze. Two
% companions, one skill each from seven. Someone gets the golem out of the
% arch; someone puts the eye out; then one of them walks across the hall
% and steps onto the switch.
%
%                 balcony (eye)
%                /    |   (a shove from the nook throws it down to the camp)
%   camp ---- nook    |
%     \        \      v
%      ------- hall (watched) --- arch (golem) --- switch [plate] --- portcullis
%                 \               /
%                  --- alcove ---
%
% The decoy: a taunted golem is dragged to its taunter and winds up a
% ground slam there (heavy, physical: it cannot be stopped). The team gets
% one cast before it lands on everyone in that region but the golem. Taunt
% it from the balcony, and the slam stuns the eye (a stunned eye cannot
% watch) - but the taunter is in the blast, and cannot save themselves: the
% friend's one cast in the window must pull them clear.
%
% Obstacles and every method:
%   the arch    the golem is a blocker. Get it out: taunt it (dragged to
%               the taunter), hook it (dragged to the hooker), fireball it
%               from the nook (thrown into the alcove), or vortex it into
%               the alcove (rooted there).
%   the hall    the eye watches it. Blind it: blindingFlash next to it, or
%               shieldBash it (stunned); or bait the golem's slam onto it.
%   the slam    the taunter on the balcony is caught in it; the friend's
%               cast in the window gets them out: hook them away, fireball
%               or tidalWave them off the balcony (they land in the camp),
%               or vortex everything movable on the balcony into the nook.
%               The heavy eye stays and takes the blow.
%
% Traps:
%   - moving the golem does not blind the eye; blinding the eye does not
%     move the golem;
%   - taunting from the camp or the nook drags the golem there: its slam
%     hits no eye, and the taunter still needs saving;
%   - blindingFlash only saves its caster (disjoint), never the taunter; a
%     shield bash cannot stop a physical blow;
%   - companions cannot be taunted, so a taunt never rescues anyone.
%
% Hypothesis (design.md): no single skill wins; 20 of 49 assignments win
% (the taunt with each of its four rescuers, and each of three lures with
% each of two blinders, either seat), by 10 methods.

% === Regions ===
region(camp).
region(nook).
region(balcony).
region(hall).
region(alcove).
region(arch).
region(switch).
region(portcullis).
connected(camp, nook).
connected(nook, camp).
connected(nook, balcony).
connected(balcony, nook).
connected(camp, hall).
connected(hall, camp).
connected(nook, hall).
connected(hall, nook).
connected(hall, alcove).
connected(alcove, hall).
connected(alcove, arch).
connected(arch, alcove).
connected(hall, arch).
connected(arch, hall).
connected(arch, switch).
connected(switch, arch).
connected(switch, portcullis).
connected(portcullis, switch).

lineOfSight(camp, nook).
lineOfSight(nook, camp).
lineOfSight(camp, balcony).
lineOfSight(nook, balcony).
lineOfSight(camp, arch).
lineOfSight(nook, arch).
lineOfSight(balcony, arch).
lineOfSight(camp, alcove).
lineOfSight(nook, alcove).

% From the nook, a shove on the arch lands in the alcove; a shove on the
% balcony throws whoever is up there down into the camp.
beyond(nook, arch, alcove).
beyond(nook, balcony, camp).

% === Terrain ===
onEnter(switch, winch).
effect(winch, target, open(portcullis)).
door(portcullis).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 4).
mana(mage, 4).
% Only enemies can be provoked.
immune(?x, taunted) :- canAct(?x).

% === The golem ===
role(golem, enemy).
at(golem, arch).
tag(golem, living).
blocker(golem).
% Taunted, it is dragged to its taunter (onGrant pull) and slams the
% ground there: a telegraphed groundSlam on that region.
behavior(golem, taunted, groundSlam, here).

% === The eye ===
role(eye, enemy).
at(eye, balcony).
tag(eye, machine).
tag(eye, heavy).
watches(eye, hall).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, hook).

% === Victory ===
% ?b stands by (in the camp or the nook), the golem leaves the arch, the
% eye stops seeing, and someone walks onto the switch.
win :-
    if(canAct(?b), standby(?w)),
    do(walkTo(?b, ?w), lure, veil, slip).

standby(camp).
standby(nook).

% Drag it out: anything that pulls (a taunt, a hook), from wherever it
% sees the arch.
lure :-
    if(canAct(?a), knows(?a, ?ab), pulls(?ab), spot(?a, ?ab, arch, ?from)),
    do(castFrom(?a, ?ab, golem, ?from), leftArch).
% Shove it or suck it out of the arch.
lure :- if(region(?r), \==(?r, arch)), do(place(golem, ?r, none), leftArch).
leftArch :- if(not(at(golem, arch))), do().

% The eye is already out (the slam), or someone blinds it.
veil :- if(forbidden(eye, watch)), do().
veil :- if(not(forbidden(eye, watch))), do(inflict(blinded, eye, none), unseeing).
unseeing :- if(forbidden(eye, watch)), do().

slip :- if(canAct(?c)), do(walkTo(?c, switch), opened(portcullis)).
opened(?d) :- if(open(?d)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(hook).
comboPool(fireball).
comboPool(vortex).
comboPool(tidalWave).
comboPool(blindingFlash).
comboPool(shieldBash).
comboMinWins(8).
comboMinMethods(4).

goals(win).
