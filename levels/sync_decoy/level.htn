% Sync: The Decoy (one baits the golem's slam, the other pulls them clear)
%
% A golem holds the arch to the switch room: nobody walks into its area. Up
% on the balcony a stone gargoyle - heavy, living - watches the hall in
% front of the arch: nobody walks into the hall under its gaze. Two
% companions, one skill each from six, and two mana each (one costly
% cast). Someone gets past the golem, someone gets past the gargoyle, then
% one of them steps on the switch plate and walks into the vault.
%
%   camp ------- nook ------- balcony (gargoyle)
%     |            \  sight      /  sight
%   hall (watched) --- arch (golem, well) --- switch [plate] ==portcullis== vault
%
% The decoy: taunted, the golem walks after its taunter and slams the
% ground where it stands (groundSlam, heavy, physical: it cannot be
% stopped). Taunt it from the balcony and the slam stuns the gargoyle - and
% the golem has left the arch. One taunt does both jobs, but the taunter is
% in the blast, and nobody may be left under it (mustSurvive: whoever
% baits the golem is pulled clear). The friend's one cast in the window
% must get the decoy out: a hook from the nook.
%
% Obstacles and every method:
%   the golem     taunt it (it follows you out: the decoy); hook it into
%                 the hall (the gargoyle must be out first); knock it into
%                 the well from the nook (fireball, vortex); or slip past it
%                 with a lightning flash from the hall into the arch.
%   the gargoyle  blind it (blinding flash on the balcony); bait the slam
%                 onto it (the decoy); or lightning-flash into the hall past
%                 its gaze (a dash is not a walk).
%   the vault     step on the switch (the portcullis latches open), walk in.
%
% Traps:
%   - a lure does not blind the gargoyle, a blinder does not move the golem;
%   - the decoy cannot save itself, and no one else but a hooker can: the
%     window allows one cast, without walking, and a knockback never
%     leaves the area;
%   - knocking the golem into anything during the window cancels the slam:
%     the gargoyle keeps watching;
%   - a jolt does nothing to the dry, living gargoyle; one lightning flash
%     per companion (two mana), so no one dashes both into the hall and the
%     arch;
%   - companions cannot be taunted.
%
% Hypothesis (design.md): no single skill wins; 14 of 36 assignments win
% (7 pairs, either seat), by 7 methods, no dead skill.

% === Areas ===
region(camp).
region(nook).
region(balcony).
region(hall).
region(arch).
region(switch).
region(vault).
connected(camp, nook).
connected(nook, balcony).
connected(camp, hall).
connected(hall, arch).
connected(arch, switch).
doorway(switch, vault, portcullis).

lineOfSight(nook, arch).
lineOfSight(balcony, arch).
lineOfSight(nook, balcony).

% The route, for leaps (passage): only forward.
progress(camp, 0).
progress(nook, 0).
progress(balcony, 0).
progress(hall, 1).
progress(arch, 2).
progress(switch, 3).
progress(vault, 4).

% === Features ===
feature(arch, well, chasm).
feature(switch, lever, winch).
plate(lever).
effect(winch, target, open(portcullis)).
door(portcullis).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).
% Whoever baits the golem is pulled clear: no blow may land on a companion.
mustSurvive(player).
mustSurvive(mage).

% === The golem ===
role(golem, enemy).
at(golem, arch).
tag(golem, living).
blocker(golem).
% Taunted, it walks after its taunter and slams the ground there.
behavior(golem, taunted, groundSlam, here).

% === The gargoyle ===
role(gargoyle, enemy).
at(gargoyle, balcony).
tag(gargoyle, living).
tag(gargoyle, heavy).
watches(gargoyle, hall).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, hook).

% === Victory ===
% The gargoyle is dealt with (or left for a dash), the golem is dealt with
% (or left for a dash), then someone reaches the switch, steps on it and
% walks into the vault.
win :- if(), do(veil, lure, slip).

veil :- if(forbidden(gargoyle, watch)), do().
veil :- if(not(forbidden(gargoyle, watch))), do(inflict(blinded, gargoyle, none), unseeing).
veil :- if(not(forbidden(gargoyle, watch))), do().
unseeing :- if(forbidden(gargoyle, watch)), do().

% Drawn out of the arch by a hook ...
lure :-
    if(at(golem, arch), canAct(?a), knows(?a, ?ab), pulls(?ab), region(?r), \==(?r, arch),
       bringing(?a, ?ab, ?r, golem, golem, ?r, land)),
    do(castFrom(?a, ?ab, golem, ?r), leftArch).
% ... or by a taunt: the decoy. The friend first takes a post from which
% the window can be answered.
lure :-
    if(at(golem, arch), canAct(?a), knows(?a, ?ab), grants(?ab, taunted), canAct(?b), \==(?b, ?a),
       standby(?w), region(?r), \==(?r, arch)),
    do(walkTo(?b, ?w), bait(?a, ?ab, ?r), leftArch).
bait(?a, ?ab, ?r) :-
    if(bringing(?a, ?ab, ?r, golem, golem, ?r, land)), do(castFrom(?a, ?ab, golem, ?r)).
standby(nook).
% ... knocked into the well ...
lure :- if(at(golem, arch)), do(knockOn(golem, feature(well), none), confirmStopped(golem)).
% ... or left there, for a lightning flash past it.
lure :- if(at(golem, arch)), do().
lure :- if(not(at(golem, arch))), do().
leftArch :- if(not(at(golem, arch))), do().

slip :- if(canAct(?c)), do(reach(?c, switch), stepOn(?c, lever), opened(portcullis), walkTo(?c, vault)).
opened(?d) :- if(open(?d)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(hook).
comboPool(fireball).
comboPool(vortex).
comboPool(blindingFlash).
comboPool(lightningFlash).
comboMinWins(8).
comboMinMethods(4).

goals(win).
