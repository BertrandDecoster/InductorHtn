% Cold Shoulder (ability catalogue; category: enemies' powers used against them)
%
% Two fire imps keep the goblin foundry hot: one in the forge, one in the
% kiln. Below, in the cave, sleeps the frost troll the goblins keep for the
% cold-room. Chilled, an imp dies (it is a fire elemental) - but nobody in
% the party carries cold. The troll does. Taunted, it is dragged to whoever
% taunted it; blinded, it lashes out where it stands. Either way it winds up
% a frost breath (a heavy blow) on its region: everyone there but the troll
% is chilled, and the floor ices over. The ice stays: an imp that arrives on
% it later is chilled too. Each mood works once (the tag stays).
%
%                  kiln (imp2)
%                 /   |
%   gate --- hall --- | --- cave (troll) --- vent
%                 \   |
%                  forge (imp1)
%
% (Walks: the hall joins the gate, forge, kiln and cave; the forge and kiln
% share a flue; the vent is behind the cave. The forge and kiln both look
% down into the cave through grates.)
%
% The imps are sparks of the forge: mindless (no taunt lands) and light.
% Three shapes, two companions:
%   gather, then one breath
%       put both imps in one room - hook one across (hook), draw them both
%       into the hall (vortex), wash or blast one along a line (tidalWave,
%       fireball) - and bring the troll's breath there: blinded where it
%       stands (blindingFlash, after it was brought), or taunted from that
%       room (taunt: the taunter is in the struck region, and a friend must
%       get it out in the one cast it has - a hook, or a fireball that
%       knocks it clear)
%   breathe first, then deliver
%       set the troll off where it stands (blindingFlash) and send the imps
%       onto the ice it leaves (hook, fireball along the flue line)
%   bring them to the troll
%       hook both imps into the cave, then blind it
% Traps:
%   - taunting from a room with one imp: the second imp is out of reach,
%     and the troll will not answer a taunt twice;
%   - a soaked imp that walks onto ice only freezes over (stunned): water
%     and cold react on arrival, but the breath itself kills a wet imp;
%   - fire on the ice leaves a puddle: a fireball on the iced room undoes
%     the trap for the second imp;
%   - a vortex or a wave cast to save the taunter moves the imps out too.
% The breath never lands on a companion: a plan that leaves one in the
% struck region has no plan.

% === Regions ===
region(gate).
region(hall).
region(forge).
region(kiln).
region(cave).
region(vent).
connected(gate, hall).
connected(hall, gate).
connected(hall, forge).
connected(forge, hall).
connected(hall, kiln).
connected(kiln, hall).
connected(hall, cave).
connected(cave, hall).
connected(forge, kiln).
connected(kiln, forge).
connected(cave, vent).
connected(vent, cave).
lineOfSight(gate, hall).
lineOfSight(hall, gate).
lineOfSight(hall, forge).
lineOfSight(forge, hall).
lineOfSight(hall, kiln).
lineOfSight(kiln, hall).
lineOfSight(hall, cave).
lineOfSight(cave, hall).
lineOfSight(forge, kiln).
lineOfSight(kiln, forge).
lineOfSight(forge, cave).
lineOfSight(cave, forge).
lineOfSight(kiln, cave).
lineOfSight(cave, kiln).
lineOfSight(vent, cave).

% Push lines: from the vent, whatever is driven out of the cave lands in
% the kiln; from the hall, back into the vent. From the hall, a blow on the
% forge carries into the kiln; from the forge, a blow on the kiln carries
% down into the cave.
beyond(vent, cave, kiln).
beyond(hall, cave, vent).
beyond(hall, forge, kiln).
beyond(forge, kiln, cave).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gate).
at(mage, gate).
mana(player, 4).
mana(mage, 4).

% === Enemies ===
role(imp1, enemy).
at(imp1, forge).
tag(imp1, fireElemental).
immune(imp1, taunted).

role(imp2, enemy).
at(imp2, kiln).
tag(imp2, fireElemental).
immune(imp2, taunted).

% The frost troll: taunted or blinded, it breathes frost where it stands.
role(troll, enemy).
at(troll, cave).
tag(troll, living).
immune(troll, chilled).
behavior(troll, taunted, frostBreath, here).
behavior(troll, blinded, frostBreath, here).
heavy(frostBreath).
effect(frostBreath, area, grant(chilled)).
effect(frostBreath, target, spill(iceSheet)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, blindingFlash).

% === Recipes (level-local: the troll's breath, turned on the imps) ===

% ?e ends up in ?r: already there, pulled there by someone standing in ?r,
% or pushed, washed or drawn there.
bring(?e, ?r) :- if(at(?e, ?r)), do().
bring(?e, ?r) :-
    if(at(?e, ?er), \==(?er, ?r), puller(?p, ?ab, ?e), reach(?ab, ?k), inRange(?k, ?r, ?er),
       canReachNow(?p, ?r)),
    do(castFrom(?p, ?ab, ?e, ?r), arrived(?e, ?r)).
bring(?e, ?r) :-
    if(not(at(?e, ?r)), canAct(?p), first(placement(?p, ?ab, ?from, ?aim, ?e, ?r))),
    do(castFrom(?p, ?ab, ?aim, ?from), arrived(?e, ?r)).
arrived(?e, ?r) :- if(at(?e, ?r)), do().

% Set ?npc off in ?r: a trigger whose own movement drags it into ?r, given
% from ?r; or, standing in ?r already, any trigger that does not move it.
trigger(?npc, ?r) :-
    if(behavior(?npc, ?t, ?b, here), onGrant(?t, pull), at(?npc, ?nr),
       canAct(?a), knows(?a, ?ab), grants(?ab, ?t), ready(?a, ?ab, ?npc),
       reach(?ab, ?k), inRange(?k, ?r, ?nr), canReachNow(?a, ?r)),
    do(standBy(?r, ?a), castFrom(?a, ?ab, ?npc, ?r)).
trigger(?npc, ?r) :-
    if(at(?npc, ?r), behavior(?npc, ?t, ?b, here), not(hasOnGrant(?t)),
       canAct(?a), first(canInflict(?a, ?ab, ?t, ?npc))),
    do(stepAside(?r, ?a), inflictAs(?a, ?t, ?npc)).

% Before a lure, the other companion steps out of ?r - or, if it pushes,
% takes a stand next to ?r on a line that would knock the lurer clear.
standBy(?r, ?a) :- if(), do(stepAside(?r, ?a)).
standBy(?r, ?a) :-
    if(canAct(?c), \==(?c, ?a), knows(?c, ?ab), effect(?ab, target, push), connected(?r, ?n),
       lineOfSight(?n, ?r), landing(?n, ?r, ?x), not(at(?c, ?n))),
    do(walkTo(?c, ?n)).

% Everyone but ?a steps out of ?r, to a next region that still sees it.
stepAside(?r, ?a) :- if(not(first(and(at(?c, ?r), canAct(?c), \==(?c, ?a))))), do().
stepAside(?r, ?a) :-
    if(at(?c, ?r), canAct(?c), \==(?c, ?a), first(and(connected(?r, ?n), lineOfSight(?n, ?r)))),
    do(walkTo(?c, ?n)).

% The troll breathes on ?r: lured there, or brought there and set off.
breatheOn(?npc, ?r) :- if(), do(trigger(?npc, ?r)).
breatheOn(?npc, ?r) :- if(not(at(?npc, ?r))), do(bring(?npc, ?r), trigger(?npc, ?r)).

% An imp is in ?r before the breath, or left where it is for now.
before(?e, ?r) :- if(), do(bring(?e, ?r)).
before(?e, ?r) :- if(not(at(?e, ?r))), do().
% After the breath, an imp still standing is sent onto the ice.
after(?e, ?r) :- if(neutralized(?e)), do().
after(?e, ?r) :- if(not(neutralized(?e))), do(bring(?e, ?r), confirmStopped(?e)).

% Pick the room the breath falls on; gather there what can be gathered,
% set the troll off there, deliver the rest onto the ice.
% The troll can be brought first, before the imps.
win :-
    if(floor(?r)),
    do(before(troll, ?r), before(imp1, ?r), before(imp2, ?r), breatheOn(troll, ?r),
       after(imp1, ?r), after(imp2, ?r), confirmStopped(imp1), confirmStopped(imp2)).

% The rooms a breath can be brought to (the gate and the vent are too far).
floor(hall).
floor(forge).
floor(kiln).
floor(cave).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(blindingFlash).
comboPool(hook).
comboPool(vortex).
comboPool(tidalWave).
comboPool(fireball).
comboMinWins(6).
comboMinMethods(3).

goals(win).
