% Cold Shoulder (ability catalogue; category: enemies' powers used against them)
%
% Two fire imps keep the goblin foundry hot: one in the forge, one in the
% kiln. Chilled, an imp dies (it is a fire elemental) - but nobody in the
% party carries cold. The frost troll in the cave does. Taunted, blinded or
% jolted, it breathes frost on the area it stands in: the floor ices over,
% and everyone there is chilled (applied raw: the imps' weakness answers).
% The ice stays - an imp brought onto it later dies too. Each mood works
% once (the tag stays), and a taunted troll keeps following its taunter.
%
%     hall (party) ---------- cave (troll)
%       |                  .'   :
%     forge (imp1) ---- kiln (imp2)      kiln : cave is a gap (the lip of
%                                        the cold-room); the rest walk
%
% Sight: hall-forge, hall-cave, forge-cave, kiln-cave.
% The imps are sparks of the forge: mindless (no taunt lands) and light.
% Two companions, one skill each from seven. The ways:
%   lure it     taunt from an imp's room: the troll walks over and breathes
%               there (taunt moves and triggers); then lead it on to the
%               kiln (it follows) and set it off again - a blinding flash
%               from inside, or a lightning flash from next door
%   gather      hook imp1 into the hall, then into the cave, and set the
%               troll off where it stands (flash or jolt); or breathe first
%               and hook the imp onto the ice
%   the lip     imp2 stands at the gap: knock it in (fireball, tidalWave,
%               shieldBash) or hook it across from the cave (it falls)
% Traps:
%   - the troll answers each mood once: a second taunt does nothing;
%   - a shield bash on the troll stuns it (silenced: no breath), and a
%     knock can drop the troll itself into the gap;
%   - fire on the ice leaves a puddle: a fireball on an iced room undoes
%     it for the second imp;
%   - a wave soaks the imps: a wet imp brought onto the ice only freezes
%     over (stunned), though the breath itself still kills it.
% The breath is instant (no wind-up): nothing to answer.

% === Map ===
region(hall).
region(forge).
region(kiln).
region(cave).
connected(hall, forge).
connected(hall, cave).
connected(forge, kiln).
gap(kiln, cave).
lineOfSight(hall, forge).
lineOfSight(forge, hall).
lineOfSight(hall, cave).
lineOfSight(cave, hall).
lineOfSight(kiln, cave).
lineOfSight(cave, kiln).
lineOfSight(forge, cave).
lineOfSight(cave, forge).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, hall).
at(mage, hall).
mana(player, 4).
mana(mage, 4).

% === Enemies ===
role(imp1, enemy).
at(imp1, forge).
tag(imp1, fireElemental).
immune(imp1, taunted).

role(imp2, enemy).
at(imp2, kiln).
tag(imp2, fireElemental).
immune(imp2, taunted).

% The troll: taunted, blinded or jolted, it breathes frost where it stands
% (after a taunt, where it has walked to).
role(troll, enemy).
at(troll, cave).
tag(troll, living).
immune(troll, chilled).
behavior(troll, taunted, frostBreath, here).
behavior(troll, blinded, frostBreath, here).
behavior(troll, electrocuted, frostBreath, here).
effect(frostBreath, target, spill(iceSheet)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, fireball).

% === Recipes (level-local: the troll's breath, turned on the imps) ===

iced(?r) :- onEnter(?r, iceSheet).
settled(?e, ?r) :- if(at(?e, ?r)), do().

% ?e ends up in ?r: there already, brought one link (a hook, a taunt), or
% two, through the area between.
fetch(?e, ?r) :- if(at(?e, ?r)), do().
fetch(?e, ?r) :- if(not(at(?e, ?r))), do(bringTo(?e, ?r, nobody)).
fetch(?e, ?r) :-
    if(at(?e, ?f), \==(?f, ?r), edge(?f, ?m, walk), edge(?m, ?r, walk), \==(?m, ?r)),
    do(bringTo(?e, ?m, nobody), bringTo(?e, ?r, nobody)).

% The troll comes to ?r: there already, brought (a hook; a taunt, which
% sets it off on arrival), or led there by the one it follows.
come(?r) :- if(at(troll, ?r)), do().
come(?r) :- if(not(at(troll, ?r))), do(bringTo(troll, ?r, nobody)).
come(?r) :-
    if(not(at(troll, ?r)), follows(troll, ?a), tag(troll, taunted)),
    do(walkTo(?a, ?r), settled(troll, ?r)).

% Everyone but ?a steps out of ?r.
stepAside(?r, ?a) :-
    if(not(first(and(at(?c, ?r), canAct(?c), \==(?c, ?a), not(follows(troll, ?c)))))), do().
stepAside(?r, ?a) :-
    if(at(?c, ?r), canAct(?c), \==(?c, ?a), not(follows(troll, ?c)), first(edge(?r, ?n, walk))),
    do(walkTo(?c, ?n)).

% The troll, in ?r, breathes there: it has already, or a companion sets it
% off - a flash from inside, a jolt or a taunt from where it reaches.
setOff(?r) :- if(iced(?r)), do().
setOff(?r) :-
    if(not(iced(?r)), at(troll, ?r), canAct(?a), knows(?a, ?ab), reach(?ab, self),
       grants(?ab, ?t), behavior(troll, ?t, ?b, here), canReachNow(?a, ?r)),
    do(walkTo(?a, ?r), stepAside(?r, ?a), castFrom(?a, ?ab, ?a, ?r), settled(troll, ?r), iceOn(?r)).
setOff(?r) :-
    if(not(iced(?r)), at(troll, ?r), canAct(?a), knows(?a, ?ab), reach(?ab, ?k),
       \==(?k, self), grants(?ab, ?t), behavior(troll, ?t, ?b, here), region(?from),
       inRange(?k, ?from, ?r), canReachNow(?a, ?from)),
    do(stepAside(?r, ?a), castFrom(?a, ?ab, troll, ?from), settled(troll, ?r), iceOn(?r)).
iceOn(?r) :- if(iced(?r)), do().

% An imp is out: dropped in the gap at its edge, brought onto the ice, or
% caught in the breath - the troll brought to it, or it to the troll.
chill(?imp) :- if(neutralized(?imp)), do().
chill(?imp) :-
    if(not(neutralized(?imp)), gapNextTo(?imp)), do(dropInGap(?imp, nobody), confirmStopped(?imp)).
chill(?imp) :-
    if(not(neutralized(?imp)), iced(?r)), do(fetch(?imp, ?r), confirmStopped(?imp)).
chill(?imp) :-
    if(not(neutralized(?imp)), at(?imp, ?r), not(iced(?r))),
    do(come(?r), setOff(?r), confirmStopped(?imp)).
chill(?imp) :-
    if(not(neutralized(?imp)), at(troll, ?r), not(at(?imp, ?r)), not(iced(?r))),
    do(fetch(?imp, ?r), setOff(?r), confirmStopped(?imp)).
chill(?imp) :-
    if(not(neutralized(?imp)), at(troll, ?r), not(at(?imp, ?r)), not(iced(?r))),
    do(setOff(?r), fetch(?imp, ?r), confirmStopped(?imp)).

% Both imps out, the forge imp first.
win :- if(), do(chill(imp1), chill(imp2)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(blindingFlash).
comboPool(lightningFlash).
comboPool(fireball).
comboPool(tidalWave).
comboPool(shieldBash).
comboMinWins(6).
comboMinMethods(3).

goals(win).
