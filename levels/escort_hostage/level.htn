% The Hostage (escort, protect, rescue)
%
% A hostage sits hobbled in a cell at the end of a corridor. It never walks
% on its own: it is dragged out (a hook, one area at a time), or it
% shuffles after a voice it trusts (a taunt: it follows its caller). A
% warlock in the guardroom watches the corridor through a window: no
% companion walks in under his eyes. Alarm him - blind him, taunt him,
% burn him - and he calls a meteor down on the cell to execute the hostage.
%
%   gate (player, mage) ---- corridor ---- cell (hostage)
%     |                      (watched)      :
%   guardroom (warlock, firepit) ..wall.....:  (a spyhole)
%
% Map: four areas. Walkable: gate-corridor, corridor-cell, gate-guardroom.
% A wall between the guardroom and the cell (a spyhole: sight, no passage).
% A fire pit (lava) in the guardroom.
%
% Obstacles, and the answers to each:
%   the warlock   quietly: stun him (shield bash - a stun blinds and
%                 silences, so no alarm), or drop him in the fire pit (a
%                 vortex on the pit from the gate; a tidal wave in the
%                 guardroom; a shield bash). Loudly: blind him (blinding
%                 flash from the guardroom): the meteor winds up on the
%                 cell, and in that one cast a friend at the gate hooks the
%                 warlock (the meteor is magic: interrupted). Or burn him
%                 (fireball): the meteor winds up, and in that one cast the
%                 fireballer throws a second one that knocks him into the
%                 pit (a fallen warlock's meteor misses).
%   the hostage   hook it from the corridor into the corridor, then from the
%                 gate to the gate; or call it (taunt) from the corridor: it
%                 walks after its caller all the way out.
%
% Traps:
%   - an alarm with nobody to answer: the meteor would land on the hostage
%     (mustSurvive), so there is no plan - a blinding flash with a taunter;
%     a taunt on the warlock (and he still watches);
%   - a hook answering a fireball drags the burning warlock to the gate,
%     away from his pit: the blast's knockback finds nothing to knock him
%     into, and he still watches;
%   - a vortex or a wave pulls in whoever stands in the guardroom: a friend
%     there burns with the warlock.

% === Areas ===
region(gate).
region(corridor).
region(cell).
region(guardroom).
connected(gate, corridor).
connected(corridor, cell).
connected(gate, guardroom).
wall(guardroom, cell).

lineOfSight(gate, corridor).
lineOfSight(corridor, gate).
lineOfSight(corridor, cell).
lineOfSight(cell, corridor).
lineOfSight(gate, guardroom).
lineOfSight(guardroom, gate).
lineOfSight(guardroom, corridor).
lineOfSight(corridor, guardroom).
lineOfSight(guardroom, cell).
lineOfSight(cell, guardroom).

% === Features ===
feature(guardroom, firepit, lava).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, gate).
at(mage, gate).
mana(player, 4).
mana(mage, 4).

% === The hostage: never casts, never walks alone ===
role(hostage, ward).
at(hostage, cell).
tag(hostage, living).
mustSurvive(hostage).

% === The warlock: watches the corridor; alarmed, he executes the hostage ===
role(warlock, enemy).
at(warlock, guardroom).
tag(warlock, living).
watches(warlock, corridor).
behavior(warlock, blinded, meteor, there(cell)).
behavior(warlock, taunted, meteor, there(cell)).
behavior(warlock, burning, meteor, there(cell)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, shieldBash).
knows(mage, hook).

% === Victory: the hostage stands at the gate, whole ===
win :- if(), do(quiet(warlock), extract(hostage), confirmSafe(hostage, gate)).

% The warlock stops watching: blinded (a stun blinds too), or dropped in
% his fire pit.
watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
quiet(?g) :- if(not(watching(?g))), do().
quiet(?g) :- if(watching(?g)), do(inflict(blinded, ?g, none), confirmQuiet(?g)).
quiet(?g) :- if(watching(?g)), do(sendDown(?g, none), confirmQuiet(?g)).
confirmQuiet(?g) :- if(not(watching(?g))), do().

% The hostage: brought into the corridor (hooked, or called), then out to
% the gate - it follows its caller, or it is hooked again.
extract(?v) :- if(), do(bringTo(?v, corridor, none), lead(?v, gate)).
lead(?v, ?r) :- if(at(?v, ?r)), do().
lead(?v, ?r) :-
    if(not(at(?v, ?r)), follows(?v, ?a), tag(?v, taunted), canAct(?a)),
    do(walkTo(?a, ?r), confirmAt(?v, ?r)).
lead(?v, ?r) :-
    if(not(at(?v, ?r)), not(first(and(follows(?v, ?a), tag(?v, taunted))))),
    do(bringTo(?v, ?r, none)).
confirmAt(?v, ?r) :- if(at(?v, ?r)), do().

% The hostage arrives, whole.
confirmSafe(?v, ?r) :- if(at(?v, ?r), not(gone(?v))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(shieldBash).
comboPool(vortex).
comboPool(tidalWave).
comboPool(blindingFlash).
comboPool(fireball).
comboMinWins(4).
comboMinMethods(3).

goals(win).
