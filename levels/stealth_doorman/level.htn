% The Doorman (stealth and avoidance)
%
% A thief's night at the manor. From the yard, the courtyard leads to the
% hall and the vault behind it. A clockwork sentry on the gatehouse tower
% watches the courtyard: nobody walks into it under its eyes. The tower
% stands across the moat - a drop on both sides, from the yard and from the
% courtyard - and a murder hole opens in its floor. A portly doorman fills
% the hall: nobody walks past him, and from the hall he watches the vault.
% The house wards hush the hall: whoever arrives there casts nothing more.
% One companion must reach the vault; the other helps.
%
%   yard ::moat:: tower (sentry; murder hole) ::moat:: court
%    |______________________________________________|
%                                                   |
%                        vault ---- hall (doorman; hushed; the cellar steps)
%
% Two obstacles, answered in kind:
%   the sentry    slip into the courtyard (blink teleports, lightningFlash
%                 dashes: both pass a watched area), or answer it from the
%                 yard: shieldBash stuns it (or knocks it into the moat),
%                 hook drags it across the moat (it falls), fireball blows
%                 it into the moat or the murder hole, vortex on the murder
%                 hole sucks it in, lightningFlash shorts it out (a
%                 machine: a jolt stuns it). It cannot walk off its tower:
%                 a taunt breaks.
%   the doorman   heavy, and his lantern means nothing blinds him (so
%                 nothing stuns him). Taunt him out of the hall - he walks
%                 after you - or turn him to mist (turnToMist takes `heavy`
%                 off for a moment) and then knock him down the cellar
%                 steps (fireball, shieldBash, vortex on the steps) or hook
%                 him into the courtyard.
%
% Traps:
%   - a blink into the hall is hushed: the thief cannot blink on into the
%     vault, and walking in is under the doorman's eyes.
%   - a hook on the heavy doorman yanks the hooker into the hall (hushed).
%   - a doorman hooked into the courtyard blocks it: the hooker must be the
%     thief, already inside.
%   - after turnToMist, one hook, fireball, bash or vortex serves both
%     guards; without it, only a taunt moves the doorman.
%
% Victory: either companion is the thief (win/0).

% === Areas ===
region(yard).
region(tower).
region(court).
region(hall).
region(vault).
connected(yard, court).
gap(yard, tower).
gap(tower, court).
connected(court, hall).
connected(hall, vault).
feature(tower, murderHole, chasm).
feature(hall, cellarSteps, chasm).

lineOfSight(yard, tower).
lineOfSight(yard, court).
lineOfSight(yard, hall).
lineOfSight(court, tower).
lineOfSight(court, hall).

% The house wards: whoever arrives in the hall is pinned to the world (no
% disjoint) and hushed (silenced: no skills).
onEnter(hall, wards).
effect(wards, target, remove(disjoint)).
effect(wards, target, grant(silenced)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, yard).
at(mage, yard).
mana(player, 4).
mana(mage, 4).

% === The watch ===
% The clockwork sentry watches the courtyard while it stands on its tower.
role(sentry, enemy).
at(sentry, tower).
tag(sentry, machine).
watches(sentry, court) :- at(sentry, tower).

% The doorman fills the hall and, from it, watches the vault. Portly
% (heavy); the lantern over the door: nothing blinds him.
role(doorman, enemy).
at(doorman, hall).
tag(doorman, living).
tag(doorman, heavy).
blocker(doorman).
immune(doorman, blinded).
watches(doorman, vault) :- at(doorman, hall).

% === Default kit (combos replans the whole matrix) ===
knows(player, blink).
knows(mage, taunt).

% === Getting somewhere unseen ===

% A watcher that can still see; a blocker still in the way.
watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
holding(?b) :- blocker(?b), not(gone(?b)).
% A skill that carries its caster next door: a teleport or a dash.
carries(?ab) :- effect(?ab, target, teleport).
carries(?ab) :- effect(?ab, target, dash).
leap(?a, ?ab, ?to) :-
    canAct(?a), knows(?a, ?ab), carries(?ab), region(?to), not(canReachNow(?a, ?to)),
    ready(?a, ?ab, ?to), at(?a, ?cur), first(spot(?a, ?ab, ?to, ?from)).

% ?a gets to ?r: walk if it can; else leap somewhere it cannot walk, stop a
% watcher watching, or shift a blocker, and try again (at most ?n times).
getTo(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), leap(?a, ?ab, ?to)),
    do(cast(?a, ?ab, ?to), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watching(?g)),
    do(answer(?g), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), holding(?b), not(watching(?b))),
    do(answer(?b), getTo(?a, ?r, ?m)).

% A guard is answered: one cast lands on it (a stun, a jolt, a hook, a
% taunt, a knock into a pit or the moat), or a vortex on a pit in its area
% - or, heavy, it turns to mist first and then one of those lands.
answer(?g) :- if(), do(strike(?g), cleared(?g)).
answer(?g) :-
    if(anchoredAgainst(?g), canAct(?c), knows(?c, ?ab), strips(?ab, heavy), ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g), strike(?g), cleared(?g)).
strike(?g) :-
    if(canAct(?c), knows(?c, ?ab), not(strips(?ab, heavy)), not(carries(?ab)), ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g)).
strike(?g) :-
    if(at(?g, ?r), feature(?r, ?f, ?x), knocks(?c, ?ab, ?from, ?f, ?g, feature(?f))),
    do(castFrom(?c, ?ab, ?f, ?from)).
strike(?g) :-
    if(canAct(?c), knows(?c, ?ab), effect(?ab, target, dash), not(strips(?ab, heavy)),
       ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g)).
% The physics tries every aim: confirm the guard no longer watches or holds.
cleared(?g) :- if(not(watching(?g)), not(holding(?g))), do().
cleared(?g) :- if(not(watching(?g)), holding(?g), not(at(?g, hall))), do().

% === Victory: a thief in the vault ===
win :- if(canAct(?t)), do(getTo(?t, vault, 3)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blink).
comboPool(lightningFlash).
comboPool(shieldBash).
comboPool(hook).
comboPool(fireball).
comboPool(vortex).
comboPool(taunt).
comboPool(turnToMist).
comboMinWins(10).
comboMinMethods(3).

goals(win).
