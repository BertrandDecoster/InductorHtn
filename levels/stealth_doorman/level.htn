% The Doorman (stealth and avoidance)
%
% A thief's night at the manor. From the yard, a courtyard leads to the
% vault door. A sentry braced on the wall watches the courtyard: nobody
% walks into it under his eyes. A portly doorman fills the vault doorway:
% nobody walks past him, and from the doorway he watches the vault itself,
% so a thief who slips into the doorway is still seen stepping into the
% vault. One companion must reach the vault; the other helps.
%
%          wall (sentry: watches the court)
%           |
%   garden - yard ---- court ---- door (doorman: watches the vault) ---- vault
%     :                  :          |
%     :..................:....... cellar (the steps down)
%
% Two obstacles, each with answers of different kinds:
%   the sentry    slip into the courtyard (blink: a teleport passes a
%                 watched region), blind him (blindingFlash from the yard or
%                 the wall, or shieldBash's stun), or pull him off the wall
%                 once he is mist (turnToMist takes his bracing - `heavy` -
%                 for a moment; then taunt or hook drags him down, or a
%                 vortex on the yard draws him in).
%   the doorman   move him out of the doorway: taunt or hook drag him to the
%                 caster, a fireball from the garden (or the courtyard)
%                 blows him down the cellar steps, a vortex on the cellar
%                 draws him down and roots him there. The lantern over the
%                 door: nothing blinds him.
%
% Traps:
%   - blink into the doorway still leaves the thief under the doorman's
%     eyes; nothing sees into the vault, so nobody blinks in.
%   - the braced sentry cannot be moved; a hook on him drags the hooker up
%     onto the wall instead. taunt and hook serve both guards only after
%     turnToMist.
%   - a vortex draws in everyone next door, companions included, and roots
%     them; a doorman drawn into the courtyard blocks the courtyard.
%   - a doorman taunted into the courtyard blocks it, too: taunt him from
%     the garden, or once the thief is through.
%   - two sentry answers, or two movers without turnToMist: one guard stays.
%
% Victory: either companion is the thief (win/0).

% === Regions ===
region(yard).
region(garden).
region(wall).
region(court).
region(door).
region(cellar).
region(vault).
connected(yard, court).
connected(court, yard).
connected(yard, garden).
connected(garden, yard).
connected(yard, wall).
connected(wall, yard).
connected(door, cellar).
connected(cellar, door).
connected(court, door).
connected(door, court).
connected(door, vault).
connected(vault, door).

lineOfSight(yard, court).
lineOfSight(yard, wall).
lineOfSight(garden, door).
lineOfSight(garden, cellar).
lineOfSight(court, wall).
lineOfSight(court, door).
lineOfSight(court, cellar).

% Push lines: from the garden or the courtyard, whatever is in the doorway
% goes down the cellar steps.
beyond(garden, door, cellar).
beyond(court, door, cellar).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, yard).
at(mage, yard).
mana(player, 4).
mana(mage, 4).

% === The watch ===
% The sentry: braced on the battlement (heavy), watching the courtyard
% while he stands there.
role(sentry, enemy).
at(sentry, wall).
tag(sentry, living).
tag(sentry, heavy).
watches(sentry, court) :- at(sentry, wall).

% The doorman fills the doorway and, from it, watches the vault. The
% lantern over the door: no flash blinds him.
role(doorman, enemy).
at(doorman, door).
tag(doorman, living).
blocker(doorman).
immune(doorman, blinded).
watches(doorman, vault) :- at(doorman, door).

% === Default kit (combos replans the whole matrix) ===
knows(player, blink).
knows(mage, taunt).

% === Getting somewhere unseen ===

% A watcher that can still see; a blocker still in the way.
watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
holding(?b) :- blocker(?b), not(gone(?b)).
% A skill that carries its caster to a region: a teleport or a dash.
carries(?ab) :- effect(?ab, target, teleport).
carries(?ab) :- effect(?ab, target, dash).
leap(?a, ?ab, ?to) :-
    canAct(?a), knows(?a, ?ab), carries(?ab), region(?to), not(canReachNow(?a, ?to)),
    ready(?a, ?ab, ?to), at(?a, ?cur), first(spot(?a, ?ab, ?to, ?from)).

% ?a gets to ?r: walk if it can; else leap somewhere it cannot walk, stop a
% watcher watching, or budge a blocker, and try again (at most ?n times).
getTo(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), leap(?a, ?ab, ?to)),
    do(cast(?a, ?ab, ?to), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watching(?g)),
    do(unwatch(?g), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), holding(?b)),
    do(budge(?b), getTo(?a, ?r, ?m)).

% A watcher stops watching: blinded (a flash, a stun), moved off his post,
% or turned to mist first and then moved.
unwatch(?g) :-
    if(canInflict(?c, ?ab, blinded, ?g)), do(cast(?c, ?ab, ?g), confirmUnwatched(?g)).
unwatch(?g) :- if(), do(budge(?g), confirmUnwatched(?g)).
unwatch(?g) :-
    if(anchoredAgainst(?g), canAct(?c), knows(?c, ?ab), strips(?ab, heavy), ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g), budge(?g), confirmUnwatched(?g)).
confirmUnwatched(?g) :- if(not(watching(?g))), do().

% Something moves off its spot: dragged to someone (taunt, hook), pushed
% along a line (fireball), or drawn into the next region (vortex).
budge(?e) :-
    if(at(?e, ?r), canAct(?a), knows(?a, ?ab), pulls(?ab), ready(?a, ?ab, ?e)),
    do(cast(?a, ?ab, ?e), ensureMoved(?e, ?r)).
budge(?e) :-
    if(at(?e, ?r), placement(?a, ?ab, ?from, ?aim, ?e, ?to)),
    do(castFrom(?a, ?ab, ?aim, ?from), ensureMoved(?e, ?r)).

% === Victory: a thief in the vault ===
win :- if(canAct(?t)), do(getTo(?t, vault, 3)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blink).
comboPool(blindingFlash).
comboPool(shieldBash).
comboPool(turnToMist).
comboPool(taunt).
comboPool(hook).
comboPool(vortex).
comboPool(fireball).
comboMinWins(10).
comboMinMethods(3).

goals(win).
