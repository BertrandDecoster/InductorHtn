% The Scholar (escort, protect, rescue)
%
% A scholar who cannot fight must get from the library to the exit. The
% short way runs through the hall, where a clockwork brute - a heavy
% machine - stands in the way: nobody walks past it. The long way is round
% by the balcony and across the flooded cistern, but the scholar cannot
% swim, and the brute's searchlight eye sweeps the cistern: no companion
% wades in under it. Only from the cistern's far side (the exit) can
% anyone see the water well enough to ice it.
%
%   library (scholar, player, mage) --- hall (brute, shaft) --- exit
%      |                                                        |
%   balcony ------------------ cistern (deep water) -------------+
%
% Map: five areas. Walkable: library-hall, hall-exit, library-balcony,
% balcony-cistern, cistern-exit. The cistern is deep water (a zone: the
% scholar and the heavy sink in it). A shaft (chasm) in the hall.
%
% Ways out, each needing both companions:
%   drop it       it is heavy: turn it to mist, and in that moment knock it
%                 down the shaft (a fireball, a shield bash, a vortex on the
%                 shaft), or hook it out of the doorway into the library.
%   ice the way   put the eye out - a shield bash (stunned) or a lightning
%                 flash (a dry machine is stunned by a jolt, and the flash
%                 lands its caster in the hall, past the brute) - then wade
%                 the cistern to the exit and ice it over from there (a
%                 blizzard): the scholar crosses on the ice.
%
% The heavy blow: set alight, the brute lashes out at the library doorway
% (a telegraphed ground slam on the library, where the scholar waits). A
% fireball that drops the misted brute sets it alight first: the slam winds
% up, and in that one cast the fireballer throws a second fireball that
% knocks it down the shaft (a fallen brute's blow misses). Without the
% mana for it, or with a partner who cannot answer, there is no plan: the
% scholar must survive.
%
% Traps:
%   - a stunned brute still fills the doorway: only the ice route gets
%     past it;
%   - a push or a pull on the heavy brute does nothing, and a hook on it
%     drags the caster into the hall instead - unless it is mist; mist
%     lasts one cast, so the knock must be the very next one;
%   - the eye sees only the cistern: the scholar may cross the ice under
%     it, but no companion walks in to cast the blizzard until it is out.

% === Areas ===
region(library).
region(hall).
region(exit).
region(balcony).
region(cistern).
connected(library, hall).
connected(hall, exit).
connected(library, balcony).
connected(balcony, cistern).
connected(cistern, exit).

lineOfSight(library, hall).
lineOfSight(hall, library).
lineOfSight(hall, exit).
lineOfSight(exit, hall).
lineOfSight(library, balcony).
lineOfSight(balcony, library).
lineOfSight(exit, cistern).
lineOfSight(cistern, exit).

% === Terrain and features ===
onEnter(cistern, deepWater).
feature(hall, shaft, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, library).
at(mage, library).
mana(player, 4).
mana(mage, 4).

% === The scholar: never casts; walks when the way is clear ===
role(scholar, ward).
at(scholar, library).
tag(scholar, living).
mustSurvive(scholar).
% It cannot swim.
weakness(scholar, deepWater, none, fell).

% === The brute: heavy, a machine, fills the hall; its eye sweeps the cistern ===
role(brute, enemy).
at(brute, hall).
blocker(brute).
tag(brute, machine).
tag(brute, heavy).
watches(brute, cistern).
% Set alight, it lashes out at the library doorway (a telegraphed ground
% slam: stunned, and thrown).
behavior(brute, burning, groundSlam, there(library)).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, turnToMist).
knows(mage, fireball).

% === Victory: the scholar stands at the exit, whole ===
win :- if(), do(dropBrute(brute), bringOut(scholar, exit)).
win :- if(), do(iceOver(cistern, brute), bringOut(scholar, exit)).

% The hall: the brute turned to mist, then knocked down the shaft (the
% into-the-pit recipe: take the ward off, then send it down), or hooked
% out of the doorway while it is mist.
dropBrute(?e) :- if(), do(intoThePit(?e)).
dropBrute(?e) :-
    if(has(?e, heavy), canUnset(?p, ?ab, heavy, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(heavy, ?e), bringTo(?e, library, ?p), confirmAt(?e, library)).
confirmAt(?e, ?r) :- if(at(?e, ?r)), do().

% The cistern: its watcher looks away (stunned, which blinds), someone
% wades to the far side, and ices the water from there.
iceOver(?r, ?g) :- if(), do(lookAway(?g), freezeOver(?r)).
lookAway(?g) :- if(), do(inflict(blinded, ?g, none), ensureBlind(?g)).
lookAway(?g) :- if(), do(inflict(electrocuted, ?g, none), ensureBlind(?g)).
ensureBlind(?g) :- if(forbidden(?g, watch)), do().
freezeOver(?r) :-
    if(canAct(?a), knows(?a, ?ab), effect(?ab, target, spill(iceSheet))),
    do(cast(?a, ?ab, ?r), ensureIce(?r)).
ensureIce(?r) :- if(onEnter(?r, iceSheet)), do().

% The scholar walks out, and must arrive whole.
bringOut(?v, ?r) :- if(), do(walkTo(?v, ?r), confirmSafe(?v, ?r)).
confirmSafe(?v, ?r) :- if(at(?v, ?r), not(gone(?v))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(turnToMist).
comboPool(fireball).
comboPool(shieldBash).
comboPool(vortex).
comboPool(hook).
comboPool(lightningFlash).
comboPool(blizzard).
comboMinWins(4).
comboMinMethods(3).

goals(win).
