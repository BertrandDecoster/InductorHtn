% The Scholar (escort, protect, rescue)
%
% A scholar who cannot fight must get from the library to the exit. The
% only door runs through the hall, where a clockwork brute - a heavy machine
% - stands in the way: nobody walks past it. The other way is round by the
% balcony and across the flooded cistern, but the scholar cannot swim, and
% the brute's searchlight eye sweeps the cistern: nobody wades in under it.
%
%   library (scholar, player, mage) --- hall (brute) --- exit (pillar)
%      |                                  |                |
%   balcony ------------ cistern (deep water) -------------+
%                                         pit (chasm, below the hall)
%
% Three ways out, each needing both companions:
%   short it       it is a machine: soak it (a tidal wave from the library),
%                  then jolt it (a lightning flash): it stops for good, and
%                  the scholar walks through the hall.
%   drop it        it is heavy: turn it to mist, and in that moment move it
%                  out of the doorway - wash it into the pit (tidal wave from
%                  the library), suck it into the pit (vortex), or hook it
%                  into the library.
%   ice the way    the scholar crosses on the ice: a blizzard turns the
%                  cistern into a floor, once the brute's eye is off -
%                  bashed (stunned), blinded, or jolted (a dry machine is
%                  stunned).
%
% Traps:
%   - a tidal wave from the library soaks the scholar too: a wet scholar
%     walking onto the ice freezes there (wet + chilled: stunned);
%   - a frozen or stunned brute still fills the doorway;
%   - hooking the scholar over the cistern drops it in (it cannot swim);
%     a vortex on the cistern does the same;
%   - a push or a pull on the heavy brute does nothing, and a hook on it
%     drags the caster in instead - unless it is mist.

% === Regions ===
region(library).
region(balcony).
region(hall).
region(cistern).
region(exit).
region(pit).
connected(library, hall).
connected(hall, library).
connected(hall, exit).
connected(exit, hall).
connected(library, balcony).
connected(balcony, library).
connected(balcony, cistern).
connected(cistern, balcony).
connected(cistern, exit).
connected(exit, cistern).
connected(hall, pit).
connected(pit, hall).

lineOfSight(library, hall).
lineOfSight(hall, library).
lineOfSight(library, balcony).
lineOfSight(balcony, library).
lineOfSight(library, pit).
lineOfSight(balcony, hall).
lineOfSight(hall, balcony).
lineOfSight(balcony, cistern).
lineOfSight(cistern, balcony).
lineOfSight(balcony, exit).
lineOfSight(exit, balcony).
lineOfSight(exit, hall).
lineOfSight(hall, exit).
lineOfSight(exit, cistern).

% Push lines (and what lies between).
beyond(balcony, cistern, exit).
beyond(exit, cistern, balcony).

% === Terrain ===
onEnter(pit, chasm).
onEnter(cistern, deepWater).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, library).
at(mage, library).
mana(player, 4).
mana(mage, 4).

% === The scholar: never casts; walks when the way is clear ===
role(scholar, ward).
at(scholar, library).
tag(scholar, living).
mustSurvive(scholar).
% It cannot swim.
weakness(scholar, deepWater, none, fell).

% === Things ===
role(brute, enemy).
at(brute, hall).
blocker(brute).
tag(brute, machine).
tag(brute, heavy).
watches(brute, cistern).
% Soaked, its gears spark and it swings at whoever soaked it (a telegraphed
% ground slam: stunned, and thrown back).
behavior(brute, wet, groundSlam, source).

role(pillar, object).
at(pillar, exit).
tag(pillar, heavy).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, lightningFlash).

% === Victory: the scholar stands at the exit, whole ===
win :- if(), do(clearWay(brute), bringOut(scholar, exit)).
win :- if(), do(iceOver(cistern, brute), bringOut(scholar, exit)).

% The doorway: the brute is out of the fight, or moved out of it while it
% is mist.
clearWay(?e) :- if(), do(neutralize(?e)).
% Soaked, it swings at the soaker: the jolt has to come in that window.
clearWay(?e) :-
    if(not(neutralized(?e)), supplier(?p, wet, ?e), \==(?p, none)),
    do(supply(?p, wet, ?e), confirmStopped(?e)).
clearWay(?e) :-
    if(not(neutralized(?e)), first(and(has(?e, ?w), wards(?w, forcedMove))),
       canUnset(?p, ?ab, ?w, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(?w, ?e), shift(?e, ?p)).

% Anyone but ?not moves it out of the doorway, from any spot they can reach.
shift(?e, ?not) :-
    if(at(?e, ?r), canAct(?a), \==(?a, ?not), knows(?a, ?ab), moves(?ab), ready(?a, ?ab, ?e),
       reach(?ab, ?k), region(?from), inRange(?k, ?from, ?r), canReachNow(?a, ?from)),
    do(castFrom(?a, ?ab, ?e, ?from), ensureMoved(?e, ?r)).
shift(?e, ?not) :-
    if(at(?e, ?r), canAct(?a), \==(?a, ?not), placement(?a, ?ab, ?from, ?aim, ?e, ?to)),
    do(castFrom(?a, ?ab, ?aim, ?from), ensureMoved(?e, ?r)).

% The cistern: its watcher looks away (stunned, blinded), then the water
% ices over.
iceOver(?r, ?g) :- if(), do(lookAway(?g), freezeOver(?r)).
lookAway(?g) :- if(), do(inflict(blinded, ?g, none), ensureBlind(?g)).
lookAway(?g) :- if(), do(inflict(electrocuted, ?g, none), ensureBlind(?g)).
ensureBlind(?g) :- if(forbidden(?g, watch)), do().
freezeOver(?r) :- if(canAct(?a), knows(?a, ?ab), effect(?ab, target, spill(iceSheet))),
    do(cast(?a, ?ab, ?r), ensureIce(?r)).
ensureIce(?r) :- if(onEnter(?r, iceSheet)), do().

% The scholar walks out, and must arrive whole.
bringOut(?v, ?r) :- if(), do(walkTo(?v, ?r), confirmSafe(?v, ?r)).
% ... and nobody was lost on the way.
confirmSafe(?v, ?r) :- if(at(?v, ?r), not(gone(?v)), not(first(and(canAct(?a), gone(?a))))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(vortex).
comboPool(tidalWave).
comboPool(lightningFlash).
comboPool(turnToMist).
comboPool(blizzard).
comboPool(shieldBash).
comboPool(blindingFlash).
comboMinWins(4).
comboMinMethods(3).

goals(win).
