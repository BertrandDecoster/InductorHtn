% One Bolt (resource scarcity: a mana budget)
%
% A flooded chapel. In the hall stands a sentry drone; behind the flooded
% nave, in the apse, squats the pump engine - a heavy machine, soaked in its
% own sump. Both must go. Everyone has 2 mana, and a lightning flash costs
% 2: whoever holds it gets ONE bolt. It has to take both machines at once.
%
%   porch --- hall (drone) --- nave (flooded) --- apse (engine, sump)
%     |        |
%   gallery ---+        pit   (off the hall: a push from the gallery)
%
% A lightning flash strikes its target and everything on its way. From the
% porch at the engine it runs through the hall and the nave. The engine is
% wet: the flash kills it. The drone is dry: a jolt only stuns it. So the
% one bolt must meet a wet drone on its way, or the drone must go some
% other way first.
%
% Methods:
%   line up     soak the drone where it stands (tidalWave), then flash from
%               the porch at the engine: the bolt runs through the hall and
%               kills both
%   the flood   put the drone in the flooded nave, on the bolt's way: wash
%               it in from the porch (tidalWave), drag it in from the nave
%               (hook, taunt) or draw it in (vortex on the nave); it
%               arrives soaked, and one flash takes both
%   the pit     knock the drone into the pit from the gallery (fireball,
%               tidalWave), then flash the engine
%
% Traps (each spends the only bolt, or wastes the soak):
%   - jolting before the drone is wet: it is only stunned, and the mana is
%     gone (the obvious order - soak it, jolt it, then the engine - never
%     works: the bolt spent on the drone cannot reach the engine);
%   - a fireball from the porch throws the drone into the flood burning:
%     the water only puts it out, and it arrives dry;
%   - a fireball on the engine dries it (steam); a vortex on the hall
%     roots the drone where it is, dry.
%
% Hypothesis (design.md): no single skill wins; every winning pair holds
% the flash, and the partner decides the method; every winning plan
% casts exactly one bolt.

% === Regions ===
region(porch).
region(gallery).
region(hall).
region(nave).
region(apse).
region(pit).
connected(porch, hall).
connected(hall, porch).
connected(porch, gallery).
connected(gallery, porch).
connected(gallery, hall).
connected(hall, gallery).
connected(hall, nave).
connected(nave, hall).
connected(nave, apse).
connected(apse, nave).
lineOfSight(porch, hall).
lineOfSight(porch, nave).
lineOfSight(porch, apse).
lineOfSight(gallery, hall).
lineOfSight(hall, nave).
lineOfSight(nave, hall).
lineOfSight(nave, apse).

% Lines: from the porch, a push on the hall lands in the nave, and the
% hall and the nave lie on the way to the apse; from the gallery, a push on
% the hall goes into the pit.
beyond(porch, hall, nave).
beyond(porch, hall, apse).
beyond(porch, nave, apse).
beyond(gallery, hall, pit).

% === Terrain ===
onEnter(nave, puddle).
onEnter(apse, puddle).
onEnter(pit, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, porch).
at(mage, porch).
mana(player, 2).
mana(mage, 2).

% === Machines ===
role(drone, enemy).
at(drone, hall).
tag(drone, machine).

role(engine, enemy).
at(engine, apse).
tag(engine, machine).
tag(engine, heavy).
tag(engine, wet).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, lightningFlash).

% === Victory ===
% Each machine on its own (the pit), or the drone soaked first so one bolt
% takes both.
win :- if(), do(neutralize(drone), neutralize(engine)).
win :- if(), do(douse(drone), neutralize(engine), neutralize(drone)).

% The drone carries wet: it already does; someone soaks it, washes it into
% the flood or draws it in; or someone in the flood drags it in.
douse(?e) :- if(holds(?e, wet)), do().
douse(?e) :-
    if(not(holds(?e, wet)), supplier(?p, wet, ?e), \==(?p, none)),
    do(supply(?p, wet, ?e)).
douse(?e) :-
    if(not(holds(?e, wet)), zoneFor(?r, wet), at(?e, ?er), \==(?r, ?er), puller(?a, ?ab, ?e),
       reach(?ab, ?k), inRange(?k, ?r, ?er)),
    do(castFrom(?a, ?ab, ?e, ?r), confirmWet(?e)).
confirmWet(?e) :- if(holds(?e, wet)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(fireball).
comboPool(hook).
comboPool(taunt).
comboPool(vortex).
comboPool(lightningFlash).
comboMinWins(8).
comboMinMethods(3).

goals(win).
