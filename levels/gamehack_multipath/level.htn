% GameHack Multipath Level
% Four companions, every strategy at once, several locations for the combos (water, ice, oil),
% and skills held or granted by shrines. defeat(gob) returns many plans.

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, companionA).
type(agent, companionB).
type(agent, companionC).
type(agent, gob).
type(agent, teslaTower).
type(agent, iceElemental).

% Locations (named positions in the world)
type(location, arena).
type(location, forge).
type(location, glacier).
type(location, lakeShore).
type(location, sea).
type(location, volcano).
type(location, refinery).

% Objects (grant skills)
type(object, volcanoShrine).
type(object, glacierShrine).
type(object, shoreShrine).

% Skills (abilities)
type(skill, frostSkill).
type(skill, fireballSkill).
type(skill, lightningSkill).
type(skill, iceBlastSkill).

% === Agents ===
companion(player).
companion(companionA).
companion(companionB).
companion(companionC).
enemy(gob).
enemy(teslaTower).
enemy(iceElemental).

% === Positions ===
at(player, arena).
at(companionA, arena).
at(companionB, forge).
at(companionC, glacier).
at(gob, arena).
at(teslaTower, lakeShore).
at(iceElemental, glacier).

% === Locations ===
location(arena).
location(forge).
location(glacier).
location(lakeShore).
location(sea).
location(volcano).
location(refinery).

% === Location tags ===
locationCanApplyTag(lakeShore, wet).
locationCanApplyTag(sea, wet).
locationCanApplyTag(glacier, ice).
locationCanApplyTag(refinery, oil).
% Agents that start on a tagged location have its tag.
hasTag(teslaTower, wet).
hasTag(companionC, ice).
hasTag(iceElemental, ice).

% === Static agents (cannot be lured) ===
static(teslaTower).

% === Skills currently held ===
hasSkill(companionA, frostSkill).
hasSkill(companionB, fireballSkill).
hasSkill(teslaTower, lightningSkill).
hasSkill(iceElemental, iceBlastSkill).

% === Skill -> tag mappings ===
skillAppliesTag(frostSkill, chilled).
skillAppliesTag(lightningSkill, electrified).
skillAppliesTag(fireballSkill, burning).
skillAppliesTag(iceBlastSkill, stunned).

% === fireballSkill is slow, which makes stunAndSlow possible ===
skillHasTag(fireballSkill, slow).

% === Objects that grant a skill ===
object(volcanoShrine).
at(volcanoShrine, volcano).
canGetSkillFrom(volcanoShrine, fireballSkill).
object(glacierShrine).
at(glacierShrine, glacier).
canGetSkillFrom(glacierShrine, iceBlastSkill).
object(shoreShrine).
at(shoreShrine, lakeShore).
canGetSkillFrom(shoreShrine, frostSkill).

% === What defeats whom ===
vulnerableToLocationCombo(gob, wet, chilled).
vulnerableToLocationCombo(gob, ice, chilled).
vulnerableToLocationCombo(gob, oil, burning).

% === Level Goal ===
goals(defeat(gob)).
