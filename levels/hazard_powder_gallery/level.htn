% The Powder Gallery (hazard terrain and physics objects)
%
% A siege golem holds the nave of a ruined chapel. The gallery floor that
% led to it has broken away (a gap), and on what is left of it sits a
% powder keg. Nobody can hurt the golem: the floor can. The golem is heavy
% (nothing knocks it, a hook drags you to it) and a machine. Two
% companions, one skill each, from eight.
%
%   entry --- gallery (keg) :gap: nave (golem; the open crypt) --- apse
%     |                                                             |
%     +------------------------ cloister ---------------------------+
%
% The keg is the star: a flame or a spark (burning, electrocuted) lights
% its fuse, and the floor it stands on caves in (the catalogue's caveIn, a
% telegraphed heavy blow: the struck area becomes a chasm and takes
% everyone there). The golem, taunted, walks round by the cloister after
% its taunter and slams it (groundSlam: stunned and knocked back, everyone
% in that area but the golem).
% Methods:
%   bomb it     taunt it onto the keg's floor (the long way round), then
%               light the keg: fireball from the entry, lightningFlash into
%               the gallery, blindingFlash beside it - the cave-in takes the
%               golem (and whoever stayed: sacrifice is allowed). A friend
%               standing by the keg is caught in the golem's slam unless it
%               answers in the wind-up (the flash is disjoint): lit then, the
%               floor goes before the blow lands.
%   short it    soak it (tidalWave, in the nave), then jolt it
%               (lightningFlash, blindingFlash): a wet machine dies.
%   drop it     turn it to mist (turnToMist) and knock it into the open crypt
%               or the gap while the moment lasts: fireball, vortex on the
%               crypt, tidalWave in the nave, or hook it across the gap from
%               the gallery.
% Traps: a wet keg does not light with fire (steam); a wave or a slam in the
% gallery can knock the keg into the gap; hooked across the gap, the keg
% drops in; a dry jolt only stuns the golem; a keg lit on its own caves in
% an empty floor; misted, it lasts one cast.
region(entry).
region(gallery).
region(nave).
region(apse).
region(cloister).
connected(entry, gallery).
gap(gallery, nave).
connected(nave, apse).
connected(apse, cloister).
connected(cloister, entry).
lineOfSight(entry, gallery).
lineOfSight(gallery, nave).
lineOfSight(apse, nave).
lineOfSight(cloister, apse).

% === Terrain ===
% The open crypt in the nave: a pit.
feature(nave, crypt, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, entry).
at(mage, entry).
mana(player, 4).
mana(mage, 4).

% === The golem ===
% Heavy and a machine (soaked and jolted, it dies). Taunted, it walks after
% its taunter and slams it.
role(golem, enemy).
at(golem, nave).
tag(golem, machine).
tag(golem, heavy).
behavior(golem, taunted, groundSlam, source).

% === The keg ===
% A flame or a spark lights the fuse; the floor under it caves in. It does
% not walk.
role(keg, object).
at(keg, gallery).
immune(keg, taunted).
behavior(keg, burning, caveIn, here).
behavior(keg, electrocuted, caveIn, here).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, taunt).
knows(mage, fireball).

% === Victory ===
win :- if(), do(bomb(golem, keg)).
win :- if(), do(combo(wet, electrocuted, golem)).
win :- if(), do(dropIt(golem)).

% Bomb: bring ?e onto the keg's floor, then light the keg - or first post
% a friend by the keg, to light it in the golem's wind-up.
bomb(?e, ?k) :-
    if(at(?k, ?r)), do(bringTo(?e, ?r, none), light(?k), confirmStopped(?e)).
bomb(?e, ?k) :-
    if(at(?k, ?r), canAct(?b), not(at(?b, ?r))),
    do(walkTo(?b, ?r), bringTo(?e, ?r, ?b), light(?k), confirmStopped(?e)).

% Light the keg: land on it a tag its fuse answers - unless it already
% went up (lit in the golem's wind-up).
light(?k) :- if(gone(?k)), do().
light(?k) :-
    if(not(gone(?k)), behavior(?k, ?t, ?ab, here), heavy(?ab)),
    do(inflict(?t, ?k, none), confirmBlown(?k)).
confirmBlown(?k) :- if(gone(?k)), do().

% Drop: take its weight away for a moment, and someone else sends it down
% while the moment lasts.
dropIt(?e) :-
    if(has(?e, heavy), canUnset(?p, ?ab, heavy, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(heavy, ?e), sendDown(?e, ?p), confirmStopped(?e)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(taunt).
comboPool(fireball).
comboPool(lightningFlash).
comboPool(blindingFlash).
comboPool(tidalWave).
comboPool(turnToMist).
comboPool(vortex).
comboPool(hook).
comboMinWins(12).
comboMinMethods(5).

goals(win).
