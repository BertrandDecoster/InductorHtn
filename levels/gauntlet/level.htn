% The Gauntlet (pure movement)
%
% Nothing here dies except by falling. A heavy guard holds the choke above a
% trapdoor; past it, a hall, and a grated alcove - seen through the bars,
% never walked into - whose lever latches the exit gate open; then the rim
% of a lava channel with a barrel on it, a stone pillar on the far bank,
% and the exit.
%
%   start --- choke (guard; trapdoor) --- hall --- rim (barrel) ~~ far (pillar) --- exit
%                                          #                        ~~               (gate)
%                                        alcove (crate; lever) ~~~~~~
%   (--- walkable   # wall: the grate   ~~ gap: the lava channel)
%
% Victory: everyone reaches the exit. The Warden cannot leap, so the guard
% has to be moved and the channel bridged for him. The Warden only knows
% turnToMist; the player and the mage pick one skill each from six, with
% mana for one costly cast each.
%
% A knockback never leaves its area, so each thing is knocked into what is
% beside it:
%   the guard    heavy: nothing moves it. The Warden turns it to mist, and
%                while it lasts (the next cast) someone knocks it through the
%                trapdoor under it (fireball, shield bash from the start, a
%                vortex on the trapdoor) or hooks it out into the start
%   the lever    the crate stands beside it behind the grate: knock it on
%                through the bars (fireball, a vortex on the lever); or blink
%                in, step on, and blink on over the lava. Nothing melee, no
%                dash and no pull passes the grate
%   the channel  the barrel on the rim, knocked into the gap, bridges it
%                (fireball, shield bash, a tidal wave from the rim); or a
%                hooker swings over on the pillar and drags it in from the
%                far side
%
% Traps: the mist lasts one cast, so the push must come next; unmisted, the
% guard is an anchor and a hook swings the hooker into the choke; two
% fireballs are two casts for three jobs; a wave from the rim knocks
% everyone else there, the Warden included; bash and hook never reach the
% lever.

% === Map: seven areas ===
region(start).
region(choke).
region(hall).
region(alcove).
region(rim).
region(far).
region(exit).
connected(start, choke).
connected(choke, hall).
connected(hall, rim).
% The alcove is behind a grate: seen through, never walked or dashed into.
wall(hall, alcove).
% The lava channel: a short pit between the rim and the far bank, and
% between the alcove and the far bank.
gap(rim, far).
gap(alcove, far).
doorway(far, exit, gate).
door(gate).

lineOfSight(start, choke).
lineOfSight(start, hall).
lineOfSight(choke, hall).
lineOfSight(hall, choke).
lineOfSight(hall, alcove).
lineOfSight(hall, rim).
lineOfSight(rim, hall).
lineOfSight(rim, alcove).
lineOfSight(rim, far).
lineOfSight(far, rim).
lineOfSight(far, alcove).
lineOfSight(alcove, far).

% The route, for leaps: only forward.
progress(start, 0).
progress(choke, 1).
progress(hall, 2).
progress(alcove, 3).
progress(rim, 3).
progress(far, 4).
progress(exit, 5).

% === Features ===
% A trapdoor in the choke; the lever plate in the alcove latches the gate.
feature(choke, trapdoor, chasm).
feature(alcove, lever, press).
plate(lever).
effect(press, target, open(gate)).

% === Companions ===
role(player, player).
role(mage, companion).
role(warden, companion).
at(player, start).
at(mage, start).
at(warden, start).
mana(player, 2).
mana(mage, 2).
knows(warden, turnToMist).

% === Things ===
role(guard, enemy).
at(guard, choke).
blocker(guard).
tag(guard, living).
tag(guard, heavy).

role(crate, object).
at(crate, alcove).

role(barrel, object).
at(barrel, rim).
tag(barrel, filler).

role(pillar, object).
at(pillar, far).
tag(pillar, heavy).

% === Default kit (a winning pair; combos strips these) ===
knows(player, fireball).
knows(mage, hook).

% === Victory: everyone reaches the exit ===
win :- if(), do(escape).

escape :-
    if(),
    do(unguard, weighPlate, spanChannel, leave(warden), leave(mage), leave(player)).

% The guard: misted, then - while it lasts - knocked through the trapdoor
% or dragged out of the choke by someone else.
unguard :-
    if(has(guard, heavy), canUnset(?w, ?ab, heavy, guard, ?aim)),
    do(cast(?w, ?ab, ?aim), ensureOff(heavy, guard), knockOn(guard, feature(trapdoor), ?w),
       confirmStopped(guard)).
unguard :-
    if(has(guard, heavy), canUnset(?w, ?ab, heavy, guard, ?aim)),
    do(cast(?w, ?ab, ?aim), ensureOff(heavy, guard), place(guard, start, ?w),
       ensureMoved(guard, choke)).

% The lever: the crate beside it is knocked onto it through the grate, or
% someone lands in the alcove and steps on.
weighPlate :- if(), do(knockOn(crate, feature(lever), none), confirmOpen(gate)).
weighPlate :-
    if(canAct(?a), first(leap(?a, ?ab, ?from, ?aim, alcove))),
    do(castFrom(?a, ?ab, ?aim, ?from), stepOn(?a, lever), confirmOpen(gate)).

% The channel: the barrel knocked into it from the rim side, or dragged
% across it by a hooker who swung over on the pillar.
spanChannel :- if(), do(knockOn(barrel, gap(far), none), confirmBridged(rim, far)).
spanChannel :-
    if(at(barrel, rim), puller(?a, ?ab, barrel), first(leap(?a, ?hab, ?from, ?aim, far))),
    do(castFrom(?a, ?hab, ?aim, ?from), castFrom(?a, ?ab, barrel, far), confirmBridged(rim, far)).

% Out: walk, or leap and carry on.
leave(?a) :- if(canReachNow(?a, exit)), do(walkTo(?a, exit)).
leave(?a) :-
    if(not(canReachNow(?a, exit)), first(leap(?a, ?ab, ?from, ?aim, ?land))),
    do(reach(?a, exit)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(tidalWave).
comboPool(shieldBash).
comboPool(hook).
comboPool(blink).
comboPool(vortex).

goals(win).
