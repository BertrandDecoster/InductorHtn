% The Gauntlet (pure movement)
%
% Nothing here dies except by falling. A guard holds the choke above a
% trapdoor; past it, a hall with a crate and an alcove whose plate latches
% the far gate open; then a chasm, with a stone pillar and an archer on the
% far side (a cliff behind it), the gate, and the exit.
%
% Two ways to win:
%   escape   all three companions reach the exit
%   rout     both enemies go into the dark
%
% Every obstacle has several answers, and every skill answers several
% obstacles:
%   the guard   drop it through the trapdoor (push it from the start), move
%               it out of the doorway (pull, swap, push it back), or leave it
%               and slip past (blink, dash, swap with it)
%   the gate    walk onto the plate, or push the crate onto it
%   the chasm   bridge it with the crate (two pushes, or dragged in from the
%               far side), or cross one by one: blink or dash over, hook the
%               pillar, swap with the archer, or be swapped over by a friend
%   the archer  armoured: nothing moves it until the Warden sunders the
%               armour from close by - so the chasm has to be bridged - then
%               push it off the cliff behind it. A hook on the armoured
%               archer drags the caster across instead.
% The crate can hold the plate or fill the chasm - not both.
%
% Hypothesis (design.md): many kits win, by many routes, and both victories
% are reachable; every plan needs two companions.

% === Regions ===
region(start).
region(choke).
region(pit).
region(hall).
region(alcove).
region(rim).
region(chasm).
region(far).
region(gate).
region(exit).
region(cliff).
connected(start, choke).
connected(choke, start).
connected(choke, hall).
connected(hall, choke).
connected(hall, alcove).
connected(alcove, hall).
connected(hall, rim).
connected(rim, hall).
connected(rim, chasm).
connected(chasm, rim).
connected(chasm, far).
connected(far, chasm).
connected(far, gate).
connected(gate, far).
connected(gate, exit).
connected(exit, gate).

lineOfSight(start, choke).
lineOfSight(start, hall).
lineOfSight(choke, start).
lineOfSight(choke, hall).
lineOfSight(hall, choke).
lineOfSight(hall, alcove).
lineOfSight(alcove, hall).
lineOfSight(hall, rim).
lineOfSight(rim, hall).
lineOfSight(rim, chasm).
lineOfSight(rim, far).
lineOfSight(far, rim).
lineOfSight(far, chasm).
lineOfSight(far, gate).
lineOfSight(gate, far).
lineOfSight(gate, exit).

% The route, for leaps: only forward.
progress(start, 0).
progress(choke, 1).
progress(hall, 2).
progress(alcove, 2).
progress(rim, 3).
progress(chasm, 4).
progress(far, 5).
progress(gate, 6).
progress(exit, 7).

% Push lines (and what lies between).
beyond(start, choke, pit).
beyond(hall, choke, start).
beyond(choke, hall, alcove).
beyond(alcove, hall, rim).
beyond(hall, rim, chasm).
beyond(rim, chasm, far).
beyond(far, chasm, rim).
beyond(chasm, far, cliff).
beyond(gate, far, cliff).

% === Terrain ===
onEnter(pit, chasm).
onEnter(chasm, chasm).
onEnter(cliff, chasm).
onEnter(alcove, press).
effect(press, target, open(gate)).
door(gate).

% === Companions ===
role(player, player).
role(mage, companion).
role(warden, companion).
at(player, start).
at(mage, start).
at(warden, start).
mana(player, 4).
knows(mage, translocate).
knows(warden, shieldBash).
knows(warden, sunder).

% === Things ===
role(guard, enemy).
at(guard, choke).
blocker(guard).
trait(guard, living).

role(archer, enemy).
at(archer, far).
trait(archer, living).
tag(archer, armored).

role(crate, object).
at(crate, hall).
trait(crate, filler).

role(pillar, object).
at(pillar, far).
trait(pillar, heavy).

% === Default kit (a winning pair; F4 strips these and re-adds each pick) ===
knows(player, gust).
knows(player, magnetize).

% === Victory: two ways ===
win :- if(), do(escape).
win :- if(), do(rout).

escape :-
    if(),
    do(clear(guard), openWay(gate), span(chasm),
       reach(warden, exit), reach(mage, exit), reach(player, exit)).

rout :- if(), do(neutralize(guard), span(chasm), neutralize(archer)).

% === Declared choice space: pick 2 of 8 ===
funChoiceSpace(kit, 2).
funChoice(kit, gust).
funChoice(kit, magnetize).
funChoice(kit, charge).
funChoice(kit, pounce).
funChoice(kit, shadowStep).
funChoice(kit, lightningFlash).
funChoice(kit, taunt).
funChoice(kit, tidalWave).
funChoiceFact(gust, knows(player, gust)).
funChoiceFact(magnetize, knows(player, magnetize)).
funChoiceFact(charge, knows(player, charge)).
funChoiceFact(pounce, knows(player, pounce)).
funChoiceFact(shadowStep, knows(player, shadowStep)).
funChoiceFact(lightningFlash, knows(player, lightningFlash)).
funChoiceFact(taunt, knows(player, taunt)).
funChoiceFact(tidalWave, knows(player, tidalWave)).
% Each obstacle, taken alone.
pastGuard :- if(), do(clear(guard), reach(player, hall)).
overChasm :- if(), do(clear(guard), span(chasm), reach(player, far)).
funBlocker(guard).
funBlocker(gate).
funBlocker(chasm).
funBlockerGoal(guard, pastGuard).
funBlockerGoal(gate, openWay(gate)).
funBlockerGoal(chasm, overChasm).
funExpect(single_actor_plans, atMost, 0).

% === Choice: the player picks two (htn_components combos) ===
comboSeat(player, 2).
comboPool(gust).
comboPool(magnetize).
comboPool(charge).
comboPool(pounce).
comboPool(shadowStep).
comboPool(lightningFlash).
comboPool(taunt).
comboPool(tidalWave).
comboMinWins(4).

goals(win).
