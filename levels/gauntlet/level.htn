% The Gauntlet (pure movement)
%
% Nothing here dies except by falling. An armoured guard holds the choke
% above a trapdoor; past it, a hall with a crate, and a grated alcove - a
% ledge nobody can walk onto - whose plate latches the far gate open; then a
% chasm, a stone pillar on the far side, the gate, and the exit.
%
%   start --- choke (guard) --- hall (crate) --- rim ~~ chasm ~~ far (pillar) --- gate --- exit
%     |                          :                                 |
%    pit (trapdoor)          alcove (plate; seen from the hall and the rim, never walked into)
%
% Victory: everyone reaches the exit. The Warden cannot leap, so the guard
% has to be moved out of the doorway and the chasm has to be bridged for
% him. The Warden only knows sunder; the player and the mage pick one skill
% each.
%
% The obstacles, and every answer:
%   the guard   armoured: the Warden sunders it, then someone drops it
%               through the trapdoor (a push from the start) or moves it
%               out of the doorway (a push back, a hook, a swap)
%   the plate   something has to land in the alcove: a dasher blinks onto
%               it, or a friend is thrown onto it (a push from the rim) -
%               and whoever is up there has to get out forward: dash on
%               over the chasm, hook the pillar, or be swapped out by a
%               friend already across. The crate can be pushed onto it too.
%   the chasm   the crate, pushed twice (onto the rim, then in), bridges it
%               for the Warden - or a dasher crosses alone, a hook to the
%               pillar, a swap with a friend.
% The crate can hold the plate or fill the chasm - not both.
%
% Traps: a pusher alone cannot leave the alcove; a dasher alone cannot move
% the crate; two pushers throw a friend onto the plate and strand him.

% === Regions ===
region(start).
region(pit).
region(choke).
region(hall).
region(alcove).
region(rim).
region(chasm).
region(far).
region(gate).
region(exit).
connected(start, choke).
connected(choke, start).
connected(choke, hall).
connected(hall, choke).
connected(hall, rim).
connected(rim, hall).
connected(rim, chasm).
connected(chasm, rim).
connected(chasm, far).
connected(far, chasm).
connected(far, gate).
connected(gate, far).
connected(gate, exit).
connected(exit, gate).

lineOfSight(start, choke).
lineOfSight(start, hall).
lineOfSight(choke, hall).
lineOfSight(hall, alcove).
lineOfSight(rim, hall).
lineOfSight(choke, start).
lineOfSight(hall, rim).
lineOfSight(rim, alcove).
lineOfSight(rim, far).
lineOfSight(alcove, far).
lineOfSight(far, alcove).
lineOfSight(far, rim).

% The route, for leaps: only forward.
progress(start, 0).
progress(choke, 1).
progress(hall, 2).
progress(alcove, 3).
progress(rim, 3).
progress(chasm, 4).
progress(far, 5).
progress(gate, 6).
progress(exit, 7).

% Push lines (and what lies between).
beyond(start, choke, pit).
beyond(hall, choke, start).
beyond(choke, hall, rim).
beyond(rim, hall, alcove).
beyond(hall, rim, chasm).
beyond(far, chasm, rim).

% === Terrain ===
onEnter(pit, chasm).
onEnter(chasm, chasm).
onEnter(alcove, press).
effect(press, target, open(gate)).
door(gate).

% === Companions ===
role(player, player).
role(mage, companion).
role(warden, companion).
at(player, start).
at(mage, start).
at(warden, start).
knows(warden, sunder).

% === Things ===
role(guard, enemy).
at(guard, choke).
blocker(guard).
trait(guard, living).
tag(guard, armored).

role(crate, object).
at(crate, hall).
trait(crate, filler).
trait(crate, mindless).

role(pillar, object).
at(pillar, far).
trait(pillar, heavy).

role(idol, object).
at(idol, far).

% === Default kit (a winning pair; combos strips these) ===
knows(player, gust).
knows(mage, shadowStep).

% === Victory ===
win :- if(), do(escape).

escape :-
    if(),
    do(unguard, weighPlate, bridge,
       reach(warden, exit), reach(mage, exit), reach(player, exit)).

% The guard: dropped or moved (passage), or its armour off and then moved.
unguard :- if(), do(clear(guard)).
unguard :- if(tag(guard, armored)), do(unset(armored, guard), dislodge(guard)).

% The plate: someone gets up there (passage), or a friend is thrown on it.
weighPlate :- if(), do(openWay(gate)).
weighPlate :-
    if(not(open(gate)), landing(?from, ?over, alcove), canAct(?a), canAct(?p), \==(?a, ?p),
       knows(?p, ?ab), pusher(?ab)),
    do(walkTo(?a, ?over), castFrom(?p, ?ab, ?a, ?from), confirmOpen(gate)).
pusher(?ab) :- effect(?ab, target, push).

% The chasm: bridged or crossed (passage), or the crate hauled to the rim
% by someone who then crosses and drags it in from the far side.
bridge :- if(), do(span(chasm)).
bridge :-
    if(not(filled(chasm)), filler(?x), at(?x, ?xr), landing(?f, ?rim, chasm), \==(?xr, ?rim),
       puller(?a, ?ab, ?x)),
    do(castFrom(?a, ?ab, ?x, ?rim), reach(?a, far), span(chasm)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(gust).
comboPool(shieldBash).
comboPool(magnetize).
comboPool(translocate).
comboPool(shadowStep).
comboPool(pounce).

goals(win).
