% The Idol (stealth and avoidance)
%
% A thief and a lookout, and a golden idol in a temple shrine. The way in
% is the nave, watched from the altar by the high keeper - heavy, and a
% boss: nothing stuns him. The way out is the stair down to the crypt,
% where a skeleton watches its own floor, before the exit. The idol hushes
% whoever takes it: its bearer can cast nothing more. From the entry, a
% gallery runs round above the crypt - a drop between them.
%
%   gallery ::drop:: crypt (skeleton; the ossuary pit) ---- exit
%     |                |
%   entry ---- nave ---- shrine (the idol)
%     |  \      |       ||
%     |   altar (keeper; the sacred well)
%     ||=================||  (the temple wall: entry to shrine)
%
% Two obstacles; once the thief holds the idol, only the lookout answers:
%   the nave    slip in (blink teleports - even through the temple wall
%               straight into the shrine - and lightningFlash dashes: both
%               pass a watched area), or blind the keeper from the side
%               aisle (blindingFlash at the altar), or turn him to mist
%               (turnToMist takes `heavy` off for a moment) and then move
%               him: hook drags him out to the entry; fireball, shieldBash
%               or a vortex on the well knock him into it.
%   the crypt   from the gallery: shieldBash stuns the skeleton (or knocks
%               it into the drop), hook drags it across the drop (it
%               falls), fireball blows it into the drop or the ossuary,
%               vortex on the ossuary sucks it in. The thief can do it on
%               the way in, before taking the idol - or the lookout does.
%
% Traps:
%   - whatever got the thief in is spent: the idol silences its bearer (and
%     takes off blink's disjoint, so the hush lands).
%   - the keeper is a boss: shieldBash does not stun him; heavy, nothing
%     knocks or hooks him (a hook drags the hooker to the altar instead).
%   - blink or blindingFlash in the crypt does nothing: the skeleton sees.
%   - after turnToMist, one hook, fireball, bash or vortex serves the nave
%     and the crypt.
%
% Victory: either companion carries the idol to the exit (heist/0).

% === Areas ===
region(entry).
region(gallery).
region(nave).
region(altar).
region(shrine).
region(crypt).
region(exit).
connected(entry, gallery).
connected(entry, nave).
connected(entry, altar).
connected(nave, altar).
connected(nave, shrine).
wall(entry, shrine).
connected(shrine, crypt).
gap(gallery, crypt).
connected(crypt, exit).
feature(altar, well, chasm).
feature(crypt, ossuary, chasm).

lineOfSight(entry, nave).
lineOfSight(entry, altar).
lineOfSight(nave, altar).
lineOfSight(nave, shrine).
lineOfSight(gallery, crypt).

% The idol: whoever enters the shrine takes it, is pinned to the world (no
% disjoint) and hushed (silenced: no skills).
onEnter(shrine, idol).
effect(idol, target, remove(disjoint)).
effect(idol, target, grant(silenced)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, entry).
at(mage, entry).
mana(player, 4).
mana(mage, 4).

% === The watch ===
% The keeper watches the nave from the altar. Heavy, and a boss: no stun.
role(keeper, enemy).
at(keeper, altar).
rank(keeper, boss).
tag(keeper, living).
tag(keeper, heavy).
watches(keeper, nave) :- at(keeper, altar).

% The skeleton watches the crypt while it stands there.
role(skeleton, enemy).
at(skeleton, crypt).
watches(skeleton, crypt) :- at(skeleton, crypt).

% === Default kit (combos replans the whole matrix) ===
knows(player, blink).
knows(mage, hook).

% === Getting somewhere unseen ===

watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
% A skill that carries its caster next door: a teleport or a dash.
carries(?ab) :- effect(?ab, target, teleport).
carries(?ab) :- effect(?ab, target, dash).
leap(?a, ?ab, ?to) :-
    canAct(?a), knows(?a, ?ab), carries(?ab), region(?to), not(canReachNow(?a, ?to)),
    ready(?a, ?ab, ?to), at(?a, ?cur), first(spot(?a, ?ab, ?to, ?from)).

% ?a gets to ?r: walk if it can; else leap somewhere it cannot walk, or
% stop a watcher watching, and try again (at most ?n times).
getTo(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), leap(?a, ?ab, ?to)),
    do(cast(?a, ?ab, ?to), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watching(?g)),
    do(answer(?g), getTo(?a, ?r, ?m)).

% A watcher is answered: one cast lands on it (a blinding, a stun, a hook,
% a knock into a pit or the drop), or a vortex on a pit in its area - or,
% heavy, it turns to mist first and then one of those lands.
answer(?g) :- if(), do(strike(?g), cleared(?g)).
answer(?g) :-
    if(anchoredAgainst(?g), canAct(?c), knows(?c, ?ab), strips(?ab, heavy), ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g), strike(?g), cleared(?g)).
strike(?g) :-
    if(canAct(?c), knows(?c, ?ab), not(strips(?ab, heavy)), not(carries(?ab)), ready(?c, ?ab, ?g)),
    do(cast(?c, ?ab, ?g)).
strike(?g) :-
    if(at(?g, ?r), feature(?r, ?f, ?x), knocks(?c, ?ab, ?from, ?f, ?g, feature(?f))),
    do(castFrom(?c, ?ab, ?f, ?from)).
% The physics tries every aim: confirm the watcher no longer watches.
cleared(?g) :- if(not(watching(?g))), do().

% === Victory: the idol out ===
% The thief may clear the crypt on the way in, before the idol hushes it.
carried(?t) :- if(has(?t, silenced)), do().
heist :-
    if(canAct(?t)), do(getTo(?t, shrine, 2), carried(?t), getTo(?t, exit, 1)).
heist :-
    if(canAct(?t), watching(skeleton)),
    do(answerAs(?t, skeleton), getTo(?t, shrine, 2), carried(?t), getTo(?t, exit, 0)).
answerAs(?t, ?g) :-
    if(knows(?t, ?ab), not(carries(?ab)), not(strips(?ab, heavy)), ready(?t, ?ab, ?g)),
    do(cast(?t, ?ab, ?g), cleared(?g)).
answerAs(?t, ?g) :-
    if(at(?g, ?r), feature(?r, ?f, ?x), knocks(?t, ?ab, ?from, ?f, ?g, feature(?f))),
    do(castFrom(?t, ?ab, ?f, ?from), cleared(?g)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blink).
comboPool(lightningFlash).
comboPool(blindingFlash).
comboPool(turnToMist).
comboPool(hook).
comboPool(shieldBash).
comboPool(fireball).
comboPool(vortex).
comboMinWins(10).
comboMinMethods(3).

goals(heist).
