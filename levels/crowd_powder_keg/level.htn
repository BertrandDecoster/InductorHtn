% Powder Keg (ability catalogue, crowd control)
%
% Three old treants stand rooted in a rain-soaked grove. Wood burns (the
% catalogue's wooden weakness), but these are drenched: fire on one only
% steams it dry, and an area that has caught fire does not catch again.
% Nothing moves them: they are heavy, and rooted to the ground. Two things
% burn hot enough to take the whole grove through the wet, raw:
%   - the keg of lamp oil on the ramp above: oil that catches fire blazes
%     (the catalogue's `blaze`), setting everyone in its area alight at once;
%   - the cinder priest's meteor (the catalogue's telegraphed, magic heavy
%     attack): dazzled (blinded) or jolted (electrocuted), the priest calls
%     it down on the area it stands in. The blow lands on everyone there but
%     the priest - the treants, and any companion who stayed.
%
%   camp (player, mage) --- ramp (keg; lip) --- grove (t1, t2, t3) --- shrine (priest)
%
% Four areas in a line, all walkable. On the ramp, a feature: the lip, a
% chute down into the grove - whatever is knocked over it slides down and
% lands in the grove. The camp overlooks the ramp and the grove; the ramp
% and the grove see each other; the grove sees the shrine.
%
% Two companions, one skill each, from seven. Each has mana for one wave,
% fireball or flash of lightning.
%
% Obstacles:
%   - the treants are wet: fire on them only steams them;
%   - the keg is on the ramp, the priest in the shrine: neither is among
%     the trees, and only a hook or a taunt (the priest) moves them - or a
%     knock over the lip (the keg);
%   - the priest only strikes where it stands, and only when dazzled or
%     jolted.
%
% Methods:
%   keg      bring it down into the grove: hook it from the grove, vortex
%            the lip (everything on the ramp goes over), or a tidal wave on
%            the ramp that washes it over; then fireball the grove - the keg
%            blazes and the crowd burns. Laying the fire first and bringing
%            the keg into the flames works too.
%   meteor   bring the priest among the trees - taunt it (it walks after
%            you) or hook it from the grove - then set it off: a blinding
%            flash from the grove (the flasher is disjoint: the meteor passes
%            through), or a flash of lightning into the grove from the ramp
%            (the jolt sets the priest off at once; the caster lands in the
%            burning grove after the blow). A companion caught under it
%            burns: sacrifice is allowed.
% So hook plays both halves (fetch the keg, fetch the priest), and the two
% flashes each set the priest off.
%
% Traps:
%   - fire on the keg first: it blazes alone on the ramp and rolls down
%     spent;
%   - two movers, or two fires: nothing lit, or nothing gathered;
%   - dazzling or jolting the priest in its shrine: the meteor falls on the
%     shrine;
%   - a taunted treant does not walk: it is rooted.

% === Areas ===
region(camp).
region(ramp).
region(grove).
region(shrine).
connected(camp, ramp).
connected(ramp, grove).
connected(grove, shrine).
lineOfSight(camp, ramp).
lineOfSight(camp, grove).
lineOfSight(ramp, grove).
lineOfSight(grove, ramp).
lineOfSight(grove, shrine).

% The lip of the ramp: whatever is knocked over it slides down into the
% grove.
feature(ramp, lip, chute).
effect(chute, target, teleport(grove)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).

% === The keg ===
role(keg, object).
at(keg, ramp).
tag(keg, oiled).
immune(keg, taunted).

% === The priest ===
role(priest, enemy).
at(priest, shrine).
tag(priest, fireElemental).
behavior(priest, blinded, meteor, here).
behavior(priest, electrocuted, meteor, here).

% === The crowd ===
role(t1, enemy).
role(t2, enemy).
role(t3, enemy).
at(t1, grove).
at(t2, grove).
at(t3, grove).
tag(t1, wooden).
tag(t2, wooden).
tag(t3, wooden).
tag(t1, heavy).
tag(t2, heavy).
tag(t3, heavy).
tag(t1, rooted).
tag(t2, rooted).
tag(t3, rooted).
tag(t1, wet).
tag(t2, wet).
tag(t3, wet).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, vortex).
knows(mage, fireball).

% === The crowd, as a group ===
% The need: every treant burnt. Fire cast on a wet treant only steams it, so
% the burning has to come from something that burns the whole area at
% once, raw: a fuse (what a flame sets blazing over its area) brought to the
% crowd and lit, or an enemy's heavy blow brought down on it.

crowd(?e) :- tag(?e, wooden).
standing(?e) :- crowd(?e), not(neutralized(?e)).
cleared :- not(first(standing(?e))).
% Where the crowd stands (it cannot be moved).
crowdAt(?r) :- first(standing(?e)), at(?e, ?r).

% A fuse: the reaction a flame would set off on it spreads fire over its
% area.
fuse(?x) :-
    at(?x, ?r), not(role(?x, enemy)), reactionFor(?x, burning, ?have, ?ab),
    effect(?ab, area, grant(burning)).
% A striker: an enemy whose heavy blow burns where it stands, set off by ?t.
striker(?npc, ?t) :-
    behavior(?npc, ?t, ?blow, here), heavy(?blow), effect(?blow, target, spill(?z)),
    first(effect(?z, target, grant(burning))).

win :- if(crowdAt(?r)), do(burnOut(?r)).

% Bring the fuse to the crowd, then light it; or lay the fire, then bring the
% fuse into it.
burnOut(?r) :- if(first(fuse(?k))), do(bring(?k, ?r), light(?r), confirmCleared).
burnOut(?r) :- if(first(fuse(?k)), not(at(?k, ?r))), do(light(?r), bring(?k, ?r), confirmCleared).
% Bring a striker among the crowd, then set it off.
burnOut(?r) :-
    if(striker(?npc, ?t)), do(bring(?npc, ?r), setOff(?t, ?npc), confirmCleared).

% ?x ends up in ?r: it is there; a hook or a taunt brings it; or it is
% knocked into a feature that sends it there (the lip).
bring(?x, ?r) :- if(at(?x, ?r)), do().
bring(?x, ?r) :- if(not(at(?x, ?r))), do(bringTo(?x, ?r, none), ensureAt(?x, ?r)).
bring(?x, ?r) :-
    if(at(?x, ?xr), \==(?xr, ?r), feature(?xr, ?f, ?ab), effect(?ab, target, teleport(?r))),
    do(knockOn(?x, feature(?f), none), ensureAt(?x, ?r)).

ensureAt(?x, ?r) :- if(at(?x, ?r)), do().

% Set fire to area ?r.
light(?r) :-
    if(knows(?a, ?ab), grants(?ab, burning), canAct(?a), ready(?a, ?ab, ?r)),
    do(cast(?a, ?ab, ?r)).

% Set ?npc off with ?t, where it stands.
setOff(?t, ?npc) :- if(canInflict(?a, ?ab, ?t, ?npc)), do(cast(?a, ?ab, ?npc)).

confirmCleared :- if(cleared), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(hook).
comboPool(taunt).
comboPool(vortex).
comboPool(tidalWave).
comboPool(fireball).
comboPool(blindingFlash).
comboPool(lightningFlash).
comboMinWins(12).
comboMinMethods(6).

goals(win).
