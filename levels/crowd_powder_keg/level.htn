% Powder Keg (ability catalogue, crowd control)
%
% Three old treants stand rooted in a rain-soaked grove. Wood burns (the
% catalogue's wooden weakness), but these are drenched: fire cast on one only
% steams it dry, and a burning region goes up only once. Nothing moves them
% (they are heavy). Two things burn hot enough to take the whole grove
% through the wet:
%   - the keg of lamp oil up the ramp: oil that catches fire blazes (the
%     catalogue's `blaze`), setting everyone in its region alight at once;
%   - the cinder priest's meteor (a telegraphed, magic heavy attack): taunted,
%     the priest is dragged to its taunter; taunted or dazzled (blinded), it
%     calls a meteor down on the region it stands in. The blow lands raw - no
%     steam - so every treant in that region burns.
%
%   camp (player, mage) --- ramp (keg) --- grove (t1, t2, t3) --- shrine (priest)
%
% The ramp runs down into the grove: a push from the camp on the ramp rolls
% whatever is there into the grove. The camp sees the ramp and the grove; the
% ramp and the grove see each other; the grove sees the shrine.
%
% Two companions, one skill each, from six. Each has mana for one wave or
% fireball.
%
% Obstacles:
%   - the treants are wet: fire on them only steams them;
%   - the keg is on the ramp, and the treants cannot be moved (heavy);
%   - the meteor falls where the priest stands, and no plan may leave a
%     companion under it: whoever brings it down on the grove has to be out
%     of the grove, or disjoint, when it lands.
%
% Methods:
%   keg      bring it down: tidalWave from the camp (it rolls down), vortex
%            on the grove (it is sucked in), hook or taunt from the grove (it
%            is dragged in); then fireball the grove - the keg blazes and the
%            crowd burns. Laying the fire first and bringing the keg into it
%            works too.
%   meteor   taunt the priest from the grove: it is dragged in and winds up
%            on the grove; in the wind-up the other companion hooks the
%            taunter out, or vortexes the ramp (the taunter and the priest are
%            sucked out, the heavy treants stay).
%            Or vortex the grove: the keg and the priest are sucked in; a
%            blinding flash from the grove (disjoint: the meteor passes
%            through the flasher) or from next door sets it off.
% So vortex plays three roles: fetch the keg, fetch the priest, pull a
% friend out from under the meteor. Taunt plays two: fetch the keg, or
% provoke the priest.
%
% Traps:
%   - fire first on the keg: fireball on the keg from the camp lights it on
%     the ramp, where it blazes alone, then rolls down spent;
%   - two movers, or two fires: nothing lit, or nothing gathered;
%   - hook the priest in and flash: the hooker is still in the grove when
%     the meteor falls;
%   - taunting the priest from anywhere but the grove: the meteor falls on
%     the taunter, not on the trees. Companions cannot be taunted, so no
%     friend can taunt you out of the way.

% === Regions ===
region(camp).
region(ramp).
region(grove).
region(shrine).
connected(camp, ramp).
connected(ramp, camp).
connected(ramp, grove).
connected(grove, ramp).
connected(grove, shrine).
connected(shrine, grove).
lineOfSight(camp, ramp).
lineOfSight(camp, grove).
lineOfSight(ramp, grove).
lineOfSight(grove, ramp).
lineOfSight(grove, shrine).

% The ramp runs down into the grove.
beyond(camp, ramp, grove).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).
% Companions keep their heads: nothing drags them by a taunt.
immune(player, taunted).
immune(mage, taunted).

% === The keg ===
role(keg, object).
at(keg, ramp).
tag(keg, oiled).

% === The priest ===
role(priest, enemy).
at(priest, shrine).
tag(priest, fireElemental).
behavior(priest, taunted, meteor, here).
behavior(priest, blinded, meteor, here).

% === The crowd ===
role(t1, enemy).
role(t2, enemy).
role(t3, enemy).
at(t1, grove).
at(t2, grove).
at(t3, grove).
tag(t1, wooden).
tag(t2, wooden).
tag(t3, wooden).
tag(t1, heavy).
tag(t2, heavy).
tag(t3, heavy).
tag(t1, wet).
tag(t2, wet).
tag(t3, wet).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, fireball).

% === The crowd, as a group ===
% The need: every treant burnt. Fire cast on a wet treant only steams it, so
% the burning has to come from something that burns the whole region at
% once: a fuse (what a flame sets blazing over its region) brought to the
% crowd and lit, or an enemy's heavy blow brought down on it.

crowd(?e) :- tag(?e, wooden).
standing(?e) :- crowd(?e), not(neutralized(?e)).
cleared :- not(first(standing(?e))).
% Where the crowd stands (it cannot be moved).
crowdAt(?r) :- first(standing(?e)), at(?e, ?r).

% A fuse: the reaction a flame would set off on it spreads fire over its
% region.
fuse(?x) :-
    at(?x, ?r), not(role(?x, enemy)), reactionFor(?x, burning, ?have, ?ab),
    effect(?ab, area, grant(burning)).

win :- if(crowdAt(?r)), do(burnOut(?r), teamFit).

% Bring the fuse to the crowd, then light it; or lay the fire, then bring the
% fuse into it.
burnOut(?r) :- if(first(fuse(?k))), do(bring(?k, ?r), light(?r), confirmCleared).
burnOut(?r) :- if(first(fuse(?k)), not(at(?k, ?r))), do(light(?r), bring(?k, ?r), confirmCleared).
% Bring a heavy blow down on the crowd: provoke, from the crowd's region, an
% enemy whose provoked move is heavy and falls where it is dragged to. The
% team gets the wind-up to get out.
burnOut(?r) :-
    if(behavior(?npc, ?t, ?blow, here), heavy(?blow), onGrant(?t, pull), knows(?a, ?ab),
       grants(?ab, ?t), canAct(?a), ready(?a, ?ab, ?npc), at(?npc, ?nr), reach(?ab, ?k),
       inRange(?k, ?r, ?nr), canReachNow(?a, ?r)),
    do(castFrom(?a, ?ab, ?npc, ?r), confirmCleared).
% Or bring that enemy to the crowd, then set it off with a tag that does not
% move it (a flash that blinds it).
burnOut(?r) :-
    if(behavior(?npc, ?t, ?blow, here), heavy(?blow), not(onGrant(?t, pull)), not(at(?npc, ?r))),
    do(bring(?npc, ?r), setOff(?t, ?npc), confirmCleared).

% A cast on it, or a flash around the caster from any spot that reaches it.
setOff(?t, ?npc) :-
    if(canInflict(?a, ?ab, ?t, ?npc), not(reach(?ab, self))), do(cast(?a, ?ab, ?npc)).
setOff(?t, ?npc) :-
    if(canInflict(?a, ?ab, ?t, ?npc), reach(?ab, self), at(?npc, ?nr), aroundSpot(?a, ?nr, ?from)),
    do(castFrom(?a, ?ab, ?a, ?from)).

% ?x ends up in ?r: pushed, washed or sucked in; or dragged there by someone
% standing in ?r.
bring(?x, ?r) :- if(at(?x, ?r)), do().
bring(?x, ?r) :-
    if(not(at(?x, ?r)), placement(?a, ?ab, ?from, ?aim, ?x, ?r)),
    do(castFrom(?a, ?ab, ?aim, ?from), ensureAt(?x, ?r)).
bring(?x, ?r) :-
    if(at(?x, ?xr), \==(?xr, ?r), puller(?a, ?ab, ?x), reach(?ab, ?k), inRange(?k, ?r, ?xr),
       canReachNow(?a, ?r)),
    do(castFrom(?a, ?ab, ?x, ?r), ensureAt(?x, ?r)).

ensureAt(?x, ?r) :- if(at(?x, ?r)), do().

% Set fire to region ?r.
light(?r) :-
    if(knows(?a, ?ab), grants(?ab, burning), canAct(?a), ready(?a, ?ab, ?r)),
    do(cast(?a, ?ab, ?r)).

confirmCleared :- if(cleared), do().
% Nobody on the team is left stunned.
teamFit :- if(not(first(and(canAct(?a), tag(?a, stunned))))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(vortex).
comboPool(hook).
comboPool(taunt).
comboPool(fireball).
comboPool(blindingFlash).
comboMinWins(8).
comboMinMethods(4).

goals(win).
