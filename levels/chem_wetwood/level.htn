% Wet Wood (elemental chemistry)
%
% A treant, heavy and rain-soaked, holds the grove. Wood burns - but this
% wood is wet, and fire on something wet only makes steam. Up on the ramp,
% in a spill of lamp oil (a slick zone), stands a keg; at the grove's edge
% glows the charcoal-burners' kiln (a feature: what is knocked in burns).
% Two companions, one skill each, from a pool of seven.
%
%   glade (player, mage) ---- grove (treant: wooden, heavy, wet; kiln)
%     |                         |
%   landing --------------- ramp (slick; keg: oiled)
%
%   sight: glade->grove, landing->ramp, ramp->grove, grove->ramp
%
% Obstacles:
%   wet        fire on it makes steam and dries it; it does not burn
%   heavy      nothing knocks or pulls it (a hook drags the caster to it)
%   a spilled fire does not land again where flames already lie
%
% Methods (one companion brings the fuel and the wood together, the other
% sets it off):
%   keg to the tree    hook the keg down off the ramp into the grove, then
%                      set it off: fire (fireball), a spark (lightningFlash,
%                      blindingFlash: this level's reaction, sparks set oil
%                      off), or a vortex on the kiln that knocks the keg in.
%                      The blaze throws fire on everyone around it, and that
%                      fire is raw: the soak does not save the treant. Or
%                      the grove alight first, and the keg hooked into the
%                      flames
%   tree to the oil    lure it onto the ramp (taunt from the ramp: it walks
%                      through the slick and comes out oiled), then fire or
%                      a spark on the ramp: the oil on it, and the keg
%                      beside it, go up
%   into the kiln      turn it to mist (not heavy for a moment), then
%                      fireball it: the flames dry it (steam) and the blast
%                      knocks it into the kiln, where it burns
%
% Traps:
%   fire on the treant alone only steams it; a second fire on the grove
%   lands on flames already there. Fire or a spark on the keg where it
%   stands blows it up on the ramp, far from the tree - and fire on the
%   ramp turns the slick to flames (a zone reaction): lured through them
%   later, the treant only steams. A misted treant knocked into the kiln by
%   a vortex is still wet: the kiln only steams it. The keg does not walk:
%   a taunt does nothing to it.

% === Areas ===
region(glade).
region(grove).
region(ramp).
region(landing).
connected(glade, grove).
connected(grove, ramp).
connected(glade, landing).
connected(landing, ramp).
lineOfSight(glade, grove).
lineOfSight(landing, ramp).
lineOfSight(ramp, grove).
lineOfSight(grove, ramp).

% === Terrain ===
feature(grove, kiln, flames).
onEnter(ramp, slick).

% === Level physics: a spark sets oil off ===
reaction(oiled, electrocuted, blaze).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, glade).
at(mage, glade).
mana(player, 4).
mana(mage, 4).

% === The treant, and the keg ===
role(treant, enemy).
at(treant, grove).
tag(treant, wooden).
tag(treant, heavy).
tag(treant, wet).

role(keg, object).
at(keg, ramp).
tag(keg, oiled).
immune(keg, taunted).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, hook).
knows(mage, fireball).

% === The goal: the treant burns ===
win :- if(), do(blazeBeside(treant)).
win :- if(), do(lureOntoOil(treant)).
win :- if(), do(intoTheKiln(treant)).

% Fuel goes up beside it: bring the fuel in and set it off, or set the
% area alight and bring the fuel into the flames.
blazeBeside(?e) :-
    if(at(?e, ?r), tag(?x, oiled), \==(?x, ?e), not(at(?x, ?r)), canAct(?a)),
    do(placeAs(?a, ?x, ?r), setOff(?x, ?a), confirmStopped(?e)).
blazeBeside(?e) :-
    if(at(?e, ?r), tag(?x, oiled), \==(?x, ?e), not(at(?x, ?r)), canAct(?a)),
    do(setAlight(?a, ?r), bringTo(?x, ?r, ?a), confirmStopped(?e)).

% It is lured onto the oil (it comes out oiled), and the oil is set off.
lureOntoOil(?e) :-
    if(zoneFor(?r, oiled), not(at(?e, ?r)), canAct(?a)),
    do(placeAs(?a, ?e, ?r), confirmHas(?e, oiled), setOff(?e, ?a), confirmStopped(?e)).

% Fire or a spark on the fuel, or the fuel knocked into a fire, by anyone
% but ?not.
setOff(?x, ?not) :- if(), do(inflict(burning, ?x, ?not)).
setOff(?x, ?not) :- if(), do(inflict(electrocuted, ?x, ?not)).
setOff(?x, ?not) :- if(featureFor(?f, burning)), do(knockOn(?x, feature(?f), ?not)).

% ?a sets area ?r alight: it becomes a fire zone.
setAlight(?a, ?r) :-
    if(canAct(?a), knows(?a, ?ab), effect(?ab, target, spill(flames)), ready(?a, ?ab, ?r),
       first(spot(?a, ?ab, ?r, ?from))),
    do(castFrom(?a, ?ab, ?r, ?from)).

% The heavy treant is made light for a moment, and someone else knocks it
% into the fire.
intoTheKiln(?e) :-
    if(holds(?e, heavy), featureFor(?f, burning), canUnset(?p, ?ab, heavy, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(heavy, ?e), knockOn(?e, feature(?f), ?p),
       confirmStopped(?e)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(lightningFlash).
comboPool(blindingFlash).
comboPool(hook).
comboPool(taunt).
comboPool(vortex).
comboPool(turnToMist).
comboMinWins(4).
comboMinMethods(3).

goals(win).
