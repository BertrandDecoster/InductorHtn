% Wet Wood (elemental chemistry)
%
% A treant, rooted and rain-soaked, blocks the grove. Wood burns - but this
% wood is wet, and fire on something wet only makes steam. Up on the ramp,
% in a spill of lamp oil (a slick zone), stands a keg; beyond the grove the
% charcoal-burners' kiln glows (a flames zone). Two companions, one skill
% each, from a pool of seven.
%
%   ridge ---- glade (player, mage) ---- grove (treant: wooden, heavy, wet) ---- kiln (flames)
%                |                        |
%              landing ---- ramp (slick; keg: oiled) ----+
%
% Obstacles:
%   wet        fire on it makes steam and dries it; it does not burn
%   heavy      it is rooted: nothing moves it
%   a spilled fire zone does not land again where it already lies, so a
%   second fire on the grove does nothing
%
% Methods (each needs two different companions):
%   keg, then fire   bring the keg into the grove (tidalWave pushes it off
%                    the ramp from the landing; hook or taunt drag it in from
%                    the grove; a vortex on the grove pulls it in), then set
%                    it off: fireball, or a spark (lightningFlash: this
%                    level's reaction, sparks ignite oil). The blaze throws
%                    fire on everyone around it, and that fire is raw: the
%                    soak does not save the treant
%   fire, then keg   set the grove alight first (fireball on the grove: the
%                    steam dries it, and the grove stays a fire zone), then
%                    bring the keg in: it blazes as it arrives
%   into the kiln    turn it to mist (not heavy for a moment), then fireball
%                    it from the glade: the flames dry it (steam) and the
%                    blast throws it into the kiln, where it burns
%
% Traps:
%   fire on the treant alone only steams it; a second fire on the grove
%   lands on flames already there. Fire or a spark on the keg where it
%   stands burns the oil off on the ramp (slick + flames = flames, a zone
%   reaction), wasted - fireball does it even while it throws the keg into
%   the grove, since the spill comes before the push. A misted treant washed
%   (tidalWave), pulled (vortex) or dragged into the kiln is still wet: the
%   kiln only steams it.

% === Regions ===
region(glade).
region(grove).
region(ramp).
region(landing).
region(ridge).
region(kiln).
connected(glade, grove).
connected(grove, glade).
connected(glade, landing).
connected(landing, glade).
connected(landing, ramp).
connected(ramp, landing).
connected(grove, ramp).
connected(ramp, grove).
connected(glade, ridge).
connected(ridge, glade).
connected(grove, kiln).
connected(kiln, grove).
lineOfSight(glade, grove).
lineOfSight(ridge, grove).
lineOfSight(landing, ramp).
lineOfSight(grove, ramp).

% Push lines: from the landing, the ramp tips into the grove; from the
% glade, the grove falls away into the kiln.
beyond(landing, ramp, grove).
beyond(glade, grove, kiln).

% === Zones ===
onEnter(ramp, slick).
onEnter(kiln, flames).

% === Level physics: a spark sets oil off ===
reaction(oiled, electrocuted, blaze).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, glade).
at(mage, glade).
mana(player, 4).
mana(mage, 4).

% === The treant, and the keg ===
role(treant, enemy).
at(treant, grove).
tag(treant, wooden).
tag(treant, heavy).
tag(treant, wet).

role(keg, object).
at(keg, ramp).
tag(keg, oiled).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, fireball).

% === The goal: the treant burns ===
win :- if(), do(neutralize(treant)).
win :- if(), do(blazeBeside(treant)).
win :- if(), do(intoTheFire(treant)).

% Something oiled goes up beside it: bring the fuel in and set it off, or
% set the region alight and bring the fuel in.
blazeBeside(?e) :-
    if(at(?e, ?r), tag(?x, oiled), \==(?x, ?e), not(at(?x, ?r)), canAct(?a)),
    do(bringAs(?a, ?x, ?r), igniteFuel(?x, ?a), confirmStopped(?e)).
blazeBeside(?e) :-
    if(at(?e, ?r), tag(?x, oiled), \==(?x, ?e), not(at(?x, ?r)), canAct(?a)),
    do(setAlight(?a, ?r), bringIn(?x, ?r, ?a), confirmStopped(?e)).

% ?a moves ?x into ?r: a push along a line or a pull-in, or a drag from ?r.
bringAs(?a, ?x, ?r) :-
    if(first(placement(?a, ?ab, ?from, ?aim, ?x, ?r))), do(castFrom(?a, ?ab, ?aim, ?from)).
bringAs(?a, ?x, ?r) :-
    if(puller(?a, ?ab, ?x), at(?x, ?xr), reach(?ab, ?k), inRange(?k, ?r, ?xr), canReachNow(?a, ?r)),
    do(castFrom(?a, ?ab, ?x, ?r)).
bringIn(?x, ?r, ?not) :- if(canAct(?a), \==(?a, ?not)), do(bringAs(?a, ?x, ?r)).

% Fire or a spark on the fuel, by anyone but ?not.
igniteFuel(?x, ?not) :- if(), do(inflict(burning, ?x, ?not)).
igniteFuel(?x, ?not) :- if(), do(inflict(electrocuted, ?x, ?not)).

% ?a sets the region alight: it becomes a fire zone.
setAlight(?a, ?r) :-
    if(canAct(?a), knows(?a, ?ab), effect(?ab, target, spill(flames)), ready(?a, ?ab, ?r),
       first(spot(?a, ?ab, ?r, ?from))),
    do(castFrom(?a, ?ab, ?r, ?from)).

% The rooted treant is made light for a moment, and someone else sends it
% into a fire.
intoTheFire(?e) :-
    if(holds(?e, heavy), at(?e, ?r), zoneFor(?k, burning), \==(?k, ?r),
       canUnset(?p, ?ab, heavy, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(heavy, ?e), place(?e, ?k, ?p), confirmStopped(?e)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(lightningFlash).
comboPool(tidalWave).
comboPool(hook).
comboPool(vortex).
comboPool(taunt).
comboPool(turnToMist).
comboMinWins(4).
comboMinMethods(3).

goals(win).
