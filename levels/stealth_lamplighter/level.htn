% The Lamplighter (stealth and avoidance)
%
% Everyone out through the town gate. The gate is shut; its winch stands
% in the gatehouse yard, which the warden watches from his lodge - a big
% man, rooted in his chair: no taunt gets him up, no hook moves him. The
% road to the gate runs down the lamp-lit street, which the lamplighter
% watches from his post while the lamps burn. His own lantern means no
% flash dazzles him. At the post hangs the lamp rope: weigh it down and
% every lamp in the street goes out.
%
%   lodge (warden) ---- square (start) ---- yard (the winch plate)
%                          |
%                        street (lamps) ==gate== exit
%                          |
%                        post (lamplighter; the lamp rope plate)
%
% Two obstacles:
%   the winch     a companion must stand on it, and the warden sees the
%                 yard: blind him (blindingFlash in his lodge), stun him
%                 (shieldBash), or soak him (tidalWave in his lodge) and
%                 freeze him (blizzard): wet and chilled, he is stunned.
%   the street    everyone crosses it: taunt the lamplighter off his post
%                 (he walks after you), knock him onto his own lamp rope
%                 (fireball, or a vortex on the rope: the street goes
%                 dark), or frost the lamps over (blizzard on the street).
%
% blizzard has two roles: it frosts the lamps, and it freezes a soaked
% warden - one blizzard each, with the mana for two.
%
% Traps:
%   - nothing dazzles or stuns the lamplighter (his lantern); nothing moves
%     the warden (rooted and heavy). A taunt on him breaks.
%   - blizzard on the warden alone only chills him: he must be wet.
%   - the post can only be reached through the lit street.
%
% Victory: both companions at the exit (escape/0).

% === Areas ===
region(square).
region(lodge).
region(yard).
region(street).
region(post).
region(exit).
connected(square, lodge).
connected(square, yard).
connected(square, street).
connected(street, post).
doorway(street, exit, gate).
door(gate).
feature(yard, winch, turnWinch).
plate(winch).
effect(turnWinch, target, open(gate)).
feature(post, lampRope, douse).
plate(lampRope).
effect(douse, target, spill(shadows, street)).

lineOfSight(square, lodge).
lineOfSight(square, yard).
lineOfSight(square, street).
lineOfSight(square, post).
lineOfSight(lodge, yard).
lineOfSight(street, post).

% === Terrain ===
% The street lamps are a zone with no effect of their own. Dark (shadows)
% or frosted over (an ice sheet), they are out.
onEnter(street, lamplight).
zoneReaction(lamplight, shadows, shadows).
zoneReaction(lamplight, iceSheet, iceSheet).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, square).
at(mage, square).
mana(player, 4).
mana(mage, 4).

% === The watch ===
% The warden watches the yard from his lodge; big and rooted in his chair.
role(warden, enemy).
at(warden, lodge).
tag(warden, living).
tag(warden, heavy).
tag(warden, rooted).
watches(warden, yard) :- at(warden, lodge).

% The lamplighter watches the street from his post while the lamps burn.
% His lantern: nothing blinds him.
role(lamplighter, enemy).
at(lamplighter, post).
tag(lamplighter, living).
immune(lamplighter, blinded).
watches(lamplighter, street) :- at(lamplighter, post), onEnter(street, lamplight).

% === Default kit (combos replans the whole matrix) ===
knows(player, blindingFlash).
knows(mage, taunt).

% === Getting somewhere unseen ===

watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).

% ?a gets to ?r: walk if it can; else stop a watcher watching, and try
% again (at most ?n times).
getTo(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watching(?g)),
    do(answer(?g), getTo(?a, ?r, ?m)).

% A watcher is answered: one cast lands on it (a blinding, a stun, a
% taunt, a knock onto the rope), on what it watches (the lamps frosted), or
% a vortex on a plate in its area - or it is soaked first and then frozen.
answer(?g) :- if(), do(strike(?g), cleared(?g)).
answer(?g) :-
    if(canAct(?c), knows(?c, ?ab), grants(?ab, wet), not(holds(?g, wet))),
    do(cast(?c, ?ab, ?g), confirmHas(?g, wet), strike(?g), cleared(?g)).
strike(?g) :-
    if(canAct(?c), knows(?c, ?ab), ready(?c, ?ab, ?g)), do(cast(?c, ?ab, ?g)).
strike(?g) :-
    if(watches(?g, ?r), canAct(?c), knows(?c, ?ab), effect(?ab, target, spill(?z)),
       ready(?c, ?ab, ?r)),
    do(cast(?c, ?ab, ?r)).
strike(?g) :-
    if(at(?g, ?r), feature(?r, ?f, ?x), knocks(?c, ?ab, ?from, ?f, ?g, feature(?f))),
    do(castFrom(?c, ?ab, ?f, ?from)).
% The physics tries every aim: confirm the watcher no longer watches.
cleared(?g) :- if(not(watching(?g))), do().

% === Victory: everyone out ===
% The gate: someone stands on the winch.
openGate :- if(open(gate)), do().
openGate :-
    if(not(open(gate)), canAct(?a)), do(getTo(?a, yard, 2), stepOn(?a, winch), gateOpen(gate)).
gateOpen(?d) :- if(open(?d)), do().

escape :- if(), do(openGate, getTo(player, exit, 1), getTo(mage, exit, 1)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blindingFlash).
comboPool(shieldBash).
comboPool(tidalWave).
comboPool(blizzard).
comboPool(taunt).
comboPool(fireball).
comboPool(vortex).
comboMinWins(10).
comboMinMethods(3).

goals(escape).
