% The Lamplighter (stealth and avoidance)
%
% Everyone out through the town gate. The gate is shut; its lever lies in
% the guardroom, under a warden's eyes. The road to the gate runs down the
% lamp-lit street, then through the hall, which the lamplighter watches
% from his post. His own lantern means no flash dazzles him. The hall's
% shutters are closed and the guardroom has no window: nobody sees into
% either, so nobody blinks or dashes in.
%
%   guardroom (warden; the lever)      yard (a crate)
%        |                         ___/    \___
%      start ------------------------ lamps ---- hall ---- gate ---- exit
%                                       |
%                                      post (lamplighter)
%
% Two obstacles:
%   the lever      someone on it, or something: blind the warden from the
%                  start (blindingFlash), stun him (shieldBash), or push the
%                  crate from the yard onto the lever (a fireball from the
%                  start, or a tidalWave that washes it in).
%   the hall       everyone crosses it: drag the lamplighter off his post
%                  (taunt, hook), draw him into the street (a vortex on the
%                  lamps), or push the crate into the hall from the lamps
%                  (fireball, tidalWave) and walk behind it - cover.
%
% fireball and tidalWave have two roles - the crate on the lever, or the
% crate as cover - but there is one crate: the two of them, or one of them
% twice, leave one obstacle.
%
% Traps:
%   - nothing dazzles or stuns the lamplighter (his lantern); nothing drags
%     the warden (nobody sees into his room).
%   - a vortex on the lamps draws in everyone next to them, companions
%     included, and roots them for good: cast it when your friend is on the
%     lever, not beside you. With the crate on the lever, there is nowhere
%     for your friend to stand clear, so crate + vortex has no plan.
%   - the crate cannot be in two places.
%
% Victory: both companions at the exit (escape/0).

% === Regions ===
region(start).
region(guardroom).
region(yard).
region(lamps).
region(post).
region(hall).
region(gate).
region(exit).
connected(start, guardroom).
connected(guardroom, start).
connected(start, lamps).
connected(lamps, start).
connected(start, yard).
connected(yard, start).
connected(yard, lamps).
connected(lamps, yard).
connected(lamps, post).
connected(post, lamps).
connected(lamps, hall).
connected(hall, lamps).
connected(hall, gate).
connected(gate, hall).
connected(gate, exit).
connected(exit, gate).

lineOfSight(start, yard).
lineOfSight(start, lamps).
lineOfSight(lamps, yard).
lineOfSight(lamps, post).
lineOfSight(lamps, start).
lineOfSight(hall, gate).
lineOfSight(gate, exit).

% Push lines for the crate: from the start into the guardroom (onto the
% lever); from under the lamps into the hall (cover).
beyond(start, yard, guardroom).
beyond(lamps, yard, hall).

% === Terrain ===
door(gate).
onEnter(guardroom, lever).
effect(lever, target, open(gate)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, start).
at(mage, start).
mana(player, 4).
mana(mage, 4).

% === The watch ===
role(warden, enemy).
at(warden, guardroom).
tag(warden, living).
watches(warden, guardroom) :- at(warden, guardroom).

% The lamplighter watches the hall from his post - unless the crate stands
% in the hall to hide behind. His lantern: nothing blinds him.
role(lamplighter, enemy).
at(lamplighter, post).
tag(lamplighter, living).
immune(lamplighter, blinded).
watches(lamplighter, hall) :- at(lamplighter, post), not(at(crate, hall)).

role(crate, object).
at(crate, yard).

% === Default kit (combos replans the whole matrix) ===
knows(player, fireball).
knows(mage, taunt).

% === Getting somewhere unseen ===

watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
watchedRegion(?r) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).

% ?a gets to ?r: walk if it can; else stop a watcher watching, or put the
% crate in a watched region as cover, and try again (at most ?n times).
getTo(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watching(?g)),
    do(unwatch(?g), getTo(?a, ?r, ?m)).
getTo(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), is(?m, -(?n, 1)), watchedRegion(?w),
       not(at(crate, ?w))),
    do(place(crate, ?w, none), getTo(?a, ?r, ?m)).

% A watcher stops watching: blinded (a flash, a stun) or moved off his post.
unwatch(?g) :-
    if(canInflict(?c, ?ab, blinded, ?g)), do(cast(?c, ?ab, ?g), confirmUnwatched(?g)).
unwatch(?g) :- if(), do(budge(?g), confirmUnwatched(?g)).
confirmUnwatched(?g) :- if(not(watching(?g))), do().

% Something moves off its spot: dragged to someone (taunt, hook), pushed
% along a line, or drawn into the next region (vortex).
budge(?e) :-
    if(at(?e, ?r), canAct(?a), knows(?a, ?ab), pulls(?ab), ready(?a, ?ab, ?e)),
    do(cast(?a, ?ab, ?e), ensureMoved(?e, ?r)).
budge(?e) :-
    if(at(?e, ?r), placement(?a, ?ab, ?from, ?aim, ?e, ?to)),
    do(castFrom(?a, ?ab, ?aim, ?from), ensureMoved(?e, ?r)).

% === Victory: everyone out ===
openGate :- if(open(gate)), do().
openGate :- if(not(open(gate)), canAct(?a)), do(getTo(?a, guardroom, 1)).
openGate :- if(not(open(gate))), do(place(crate, guardroom, none)).

escape :- if(), do(openGate, getTo(player, exit, 1), getTo(mage, exit, 1)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blindingFlash).
comboPool(shieldBash).
comboPool(fireball).
comboPool(tidalWave).
comboPool(taunt).
comboPool(hook).
comboPool(vortex).
comboMinWins(10).
comboMinMethods(3).

goals(escape).
