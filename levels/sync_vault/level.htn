% Sync: The Vault (two plates at once)
%
% The vault door opens only once both of its plates are weighed down at the
% same time. One plate stands on an island across a rift; the other lies in
% the warden's forge, behind a grate, on a floor of lava no companion can
% set foot on. A barrel stands in the forge beside the warden. Two
% companions, one skill each from six, two mana each. Whoever holds the
% island plate is stranded there: the other has to weigh the forge plate
% down with the barrel - through the grate - and then walk into the vault.
%
%   rim ~~rift (a gap)~~ island (pillar) [plate]
%    |
%   hall ==vaultdoor== vault
%    :
%   grate (a wall, seen through)
%    :
%   forge (lava: warden, barrel) [plate]
%
% The warden is heavy: nothing moves it. It answers a taunt with a ground
% slam where it stands (heavy, physical: it cannot be stopped); walled in,
% it cannot walk after its taunter, so the taunt breaks and the slam falls
% on its own forge: whatever is there but the warden is knocked down and
% thrown - the barrel onto the plate.
%
% Obstacles and every method:
%   the island   no walking over the rift. From the rim: blink onto the
%                island, lightning-flash there (a dash), or hook the
%                anchored pillar (the hook drags you over). Then step on
%                the plate - and stay.
%   the forge    nobody gets in (a wall, and lava). Through the grate,
%                knock the barrel onto the plate: fireball it, vortex the
%                plate, or taunt the warden and let its own slam throw it.
%   the vault    once both plates were held together, the door latches
%                open; the one left in the hall walks in.
%
% Traps:
%   - the forge is behind a wall: no walk, no dash, no hook, no melee;
%     a blink through the wall would land in the lava, so it never does;
%   - the warden is heavy: pushes and the vortex move only the barrel;
%   - a hook through the grate is out of reach; a hook on the barrel
%     would only drag it away from the plate;
%   - the island holder cannot also do the forge, and leaving the island
%     leaves its plate;
%   - one costly cast each (two mana): a lightning flash, or a fireball.
%
% Hypothesis (design.md): no single skill wins; 18 of 36 assignments win
% (each island skill with each forge skill, either seat), by 9 methods.

% === Areas ===
region(hall).
region(rim).
region(island).
region(forge).
region(vault).
connected(hall, rim).
gap(rim, island).
wall(hall, forge).
doorway(hall, vault, vaultdoor).

lineOfSight(hall, forge).
lineOfSight(rim, island).

% The route, for leaps (passage): only forward.
progress(hall, 0).
progress(rim, 0).
progress(forge, 0).
progress(vault, 0).
progress(island, 1).

% === Terrain and features ===
onEnter(forge, lava).
door(vaultdoor).
feature(island, islandPlate, pressIsland).
plate(islandPlate).
feature(forge, forgePlate, pressForge).
plate(forgePlate).
plateFor(islandPlate, vaultdoor).
plateFor(forgePlate, vaultdoor).
effect(pressIsland, target, openWhenHeld(vaultdoor)).
effect(pressForge, target, openWhenHeld(vaultdoor)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, hall).
at(mage, hall).
mana(player, 2).
mana(mage, 2).

% === The warden ===
role(warden, enemy).
at(warden, forge).
tag(warden, living).
tag(warden, heavy).
tag(warden, fireElemental).
% Taunted, it slams where it stands: a telegraphed groundSlam there.
behavior(warden, taunted, groundSlam, here).

% === Things ===
role(pillar, object).
at(pillar, island).
tag(pillar, heavy).

role(barrel, object).
at(barrel, forge).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, blink).
knows(mage, fireball).

% === Victory ===
% Someone holds the island plate, the barrel is put on the forge plate, and
% the door must have opened; then someone walks into the vault.
win :- if(canAct(?a)), do(weighIsland(?a), weighForge(?a), confirmOpen(vaultdoor), lootVault).

weighIsland(?a) :- if(), do(reach(?a, island), stepOn(?a, islandPlate)).

% Knocked onto the plate through the grate: shoved, or drawn in ...
weighForge(?a) :- if(), do(knockOn(barrel, feature(forgePlate), ?a), onPlate(barrel, forgePlate)).
% ... or thrown there by the warden's own slam.
weighForge(?a) :-
    if(canAct(?b), \==(?b, ?a), knows(?b, ?ab), grants(?ab, taunted)),
    do(cast(?b, ?ab, warden), onPlate(barrel, forgePlate)).
onPlate(?x, ?p) :- if(on(?x, ?p)), do().

lootVault :- if(canAct(?c), not(at(?c, island))), do(walkTo(?c, vault)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blink).
comboPool(lightningFlash).
comboPool(hook).
comboPool(fireball).
comboPool(vortex).
comboPool(taunt).
comboMinWins(8).
comboMinMethods(4).

goals(win).
