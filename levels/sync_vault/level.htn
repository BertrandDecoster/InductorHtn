% Sync: The Vault (two plates at once)
%
% The vault door opens only once both of its plates are weighed down at the
% same moment. One plate stands on an island across a rift; the other sits
% in a closet that a warden keeps its eye on from its post. A barrel stands
% on the post beside the warden. Two companions, one skill each from seven.
% Whoever holds the island plate is stranded there: the other has to weigh
% the closet down - with themselves, or with the barrel.
%
%   foyer --- hall --- rim ~~rift~~ outcrop (pillar) --- island [plate]
%              |  \
%              |   post (warden, barrel) --- closet [plate, watched]
%              |
%          vaultdoor (door) --- vault
%
% The warden is a heavy boss: nothing moves it and nothing stuns it. It
% answers a taunt with a telegraphed ground slam on its own post (heavy,
% physical: it cannot be stopped): everyone on the post but the warden is
% knocked down and thrown into the closet. Bait it, and its own blow throws
% the barrel onto the plate - as long as no companion stands on the post.
%
% Obstacles and every method:
%   the island   no walking over the rift. From the rim: blink onto the
%                outcrop, lightningFlash there (a dash), or hook the
%                anchored pillar (the hook drags you over). Then walk onto
%                the plate.
%   the closet   the warden watches it: nobody walks in seen. Walk in once
%                it is blinded (blindingFlash beside it); or weigh the plate
%                with the barrel, without walking in at all: fireball or
%                tidalWave it off the post from the hall (a push; the heavy
%                warden stays), or taunt the warden and let its own slam
%                throw the barrel.
%   the vault    once both plates were held together, the door latches
%                open; the one left on the near side walks in.
%
% Traps:
%   - there is no line of sight into the closet, so nothing blinks or
%     dashes in (and nothing vortexes it);
%   - the warden is a boss: a stun does not land on it, and it is heavy,
%     so no push or pull moves it - only the barrel goes;
%   - hooking the barrel drags it to you, away from the plate;
%   - the island holder cannot come back, so it cannot also do the closet;
%   - whoever stands on the post when the warden slams is thrown too:
%     no plan lets a companion take that blow.
%
% Hypothesis (design.md): no single skill wins; 24 of 49 assignments win
% (each island skill with each closet skill, either seat), by 12 methods.

% === Regions ===
region(foyer).
region(hall).
region(rim).
region(rift).
region(outcrop).
region(island).
region(post).
region(closet).
region(vaultdoor).
region(vault).
connected(foyer, hall).
connected(hall, foyer).
connected(hall, rim).
connected(rim, hall).
connected(rim, rift).
connected(rift, rim).
connected(rift, outcrop).
connected(outcrop, rift).
connected(outcrop, island).
connected(island, outcrop).
connected(hall, post).
connected(post, hall).
connected(post, closet).
connected(closet, post).
connected(hall, vaultdoor).
connected(vaultdoor, hall).
connected(vaultdoor, vault).
connected(vault, vaultdoor).

lineOfSight(foyer, hall).
lineOfSight(hall, foyer).
lineOfSight(hall, rim).
lineOfSight(rim, hall).
lineOfSight(rim, outcrop).
lineOfSight(hall, post).
lineOfSight(post, hall).

% The route over the rift, for leaps: only forward.
progress(foyer, 0).
progress(hall, 0).
progress(rim, 0).
progress(rift, 1).
progress(outcrop, 2).
progress(island, 3).

% A push from the hall on the post lands in the closet; so does the
% warden's slam on its own post.
beyond(hall, post, closet).
beyond(post, post, closet).

% === Terrain ===
onEnter(rift, chasm).
door(vaultdoor).
plateFor(island, vaultdoor).
plateFor(closet, vaultdoor).
onEnter(island, pressIsland).
onEnter(closet, pressCloset).
effect(pressIsland, target, openWhenHeld(vaultdoor)).
effect(pressCloset, target, openWhenHeld(vaultdoor)).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, foyer).
at(mage, foyer).
mana(player, 4).
mana(mage, 4).

% === The warden ===
role(warden, enemy).
at(warden, post).
tag(warden, living).
tag(warden, heavy).
rank(warden, boss).
watches(warden, closet).
% Taunted, it slams its own post: a telegraphed groundSlam there.
behavior(warden, taunted, groundSlam, here).

% === Things ===
role(pillar, object).
at(pillar, outcrop).
tag(pillar, heavy).

role(barrel, object).
at(barrel, post).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, blink).
knows(mage, fireball).

% === Victory ===
% Someone weighs the island down, the closet is weighed down, and the door
% must have opened; then someone walks into the vault.
win :- if(), do(weighIsland, weighCloset, confirmOpen(vaultdoor), lootVault).

weighIsland :- if(canAct(?a)), do(reach(?a, island)).

% Walk in with the warden blinded ...
weighCloset :-
    if(canAct(?b), not(at(?b, island))),
    do(inflict(blinded, warden, none), walkTo(?b, closet)).
% ... or put the barrel on the plate: shoved, sucked in ...
weighCloset :- if(), do(place(barrel, closet, none), onPlate(barrel)).
% ... or thrown there by the warden's own slam.
weighCloset :-
    if(canAct(?a), knows(?a, ?ab), grants(?ab, taunted)),
    do(cast(?a, ?ab, warden), onPlate(barrel)).
onPlate(?x) :- if(at(?x, closet)), do().

lootVault :- if(canAct(?c)), do(walkTo(?c, vault)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from seven (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(blink).
comboPool(lightningFlash).
comboPool(hook).
comboPool(blindingFlash).
comboPool(fireball).
comboPool(tidalWave).
comboPool(taunt).
comboMinWins(8).
comboMinMethods(4).

goals(win).
