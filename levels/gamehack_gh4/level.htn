% GameHack GH4 Level: GH4-style world state
% Three companions: companionE (lightning), companionW (frost), and the player (no skill).
% Only wetAndFreeze works: gob is vulnerable to wet + chilled; nothing stuns, and there is no oil.

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, companionE).
type(agent, companionW).
type(agent, gob).
type(agent, mimic).
type(agent, electricityElemental).
type(agent, teslaTower).

% Locations (named positions in the world)
type(location, room).
type(location, inn).
type(location, hut).
type(location, mountain).
type(location, lake).
type(location, sea).

% Skills (abilities)
type(skill, lightningSkill).
type(skill, frostSkill).

% === Agents ===
companion(player).
companion(companionE).
companion(companionW).
enemy(gob).
enemy(mimic).
enemy(electricityElemental).
enemy(teslaTower).

% === Positions ===
at(player, room).
at(companionE, hut).
at(companionW, inn).
at(mimic, room).
at(gob, hut).
at(electricityElemental, mountain).
at(teslaTower, lake).

% === Locations ===
location(room).
location(inn).
location(hut).
location(mountain).
location(lake).
location(sea).

% === Location tags ===
locationCanApplyTag(lake, wet).
locationCanApplyTag(sea, wet).

immune(electricityElemental, electrified).

static(teslaTower).

% === Skills ===
hasSkill(companionE, lightningSkill).
hasSkill(companionW, frostSkill).
hasSkill(teslaTower, lightningSkill).
hasSkill(electricityElemental, lightningSkill).

skillAppliesTag(lightningSkill, electrified).
skillAppliesTag(frostSkill, chilled).

% === What defeats whom ===
vulnerableToLocationCombo(gob, wet, chilled).

% === Level Goal ===
goals(defeat(gob)).
