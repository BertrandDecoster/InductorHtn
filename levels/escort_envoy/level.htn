% The Envoy (escort, protect, rescue)
%
% An envoy who cannot fight must reach the gate road. Between the yard and
% the lawn run the briars, a strip of thorns: a leaper clears it, but the
% envoy only walks, and nobody drags it over (pulled across, it falls in).
% Past the lawn, an armoured sentry (heavy) holds the gatehouse: nobody
% walks through it while it stands there.
%
%   camp (envoy, player, mage) --- yard (crate) ~~briars~~ lawn (statue) --- gatehouse (sentry, trapdoor) --- road
%                                                           |
%                                                         tower
%
% Map: six areas. Walkable: camp-yard, lawn-gatehouse, gatehouse-road,
% lawn-tower. A gap (the briars) between the yard and the lawn. A
% trapdoor (chasm) in the gatehouse.
%
% Obstacles, and the answers to each:
%   the briars    bridge them with the crate: knock it in from the yard
%                 side (a fireball, a shield bash, a tidal wave in the
%                 yard), or grapple over to the statue on the lawn (hook)
%                 and drag the crate across behind you - it falls in and
%                 fills the gap.
%   the sentry    lure it out: taunted from the tower, it walks after its
%                 taunter, off the envoy's road; or drop it: turn it to
%                 mist, and in that moment knock it into the trapdoor (a
%                 fireball, a shield bash).
% Then the envoy walks out on its own.
%
% Traps:
%   - hooking the envoy over the briars drops it in the thorns;
%   - a push on the heavy sentry does nothing, and a hook on it drags the
%     caster into the gatehouse instead; mist lasts one cast, so the knock
%     must be the very next one;
%   - a taunt from the lawn only brings the sentry onto the lawn, into the
%     envoy's way: the taunter must walk it off to the tower.

% === Areas ===
region(camp).
region(yard).
region(lawn).
region(gatehouse).
region(road).
region(tower).
connected(camp, yard).
gap(yard, lawn).
connected(lawn, gatehouse).
connected(gatehouse, road).
connected(lawn, tower).

lineOfSight(camp, yard).
lineOfSight(yard, camp).
lineOfSight(yard, lawn).
lineOfSight(lawn, yard).
lineOfSight(lawn, gatehouse).
lineOfSight(gatehouse, lawn).
lineOfSight(lawn, tower).
lineOfSight(tower, lawn).
lineOfSight(tower, gatehouse).
lineOfSight(gatehouse, tower).
lineOfSight(gatehouse, road).
lineOfSight(road, gatehouse).

% The route, for leaps over the briars (passage).
progress(camp, 0).
progress(yard, 1).
progress(lawn, 2).
progress(tower, 3).
progress(gatehouse, 3).
progress(road, 4).

% === Features ===
feature(gatehouse, trapdoor, chasm).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 4).
mana(mage, 4).

% === The envoy: never casts; walks when the way is clear ===
role(envoy, ward).
at(envoy, camp).
tag(envoy, living).
mustSurvive(envoy).

% === Things ===
role(crate, object).
at(crate, yard).
tag(crate, filler).

role(statue, object).
at(statue, lawn).
tag(statue, heavy).

role(sentry, enemy).
at(sentry, gatehouse).
tag(sentry, living).
tag(sentry, heavy).
blocker(sentry).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, fireball).
knows(mage, taunt).

% === Victory: the envoy stands on the road, whole ===
win :- if(), do(crossBriars, clearGate(sentry), bringOut(envoy, road)).

% The briars: bridged by the crate - knocked in from the yard side, or
% dragged across by someone who leapt over first.
crossBriars :- if(bridgedGap(yard, lawn)), do().
crossBriars :-
    if(not(bridgedGap(yard, lawn))), do(bridge(yard, lawn), confirmBridged(yard, lawn)).
crossBriars :-
    if(not(bridgedGap(yard, lawn)), canAct(?a)),
    do(reach(?a, lawn), bridge(yard, lawn), confirmBridged(yard, lawn)).

% The gatehouse: the sentry dropped through its trapdoor, or lured to the
% tower, off the road.
clearGate(?e) :- if(neutralized(?e)), do().
clearGate(?e) :- if(not(neutralized(?e))), do(intoThePit(?e)).
clearGate(?e) :- if(not(neutralized(?e))), do(bringTo(?e, tower, none), confirmAt(?e, tower)).
confirmAt(?e, ?r) :- if(at(?e, ?r)), do().

% The envoy walks out, and must arrive whole.
bringOut(?v, ?r) :- if(), do(walkTo(?v, ?r), confirmSafe(?v, ?r)).
confirmSafe(?v, ?r) :- if(at(?v, ?r), not(gone(?v))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(fireball).
comboPool(shieldBash).
comboPool(tidalWave).
comboPool(hook).
comboPool(taunt).
comboPool(turnToMist).
comboMinWins(4).
comboMinMethods(3).

goals(win).
