% The Envoy (escort, protect, rescue)
%
% An envoy who cannot fight must reach the gate road. Between the yard and
% the lawn lie briars: the companions wade through them, but the envoy
% would never come out. Past the lawn, an armoured sentry (heavy) on a
% tower watches the gatehouse: nobody walks through it under its eyes.
%
%   camp --- yard (crate) --- briars --- lawn --- gatehouse --- exit
%                                          |        (watched)
%                                        tower (sentry) --- moat (chasm)
%
% Obstacles, and the answers to each:
%   the briars    fill them with the crate: wash it in from the camp (tidal
%                 wave), blast it in (fireball from the camp), suck it in
%                 (vortex on the briars), or hook it across them from the
%                 lawn. Nothing carries the envoy over.
%   the sentry    blind it (blinding flash from the lawn), stun it (shield
%                 bash), freeze it (a tidal wave from the lawn soaks it, a
%                 blizzard on the tower chills it), or drop it: turn it to
%                 mist, and in that moment wash it (tidal wave), blast it
%                 (fireball) or suck it (vortex on the moat) into the moat.
% Then the envoy walks out on its own.
%
% Traps:
%   - hooking the envoy across the lawn drops it in the briars: a pull
%     falls into the first live hazard on the way;
%   - a push on the heavy sentry does nothing; a hook on it drags the
%     caster up the tower instead. Mist lasts one cast: the push must be
%     the very next one;
%   - one companion cannot do both halves: the soaker spends its mana on
%     the crate and the sentry, and the blizzard is somebody else's.

% === Regions ===
region(camp).
region(yard).
region(briars).
region(lawn).
region(gatehouse).
region(exit).
region(tower).
region(moat).
connected(camp, yard).
connected(yard, camp).
connected(yard, briars).
connected(briars, yard).
connected(briars, lawn).
connected(lawn, briars).
connected(lawn, gatehouse).
connected(gatehouse, lawn).
connected(gatehouse, exit).
connected(exit, gatehouse).
connected(lawn, tower).
connected(tower, lawn).
connected(tower, moat).
connected(moat, tower).

lineOfSight(camp, yard).
lineOfSight(camp, briars).
lineOfSight(camp, lawn).
lineOfSight(yard, camp).
lineOfSight(yard, lawn).
lineOfSight(lawn, yard).
lineOfSight(lawn, camp).
lineOfSight(lawn, tower).
lineOfSight(lawn, moat).
lineOfSight(lawn, gatehouse).
lineOfSight(tower, lawn).
lineOfSight(tower, gatehouse).
lineOfSight(gatehouse, exit).

% Push lines (and what lies between).
beyond(camp, yard, briars).
beyond(lawn, briars, yard).
beyond(lawn, briars, camp).
beyond(lawn, tower, moat).

% === Terrain ===
% Briars: a hazard only the envoy (and the crate, which sinks in and fills
% them) are weak to.
onEnter(briars, thorns).
effect(thorns, target, hazard(thorns)).
weakness(envoy, thorns, none, fell).
weakness(crate, thorns, none, fell).
onEnter(moat, chasm).
watches(sentry, gatehouse).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 4).
mana(mage, 4).

% === The envoy: never casts; walks when the way is clear ===
role(envoy, ward).
at(envoy, camp).
tag(envoy, living).
mustSurvive(envoy).

% === Things ===
role(crate, object).
at(crate, yard).
tag(crate, filler).

role(sentry, enemy).
at(sentry, tower).
tag(sentry, living).
tag(sentry, heavy).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, blindingFlash).

% === Victory: the envoy stands at the exit, whole ===
win :- if(), do(crossBriars, passSentry(sentry), bringOut(envoy, exit)).

% The briars: already filled, or the crate goes in (pushed, sucked or dragged).
crossBriars :- if(filled(briars)), do().
crossBriars :- if(not(filled(briars))), do(span(briars), confirmFilled(briars)).

% The sentry: blind or gone already; blinded (a stun blinds too); frozen
% or shocked stiff - soaked by one companion, iced or jolted by the other;
% or dropped from its tower.
watching(?g) :- watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)).
passSentry(?g) :- if(not(watching(?g))), do().
passSentry(?g) :- if(watching(?g)), do(inflict(blinded, ?g, none), confirmQuiet(?g)).
passSentry(?g) :-
    if(watching(?g), supplier(?p, wet, ?g), \==(?p, none)),
    do(supply(?p, wet, ?g), stiffen(?g, ?p), confirmQuiet(?g)).
passSentry(?g) :- if(watching(?g)), do(neutralize(?g)).
stiffen(?g, ?p) :- if(), do(inflict(chilled, ?g, ?p)).
stiffen(?g, ?p) :- if(), do(inflict(electrocuted, ?g, ?p)).
confirmQuiet(?g) :- if(not(watching(?g))), do().

% The envoy walks out, and must arrive whole.
bringOut(?v, ?r) :- if(), do(walkTo(?v, ?r), confirmSafe(?v, ?r)).
% ... and nobody was lost on the way.
confirmSafe(?v, ?r) :- if(at(?v, ?r), not(gone(?v)), not(first(and(canAct(?a), gone(?a))))), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from eight (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(fireball).
comboPool(hook).
comboPool(vortex).
comboPool(blindingFlash).
comboPool(shieldBash).
comboPool(blizzard).
comboPool(turnToMist).
comboMinWins(4).
comboMinMethods(3).

goals(win).
