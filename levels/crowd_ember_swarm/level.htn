% Ember Swarm (ability catalogue, crowd control)
%
% Three ember beetles swarm in a nest below the gate, still aflame. They are
% insects: the cold kills them - but not while they burn. A chill on a
% burning beetle only quenches the fire (the catalogue's `quench`), and a
% region ices over only once. So the whole swarm has to be doused first,
% then frozen: two steps, two companions.
%
%   camp (player, mage) --- gate --- nest (b1, b2, b3) --- ice cave (iceSheet)
%                                     |
%                                   brook (deepWater)
%
% The gate overlooks the nest, the brook and the ice cave; the brook and the
% ice cave each see the nest, not each other.
%
% Two companions, one skill each, from six. Each has mana for one wave,
% blizzard or fireball.
%
% Obstacles:
%   - the beetles burn: the first cold only quenches them;
%   - each region ices once: a second chill on the nest does nothing;
%   - a vortex pins what it gathers (rooted wards forced movement here), so
%     nothing fetches the swarm back out of the ice, or the brook, for a
%     second go;
%   - a wet beetle chilled only freezes (stunned), it does not die: the
%     douse must leave it dry (fire and water cancel out, and so do fire and
%     cold).
%
% Methods (douse the whole swarm, then freeze the whole swarm):
%   douse in place      tidalWave from the nest (the fires go out)
%   douse by cold       blizzard on the nest (quenched; the nest is iced now
%                       and will not chill again)
%   douse in the brook  vortex on the brook: the swarm is sucked into the
%                       water and pinned there
%   freeze in place     blizzard on the doused swarm: on the nest, or on the
%                       brook, whose water ices into a floor
%   drag into the ice   vortex on the ice cave (the whole nest), or taunt /
%                       hook from inside it (one at a time)
% So blizzard and vortex each play both halves, in different plans.
%
% Traps:
%   - cold twice: the first quenches, the second finds the nest iced;
%   - a vortex into the ice first: the swarm is quenched and pinned there;
%   - two waves: the second soaks the doused swarm, and wet beetles only
%     freeze (stunned) instead of dying of the cold;
%   - dragging the beetles into the brook yourself (taunt, hook): the
%     blizzard that freezes them freezes you too, and the ice cave cannot
%     see the brook;
%   - fireball: it relights the nest, and its push throws nobody anywhere
%     useful.

% === Regions ===
region(camp).
region(gate).
region(nest).
region(icecave).
region(brook).
connected(camp, gate).
connected(gate, camp).
connected(gate, nest).
connected(nest, gate).
connected(nest, icecave).
connected(icecave, nest).
connected(nest, brook).
connected(brook, nest).
lineOfSight(gate, nest).
lineOfSight(gate, icecave).
lineOfSight(gate, brook).
lineOfSight(icecave, nest).
lineOfSight(brook, nest).

onEnter(icecave, iceSheet).
onEnter(brook, deepWater).

% A vortex pins what it gathers: rooted things cannot be dragged away.
wards(rooted, forcedMove).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).

% === The swarm ===
role(b1, enemy).
role(b2, enemy).
role(b3, enemy).
at(b1, nest).
at(b2, nest).
at(b3, nest).
tag(b1, insect).
tag(b2, insect).
tag(b3, insect).
tag(b1, burning).
tag(b2, burning).
tag(b3, burning).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, vortex).

% === The swarm, as a group ===
% The need: every beetle out of the fight. The cold kills an insect, but a
% chill on a burning one only quenches it: douse the whole swarm, then
% freeze the whole swarm.

standing(?e) :- role(?e, enemy), not(neutralized(?e)).
aflame(?e) :- standing(?e), holds(?e, burning).
% What puts a fire out: a tag that burning reacts to by going out.
dousedBy(?t) :- reaction(burning, ?t, ?ab), effect(?ab, target, remove(burning)).
% What kills ?e outright.
lethal(?e, ?t) :- weakness(?e, ?t, none, dead).

win :- if(), do(rout).

rout :- if(), do(douseAll, freezeAll, teamFit).

% Nobody on the team is left frozen by a friend's blizzard.
teamFit :- if(not(first(and(canAct(?a), tag(?a, stunned))))), do().

% Every beetle's fire out: take the first that burns, and put out its fire.
douseAll :- if(not(first(aflame(?e)))), do().
douseAll :-
    if(first(aflame(?e)), dousedBy(?t)),
    do(lay(?t, ?e), ensureOut(?e), douseAll).

ensureOut(?e) :- if(not(holds(?e, burning))), do().

% Every beetle frozen: take the first still standing, and chill it.
freezeAll :- if(not(first(standing(?e)))), do().
freezeAll :-
    if(first(standing(?e)), lethal(?e, ?t)),
    do(lay(?t, ?e), confirmStopped(?e), freezeAll).

% ?e takes ?t: a skill that gives ?t, cast on it (or on everyone around it);
% a pull-in or a push into a region that gives ?t; or a drag into such a
% region by someone standing in it.
lay(?t, ?e) :- if(canInflict(?a, ?ab, ?t, ?e)), do(cast(?a, ?ab, ?e)).
lay(?t, ?e) :-
    if(zoneFor(?r, ?t), placement(?a, ?ab, ?from, ?aim, ?e, ?r)),
    do(castFrom(?a, ?ab, ?aim, ?from)).
lay(?t, ?e) :-
    if(zoneFor(?r, ?t), at(?e, ?er), \==(?er, ?r), puller(?a, ?ab, ?e), reach(?ab, ?k),
       inRange(?k, ?r, ?er), canReachNow(?a, ?r)),
    do(castFrom(?a, ?ab, ?e, ?r)).

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(blizzard).
comboPool(vortex).
comboPool(taunt).
comboPool(hook).
comboPool(fireball).
comboMinWins(8).
comboMinMethods(4).

goals(win).
