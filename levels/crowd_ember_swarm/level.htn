% Ember Swarm (ability catalogue, crowd control)
%
% Three ember beetles swarm in a nest at the bottom of a ravine, still
% aflame. They are insects: the cold kills them - but not while they burn. A
% chill on a burning beetle only quenches it (the catalogue's `quench`), an
% area ices over only once, and a wet beetle chilled only freezes (stunned)
% instead of dying. So the whole swarm has to be doused and left dry first,
% then chilled: two steps, two companions.
%
%   camp (player, mage) --- ridge (frostVent) --- ford (puddle) --- nest (spring; b1 b2 b3)
%
% Four areas in a line, all walkable. The ford is shallow water: whoever
% wades through it is soaked. Features: a spring in the nest (a pool: wet)
% and a frost vent on the ridge (a crevasse breathing cold: slowed and
% chilled, whoever is knocked into it). The ridge overlooks the ford and the
% nest; the camp sees the ridge.
%
% Two companions, one skill each, from six. Each has mana for one wave or
% one blizzard.
%
% Obstacles:
%   - the beetles burn: the first cold only quenches them;
%   - the nest ices once: a second blizzard there does nothing;
%   - the cold that kills is on the ridge (the vent) or wherever a blizzard
%     falls; the swarm is in the nest, and only a taunt (it walks after you,
%     through the ford) or a hook (one area at a time) moves it;
%   - a beetle soaked after its fire is out stays wet, and a wet beetle
%     chilled only freezes.
%
% Methods (douse the whole swarm, then chill the whole swarm):
%   douse   tidalWave in the nest (all soaked, the fires go out);
%           vortex on the spring (the whole swarm knocked into the water);
%           shieldBash each beetle into the spring;
%           herd them through the ford: taunt (they walk after you) or hook
%           (pull each into the ford)
%   chill   blizzard on wherever the doused swarm stands (the nest, or the
%           ford - its water ices over);
%           bring the swarm up to the ridge (taunted, it follows you; or
%           hooked out of the ford) and knock it into the frost vent: vortex
%           (the whole crowd at once) or shieldBash (one at a time)
% So vortex and shieldBash each play both halves, in different plans, and
% taunt and hook herd the crowd through the water and up to the vent.
%
% Traps:
%   - cold first: blizzard on the burning nest only quenches it, and the
%     nest ices once - the swarm cannot be chilled there again, and leaving
%     it means wading the ford (wet: they would only freeze);
%   - a wave after the douse, or a herd through the ford after it: the
%     beetles are wet, and wet beetles only freeze;
%   - a wave on the ridge to throw the swarm into the vent: it soaks them
%     first;
%   - two movers, two knocks, two waves: nothing chills without a blizzard
%     or the vent;
%   - whoever waded the ford is wet: the vortex that throws the swarm into
%     the vent throws the herder in too, and freezes it (a sacrifice, not a
%     failure - unless it still had work to do).

% === Areas ===
region(camp).
region(ridge).
region(ford).
region(nest).
connected(camp, ridge).
connected(ridge, ford).
connected(ford, nest).
lineOfSight(camp, ridge).
lineOfSight(ridge, ford).
lineOfSight(ridge, nest).
lineOfSight(ford, nest).
lineOfSight(ford, ridge).
lineOfSight(nest, ford).

onEnter(ford, puddle).

% Features: the spring soaks, the vent chills whatever is knocked in.
feature(nest, spring, puddle).
feature(ridge, frostVent, iceSheet).

% === Companions ===
role(player, player).
role(mage, companion).
at(player, camp).
at(mage, camp).
mana(player, 2).
mana(mage, 2).

% === The swarm ===
role(b1, enemy).
role(b2, enemy).
role(b3, enemy).
at(b1, nest).
at(b2, nest).
at(b3, nest).
tag(b1, insect).
tag(b2, insect).
tag(b3, insect).
tag(b1, burning).
tag(b2, burning).
tag(b3, burning).

% === Default kit: one skill each (combos replans the whole matrix) ===
knows(player, tidalWave).
knows(mage, blizzard).

% === The swarm, as a group ===
% The need: every beetle out of the fight. The cold kills an insect, but a
% chill on a burning one only quenches it: douse the whole swarm, then
% chill the whole swarm.

standing(?e) :- role(?e, enemy), not(neutralized(?e)).
aflame(?e) :- standing(?e), holds(?e, burning).
% What puts a fire out: a tag that burning reacts to by going out.
dousedBy(?t) :- reaction(burning, ?t, ?ab), effect(?ab, target, remove(burning)).
% What kills ?e outright.
lethal(?e, ?t) :- weakness(?e, ?t, none, dead).

win :- if(), do(douseAll, freezeAll).

% Every beetle's fire out: take the first that burns, and put out its fire.
douseAll :- if(not(first(aflame(?e)))), do().
douseAll :-
    if(first(aflame(?e)), dousedBy(?t)),
    do(lay(?t, ?e), ensureOut(?e), douseAll).

ensureOut(?e) :- if(not(holds(?e, burning))), do().

% Every beetle dead: take the first still standing, and lay on it what it is
% lethally weak to.
freezeAll :- if(not(first(standing(?e)))), do().
freezeAll :-
    if(first(standing(?e)), lethal(?e, ?t)),
    do(lay(?t, ?e), confirmStopped(?e), freezeAll).

% ?e takes ?t: a skill that gives ?t, cast on it (or its area, or everyone
% around the caster); brought into an area whose zone gives ?t; or the whole
% swarm brought to a feature that gives ?t, and ?e knocked into it.
lay(?t, ?e) :- if(canInflict(?a, ?ab, ?t, ?e)), do(cast(?a, ?ab, ?e)).
lay(?t, ?e) :-
    if(zoneFor(?r, ?t), not(at(?e, ?r))), do(herd(?e, ?r)).
lay(?t, ?e) :-
    if(featureFor(?f, ?t), feature(?r, ?f, ?ab)),
    do(herdSwarm(?r), knockOn(?e, feature(?f), none)).

% Every standing beetle in ?r: take the first that is not, and bring it.
herdSwarm(?r) :- if(not(first(and(standing(?x), not(at(?x, ?r)))))), do().
herdSwarm(?r) :-
    if(first(and(standing(?x), not(at(?x, ?r))))), do(herd(?x, ?r), herdSwarm(?r)).

% ?e ends up in ?r: it is there; it follows its taunter, who walks there; or
% a hook or a taunt brings it.
herd(?e, ?r) :- if(at(?e, ?r)), do().
herd(?e, ?r) :-
    if(not(at(?e, ?r)), follows(?e, ?a), tag(?e, taunted), canAct(?a)),
    do(walkTo(?a, ?r), ensureAt(?e, ?r)).
herd(?e, ?r) :-
    if(not(at(?e, ?r)), not(first(and(follows(?e, ?x), tag(?e, taunted))))),
    do(bringTo(?e, ?r, none), ensureAt(?e, ?r)).

ensureAt(?e, ?r) :- if(at(?e, ?r)), do().

funExpect(single_actor_plans, atMost, 0).

% === Choice: one skill each, from six (htn_components combos) ===
comboSeat(player, 1).
comboSeat(mage, 1).
comboPool(tidalWave).
comboPool(blizzard).
comboPool(vortex).
comboPool(taunt).
comboPool(hook).
comboPool(shieldBash).
comboMinWins(12).
comboMinMethods(6).

goals(win).
