% CombosLevelData: two companions defeat an enemy through its weakness, a location combo.
% The combos are facts at the bottom (locationCombo, comboSpreads). Goals to try are at the bottom.

% =============================================================================
% Goal: a menu of strategies, one plan per strategy that works
% =============================================================================

defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(defeatWithCombo(?t)).

% =============================================================================
% Strategies: if() says what makes it possible, do() lists the states to reach
% =============================================================================

% The enemy's weakness is a location combo: a lurer brings it onto a location that gives the
% location tag, then a second companion lands the skill tag.
defeatWithCombo(?t) :-
    if(enemy(?t), vulnerableToLocationCombo(?t, ?locationTag, ?skillTag), locationCanApplyTag(?location, ?locationTag),
       companion(?lurer), companion(?caster), \==(?lurer, ?caster)),
    do(bringEnemyTo(?lurer, ?t, ?location), applyTag(?caster, ?skillTag, ?t)).

% =============================================================================
% Verbs: each method is one way to reach the state
% =============================================================================

% ?t has ?tag, by ?a's doing: already, with a skill that applies it, or lured onto a location that gives it.
applyTag(?a, ?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
applyTag(?a, ?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag)), skillAppliesTag(?s, ?tag)),
    do(prepareToUseSkill(?a, ?s, ?t), useSkillOnTarget(?a, ?s, ?t)).
applyTag(?a, ?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag)), locationCanApplyTag(?l, ?tag), not(at(?t, ?l))),
    do(bringEnemyTo(?a, ?t, ?l)).

% ?a holds ?s and stands with ?t: already has it, or gets it from an object first.
prepareToUseSkill(?a, ?s, ?t) :- if(hasSkill(?a, ?s)), do(goToSameLocation(?a, ?t)).
prepareToUseSkill(?a, ?s, ?t) :- if(companion(?a), not(hasSkill(?a, ?s)), object(?o), canGetSkillFrom(?o, ?s)),
    do(goToSameLocation(?a, ?o), getSkillFrom(?a, ?o, ?s), goToSameLocation(?a, ?t)).

% ?a, standing at object ?o, learns ?s; it replaces their current skill, if any.
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), hasSkill(?a, ?old)), do(opSwapSkill(?a, ?old, ?s)).
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), not(hasSkill(?a, ?any))), do(opGetSkill(?a, ?s)).

% ?a, holding ?s and standing with ?t, uses it; each of its tags lands on ?t.
useSkillOnTarget(?a, ?s, ?t) :- if(hasSkill(?a, ?s), at(?a, ?l), at(?t, ?l)), do(opUseSkill(?a, ?s, ?t), applySkillTags(?s, ?t)).

applySkillTags(?s, ?t) :- allOf, if(skillAppliesTag(?s, ?tag)), do(landSkillTag(?tag, ?t)).
applySkillTags(?s, ?t) :- if(not(skillAppliesTag(?s, ?tag))), do().

% A skill's tag lands on ?t, and combines with the location tag ?t carries.
% A spreading combo where ?t stands (wet + electrified in water, oil + burning on oil): everyone there; the vulnerable are defeated.
landSkillTag(?tag, ?t) :- if(at(?t, ?l), locationCanApplyTag(?l, ?locationTag), hasTag(?t, ?locationTag),
       locationCombo(?locationTag, ?tag, ?result), comboSpreads(?locationTag, ?tag, ?becomes)),
    do(changeLocationTag(?l, ?locationTag, ?becomes), tagEveryoneAt(?result, ?l), defeatVulnerableAt(?locationTag, ?tag, ?l)).
% Any other combo (wet + electrified out of the water, chilled on a wet or iced ?t): ?t alone; if vulnerable, defeated.
landSkillTag(?tag, ?t) :- if(not(at(?t, ?l), locationCanApplyTag(?l, ?here), hasTag(?t, ?here), locationCombo(?here, ?tag, ?any), comboSpreads(?here, ?tag, ?becomes)),
       first(hasTag(?t, ?locationTag), locationCombo(?locationTag, ?tag, ?result))),
    do(landTag(?result, ?t), defeatVulnerable(?t, ?locationTag, ?tag)).
% No combo on ?t: the tag just lands.
landSkillTag(?tag, ?t) :- if(not(hasTag(?t, ?locationTag), locationCombo(?locationTag, ?tag, ?result))),
    do(landTag(?tag, ?t)).

% ?l's tag ?old becomes ?new: it stays (water), it changes (the oil catches fire), or ?l had ?new already.
changeLocationTag(?l, ?old, ?new) :- if(==(?old, ?new)), do().
changeLocationTag(?l, ?old, ?new) :- if(\==(?old, ?new), locationCanApplyTag(?l, ?old), not(locationCanApplyTag(?l, ?new))),
    do(opRemoveLocationTag(?old, ?l), opAddLocationTag(?new, ?l)).
changeLocationTag(?l, ?old, ?new) :- if(\==(?old, ?new), locationCanApplyTag(?l, ?old), locationCanApplyTag(?l, ?new)),
    do(opRemoveLocationTag(?old, ?l)).

% ?t has ?tag, unless it is immune.
landTag(?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag))), do(opApplyTag(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), immune(?t, ?tag)), do().

% ?x, arriving at ?l, gets the location's tag, if it has one, with its combo (oil walking into fire).
landLocationTag(?x, ?l) :- if(locationCanApplyTag(?l, ?tag)), do(landSkillTag(?tag, ?x)).
landLocationTag(?x, ?l) :- if(not(locationCanApplyTag(?l, ?tag))), do().

% Every agent at ?l gets ?tag: companions, neutrals and enemies alike.
tagEveryoneAt(?tag, ?l) :- allOf, if(agent(?a), at(?a, ?l)), do(landTag(?tag, ?a)).
tagEveryoneAt(?tag, ?l) :- if(not(agent(?a), at(?a, ?l))), do().

% An enemy vulnerable to this location combo is out of the fight.
defeatVulnerable(?e, ?base, ?tag) :- if(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead))), do(opApplyTag(dead, ?e)).
defeatVulnerable(?e, ?base, ?tag) :- if(not(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead)))), do().

defeatVulnerableAt(?base, ?tag, ?l) :- allOf, if(enemy(?e), at(?e, ?l)), do(defeatVulnerable(?e, ?base, ?tag)).
defeatVulnerableAt(?base, ?tag, ?l) :- if(not(enemy(?e), at(?e, ?l))), do().

% ?a stands where ?t is.
goToSameLocation(?a, ?t) :- if(at(?t, ?l)), do(goToLocation(?a, ?l)).

% ?a is at ?l and has its tag; the engine finds the path. Living enemies after ?a follow.
goToLocation(?a, ?l) :- if(at(?a, ?l)), do(opStayInLocation(?a)).
goToLocation(?a, ?l) :- if(location(?l), at(?a, ?from), \==(?from, ?l)),
    do(opMoveTo(?a, ?from, ?l), landLocationTag(?a, ?l), enemiesFollow(?a, ?from, ?l)).

enemiesFollow(?a, ?from, ?l) :- allOf, if(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead))),
    do(opAggroMoveTo(?e, ?from, ?l), landLocationTag(?e, ?l)).
enemiesFollow(?a, ?from, ?l) :- if(not(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead)))), do().

% ?e is after ?a: already, instead of another target, or for the first time.
getAggro(?e, ?a) :- if(hasAggro(?e, ?a)), do(opTargetAlreadyAggroed(?e, ?a)).
getAggro(?e, ?a) :- if(hasAggro(?e, ?old), \==(?old, ?a)), do(opRemoveAggro(?e, ?old), opAggro(?e, ?a)).
getAggro(?e, ?a) :- if(not(hasAggro(?e, ?any))), do(opAggro(?e, ?a)).

% Enemy ?e is at ?l: the lurer walks to it, takes its aggro, and walks to ?l.
bringEnemyTo(?lurer, ?e, ?l) :- if(at(?e, ?l)), do(opEnemyAlreadyAtLocation(?e, ?l)).
bringEnemyTo(?lurer, ?e, ?l) :- if(enemy(?e), not(static(?e)), not(at(?e, ?l))),
    do(goToSameLocation(?lurer, ?e), getAggro(?e, ?lurer), goToLocation(?lurer, ?l)).

% ?d is not locked: already, or two companions stand on its two plates together.
unlockDoor(?d) :- if(not(locked(?d))), do(opDoorAlreadyUnlocked(?d)).
unlockDoor(?d) :- if(locked(?d), first(plateOpens(?p1, ?d), plateOpens(?p2, ?d), \==(?p1, ?p2)), at(?p1, ?l1), at(?p2, ?l2),
       companion(?a1), companion(?a2), \==(?a1, ?a2)),
    do(goToLocation(?a1, ?l1), goToLocation(?a2, ?l2), opSynchronizeOnPlates(?a1, ?a2, ?p1, ?p2), opUnlock(?d)).

% =============================================================================
% Operators: game actions
% =============================================================================

opMoveTo(?who, ?from, ?to) :- del(at(?who, ?from)), add(at(?who, ?to)).
opAggroMoveTo(?e, ?from, ?to) :- del(at(?e, ?from)), add(at(?e, ?to)).
opUseSkill(?a, ?s, ?t) :- del(), add().
opSynchronizeOnPlates(?a1, ?a2, ?p1, ?p2) :- del(), add().
opApplyTag(?tag, ?t) :- del(), add(hasTag(?t, ?tag)).
opAddLocationTag(?tag, ?l) :- del(), add(locationCanApplyTag(?l, ?tag)).
opRemoveLocationTag(?tag, ?l) :- del(locationCanApplyTag(?l, ?tag)), add().
opAggro(?e, ?a) :- del(), add(hasAggro(?e, ?a)).
opRemoveAggro(?e, ?a) :- del(hasAggro(?e, ?a)), add().
opGetSkill(?a, ?s) :- del(), add(hasSkill(?a, ?s)).
opSwapSkill(?a, ?old, ?s) :- del(hasSkill(?a, ?old)), add(hasSkill(?a, ?s)).
opUnlock(?d) :- del(locked(?d)), add().

% Already true: no state change, the plan shows it.
opStayInLocation(?a) :- del(), add().
opTagAlreadyOnTarget(?tag, ?t) :- del(), add().
opTargetAlreadyAggroed(?e, ?a) :- del(), add().
opEnemyAlreadyAtLocation(?e, ?l) :- del(), add().
opDoorAlreadyUnlocked(?d) :- del(), add().

% =============================================================================
% The physics: what each location tag and skill tag do together
% =============================================================================

agent(?x) :- companion(?x).
agent(?x) :- neutral(?x).
agent(?x) :- enemy(?x).

% A target with the location tag, hit by the skill tag, gets the result.
locationCombo(wet, electrified, electrified).
locationCombo(oil, burning, burning).
locationCombo(wet, chilled, stunned).
locationCombo(ice, chilled, stunned).
% On a location with the location tag, the combo reaches everyone there, and the location's tag becomes the third.
comboSpreads(wet, electrified, wet).
comboSpreads(oil, burning, burning).

% =============================================================================
% World: three companions, a hideout behind a gate, water, oil and ice
% =============================================================================
%
%            lake (wet) --- camp --- kitchen (oil)
%                            |
%   tower --- rink (ice) --- yard --[gate]-- hideout
%
% The gate opens when two companions stand on its two plates together.

companion(player). companion(pyro). companion(frost).
enemy(gob). enemy(imp). enemy(turret).
neutral(fisher).
object(altar).

location(camp). location(lake). location(kitchen). location(yard). location(rink).
location(tower). location(hideout).

linked(camp, lake). linked(lake, camp).
linked(camp, kitchen). linked(kitchen, camp).
linked(camp, yard). linked(yard, camp).
linked(yard, rink). linked(rink, yard).
linked(rink, tower). linked(tower, rink).
linked(yard, hideout). linked(hideout, yard).
blockedLink(yard, hideout, door(gate)). blockedLink(hideout, yard, door(gate)).
locked(gate).
plateOpens(westPlate, gate). plateOpens(eastPlate, gate).
at(westPlate, yard). at(eastPlate, rink).

locationCanApplyTag(lake, wet).
locationCanApplyTag(kitchen, oil).
locationCanApplyTag(rink, ice).

at(player, camp). at(pyro, camp). at(frost, camp).
at(gob, hideout). at(imp, hideout).
at(turret, lake). at(fisher, lake).
at(altar, tower).
% Agents that start on a tagged location have its tag.
hasTag(turret, wet). hasTag(fisher, wet).

% Skills: each companion holds one; the altar grants a spark skill.
hasSkill(player, iceBlastSkill). skillAppliesTag(iceBlastSkill, stunned).
hasSkill(pyro, fireballSkill). skillAppliesTag(fireballSkill, burning).
hasSkill(frost, frostSkill). skillAppliesTag(frostSkill, chilled).
skillAppliesTag(sparkSkill, electrified).
canGetSkillFrom(altar, sparkSkill).

% gob falls to chilling in water or on ice, and to burning on oil.
vulnerableToLocationCombo(gob, wet, chilled).
vulnerableToLocationCombo(gob, ice, chilled).
vulnerableToLocationCombo(gob, oil, burning).
% imp falls only to electricity in water, and can't be stunned.
vulnerableToLocationCombo(imp, wet, electrified).
immune(imp, stunned).
% The turret never moves; it sits in the lake, so one spark is enough.
static(turret).
vulnerableToLocationCombo(turret, wet, electrified).

goals(defeat(gob)).
% Goals to try:
%   defeat(gob).                 one plan per weakness, location and pair of companions
%   defeat(imp).                 only wet + electrified; the spark also takes out the turret
%   defeat(turret).              already in the lake: the lurer has nothing to do, the caster brings the spark
%   unlockDoor(gate).            two companions on the two plates
%   applyTag(player, oil, gob).  the lurer brings gob onto the oil
