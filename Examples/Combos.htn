% Combos: every way the allies can take an enemy out of the fight.

% =============================================================================
% Goal: a menu of strategies, one plan per strategy that works
% =============================================================================

defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(wetAndElectrocute(?t), opApplyTag(dead, ?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(stunAndSlow(?t), opApplyTag(dead, ?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(oilAndFire(?t), opApplyTag(dead, ?t)).

% =============================================================================
% Strategies: if() says what makes it possible, do() lists the states to reach
% =============================================================================

% Wet, then electrocuted.
wetAndElectrocute(?t) :-
    if(enemy(?t), not(immune(?t, wet)), not(immune(?t, electrocute))),
    do(applyTag(wet, ?t), applyTag(electrocute, ?t)).

% Stunned and, at the same moment, hit by a second ally's slow skill.
stunAndSlow(?t) :-
    if(enemy(?t), not(immune(?t, stun)),
       skillAppliesTag(?stun, stun), skillHasTag(?slow, slow),
       ally(?a1), ally(?a2), \==(?a1, ?a2)),
    do(prepareToUseSkill(?a1, ?stun, ?t), prepareToUseSkill(?a2, ?slow, ?t),
       opSynchronize(?a1, ?a2),
       useSkillOnTarget(?a1, ?stun, ?t), useSkillOnTarget(?a2, ?slow, ?t)).

% Oily, then set on fire.
oilAndFire(?t) :-
    if(enemy(?t), not(immune(?t, oily)), not(immune(?t, fire))),
    do(applyTag(oily, ?t), applyTag(fire, ?t)).

% =============================================================================
% Verbs: each method is one way to reach the state
% =============================================================================

% ?t has ?tag.
applyTag(?tag, ?t) :- if(hasTag(?t, ?tag)), do().
applyTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag))), do(applyTagNotPresent(?tag, ?t)).

% Way 1: an ally uses a skill that applies it.
applyTagNotPresent(?tag, ?t) :- if(ally(?a), skillAppliesTag(?s, ?tag)),
    do(prepareToUseSkill(?a, ?s, ?t), useSkillOnTarget(?a, ?s, ?t)).
% Way 2: ?t is brought to a location that applies it.
applyTagNotPresent(?tag, ?t) :- if(locationCanApplyTag(?l, ?tag)),
    do(bringMobToLocation(?t, ?l), opApplyTag(?tag, ?t)).
% Way 3: another non-ally that holds such a skill hits ?t when they meet.
applyTagNotPresent(?tag, ?t) :- if(hasSkill(?m, ?s), skillAppliesTag(?s, ?tag), not(ally(?m)), \==(?m, ?t)),
    do(bringMobsTogether(?t, ?m), useSkillOnTarget(?m, ?s, ?t)).

% ?a holds ?s and stands with ?t: already has it, or learns it first.
prepareToUseSkill(?a, ?s, ?t) :- if(hasSkill(?a, ?s)), do(goToSameLocation(?a, ?t)).
prepareToUseSkill(?a, ?s, ?t) :- if(ally(?a), not(hasSkill(?a, ?s)), canGetSkillAtLocation(?l, ?s)),
    do(goToLocation(?a, ?l), learnSkill(?a, ?s), goToSameLocation(?a, ?t)).

% Learning replaces the current skill, if any.
learnSkill(?a, ?s) :- if(hasSkill(?a, ?old)), do(opSwapSkill(?a, ?old, ?s)).
learnSkill(?a, ?s) :- if(not(hasSkill(?a, ?any))), do(opGetSkill(?a, ?s)).

% The skill is used; its tags land on ?t.
useSkillOnTarget(?a, ?s, ?t) :- if(), do(opUseSkill(?a, ?s, ?t), applySkillTags(?s, ?t)).

applySkillTags(?s, ?t) :- allOf, if(skillAppliesTag(?s, ?tag), not(hasTag(?t, ?tag)), not(immune(?t, ?tag))),
    do(opApplyTag(?tag, ?t)).
applySkillTags(?s, ?t) :- if(not(skillAppliesTag(?s, ?tag), not(hasTag(?t, ?tag)), not(immune(?t, ?tag)))),
    do().

% ?a stands where ?t is.
goToSameLocation(?a, ?t) :- if(at(?t, ?l)), do(goToLocation(?a, ?l)).

% ?a is at ?l; the engine finds the path. Enemies after ?a follow.
goToLocation(?a, ?l) :- if(at(?a, ?l)), do().
goToLocation(?a, ?l) :- if(location(?l), at(?a, ?from), \==(?from, ?l)),
    do(opMoveTo(?a, ?from, ?l), enemiesFollow(?a, ?from, ?l)).

enemiesFollow(?a, ?from, ?l) :- allOf, if(aggro(?e, ?a), at(?e, ?from), not(static(?e))), do(opMoveTo(?e, ?from, ?l)).
enemiesFollow(?a, ?from, ?l) :- if(not(aggro(?e, ?a), at(?e, ?from), not(static(?e)))), do().

% Enemy ?t is at ?l: an ally it already follows, or a new lurer, walks there.
bringMobToLocation(?t, ?l) :- if(at(?t, ?l)), do().
bringMobToLocation(?t, ?l) :- if(not(at(?t, ?l)), not(static(?t)), aggro(?t, ?a)),
    do(goToSameLocation(?a, ?t), goToLocation(?a, ?l)).
bringMobToLocation(?t, ?l) :- if(not(at(?t, ?l)), not(static(?t)), not(aggro(?t, ?any)), ally(?a)),
    do(goToSameLocation(?a, ?t), opAggro(?t, ?a), goToLocation(?a, ?l)).

% ?m1 and ?m2 share a location: whichever can move comes to the other.
bringMobsTogether(?m1, ?m2) :- if(at(?m1, ?l), at(?m2, ?l)), do().
bringMobsTogether(?m1, ?m2) :- if(not(static(?m1)), at(?m2, ?l), not(at(?m1, ?l))), do(bringMobToLocation(?m1, ?l)).
bringMobsTogether(?m1, ?m2) :- if(static(?m1), at(?m1, ?l), not(at(?m2, ?l))), do(bringMobToLocation(?m2, ?l)).

% =============================================================================
% Operators: game actions
% =============================================================================

opMoveTo(?who, ?from, ?to) :- del(at(?who, ?from)), add(at(?who, ?to)).
opUseSkill(?a, ?s, ?t) :- del(), add().
opSynchronize(?a1, ?a2) :- del(), add().
opApplyTag(?tag, ?t) :- del(), add(hasTag(?t, ?tag)).
opAggro(?t, ?a) :- del(), add(aggro(?t, ?a)).
opGetSkill(?a, ?s) :- del(), add(hasSkill(?a, ?s)).
opSwapSkill(?a, ?old, ?s) :- del(hasSkill(?a, ?old)), add(hasSkill(?a, ?s)).

% =============================================================================
% Sample world
% =============================================================================

ally(frost). ally(pyro).
enemy(gob). enemy(tower).
static(tower).

location(camp). location(hut). location(lake). location(peak). location(kitchen). location(forge).
at(frost, camp). at(pyro, camp).
at(gob, hut). at(tower, peak).

locationCanApplyTag(lake, wet).
locationCanApplyTag(kitchen, oily).

hasSkill(frost, iceBlast). skillAppliesTag(iceBlast, stun).
hasSkill(pyro, fireball). skillAppliesTag(fireball, fire). skillHasTag(fireball, slow).
hasSkill(tower, lightning). skillAppliesTag(lightning, electrocute).
canGetSkillAtLocation(forge, fireball).

goals(defeat(gob)).
