% the_slipstream - freeze the oil into sludge, get them stuck, finish them
%
% Two roles. The *primer* freezes the oil into sludge (or the sludge from an
% earlier fight is reused and nobody primes). The *pay-off* either strikes
% the snared enemy or detonates a lethal element on the sludge and takes
% everything in it - and the pay-off may not be the primer. Anyone may fill
% either role; what they hold decides. In between, whoever carries the
% shield plants it at the edge as cover (a commitment), and the enemy is
% brought in - pushed, dragged or taunted - with whoever else can be
% brought in.

theSlipstream(?e) :-
    if(role(?e, enemy), not(status(?e, dead)), first(sludgeable(?r)), trapPrimer(?r, ?p)),
    do(ensureTrap(?r, ?p), coverAt(?r), bringTo(?e, ?r), try(gatherIntoTrap(?e, ?r)),
       finishTrap(?e, ?r, ?p)).

% A region that is, or can be frozen into, snaring terrain.
snaring(?r) :- regionHas(?r, ?trap), terrain(?trap, snared).
sludgeable(?r) :- snaring(?r).
sludgeable(?r) :- regionHas(?r, ?feat), reacts(freeze, ?feat, ?trap), terrain(?trap, snared).

% Who primes: nobody if the trap already exists, else the first companion
% who can freeze. Bound up front so the pay-off can be someone else.
trapPrimer(?r, none) :- snaring(?r).
trapPrimer(?r, ?p) :- not(snaring(?r)), primer(freeze, ?p).

ensureTrap(?r, none) :- if(), do().
ensureTrap(?r, ?p) :- if(\==(?p, none)), do(prime(freeze, ?r, ?p)).

% The shield-bearer holds the first region adjoining the trap.
coverAt(?r) :-
    if(first(and(canAct(?a), signature(?a, shield))), first(connected(?edge, ?r))),
    do(holdPosition(?a, ?edge)).
coverAt(?r) :- else, if(), do().

% Every other living enemy that can be brought into the trap, is.
gatherIntoTrap(?e, ?r) :-
    allOf, if(role(?o, enemy), \==(?o, ?e), not(status(?o, dead)), not(at(?o, ?r))),
    do(bringTo(?o, ?r)).

% Finish the one, or blast the lot. Alternatives, not fallbacks. Never the
% primer.
finishTrap(?e, ?r, ?p) :- if(status(?e, snared)), do(finish(?e, ?p)).
finishTrap(?e, ?r, ?p) :- if(status(?e, snared)), do(detonateLethal(?r, ?p)).
