% core_attunement - Primer -> Detonator, two roles, two companions
%
% GDD 2: no single entity can overcome a significant challenge alone. Here
% that is a *role* rule, not an identity rule: whoever primes a region may
% not be the one who pays it off. Any companion can fill either role - the
% player character and the AI companions have the same abilities and differ
% only by who controls them - so cooperation comes from the task's shape,
% not from a fact that names the human.
%
% Every pay-off method exists in two arities: the bare form (anyone may do
% it) and a form taking `?not`, the companion excluded from the role -
% usually the primer. Strategies bind the primer first (`primer/2`) and pass
% it down.

% === Rules ===

% The first companion who can put ?el down.
primer(?el, ?a) :-
    first(and(canAct(?a), hasSkill(?a, ?skill), skillElement(?skill, ?el),
              canPay(?a, ?skill))).

% === Methods ===

% Prime: put an element on a region. Bare form picks the first companion
% who can; the named form is for a strategy that already chose the primer.
prime(?el, ?r) :- if(primer(?el, ?a)), do(applyToRegion(?a, ?el, ?r)).
prime(?el, ?r, ?a) :- if(canAct(?a)), do(applyToRegion(?a, ?el, ?r)).

% Detonate: any companion but ?not triggers the pay-off on a region.
detonate(?el, ?r) :- if(), do(detonate(?el, ?r, none)).
detonate(?el, ?r, ?not) :-
    if(canAct(?a), \==(?a, ?not)),
    do(applyToRegion(?a, ?el, ?r)).

% Detonate with whatever lethal element the pay-off holds for this terrain:
% a blast that kills the exposed enemies standing in ?r.
detonateLethal(?r) :- if(), do(detonateLethal(?r, none)).
detonateLethal(?r, ?not) :-
    if(canAct(?a), \==(?a, ?not), regionHas(?r, ?feat),
       first(and(hasSkill(?a, ?skill), skillElement(?skill, ?el),
                 blast(?el, ?feat, dead), reacts(?el, ?feat, ?new), canPay(?a, ?skill)))),
    do(applyToRegion(?a, ?el, ?r)).

% Finish: any companion but ?not strikes a vulnerable enemy with the first
% lethal element they can afford and the enemy is not immune to.
finish(?e) :- if(), do(finish(?e, none)).
finish(?e, ?not) :-
    if(canAct(?a), \==(?a, ?not), vulnerable(?e),
       first(and(hasSkill(?a, ?skill), skillElement(?skill, ?el),
                 strike(?el, ?status), not(immune(?e, ?el)), canPay(?a, ?skill)))),
    do(applyToEntity(?a, ?el, ?e)).

% Expose: make an enemy take blasts. Already exposed: nothing to do; else
% whoever holds a marking element does it (a flare in the eyes drops the
% shield).
expose(?e) :- if(exposed(?e)), do().
expose(?e) :-
    else, if(canAct(?a),
             first(and(hasSkill(?a, ?skill), skillElement(?skill, ?el),
                       mark(?el, ?status), not(immune(?e, ?el)), canPay(?a, ?skill)))),
    do(markEntity(?a, ?el, ?e)).
