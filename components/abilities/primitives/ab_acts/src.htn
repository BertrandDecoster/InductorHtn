% ab_acts - the fixed-depth acts recipes are made of
%
% The middle layer. Each act answers one need with one cast - "?e carries
% ?t", "?e is in ?r", "?e takes ?type damage" - and binds who does it at the
% leaf, as the answer. An act never recurses to create its own
% prerequisites: a recipe states every step, in order. That keeps every
% decomposition finite (Erol, Hendler & Nau: acyclic methods, bounded depth).
%
% Cooperation is a role rule, not an identity rule: every act exists in a
% form taking ?not, the companion excluded from it (the primer may not also
% pay off). Anyone can fill any role.

% === Rules ===

% What an ability puts on what it is aimed at: directly, as an atom of a
% composite it grants, on the target or on everyone around it, or through
% the zone it spills there.
aimed(target).
aimed(area).
aimed(around).
grantsAny(?ab, ?t) :- effect(?ab, ?w, grant(?t)), aimed(?w).
grantsAny(?ab, ?t) :- effect(?ab, ?w, moment(grant(?t))), aimed(?w).
grantsAny(?ab, ?t) :- effect(?ab, ?w, grant(?c)), aimed(?w), bundles(?c, ?t).
grantsAny(?ab, ?t) :- effect(?ab, target, spill(?z)), effect(?z, target, grant(?t)).
grantsAny(?ab, ?t) :- effect(?ab, target, spill(?z)), effect(?z, target, grant(?c)), bundles(?c, ?t).
grants(?ab, ?t) :- reach(?ab, ?k), first(grantsAny(?ab, ?t)).
zoneFor(?r, ?t) :- onEnter(?r, ?ab), first(grantsAny(?ab, ?t)).

% What an ability takes off: a remove, or a purge of its group.
stripsAny(?ab, ?t) :- effect(?ab, ?w, remove(?t)), aimed(?w).
stripsAny(?ab, ?t) :- effect(?ab, ?w, moment(remove(?t))), aimed(?w).
stripsAny(?ab, ?t) :- effect(?ab, ?w, purge(?g)), aimed(?w), group(?t, ?g).
strips(?ab, ?t) :- reach(?ab, ?k), first(stripsAny(?ab, ?t)).

% What an ability pops: it lands something ?t reacts to by going away (a
% flare unmasks the stealthed; any blow breaks a shield).
popsAny(?ab, ?t) :-
    effect(?ab, ?w, grant(?in)), aimed(?w), matches(?t, ?in, ?rab), effect(?rab, target, remove(?t)).
popsAny(?ab, ?t) :-
    effect(?ab, ?w, damage(?in)), aimed(?w), matches(?t, ?in, ?rab), effect(?rab, target, remove(?t)).
pops(?ab, ?t) :- reach(?ab, ?k), first(popsAny(?ab, ?t)).

% ?a can put ?t on ?e with ?ab, from where it stands or can reach.
canInflict(?a, ?ab, ?t, ?e) :-
    grants(?ab, ?t), knows(?a, ?ab), canAct(?a), ready(?a, ?ab, ?e).

% ?a can force ?e across one link, from its area into ?to, by casting ?ab
% at ?aim from ?from (an area ?a can walk to); ?how is `land` (it ends in
% ?to) or `fall` (it drops into the gap between). The ways:
%   a push aimed at ?e, from anywhere in reach but ?to itself
%   a wave around ?a, standing in ?e's area
%   a pull or hook aimed at ?e, from ?to, next door
%   a pull-in aimed at ?to, with ?e next door
%   a taunt from ?to: the NPC walks there (it lands; it never falls)
forcing(?a, ?ab, ?from, ?e, ?e, ?to, ?how) :-
    receptive(?e, forcedMove), at(?e, ?over), forcedStep(?e, ?over, ?to, ?how),
    knows(?a, ?ab), effect(?ab, target, push), canAct(?a), \==(?a, ?e), ready(?a, ?ab, ?e),
    reach(?ab, ?k), \==(?k, self), first(and(spot(?a, ?ab, ?over, ?from), \==(?from, ?to))).
forcing(?a, ?ab, ?over, ?a, ?e, ?to, ?how) :-
    receptive(?e, forcedMove), at(?e, ?over), forcedStep(?e, ?over, ?to, ?how),
    knows(?a, ?ab), reach(?ab, self), effect(?ab, around, push), canAct(?a), \==(?a, ?e),
    ready(?a, ?ab, ?a), canReachNow(?a, ?over).
forcing(?a, ?ab, ?to, ?e, ?e, ?to, ?how) :-
    receptive(?e, forcedMove), at(?e, ?over), forcedStep(?e, ?over, ?to, ?how),
    knows(?a, ?ab), pullsAny(?ab), canAct(?a), \==(?a, ?e), ready(?a, ?ab, ?e),
    reach(?ab, ?k), inRange(?k, ?to, ?over), canReachNow(?a, ?to).
forcing(?a, ?ab, ?from, ?to, ?e, ?to, ?how) :-
    receptive(?e, forcedMove), at(?e, ?over), forcedStep(?e, ?over, ?to, ?how),
    knows(?a, ?ab), effect(?ab, target, pullIn), canAct(?a), \==(?a, ?e), ready(?a, ?ab, ?to),
    first(spot(?a, ?ab, ?to, ?from)).
forcing(?a, ?ab, ?to, ?e, ?e, ?to, land) :-
    at(?e, ?over), \==(?over, ?to), knows(?a, ?ab), effect(?ab, target, grant(?t)),
    onGrant(?t, chase), canAct(?a), \==(?a, ?e), canReceive(?e, ?t), ready(?a, ?ab, ?e),
    canReach(?e, ?over, ?to), reach(?ab, ?k), inRange(?k, ?to, ?over), canReachNow(?a, ?to).

% ?e ends in ?r; ?e drops into a gap next to it.
placement(?a, ?ab, ?from, ?aim, ?e, ?r) :- forcing(?a, ?ab, ?from, ?aim, ?e, ?r, land).
dropping(?a, ?ab, ?from, ?aim, ?e) :- forcing(?a, ?ab, ?from, ?aim, ?e, ?to, fall).

% ?a can take ?t off ?e with ?ab, aimed at ?aim: ?e itself, or its region
% when ?e cannot be aimed at and ?ab reaches everyone there.
removalAny(?ab, ?t) :- stripsAny(?ab, ?t).
removalAny(?ab, ?t) :- popsAny(?ab, ?t).
removal(?ab, ?t) :- reach(?ab, ?k), first(removalAny(?ab, ?t)).
canUnset(?a, ?ab, ?t, ?e, ?e) :-
    removal(?ab, ?t), knows(?a, ?ab), canAct(?a), ready(?a, ?ab, ?e).
canUnset(?a, ?ab, ?t, ?e, ?r) :-
    not(receptive(?e, targeted)), locus(?e, ?r), removal(?ab, ?t),
    first(and(effect(?ab, ?w, ?x), wide(?w))), knows(?a, ?ab), canAct(?a), ready(?a, ?ab, ?r).
wide(area).
wide(around).

% ?a can deal ?type damage to ?e with ?ab.
canStrike(?a, ?ab, ?type, ?e) :-
    effect(?ab, target, damage(?type)), knows(?a, ?ab), canAct(?a), ready(?a, ?ab, ?e).

% ?a can make ?e carry ?t: cast it, or push ?e into a region that grants it.
canPrime(?a, ?t, ?e) :- canInflict(?a, ?ab, ?t, ?e).
canPrime(?a, ?t, ?e) :- zoneFor(?r, ?t), placement(?a, ?ab, ?from, ?aim, ?e, ?r).

% Who supplies ?t on ?e: nobody if it is already there, else one answer per
% companion who can prime it.
supplier(none, ?t, ?e) :- holds(?e, ?t).
supplier(?p, ?t, ?e) :- not(holds(?e, ?t)), canAct(?p), first(canPrime(?p, ?t, ?e)).

% What an ability does to where its target stands: pull it in (a pull, a
% hook, a tag that drags its bearer), or move it at all.
pullsAny(?ab) :- effect(?ab, target, pull).
pullsAny(?ab) :- effect(?ab, target, hook).
pulls(?ab) :- reach(?ab, ?k), first(pullsAny(?ab)).
movesAny(?ab) :- pullsAny(?ab).
movesAny(?ab) :- effect(?ab, ?w, push), aimed(?w).
movesAny(?ab) :- effect(?ab, target, swap).
movesAny(?ab) :- effect(?ab, target, grant(?t)), onGrant(?t, chase).
moves(?ab) :- reach(?ab, ?k), first(movesAny(?ab)).
puller(?a, ?ab, ?e) :- canAct(?a), knows(?a, ?ab), pulls(?ab), ready(?a, ?ab, ?e).

% ?a can walk to ?r from where it stands.
canReachNow(?a, ?r) :- at(?a, ?cur), canReach(?a, ?cur, ?r).

% A gap next to ?e that it would fall into.
gapNextTo(?e) :- at(?e, ?r), first(and(edge(?r, ?n, gap), gapTakes(?e))).
% Somewhere ?e can go down: a hazard area, or a gap next to it.
downFor(?e) :- first(dropFor(?r, ?e)).
downFor(?e) :- not(first(dropFor(?r, ?e))), gapNextTo(?e).

% An area whose arrival takes ?e out of the fight.
dropFor(?r, ?e) :- zoneFor(?r, ?t), stops(?e, ?t).
dropFor(?r, ?e) :-
    onEnter(?r, ?ab), effect(?ab, target, hazard(?h)),
    weakness(?e, ?h, none, ?out), stops(?e, ?out).

% === Methods ===

% The need: ?e carries ?t, put there by ?a.
inflictAs(?a, ?t, ?e) :-
    if(canInflict(?a, ?ab, ?t, ?e)), do(cast(?a, ?ab, ?e)).

% The need: ?e carries ?t, put there by anyone but ?not.
inflict(?t, ?e, ?not) :-
    if(canInflict(?a, ?ab, ?t, ?e), \==(?a, ?not)), do(cast(?a, ?ab, ?e)).

% The need: ?e is in ?r, pushed there by ?a / by anyone but ?not.
placeAs(?a, ?e, ?r) :-
    if(first(placement(?a, ?ab, ?from, ?aim, ?e, ?r))), do(castFrom(?a, ?ab, ?aim, ?from)).
place(?e, ?r, ?not) :-
    if(canAct(?a), \==(?a, ?not), first(placement(?a, ?ab, ?from, ?aim, ?e, ?r))),
    do(castFrom(?a, ?ab, ?aim, ?from)).

% The need: ?e ends up in ?r, sent there by anyone but ?not.
sendInto(?e, ?r, ?not) :-
    if(canAct(?a), \==(?a, ?not), first(placement(?a, ?ab, ?from, ?aim, ?e, ?r))),
    do(castFrom(?a, ?ab, ?aim, ?from)).

% The need: ?e falls into a gap next to it, forced by anyone but ?not.
dropInGap(?e, ?not) :-
    if(canAct(?a), \==(?a, ?not), first(dropping(?a, ?ab, ?from, ?aim, ?e))),
    do(castFrom(?a, ?ab, ?aim, ?from)).

% The need: ?e goes down - into a hazard area it is weak to, or a gap.
sendDown(?e, ?not) :- if(dropFor(?r, ?e)), do(sendInto(?e, ?r, ?not)).
sendDown(?e, ?not) :- if(gapNextTo(?e)), do(dropInGap(?e, ?not)).

% The need: ?e takes ?type damage from anyone but ?not.
strike(?type, ?e, ?not) :-
    if(canStrike(?a, ?ab, ?type, ?e), \==(?a, ?not)), do(cast(?a, ?ab, ?e)).

% The need: ?e carries ?t, primed by ?a - a cast, or a push into a zone.
primeAs(?a, ?t, ?e) :- if(canInflict(?a, ?ab, ?t, ?e)), do(cast(?a, ?ab, ?e)).
primeAs(?a, ?t, ?e) :-
    if(zoneFor(?r, ?t), first(placement(?a, ?ab, ?from, ?aim, ?e, ?r))),
    do(castFrom(?a, ?ab, ?aim, ?from)).

% The supplier found by supplier/3 does its part (nothing if it was there).
supply(none, ?t, ?e) :- if(holds(?e, ?t)), do().
supply(?p, ?t, ?e) :- if(\==(?p, none), not(holds(?e, ?t))), do(primeAs(?p, ?t, ?e)).

% The need: ?e takes ?in - a tag cast on it, or damage dealt to it - from
% anyone but ?not.
deliver(?in, ?e, ?not) :- if(not(damageType(?in))), do(inflict(?in, ?e, ?not)).
deliver(?in, ?e, ?not) :- if(damageType(?in)), do(strike(?in, ?e, ?not)).

% The shape of most combos: someone makes ?e carry ?have, someone else lands
% ?in on it, and the world must show ?e out of the fight.
combo(?have, ?in, ?e) :-
    if(receptive(?e, ?in), supplier(?p, ?have, ?e)),
    do(supply(?p, ?have, ?e), deliver(?in, ?e, ?p), confirmStopped(?e)).

% The need: ?e no longer carries ?t, taken off by anyone.
unset(?t, ?e) :-
    if(canUnset(?a, ?ab, ?t, ?e, ?aim)), do(cast(?a, ?ab, ?aim), ensureOff(?t, ?e)).
ensureOff(?t, ?e) :- if(not(tag(?e, ?t))), do().

% The need: ?e is no longer where it stands, moved by anyone, any way.
dislodge(?e) :-
    if(at(?e, ?r), canAct(?a), knows(?a, ?ab), moves(?ab), ready(?a, ?ab, ?e)),
    do(cast(?a, ?ab, ?e), ensureMoved(?e, ?r)).
dislodge(?e) :-
    if(at(?e, ?r), first(placement(?a, ?ab, ?from, ?aim, ?e, ?to)), \==(?aim, ?e)),
    do(castFrom(?a, ?ab, ?aim, ?from), ensureMoved(?e, ?r)).
ensureMoved(?e, ?r) :- if(not(at(?e, ?r))), do().

% Verify the simulated world: the recipe worked only if ?e is out.
confirmStopped(?e) :- if(neutralized(?e)), do().
