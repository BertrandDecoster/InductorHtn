% ab_effects - what an ability does to the world
%
% The physics of the ability layer. Whoever acts - a companion, an NPC, a
% hazard, a reaction - owns an ability, and an ability is a bundle of
% effects applied in declared order:
%   effect(?ab, target|self, ?atom)
% where the recipient is `target`, `self` (the source), `area` (everyone
% else in the target's area: friendly fire included), `foes` (the NPCs in
% the target's area) or `around` (everyone else in the source's own area),
% with a closed set of atoms, in families:
%   tags      grant(T)  remove(T)  purge(Group)  damage(Type)
%   movement  push  pull  hook  pullIn  swap  dash  teleport  teleport(R)
%             chase
%   actions   interrupt
%   terrain   spill(ZoneAbility)  spill(ZoneAbility, Area)  hazard(H)
%             open(Door)  close(Door)
% and one duration: moment(Atom) makes a grant or a remove last only for a
% moment - through the next cast by anyone - and then undoes it.
%
% The map is large areas (a small room, a quarter of a large one) joined by
% links, each declared once, either way round:
%   connected(?a, ?b)       walkable
%   gap(?a, ?b)             a short pit: dash or teleport over it
%   wall(?a, ?b)            only a teleport goes through
%   doorway(?a, ?b, ?d)     walkable while open(?d), else a wall
% and features inside an area, each with the ability it applies:
%   feature(?r, ?f, ?ab)    a pit, a pool of lava, deep water (?ab has
%                           hazard(H)); walked around, never walked into
%   plate(?f)               the feature is a pressure plate: a companion
%                           stands on it on purpose (stepOn/2), or something
%                           is knocked onto it; either presses it, which
%                           applies ?ab (a door opens; an area fills with
%                           poison)
% Movement between areas goes one link:
%   walk      over walkable links, one area at a time (a route)
%   dash      the source next door, over a walkable link or a gap
%   teleport  the source next door, over any link
%   pull      the target into the source's area, from next door
%   hook      a pull; an anchored target pulls the source to it instead,
%             over a walkable link or a gap (a grappling hook)
%   chase     the target walks after the source (see taunted), and follows
%             it every time the source moves; if it cannot, it gives up
% A pull across a gap drops its target in. Forced movement within an area
% is a knockback - it never changes the area:
%   push      the target is knocked into a feature of its area, or into a
%             gap at its edge - wherever the source aims (every choice is a
%             plan, and so is knocking it into nothing)
%   pullIn    aimed at a feature, everything movable in its area is knocked
%             into it (aimed at an area, it only gathers)
% A filler knocked into a pit fills it; into a gap, it bridges it.
% `interrupt` stops a magic heavy attack the target is
% winding up (see ab_casting). A spill onto an area whose zone reacts to it
% reshapes the zone instead (zoneReaction/3: ice over deep water is a
% floor). An ability may target an area instead of an entity - only `area`,
% `spill`, `dash`, `teleport`, `open` and `close` do anything to an area - or
% a feature (a vortex on the pit; a fireball whose flames fill its area).
% and the world rules they consult:
%   reaction(?have, ?incoming, ?ab)  ?incoming (a tag, a damage type, or
%                                    `damage` for any damageType/1) landing
%                                    on something that has ?have fires ability
%                                    ?ab instead
%   weakness(?e, ?in, ?have, ?out)   this entity, taking ?in (a tag or a
%                                    hazard) while carrying ?have (or `none`),
%                                    gets ?out instead: a robot electrocuted
%                                    is stunned; an imp chilled is frozen
%   onGrant(?t, ?atom)               storing ?t also does ?atom to the bearer
%                                    (taunted: it chases its taunter)
%   behavior(?npc, ?t, ?ab, ?aim)    an NPC that gains ?t casts ?ab at ?aim:
%                                    `source` (whoever gave it ?t), `self`,
%                                    `here` (its own area) or there(R). A
%                                    taunted golem is dragged to its taunter,
%                                    then discharges there. Its effects apply
%                                    raw: weaknesses answer, reactions do not
%   hostile(?t)                      the tags `hostile` stands for in a
%                                    reaction or a ward (shields, wake-on-hit)
%   vulnerable(?e, ?type)            that damage kills outright (mooks)
%   onEnter(?r, ?ab)                 whoever arrives in ?r takes ?ab
%   open(?d)                         a door is open; plateFor(?p, ?d): with
%                                    openWhenHeld(D), it opens only when every
%                                    plate of D is weighed down at once
%   watches(?g, ?r)                  no companion walks into ?r under ?g's
%                                    eyes - unless stealthed, or ?g cannot see
%                                    (forbids(?t, watch): blinded, stunned)
%   blocker(?e)                      nobody else walks into its area
%   tag(?e, filler)                  fallen into a hazard, it fills it
%   tag(?e, flying)                  weighs down no plate
%   zoneReaction(?old, ?in, ?new)    a spill of zone ?in on a area with
%                                    zone ?old leaves ?new there instead
%                                    (`none`: no zone at all)
%   heavy(?ab)                       an NPC ability that is telegraphed (the
%                                    window is in ab_casting); kind(?ab,
%                                    magic) makes it interruptible
%   mustSurvive(?x)                  a level's declaration: no heavy blow may
%                                    land on it (an escort). Companions may be
%                                    sacrificed unless a level says otherwise
%
% Mode is `react`, `raw` or `bare`. A tag landing in react mode meets, in
% order: a reaction (a shield absorbs it), the bearer's own weakness, else it
% is stored. A reaction's effects apply raw: weaknesses still answer, but no
% further reaction fires. What a weakness produces is stored bare. So a
% decomposition never chains, and only a weakness - a fact about that one
% entity - produces an outcome like dead. Reactions are consulted
% here as a filter on what just happened - never searched to plan a combo.
% Planning combos is the job of the recipes at the top.
%
% An NPC behaviour whose ability is heavy(?ab) is telegraphed instead of
% landing at once: ab_casting owns the window, since the answer is a cast.
%
% Every "nothing happens" branch carries the negation of the branches before
% it. `else` is not a cut in this engine: when a later task fails, the
% planner backtracks into an `else` no-op, which would let a plan skip an
% effect it finds inconvenient (a caster "forgetting" to get tired).

% === Operators ===

opReact(?src, ?e, ?have, ?incoming, ?ab) :-
    del(), add().

opForcedMove(?src, ?e, ?from, ?to) :-
    del(at(?e, ?from)), add(at(?e, ?to)).

opSwap(?src, ?e, ?rs, ?re) :-
    del(at(?src, ?rs), at(?e, ?re)), add(at(?src, ?re), at(?e, ?rs)).

opOpen(?src, ?d) :-
    del(), add(open(?d)).

opProvoked(?npc, ?trigger, ?ab) :-
    del(), add().

opExploit(?src, ?e, ?in, ?out) :-
    del(), add().

opDash(?a, ?from, ?to) :-
    del(at(?a, ?from)), add(at(?a, ?to)).

opFall(?src, ?e, ?from, ?to) :-
    del(), add().

opBridge(?src, ?a, ?b) :-
    del(), add(bridged(?a, ?b)).

opKnock(?src, ?e, ?f) :-
    del(), add().

opSink(?src, ?e, ?f) :-
    del(), add(sunk(?e, ?f)).

opStepOn(?src, ?e, ?f) :-
    del(), add(on(?e, ?f)).

opStepOff(?src, ?e, ?f) :-
    del(on(?e, ?f)), add().

opFollow(?src, ?npc) :-
    del(), add(follows(?npc, ?src)).

opLoseTrack(?src, ?npc) :-
    del(tag(?npc, taunted), follows(?npc, ?src)), add().

opSpill(?src, ?r, ?ab) :-
    del(), add(onEnter(?r, ?ab)).

opReshape(?src, ?r, ?old, ?new) :-
    del(onEnter(?r, ?old)), add(onEnter(?r, ?new)).

opErase(?src, ?r, ?old) :-
    del(onEnter(?r, ?old)), add().

opClose(?src, ?d) :-
    del(open(?d)), add().

opTeleport(?a, ?from, ?to) :-
    del(at(?a, ?from)), add(at(?a, ?to)).

opMoment(?src, ?e, ?t, ?how, ?until) :-
    del(), add(lasts(?e, ?t, ?how, ?until)).

opInterrupt(?src, ?npc, ?ab, ?x) :-
    del(windingUp(?npc, ?ab, ?x)), add().

% === Rules ===

% Where an entity is, or a area itself.
locus(?e, ?r) :- at(?e, ?r).
locus(?r, ?r) :- region(?r).
locus(?f, ?r) :- feature(?r, ?f, ?ab).

% A reaction to exactly ?incoming, or to any damage / any hostile tag.
matches(?have, ?incoming, ?ab) :- reaction(?have, ?incoming, ?ab).
matches(?have, ?incoming, ?ab) :- damageType(?incoming), reaction(?have, damage, ?ab).
matches(?have, ?incoming, ?ab) :- hostile(?incoming), reaction(?have, hostile, ?ab).

% The weakness ?incoming meets on ?e, if any: the first declared whose
% prerequisite ?e carries.
weakFor(?e, ?incoming, ?have, ?out) :-
    receptive(?e, ?incoming),
    first(and(weakness(?e, ?incoming, ?have, ?out), weakReady(?e, ?have))).
weakReady(?e, none).
weakReady(?e, ?have) :- \==(?have, none), has(?e, ?have).

hasOnGrant(?t) :- first(onGrant(?t, ?atom)).
hasBehavior(?e, ?t) :- first(behavior(?e, ?t, ?ab, ?aim)).

% What an NPC's behaviour is aimed at.
aimAt(?src, ?e, source, ?src).
aimAt(?src, ?e, self, ?e).
aimAt(?src, ?e, here, ?r) :- at(?e, ?r).
aimAt(?src, ?e, there(?r), ?r).

% The reaction ?incoming triggers on ?e, if any: the first stored tag (then
% bundled atom) with a reaction wins, and an exact match beats `damage`.
reactionFor(?e, ?incoming, ?have, ?ab) :-
    receptive(?e, ?incoming),
    first(and(has(?e, ?have), matches(?have, ?incoming, ?ab))).

% That damage kills ?e outright.
kills(?e, ?type) :- receptive(?e, ?type), vulnerable(?e, ?type), canReceive(?e, dead).

% ?e cannot be moved by force: immune right now, or already out.
anchoredAgainst(?e) :- not(receptive(?e, forcedMove)).

hasZone(?r) :- first(onEnter(?r, ?ab)).

% Links, either way round, each counted once.
linked(?a, ?b, walk) :- connected(?a, ?b).
linked(?a, ?b, walk) :- connected(?b, ?a), not(connected(?a, ?b)).
linked(?a, ?b, gap) :- gap(?a, ?b).
linked(?a, ?b, gap) :- gap(?b, ?a), not(gap(?a, ?b)).
linked(?a, ?b, wall) :- wall(?a, ?b).
linked(?a, ?b, wall) :- wall(?b, ?a), not(wall(?a, ?b)).
linked(?a, ?b, door(?d)) :- doorway(?a, ?b, ?d).
linked(?a, ?b, door(?d)) :- doorway(?b, ?a, ?d), not(doorway(?a, ?b, ?d)).

% What a link is right now: a bridged gap is walkable, a door open or shut.
bridgedGap(?a, ?b) :- bridged(?a, ?b).
bridgedGap(?a, ?b) :- bridged(?b, ?a).
edge(?a, ?b, walk) :- linked(?a, ?b, walk).
edge(?a, ?b, walk) :- linked(?a, ?b, gap), bridgedGap(?a, ?b).
edge(?a, ?b, gap) :- linked(?a, ?b, gap), not(bridgedGap(?a, ?b)).
edge(?a, ?b, wall) :- linked(?a, ?b, wall).
edge(?a, ?b, walk) :- linked(?a, ?b, door(?d)), open(?d).
edge(?a, ?b, wall) :- linked(?a, ?b, door(?d)), not(open(?d)).

% Which links each movement crosses.
leapable(walk).
leapable(gap).
dashEdge(?a, ?b) :- edge(?a, ?b, ?k), leapable(?k).
blinkEdge(?a, ?b) :- edge(?a, ?b, ?k).

% A hazard is live until something that fills it has fallen in.
filled(?r) :- first(and(at(?x, ?r), tag(?x, filler), tag(?x, fell))).
hazardAt(?r, ?h) :- onEnter(?r, ?z), effect(?z, target, hazard(?h)), not(filled(?r)).
deadly(?e, ?r) :- first(and(hazardAt(?r, ?h), weakness(?e, ?h, none, ?o), receptive(?e, ?o))).
liveFor(?e, ?h) :- at(?e, ?r), not(filled(?r)).
% A gap takes whatever is weak to falling in it; a flyer crosses.
gapTakes(?e) :- first(and(weakness(?e, gap, none, ?o), receptive(?e, ?o))).

% Forced across the link from ?from to ?to: it lands, or falls in the gap.
forcedStep(?e, ?from, ?to, land) :- edge(?from, ?to, walk).
forcedStep(?e, ?from, ?to, fall) :- edge(?from, ?to, gap), gapTakes(?e).
forcedStep(?e, ?from, ?to, land) :- edge(?from, ?to, gap), not(gapTakes(?e)).

% Features: a pit is filled once a filler has sunk in it; it takes what is
% weak to its hazard. A plate is held while anything that weighs is on it.
filledFeature(?f) :- first(and(sunk(?x, ?f), has(?x, filler))).
pitTakes(?e, ?f) :-
    feature(?r, ?f, ?ab), effect(?ab, target, hazard(?h)), not(filledFeature(?f)),
    first(and(weakness(?e, ?h, none, ?o), receptive(?e, ?o))).
% Where a knockback can send ?e: a feature of its area, or a gap at its edge.
knockTarget(?e, feature(?f)) :- at(?e, ?r), feature(?r, ?f, ?ab).
knockTarget(?e, gap(?n)) :- at(?e, ?r), edge(?r, ?n, gap).
% A pull brings ?e into the source's area from next door.
pullable(?src, ?e, ?from, ?to, ?k) :-
    not(anchoredAgainst(?e)), at(?src, ?to), at(?e, ?from), \==(?from, ?to),
    forcedStep(?e, ?from, ?to, ?k).
grapple(?src, ?e, ?from, ?to) :-
    at(?src, ?from), at(?e, ?to), dashEdge(?from, ?to), not(deadly(?src, ?to)).
swapLine(?src, ?e, ?rs, ?re) :-
    not(anchoredAgainst(?e)), at(?src, ?rs), at(?e, ?re), \==(?rs, ?re).
% A leap never lands its source in a live hazard it is weak to.
dashLine(?src, ?e, ?from, ?to) :-
    at(?src, ?from), locus(?e, ?to), dashEdge(?from, ?to), not(deadly(?src, ?to)).
teleLine(?src, ?e, ?from, ?to) :-
    at(?src, ?from), locus(?e, ?to), blinkEdge(?from, ?to), not(deadly(?src, ?to)).
blinkLine(?e, ?r, ?from) :-
    not(anchoredAgainst(?e)), at(?e, ?from), \==(?from, ?r).
% What a vortex on a feature in ?r gathers: everything movable there.
drawnTo(?src, ?r, ?x) :- at(?x, ?r), \==(?x, ?src), not(anchoredAgainst(?x)), not(gone(?x)).

% Walking: a blocker's area, a live hazard, a watched area - none is
% passable (the last only to a companion).
heldAgainst(?a, ?r) :- first(and(at(?e, ?r), blocker(?e), \==(?e, ?a), not(gone(?e)))).
spotted(?a, ?r) :-
    canAct(?a), not(has(?a, stealthed)),
    first(and(watches(?g, ?r), not(gone(?g)), not(forbidden(?g, watch)))).
passable(?a, ?r) :- not(heldAgainst(?a, ?r)), not(deadly(?a, ?r)), not(spotted(?a, ?r)).
walkEdge(?a, ?b) :- edge(?a, ?b, walk).
% A plate is held while anything that weighs is on it.
plateHeld(?p) :- first(and(on(?x, ?p), not(gone(?x)), not(has(?x, flying)))).
allPlatesHeld(?d) :- not(first(and(plateFor(?p, ?d), not(plateHeld(?p))))).
% Routes: iterative deepening over walkable links, at most eight steps,
% never stepping straight back, so the first answer is a shortest route.
hop(0). hop(1). hop(2). hop(3). hop(4). hop(5). hop(6). hop(7).
walkable(?a, ?p, ?x, ?x, ?d).
walkable(?a, ?p, ?x, ?r, ?d) :-
    >(?d, 0), \==(?x, ?r), walkEdge(?x, ?m), \==(?m, ?p), passable(?a, ?m),
    is(?d1, -(?d, 1)), walkable(?a, ?x, ?m, ?r, ?d1).
% The first step of a shortest route to ?r.
nextStep(?a, ?f, ?r, ?n) :-
    first(and(hop(?d), walkEdge(?f, ?n), passable(?a, ?n), walkable(?a, ?f, ?n, ?r, ?d))).
canReach(?a, ?f, ?r) :- =(?f, ?r).
canReach(?a, ?f, ?r) :- \==(?f, ?r), first(nextStep(?a, ?f, ?r, ?n)).
% A chaser cannot follow: it cannot move, or cannot walk there.
cannotFollow(?npc, ?f, ?r) :- forbidden(?npc, move).
cannotFollow(?npc, ?f, ?r) :- not(forbidden(?npc, move)), not(canReach(?npc, ?f, ?r)).
hasFollower(?e) :- first(and(follows(?n, ?e), tag(?n, taunted), not(gone(?n)))).

% Someone other than ?src stands in ?r; someone at all stands in ?r.
areaHit(?src, ?r) :- first(and(at(?x, ?r), \==(?x, ?src))).
occupied(?r) :- first(at(?x, ?r)).

% The atoms that do something to a area target.
regionAtom(spill(?z)).
regionAtom(dash).
regionAtom(teleport).
regionAtom(open(?d)).
regionAtom(close(?d)).

% The clock counts casts; a moment lasts through the next one.
clockNow(?c) :- clock(?c).
clockNow(0) :- not(clock(?x)).

% A spill of ?z on ?r meets the zone there.
reshapes(?r, ?z, ?old, ?new) :- first(and(onEnter(?r, ?old), zoneReaction(?old, ?z, ?new))).

% The NPCs in ?r (not the companions, whoever the source is).
foeIn(?src, ?r, ?x) :- at(?x, ?r), \==(?x, ?src), not(canAct(?x)).

% Everyone around ?src: the others in its own area.
aroundHit(?src, ?x) :- at(?src, ?r), at(?x, ?r), \==(?x, ?src).

% === Methods ===

% Every effect of ?ab, in declared order, from ?src onto ?e. A zone may
% have none.
applyAbility(?src, ?ab, ?e, ?mode) :-
    allOf, if(effect(?ab, ?who, ?atom)),
    do(applyEffect(?src, ?who, ?atom, ?e, ?mode)).
applyAbility(?src, ?ab, ?e, ?mode) :- if(not(first(effect(?ab, ?w, ?x)))), do().

applyEffect(?src, target, ?atom, ?e, ?mode) :-
    if(not(region(?e))), do(effectOn(?src, ?e, ?atom, ?mode)).
applyEffect(?src, target, ?atom, ?e, ?mode) :-
    if(region(?e), regionAtom(?atom)), do(effectOn(?src, ?e, ?atom, ?mode)).
applyEffect(?src, target, ?atom, ?e, ?mode) :-
    if(region(?e), not(regionAtom(?atom))), do().
applyEffect(?src, self, ?atom, ?e, ?mode) :- if(), do(effectOn(?src, ?src, ?atom, ?mode)).
applyEffect(?src, area, ?atom, ?e, ?mode) :-
    if(locus(?e, ?r), areaHit(?src, ?r)), do(areaEffect(?src, ?r, ?atom, ?mode)).
applyEffect(?src, area, ?atom, ?e, ?mode) :-
    if(locus(?e, ?r), not(areaHit(?src, ?r))), do().
applyEffect(?src, foes, ?atom, ?e, ?mode) :-
    if(locus(?e, ?r), first(foeIn(?src, ?r, ?x))), do(foeEffect(?src, ?r, ?atom, ?mode)).
applyEffect(?src, foes, ?atom, ?e, ?mode) :-
    if(locus(?e, ?r), not(first(foeIn(?src, ?r, ?x)))), do().
applyEffect(?src, around, ?atom, ?e, ?mode) :-
    if(first(aroundHit(?src, ?x))), do(aroundEffect(?src, ?atom, ?mode)).
applyEffect(?src, around, ?atom, ?e, ?mode) :- if(not(first(aroundHit(?src, ?x)))), do().

foeEffect(?src, ?r, ?atom, ?mode) :-
    allOf, if(foeIn(?src, ?r, ?x)), do(effectOn(?src, ?x, ?atom, ?mode)).

aroundEffect(?src, ?atom, ?mode) :-
    allOf, if(aroundHit(?src, ?x)), do(effectOn(?src, ?x, ?atom, ?mode)).

areaEffect(?src, ?r, ?atom, ?mode) :-
    allOf, if(at(?x, ?r), \==(?x, ?src)), do(effectOn(?src, ?x, ?atom, ?mode)).

% One clause per atom; each atom's method always succeeds, so one refused
% atom never cancels the rest of the ability.
effectOn(?src, ?e, grant(?t), ?mode) :- if(), do(grantTag(?src, ?e, ?t, ?mode)).
effectOn(?src, ?e, remove(?t), ?mode) :- if(), do(removeTag(?src, ?e, ?t)).
effectOn(?src, ?e, purge(?g), ?mode) :- if(), do(purgeGroup(?src, ?e, ?g)).
effectOn(?src, ?e, spill(?z), ?mode) :- if(), do(spillZone(?src, ?e, ?z, ?mode)).
effectOn(?src, ?e, spill(?z, ?r), ?mode) :- if(), do(spillZone(?src, ?r, ?z, ?mode)).
effectOn(?src, ?e, damage(?type), ?mode) :- if(), do(takeDamage(?src, ?e, ?type, ?mode)).
effectOn(?src, ?e, push, ?mode) :- if(), do(shove(?src, ?e, ?mode)).
effectOn(?src, ?e, pull, ?mode) :- if(), do(drag(?src, ?e, ?mode)).
effectOn(?src, ?e, dash, ?mode) :- if(), do(dashTo(?src, ?e, ?mode)).
effectOn(?src, ?e, teleport(?r), ?mode) :- if(), do(blink(?src, ?e, ?r, ?mode)).
effectOn(?src, ?e, hazard(?h), ?mode) :- if(), do(suffer(?src, ?e, ?h)).
effectOn(?src, ?e, hook, ?mode) :- if(), do(hookOn(?src, ?e, ?mode)).
effectOn(?src, ?e, swap, ?mode) :- if(), do(swapPlaces(?src, ?e, ?mode)).
effectOn(?src, ?e, open(?d), ?mode) :- if(), do(openDoor(?src, ?d)).
effectOn(?src, ?e, openWhenHeld(?d), ?mode) :- if(), do(openIfHeld(?src, ?d)).
effectOn(?src, ?e, close(?d), ?mode) :- if(), do(closeDoor(?src, ?d)).
effectOn(?src, ?e, teleport, ?mode) :- if(), do(teleportTo(?src, ?e, ?mode)).
effectOn(?src, ?e, pullIn, ?mode) :- if(feature(?r, ?e, ?ab)), do(gatherInto(?src, ?e, ?r, ?mode)).
effectOn(?src, ?e, pullIn, ?mode) :- if(not(feature(?r, ?e, ?ab))), do().
effectOn(?src, ?e, interrupt, ?mode) :- if(), do(interruptOn(?src, ?e)).
effectOn(?src, ?e, chase, ?mode) :- if(), do(chase(?src, ?e)).
effectOn(?src, ?e, moment(grant(?t)), ?mode) :- if(), do(grantFor(?src, ?e, ?t, ?mode)).
effectOn(?src, ?e, moment(remove(?t)), ?mode) :- if(), do(removeFor(?src, ?e, ?t)).

% A vortex on feature ?f: everything movable in its area is knocked in.
gatherInto(?src, ?f, ?r, ?mode) :-
    if(first(drawnTo(?src, ?r, ?x))), do(gatherAll(?src, ?f, ?r, ?mode)).
gatherInto(?src, ?f, ?r, ?mode) :- if(not(first(drawnTo(?src, ?r, ?x)))), do().
gatherAll(?src, ?f, ?r, ?mode) :-
    allOf, if(drawnTo(?src, ?r, ?x)), do(impact(?src, ?x, feature(?f), ?mode)).

% Knocked into a feature: onto a plate, it presses it; into a pit, it meets
% the hazard (a filler fills it; a filled pit is only floor); into a gap at
% the edge of its area, it falls in (a flyer crosses).
impact(?src, ?e, feature(?f), ?mode) :-
    if(feature(?r, ?f, ?ab), plate(?f)), do(opKnock(?src, ?e, ?f), press(?src, ?e, ?f, ?ab, ?mode)).
impact(?src, ?e, feature(?f), ?mode) :-
    if(feature(?r, ?f, ?ab), not(plate(?f)), not(filledFeature(?f))),
    do(opKnock(?src, ?e, ?f), applyAbility(?src, ?ab, ?e, ?mode), sinkIf(?src, ?e, ?f)).
impact(?src, ?e, feature(?f), ?mode) :-
    if(feature(?r, ?f, ?ab), not(plate(?f)), filledFeature(?f)), do(opKnock(?src, ?e, ?f)).
impact(?src, ?e, gap(?n), ?mode) :-
    if(at(?e, ?r), forcedStep(?e, ?r, ?n, ?k)), do(moveBy(?src, ?e, ?r, ?n, ?k, ?mode)).
sinkIf(?src, ?e, ?f) :- if(tag(?e, fell), has(?e, filler)), do(opSink(?src, ?e, ?f)).
sinkIf(?src, ?e, ?f) :- if(not(and(tag(?e, fell), has(?e, filler)))), do().

% A plate pressed: whatever is on it presses it once.
press(?src, ?e, ?f, ?ab, ?mode) :- if(on(?e, ?f)), do().
press(?src, ?e, ?f, ?ab, ?mode) :-
    if(not(on(?e, ?f))), do(opStepOn(?src, ?e, ?f), applyAbility(?src, ?ab, ?e, ?mode)).

% A companion stands on a plate in its area, on purpose.
stepOn(?a, ?f) :- if(on(?a, ?f)), do().
stepOn(?a, ?f) :-
    if(not(on(?a, ?f)), at(?a, ?r), feature(?r, ?f, ?ab), plate(?f)),
    do(opStepOn(?a, ?a, ?f), applyAbility(?a, ?ab, ?a, react)).

% Leaving an area leaves its plates.
leavePlates(?e) :- if(first(on(?e, ?f))), do(leaveAll(?e)).
leavePlates(?e) :- if(not(first(on(?e, ?f)))), do().
leaveAll(?e) :- allOf, if(on(?e, ?f)), do(opStepOff(?e, ?e, ?f)).

% The source appears in a neighbouring area, through any link.
teleportTo(?src, ?e, ?mode) :-
    if(teleLine(?src, ?e, ?from, ?to)),
    do(opTeleport(?src, ?from, ?to), arrive(?src, ?src, ?to, ?mode)).
teleportTo(?src, ?e, ?mode) :- if(not(teleLine(?src, ?e, ?f, ?t))), do().

% Forced across one link: it lands and takes what is there, or it falls in
% the gap - which a filler bridges.
moveBy(?src, ?e, ?from, ?to, land, ?mode) :-
    if(), do(opForcedMove(?src, ?e, ?from, ?to), arrive(?src, ?e, ?to, ?mode)).
moveBy(?src, ?e, ?from, ?to, fall, ?mode) :-
    if(), do(opFall(?src, ?e, ?from, ?to), suffer(?src, ?e, gap), bridgeIf(?src, ?e, ?from, ?to)).
bridgeIf(?src, ?e, ?from, ?to) :-
    if(has(?e, filler), tag(?e, fell), not(bridgedGap(?from, ?to))), do(opBridge(?src, ?from, ?to)).
bridgeIf(?src, ?e, ?from, ?to) :-
    if(not(and(has(?e, filler), tag(?e, fell), not(bridgedGap(?from, ?to))))), do().

% Taunted: the NPC walks after its taunter and keeps following it; when it
% cannot follow, the taunt is broken.
chase(?src, ?npc) :- if(at(?src, ?r), at(?npc, ?r)), do(track(?src, ?npc)).
chase(?src, ?npc) :-
    if(at(?src, ?r), at(?npc, ?f), \==(?f, ?r), not(cannotFollow(?npc, ?f, ?r))),
    do(track(?src, ?npc), trudge(?npc, ?r)).
chase(?src, ?npc) :-
    if(at(?src, ?r), at(?npc, ?f), \==(?f, ?r), first(cannotFollow(?npc, ?f, ?r))),
    do(loseTrack(?src, ?npc)).
track(?src, ?npc) :- if(follows(?npc, ?src)), do().
track(?src, ?npc) :- if(not(follows(?npc, ?src))), do(opFollow(?src, ?npc)).
loseTrack(?src, ?npc) :- if(follows(?npc, ?src)), do(opLoseTrack(?src, ?npc)).
loseTrack(?src, ?npc) :- if(not(follows(?npc, ?src))), do(opRemove(?src, ?npc, taunted)).
% Whoever moves drags its chasers after it.
pursue(?e) :- if(hasFollower(?e)), do(pursueAll(?e)).
pursue(?e) :- if(not(hasFollower(?e))), do().
pursueAll(?e) :-
    allOf, if(follows(?n, ?e), tag(?n, taunted), not(gone(?n))), do(chase(?e, ?n)).

% A walk that stops where it must: a chaser rooted on the way, or cut off.
trudge(?a, ?r) :- if(at(?a, ?r)), do().
trudge(?a, ?r) :- if(not(at(?a, ?r)), forbidden(?a, move)), do().
trudge(?a, ?r) :-
    if(not(at(?a, ?r)), not(forbidden(?a, move)), at(?a, ?f), first(nextStep(?a, ?f, ?r, ?n))),
    do(opNavigate(?a, ?f, ?n), arrive(?a, ?a, ?n, react), trudge(?a, ?r)).
trudge(?a, ?r) :-
    if(not(at(?a, ?r)), not(forbidden(?a, move)), at(?a, ?f), not(first(nextStep(?a, ?f, ?r, ?n)))),
    do().

% A magic heavy attack being wound up stops; anything else goes on.
interruptOn(?src, ?e) :-
    if(windingUp(?e, ?ab, ?x), kind(?ab, magic)), do(opInterrupt(?src, ?e, ?ab, ?x)).
interruptOn(?src, ?e) :- if(not(first(and(windingUp(?e, ?ab, ?x), kind(?ab, magic))))), do().

% For a moment: a tag ?e did not have, granted until the cast after next;
% a tag ?e had, taken off until then. ab_casting's clock undoes them.
grantFor(?src, ?e, ?t, ?mode) :- if(tag(?e, ?t)), do().
grantFor(?src, ?e, ?t, ?mode) :- if(not(tag(?e, ?t))), do(grantTag(?src, ?e, ?t, ?mode), markFor(?src, ?e, ?t)).
markFor(?src, ?e, ?t) :-
    if(tag(?e, ?t), clockNow(?c), is(?u, +(?c, 1))), do(opMoment(?src, ?e, ?t, grant, ?u)).
markFor(?src, ?e, ?t) :- if(not(tag(?e, ?t))), do().
removeFor(?src, ?e, ?t) :-
    if(tag(?e, ?t), clockNow(?c), is(?u, +(?c, 1))),
    do(opRemove(?src, ?e, ?t), opMoment(?src, ?e, ?t, remove, ?u)).
removeFor(?src, ?e, ?t) :- if(not(tag(?e, ?t))), do().

% A hazard does nothing by itself: it takes out whatever is weak to it -
% unless something that fills it already lies at the bottom.
suffer(?src, ?e, ?h) :-
    if(weakFor(?e, ?h, ?have, ?out), liveFor(?e, ?h)),
    do(opExploit(?src, ?e, ?h, ?out), grantTag(?src, ?e, ?out, bare)).
suffer(?src, ?e, ?h) :- if(not(weakFor(?e, ?h, ?hv, ?o))), do().
suffer(?src, ?e, ?h) :- if(weakFor(?e, ?h, ?hv, ?o), not(liveFor(?e, ?h))), do().

% A grappling hook: a light target comes to the source; an anchored one
% brings the source to it, over a walkable link or a gap.
hookOn(?src, ?e, ?mode) :- if(not(anchoredAgainst(?e))), do(drag(?src, ?e, ?mode)).
hookOn(?src, ?e, ?mode) :-
    if(anchoredAgainst(?e), not(gone(?e)), grapple(?src, ?e, ?from, ?to)),
    do(opDash(?src, ?from, ?to), arrive(?src, ?src, ?to, ?mode)).
hookOn(?src, ?e, ?mode) :-
    if(anchoredAgainst(?e), not(and(not(gone(?e)), grapple(?src, ?e, ?f, ?t)))), do().

% Two change places; each takes what is where it lands.
swapPlaces(?src, ?e, ?mode) :-
    if(swapLine(?src, ?e, ?rs, ?re)),
    do(opSwap(?src, ?e, ?rs, ?re), arrive(?src, ?src, ?re, ?mode), arrive(?src, ?e, ?rs, ?mode)).
swapPlaces(?src, ?e, ?mode) :- if(not(swapLine(?src, ?e, ?a, ?b))), do().

% A door opens, and stays open - until something closes it.
openDoor(?src, ?d) :- if(not(open(?d))), do(opOpen(?src, ?d)).
openDoor(?src, ?d) :- if(open(?d)), do().
closeDoor(?src, ?d) :- if(open(?d)), do(opClose(?src, ?d)).
closeDoor(?src, ?d) :- if(not(open(?d))), do().

% A door with several plates opens (for good) the moment all are held.
openIfHeld(?src, ?d) :- if(not(open(?d)), allPlatesHeld(?d)), do(opOpen(?src, ?d)).
openIfHeld(?src, ?d) :- if(open(?d)), do().
openIfHeld(?src, ?d) :- if(not(open(?d)), not(allPlatesHeld(?d))), do().

% A tag lands: a reaction fires instead if one applies (react mode only);
% else it is stored if ?e can take it; else nothing happens.
grantTag(?src, ?e, ?t, react) :-
    if(reactionFor(?e, ?t, ?have, ?ab)),
    do(opReact(?src, ?e, ?have, ?t, ?ab), applyAbility(?src, ?ab, ?e, raw)).
grantTag(?src, ?e, ?t, react) :-
    if(not(reactionFor(?e, ?t, ?h, ?b)), weakFor(?e, ?t, ?have, ?out)),
    do(opExploit(?src, ?e, ?t, ?out), grantTag(?src, ?e, ?out, bare)).
grantTag(?src, ?e, ?t, react) :-
    if(not(reactionFor(?e, ?t, ?h, ?b)), not(weakFor(?e, ?t, ?hv, ?o)), canReceive(?e, ?t)),
    do(opGrant(?src, ?e, ?t), afterGrant(?src, ?e, ?t)).
grantTag(?src, ?e, ?t, react) :-
    if(not(reactionFor(?e, ?t, ?h, ?b)), not(weakFor(?e, ?t, ?hv, ?o)), not(canReceive(?e, ?t))),
    do().
grantTag(?src, ?e, ?t, raw) :-
    if(weakFor(?e, ?t, ?have, ?out)),
    do(opExploit(?src, ?e, ?t, ?out), grantTag(?src, ?e, ?out, bare)).
grantTag(?src, ?e, ?t, raw) :-
    if(not(weakFor(?e, ?t, ?hv, ?o)), canReceive(?e, ?t)),
    do(opGrant(?src, ?e, ?t), afterGrant(?src, ?e, ?t)).
grantTag(?src, ?e, ?t, raw) :- if(not(weakFor(?e, ?t, ?hv, ?o)), not(canReceive(?e, ?t))), do().
grantTag(?src, ?e, ?t, bare) :- if(canReceive(?e, ?t)), do(opGrant(?src, ?e, ?t)).
grantTag(?src, ?e, ?t, bare) :- if(not(canReceive(?e, ?t))), do().

% What storing ?t does at once: the tag's own movement (a taunted bearer
% chases its taunter), then the bearer's behaviour, if it is an NPC that
% answers ?t and is not silenced.
afterGrant(?src, ?e, ?t) :- if(), do(tagMoves(?src, ?e, ?t), provoke(?src, ?e, ?t)).
tagMoves(?src, ?e, ?t) :- if(hasOnGrant(?t)), do(onGrantAll(?src, ?e, ?t)).
tagMoves(?src, ?e, ?t) :- if(not(hasOnGrant(?t))), do().
provoke(?src, ?e, ?t) :-
    if(hasBehavior(?e, ?t), not(gone(?e)), not(forbidden(?e, skill))), do(behaveAll(?src, ?e, ?t)).
provoke(?src, ?e, ?t) :- if(not(hasBehavior(?e, ?t))), do().
provoke(?src, ?e, ?t) :- if(hasBehavior(?e, ?t), gone(?e)), do().
provoke(?src, ?e, ?t) :- if(hasBehavior(?e, ?t), not(gone(?e)), forbidden(?e, skill)), do().
behaveAll(?src, ?e, ?t) :-
    allOf, if(behavior(?e, ?t, ?ab, ?aim), aimAt(?src, ?e, ?aim, ?x)),
    do(opProvoked(?e, ?t, ?ab), unleash(?e, ?ab, ?x)).
onGrantAll(?src, ?e, ?t) :-
    allOf, if(onGrant(?t, ?atom)), do(effectOn(?src, ?e, ?atom, react)).

% An ordinary ability lands at once; a heavy one is telegraphed (ab_casting).
unleash(?npc, ?ab, ?x) :- if(not(heavy(?ab))), do(applyAbility(?npc, ?ab, ?x, raw)).
unleash(?npc, ?ab, ?x) :- if(heavy(?ab)), do(telegraph(?npc, ?ab, ?x)).
removeTag(?src, ?e, ?t) :- if(tag(?e, ?t)), do(opRemove(?src, ?e, ?t)).
removeTag(?src, ?e, ?t) :- if(not(tag(?e, ?t))), do().

% Every stored tag of ?e in group ?g goes (a cleanse, a dispel).
purgeGroup(?src, ?e, ?g) :- if(inGroup(?e, ?g)), do(purgeAll(?src, ?e, ?g)).
purgeGroup(?src, ?e, ?g) :- if(not(inGroup(?e, ?g))), do().
purgeAll(?src, ?e, ?g) :-
    allOf, if(tag(?e, ?t), group(?t, ?g)), do(opRemove(?src, ?e, ?t)).

% The area of ?e becomes a zone of ?z, and everyone standing there takes
% it at once - the caster too, if it stands there. If the zone already there
% reacts to ?z, it becomes what the reaction says (or nothing).
spillZone(?src, ?e, ?z, ?mode) :-
    if(locus(?e, ?r), not(reshapes(?r, ?z, ?o, ?n)), not(onEnter(?r, ?z))),
    do(opSpill(?src, ?r, ?z), soakRegion(?src, ?r, ?z, ?mode)).
spillZone(?src, ?e, ?z, ?mode) :-
    if(locus(?e, ?r), not(reshapes(?r, ?z, ?o, ?n)), onEnter(?r, ?z)), do().
spillZone(?src, ?e, ?z, ?mode) :-
    if(locus(?e, ?r), reshapes(?r, ?z, ?old, none)), do(opErase(?src, ?r, ?old)).
spillZone(?src, ?e, ?z, ?mode) :-
    if(locus(?e, ?r), reshapes(?r, ?z, ?old, ?new), \==(?new, none)),
    do(opReshape(?src, ?r, ?old, ?new), soakRegion(?src, ?r, ?new, ?mode)).
soakRegion(?src, ?r, ?z, ?mode) :- if(occupied(?r)), do(soakAll(?src, ?r, ?z, ?mode)).
soakRegion(?src, ?r, ?z, ?mode) :- if(not(occupied(?r))), do().
soakAll(?src, ?r, ?z, ?mode) :-
    allOf, if(at(?x, ?r)), do(applyAbility(?src, ?z, ?x, ?mode)).

% Damage alone harms no one prepared for it. It fires a reaction first (a
% blunt blow on something brittle; a shield absorbs it; steam saves a wet
% mook from fire), else it kills a target vulnerable to it.
takeDamage(?src, ?e, ?type, react) :-
    if(reactionFor(?e, ?type, ?have, ?ab)),
    do(opReact(?src, ?e, ?have, ?type, ?ab), applyAbility(?src, ?ab, ?e, raw)).
takeDamage(?src, ?e, ?type, react) :-
    if(not(reactionFor(?e, ?type, ?h, ?b)), kills(?e, ?type)), do(opGrant(?src, ?e, dead)).
takeDamage(?src, ?e, ?type, react) :-
    if(not(reactionFor(?e, ?type, ?h, ?b)), not(kills(?e, ?type))), do().
takeDamage(?src, ?e, ?type, raw) :- if(kills(?e, ?type)), do(opGrant(?src, ?e, dead)).
takeDamage(?src, ?e, ?type, raw) :- if(not(kills(?e, ?type))), do().

% Push: a knockback into a feature of the target's area, or a gap at its
% edge - or into nothing that matters. Every aim is a plan. Pull: into the
% source's area, from next door.
shove(?src, ?e, ?mode) :-
    if(not(anchoredAgainst(?e)), knockTarget(?e, ?t)), do(impact(?src, ?e, ?t, ?mode)).
shove(?src, ?e, ?mode) :- if(), do().

drag(?src, ?e, ?mode) :-
    if(pullable(?src, ?e, ?from, ?to, ?k)), do(moveBy(?src, ?e, ?from, ?to, ?k, ?mode)).
drag(?src, ?e, ?mode) :- if(not(first(pullable(?src, ?e, ?f, ?t, ?k)))), do().

% Dash: the source leaps to the target's area, next door.
dashTo(?src, ?e, ?mode) :-
    if(dashLine(?src, ?e, ?from, ?to)),
    do(opDash(?src, ?from, ?to), arrive(?src, ?src, ?to, ?mode)).
dashTo(?src, ?e, ?mode) :- if(not(dashLine(?src, ?e, ?f, ?t))), do().

blink(?src, ?e, ?r, ?mode) :-
    if(blinkLine(?e, ?r, ?from)),
    do(opForcedMove(?src, ?e, ?from, ?r), arrive(?src, ?e, ?r, ?mode)).
blink(?src, ?e, ?r, ?mode) :- if(not(blinkLine(?e, ?r, ?f))), do().

% Whoever arrives in ?r takes what the area does. The one who moved ?e
% there is the source: a push into the pit is the pusher's doing, and a
% walk into the pool is the walker's. (A zone's ability has no `self`.)
arrive(?src, ?e, ?r, ?mode) :-
    if(hasZone(?r)), do(leavePlates(?e), enterZone(?src, ?r, ?e, ?mode), pursue(?e)).
arrive(?src, ?e, ?r, ?mode) :- if(not(hasZone(?r))), do(leavePlates(?e), pursue(?e)).

enterZone(?src, ?r, ?e, ?mode) :-
    allOf, if(onEnter(?r, ?ab)), do(applyAbility(?src, ?ab, ?e, ?mode)).

% A companion walks somewhere over walkable links, one area at a time,
% taking what each area does. It never walks into a blocker's area, a
% watched area, or a live hazard it is weak to.
walkTo(?a, ?r) :- if(at(?a, ?r)), do().
walkTo(?a, ?r) :-
    if(not(at(?a, ?r)), not(forbidden(?a, move)), at(?a, ?f), first(nextStep(?a, ?f, ?r, ?n))),
    do(opNavigate(?a, ?f, ?n), arrive(?a, ?a, ?n, react), walkTo(?a, ?r)).
