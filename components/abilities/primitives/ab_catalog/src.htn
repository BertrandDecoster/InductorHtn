% ab_catalog - the standard tags and skills
%
% Data for the ability layer: eleven skills, each landing a tag and a
% movement (or two tags), the tags they lead to, and who is weak to what.
%
% Three kinds of tag:
%   atomic      one meaning each (blinded: no basic attack, cannot keep
%               watch; silenced: no skills - and a heavy attack winding up
%               is stopped; rooted: no moving; slowed: no dashing; wet,
%               oiled, burning, electrocuted: what elements leave behind;
%               taunted; and the buffs stealthed, shielded, armored,
%               invulnerable, flying, phased)
%   composite   a named bundle of atoms (stunned = blinded + silenced +
%               rooted; chilled = slowed; frozen = a stun that lets go of
%               the ground)
%   outcome     dead, fell - never granted by a skill. Only an enemy's own
%               weakness, or a hazard it is weak to, produces one.
%   look        appearance(?look, ?tag): a status that plays exactly like a
%               catalogue tag and only looks different (petrified is a
%               stun). The runtime draws the look; the planner sees the tag.
%
% One tag is an aura, never stored: magnetized, carried while standing in a
% magnetic field. It switches armour and shields off and lets heavy things
% be moved, and ends the moment its bearer leaves the field.
%
% Nothing here kills in general. A combo is deadly because of who it lands
% on: weakness(?e, ?in, ?have, ?out) says this enemy, taking ?in while
% carrying ?have (or `none`), gets ?out. Archetype rules at the bottom give
% the usual ones (a machine short-circuits; a fire elemental freezes solid).
% Frozen stops most enemies only for as long as it lasts: a blow shatters
% it, and fire thaws it.
%
% Skills do no damage: damage is incremental, and this layer is about the
% combos. Enemy moves are at the end: a heavy one is telegraphed (see
% ab_casting), and surviving it is what several skills are also for.

% === Atomic tags ===

forbids(blinded, attack).
forbids(blinded, watch).
forbids(silenced, skill).
forbids(rooted, move).
forbids(rooted, dash).
forbids(slowed, dash).

% Taunted: fixated on its taunter - dragged to it.
onGrant(taunted, pull).

wards(stealthed, targeted).
wards(armored, forcedMove).
wards(invulnerable, hostile).
wards(invulnerable, heavy).
wards(flying, fell).

% Phased: out of the world for an instant - nothing lands, nothing moves
% it, and a heavy blow passes through. Spent by the next blow on its
% region, or by acting.
wards(phased, hostile).
wards(phased, forcedMove).
wards(phased, targeted).
wards(phased, heavy).

% Magnetized (an aura of the magnetic field): armour and shields hang dead,
% and the heavy lose their footing.
auraOf(magnetField, magnetized).
disables(magnetized, armored).
disables(magnetized, shielded).
suspends(magnetized, forcedMove).

% === Composites ===

bundles(stunned, blinded).
bundles(stunned, silenced).
bundles(stunned, rooted).

bundles(chilled, slowed).

% Frozen: a stun in ice - and ice slides, so even the heavy can be pushed.
bundles(frozen, blinded).
bundles(frozen, silenced).
bundles(frozen, rooted).
suspends(frozen, forcedMove).

% === Groups ===

group(dead, gone).
group(fell, gone).

group(blinded, hostile).
group(silenced, hostile).
group(rooted, hostile).
group(slowed, hostile).
group(wet, hostile).
group(oiled, hostile).
group(burning, hostile).
group(electrocuted, hostile).
group(taunted, hostile).
group(stunned, hostile).
group(chilled, hostile).
group(frozen, hostile).

group(stealthed, buff).
group(shielded, buff).
group(armored, buff).
group(invulnerable, buff).
group(flying, buff).
group(phased, buff).

% A guard comes off before anything else can land.
group(stealthed, guard).
group(shielded, guard).

% What a boss shrugs off.
group(stunned, hardControl).
group(frozen, hardControl).

hostile(?t) :- group(?t, hostile).

% === Reactions: what meets what, for everyone ===

% A shield takes the next hostile tag.
reaction(shielded, hostile, absorb).
effect(absorb, target, remove(shielded)).

% Water and fire put each other out; oil spreads fire.
reaction(wet, burning, steam).
effect(steam, target, remove(wet)).
reaction(burning, wet, extinguish).
effect(extinguish, target, remove(burning)).
reaction(oiled, burning, blaze).
reaction(burning, oiled, blaze).
effect(blaze, target, remove(oiled)).
effect(blaze, target, grant(burning)).
effect(blaze, area, grant(burning)).

% Cold on water freezes, whichever came first; fire undoes cold.
reaction(wet, chilled, freeze).
effect(freeze, target, remove(wet)).
effect(freeze, target, grant(frozen)).
reaction(chilled, wet, freezeOver).
effect(freezeOver, target, remove(chilled)).
effect(freezeOver, target, grant(frozen)).
reaction(chilled, burning, thaw).
effect(thaw, target, remove(chilled)).
reaction(frozen, burning, meltdown).
effect(meltdown, target, remove(frozen)).
effect(meltdown, target, grant(wet)).
reaction(burning, chilled, quench).
effect(quench, target, remove(burning)).

% === Looks: same play, different appearance ===

appearance(petrified, stunned).
appearance(paralyzed, stunned).
appearance(knockedDown, stunned).
appearance(dazed, stunned).
appearance(disarmed, blinded).
appearance(nearsighted, blinded).
appearance(webbed, slowed).
appearance(crippled, slowed).
appearance(snared, rooted).
appearance(entangled, rooted).
appearance(netted, rooted).
appearance(drenched, wet).
appearance(frostbitten, chilled).
appearance(encased, frozen).
appearance(ignited, burning).
appearance(shocked, electrocuted).
appearance(provoked, taunted).
appearance(invisible, stealthed).
appearance(camouflaged, stealthed).
appearance(warded, shielded).
appearance(barkskin, armored).
appearance(ironclad, armored).
appearance(untouchable, invulnerable).
appearance(hovering, flying).
appearance(blinking, phased).

% === Zones (a level places them with onEnter/2; skills spill them) ===

effect(puddle, target, grant(wet)).
effect(slick, target, grant(oiled)).
effect(flames, target, grant(burning)).
effect(iceSheet, target, grant(chilled)).
effect(shadows, target, grant(stealthed)).
effect(chasm, target, hazard(chasm)).
effect(lava, target, hazard(lava)).
effect(deepWater, target, grant(wet)).
effect(deepWater, target, hazard(deepWater)).
% magnetField: no effect on entering, only its aura (see Atomic tags).

hazardType(chasm).
hazardType(lava).
hazardType(deepWater).

% === Archetypes: who is weak to what ===

% Contractual boss immunity: no hard control. The atoms still land.
immune(?e, ?t) :- rank(?e, boss), group(?t, hardControl).

% Anything that walks falls; anything not made of fire burns in lava; the
% heavy sink.
weakness(?e, chasm, none, fell) :- not(trait(?e, flier)).
weakness(?e, lava, none, fell) :- not(trait(?e, flier)), not(element(?e, fire)).
weakness(?e, deepWater, none, fell) :- trait(?e, heavy).
immune(?e, forcedMove) :- trait(?e, heavy).

% Machines: a jolt stuns them; soaked first, they short-circuit.
weakness(?e, electrocuted, wet, dead) :- trait(?e, machine).
weakness(?e, electrocuted, none, stunned) :- trait(?e, machine).
% The living: soaked and jolted, they seize up.
weakness(?e, electrocuted, wet, stunned) :- trait(?e, living).
% Things of fire freeze solid; water creatures are all conductor.
weakness(?e, chilled, none, dead) :- element(?e, fire).
immune(?e, burning) :- element(?e, fire).
weakness(?e, electrocuted, none, dead) :- element(?e, water).
immune(?e, wet) :- element(?e, water).
% Cold-blooded insects freeze solid; wood burns.
weakness(?e, chilled, none, dead) :- trait(?e, insect).
weakness(?e, burning, none, dead) :- trait(?e, wooden).
% Anything frozen shatters under a stunning blow.
weakness(?e, stunned, frozen, dead).

% === Skills ===
% Every skill is a `skill` for silence.

kind(?ab, skill) :- reach(?ab, ?r).

% Hook: a light target is dragged to you (across a pit, it falls in) and
% plucked out of the air; an anchored one drags you to it.
reach(hook, ranged).
effect(hook, target, remove(flying)).
effect(hook, target, hook).

% Vortex: everything next to the target region is sucked into it.
reach(vortex, ranged).
effect(vortex, target, pullIn(all)).

% Tidal Wave: you stand in a flood - everyone here and next door is soaked,
% and whoever is next door is washed further away.
reach(tidalWave, self).
manaCost(tidalWave, 2).
effect(tidalWave, self, spill(puddle)).
effect(tidalWave, around, grant(wet)).
effect(tidalWave, around, push).

% Blizzard: the region ices over - everyone there, and whoever walks in
% later, is chilled; the wet freeze.
reach(blizzard, ranged).
manaCost(blizzard, 2).
effect(blizzard, target, spill(iceSheet)).

% Fireball: the impact region catches fire - everyone in it burns and it
% stays a fire zone - and the target is thrown out of it.
reach(fireball, ranged).
manaCost(fireball, 2).
effect(fireball, target, spill(flames)).
effect(fireball, target, push).

% Lightning Flash: become the lightning - everyone between you and where
% you land is struck, and so is whoever stands there.
reach(lightningFlash, ranged).
manaCost(lightningFlash, 2).
effect(lightningFlash, path, grant(electrocuted)).
effect(lightningFlash, target, grant(electrocuted)).
effect(lightningFlash, target, dash).

% Translocate: appear where you look - in an empty spot, or in someone's
% place, who appears in yours.
reach(translocate, ranged).
effect(translocate, target, relocate).

% Blinding Flash: you phase out for an instant and reappear in a flash that
% blinds everyone around and shows up whatever hides there.
reach(blindingFlash, self).
effect(blindingFlash, self, grant(phased)).
effect(blindingFlash, around, grant(blinded)).
effect(blindingFlash, around, remove(stealthed)).

% Taunt: it fixates on you and comes at you - and does what it does when
% provoked.
reach(taunt, ranged).
effect(taunt, target, grant(taunted)).

% Magnetic Orb: the region becomes a magnetic field; metal next to it is
% drawn in.
reach(magneticOrb, ranged).
manaCost(magneticOrb, 2).
effect(magneticOrb, target, spill(magnetField)).
effect(magneticOrb, target, pullIn(metal)).

% Shield Bash: stunned and knocked back.
reach(shieldBash, melee).
effect(shieldBash, target, grant(stunned)).
effect(shieldBash, target, push).

% === Enemy moves ===
% A level gives them to NPCs with behavior/4. Heavy ones are telegraphed.

% Ground Slam: everyone in the struck region is stunned and thrown back.
heavy(groundSlam).
effect(groundSlam, area, grant(stunned)).
effect(groundSlam, area, push).

% Cave-in: the struck floor gives way.
heavy(caveIn).
effect(caveIn, target, spill(chasm)).
