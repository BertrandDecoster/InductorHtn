% ab_catalog - the standard tags and skills
%
% Data for the ability layer. Every skill is written with the same few
% keywords, in three families:
%   tags      what is applied to whom: grant, remove, for good or for a
%             moment (moment(...): through the next cast by anyone)
%   movement  forced movement (push anywhere next door, pull to the caster,
%             draw into an area), dash, teleport, walk (a chase) - each
%             one link: see ab_effects for walkable links, gaps and walls
%   actions   interrupt (a magic heavy attack stops) and disjoint (for a
%             moment, untouchable: an attack aimed at you misses)
% plus terrain: zones a skill leaves on a region, and how zones react.
%
% Tags:
%   atomic      one meaning each: blinded, silenced, rooted, slowed, wet,
%               chilled, oiled, burning, electrocuted, taunted, stealthed,
%               shielded, disjoint; and what an entity is - heavy, flying,
%               filler, machine, living, insect, wooden, fireElemental,
%               waterElemental - so a skill can take it off
%   composite   stunned = blinded + silenced + rooted
%   outcome     dead, fell - never granted by a skill. Only an enemy's own
%               weakness, or a hazard it is weak to, produces one.
%   look        appearance(?look, ?tag): plays exactly like a catalogue tag,
%               only looks different. Frozen is a look of stunned.
%
% Chilled does nothing by itself: chilled meeting wet makes the bearer
% stunned (it looks frozen). Things of fire and insects die of it.
%
% Skills do no damage. Enemy moves are at the end: a heavy one is
% telegraphed (see ab_casting), and surviving it is what several skills are
% also for.

% === Atomic tags ===

forbids(blinded, attack).
forbids(blinded, watch).
forbids(silenced, skill).
forbids(rooted, move).
forbids(rooted, dash).
forbids(slowed, dash).

% Taunted: an NPC fixated on its taunter walks after it, and keeps
% following; when it cannot, the taunt is broken. A companion cannot be
% taunted.
onGrant(taunted, chase).
immune(?e, taunted) :- canAct(?e).

wards(stealthed, targeted).
% A shield takes the next hostile tag, or the next heavy blow (ab_casting).
wards(heavy, forcedMove).
wards(flying, fell).

% Disjoint: for a moment, nothing aimed at it lands - no hostile tag, no
% forced movement, no heavy blow.
wards(disjoint, targeted).
wards(disjoint, hostile).
wards(disjoint, forcedMove).
wards(disjoint, heavy).

% === Composites ===

bundles(stunned, blinded).
bundles(stunned, silenced).
bundles(stunned, rooted).

% === Groups ===

group(dead, gone).
group(fell, gone).

group(blinded, hostile).
group(silenced, hostile).
group(rooted, hostile).
group(slowed, hostile).
group(wet, hostile).
group(chilled, hostile).
group(oiled, hostile).
group(burning, hostile).
group(electrocuted, hostile).
group(taunted, hostile).
group(stunned, hostile).

group(stealthed, buff).
group(shielded, buff).
group(disjoint, buff).

% A guard comes off before anything else can land.
group(stealthed, guard).
group(shielded, guard).

% What a boss shrugs off.
group(stunned, hardControl).

hostile(?t) :- group(?t, hostile).

% === Reactions: what meets what, for everyone ===

% A shield takes the next hostile tag.
reaction(shielded, hostile, absorb).
effect(absorb, target, remove(shielded)).

% Water and fire put each other out; oil spreads fire; cold on water
% freezes (a stun), whichever came first; fire undoes cold.
reaction(wet, burning, steam).
effect(steam, target, remove(wet)).
reaction(burning, wet, extinguish).
effect(extinguish, target, remove(burning)).
reaction(oiled, burning, blaze).
reaction(burning, oiled, blaze).
effect(blaze, target, remove(oiled)).
effect(blaze, target, grant(burning)).
effect(blaze, area, grant(burning)).
reaction(wet, chilled, freeze).
effect(freeze, target, remove(wet)).
effect(freeze, target, grant(stunned)).
reaction(chilled, wet, freezeOver).
effect(freezeOver, target, remove(chilled)).
effect(freezeOver, target, grant(stunned)).
reaction(chilled, burning, thaw).
effect(thaw, target, remove(chilled)).
reaction(burning, chilled, quench).
effect(quench, target, remove(burning)).

% === Looks: same play, different appearance ===

appearance(frozen, stunned).
appearance(petrified, stunned).
appearance(paralyzed, stunned).
appearance(knockedDown, stunned).
appearance(dazed, stunned).
appearance(disarmed, blinded).
appearance(nearsighted, blinded).
appearance(webbed, slowed).
appearance(crippled, slowed).
appearance(snared, rooted).
appearance(entangled, rooted).
appearance(netted, rooted).
appearance(drenched, wet).
appearance(frostbitten, chilled).
appearance(ignited, burning).
appearance(shocked, electrocuted).
appearance(provoked, taunted).
appearance(invisible, stealthed).
appearance(camouflaged, stealthed).
appearance(warded, shielded).
appearance(armored, heavy).
appearance(hovering, flying).
appearance(blinking, disjoint).
appearance(misty, disjoint).

% === Terrain ===
% Zones a level places with onEnter/2, or a skill spills. Whoever is in the
% region when it is spilled, or walks in later, takes it.

effect(puddle, target, grant(wet)).
effect(slick, target, grant(oiled)).
effect(flames, target, grant(burning)).
effect(iceSheet, target, grant(slowed)).
effect(iceSheet, target, grant(chilled)).
effect(shadows, target, grant(stealthed)).
effect(chasm, target, hazard(chasm)).
effect(lava, target, hazard(lava)).
effect(deepWater, target, grant(wet)).
effect(deepWater, target, hazard(deepWater)).

% A gap between two areas is a short pit: whatever is forced across it
% falls in (a filler bridges it).
hazardType(gap).
hazardType(chasm).
hazardType(lava).
hazardType(deepWater).

% Zones meeting zones: water and lava freeze into a floor; fire melts ice
% and lights oil; cold puts fire out.
zoneReaction(deepWater, iceSheet, iceSheet).
zoneReaction(puddle, iceSheet, iceSheet).
zoneReaction(lava, iceSheet, none).
zoneReaction(iceSheet, flames, puddle).
zoneReaction(flames, iceSheet, puddle).
zoneReaction(slick, flames, flames).

% === Archetypes: who is weak to what ===

% Contractual boss immunity: no hard control. The atoms still land.
immune(?e, ?t) :- rank(?e, boss), group(?t, hardControl).

% Anything that walks falls; anything not made of fire burns in lava; the
% heavy sink.
weakness(?e, chasm, none, fell).
weakness(?e, gap, none, fell).
weakness(?e, lava, none, fell) :- not(has(?e, fireElemental)).
weakness(?e, deepWater, none, fell) :- has(?e, heavy).

% Machines: a jolt stuns them; soaked first, they short-circuit.
weakness(?e, electrocuted, wet, dead) :- has(?e, machine).
weakness(?e, electrocuted, none, stunned) :- has(?e, machine).
% The living: soaked and jolted, they seize up.
weakness(?e, electrocuted, wet, stunned) :- has(?e, living).
% Things of fire and insects die of the cold; water creatures are all
% conductor; wood burns.
weakness(?e, chilled, none, dead) :- has(?e, fireElemental).
immune(?e, burning) :- has(?e, fireElemental).
weakness(?e, chilled, none, dead) :- has(?e, insect).
weakness(?e, electrocuted, none, dead) :- has(?e, waterElemental).
immune(?e, wet) :- has(?e, waterElemental).
weakness(?e, burning, none, dead) :- has(?e, wooden).

% === Skills ===
% Every skill is a `skill` for silence.

kind(?ab, skill) :- reach(?ab, ?r).

% Hook: forced movement of the target toward the caster, from next door
% (an anchored target pulls the caster to it instead; across a gap, it
% falls in) + interrupt.
reach(hook, melee).
effect(hook, target, interrupt).
effect(hook, target, hook).

% Vortex: forced movement of everything next door into the target area +
% rooted, for a moment, on the NPCs there.
reach(vortex, ranged).
effect(vortex, target, pullIn).
effect(vortex, foes, moment(grant(rooted))).

% Tidal Wave: wet on everyone else in the caster's area + forced movement
% of each to a neighbouring area.
reach(tidalWave, self).
manaCost(tidalWave, 2).
effect(tidalWave, around, grant(wet)).
effect(tidalWave, around, push).

% Blizzard: the area ices over - slowed and chilled on everyone there, and
% on whoever walks in later.
reach(blizzard, ranged).
manaCost(blizzard, 2).
effect(blizzard, target, spill(iceSheet)).

% Fireball: the whole area catches fire - burning on everyone there and on
% whoever walks in later - + forced movement of the target to a
% neighbouring area (aim it anywhere: next to yourself, it throws you).
reach(fireball, ranged).
manaCost(fireball, 2).
effect(fireball, target, spill(flames)).
effect(fireball, target, push).

% Lightning Flash: electrocuted on everyone in the target area + the
% caster dashes there (next door, over a walkable link or a gap).
reach(lightningFlash, melee).
manaCost(lightningFlash, 2).
effect(lightningFlash, area, grant(electrocuted)).
effect(lightningFlash, target, dash).

% Blink: disjoint + the caster teleports next door, through any link.
reach(blink, near).
effect(blink, self, moment(grant(disjoint))).
effect(blink, target, teleport).

% Blinding Flash: disjoint + blinded and electrocuted on everyone else in
% the caster's area (allies included).
reach(blindingFlash, self).
effect(blindingFlash, self, moment(grant(disjoint))).
effect(blindingFlash, around, grant(blinded)).
effect(blindingFlash, around, grant(electrocuted)).

% Taunt: taunted (the NPC chases the caster; it sets off its behaviours).
reach(taunt, ranged).
effect(taunt, target, grant(taunted)).

% Turn to Mist: for a moment, the target is neither heavy nor shielded.
reach(turnToMist, ranged).
effect(turnToMist, target, moment(remove(heavy))).
effect(turnToMist, target, moment(remove(shielded))).

% Shield Bash: stunned + interrupt on the target; the caster is shielded
% (it takes the next hostile tag, or the next heavy blow).
reach(shieldBash, melee).
effect(shieldBash, target, interrupt).
effect(shieldBash, target, grant(stunned)).
effect(shieldBash, self, grant(shielded)).

% === Enemy moves ===
% A level gives them to NPCs with behavior/4. Heavy ones are telegraphed;
% magic ones can be interrupted, physical ones only survived. A blow's
% effects land on each one it falls on; a spill, on the area.

% Ground Slam (physical): stunned, and thrown to a neighbouring area.
heavy(groundSlam).
effect(groundSlam, target, grant(stunned)).
effect(groundSlam, target, push).

% Cave-in (physical): the struck floor gives way.
heavy(caveIn).
effect(caveIn, target, spill(chasm)).

% Meteor (magic): the struck area burns.
heavy(meteor).
kind(meteor, magic).
effect(meteor, target, spill(flames)).
