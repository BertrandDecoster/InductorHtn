% ab_casting - who may use an ability, from where, at what cost
%
% GAS activation gates on the caster and the target, and costs, as facts:
%   knows(?a, ?ab)                     the loadout - what a level varies
%   reach(?ab, self|melee|near|ranged) melee: the same area, or next door over
%                                      a walkable link or a gap; near: next door
%                                      over any link (a teleport through a
%                                      wall); ranged: line of sight
%   requires(?ab, caster|target, ?t)   must carry ?t
%   blockedBy(?ab, caster|target, ?t)  must not carry ?t (hammer: tired)
%   manaCost(?ab, ?n) + mana(?a, ?m)   paid with a fluent
%   once(?ab)                          one use per encounter; spent(?a, ?ab)
%   kind(?ab, spell|attack|dash)       what a forbidding tag checks; a ranged
%                                      ability is also of kind `ranged`
%
% A self-cast whose effects reach `around` the caster (a wave, a flash) is
% cast at an enemy by standing in its area.
%
% A tag the caster carries can forbid a kind (silenced: spell; disarmed:
% attack; blinded: ranged; stunned: any). A target whose tags ward
% `targeted` (stealthed) cannot be aimed at - only reached by an area
% effect or a zone. An ability may be aimed at a region.
%
% Anyone can cast anything they know - the player character, an AI
% companion, an NPC. Nothing here gates on role(?a, player).
%
% Heavy attacks. An NPC behaviour whose ability is heavy(?ab) does not land
% at once: the NPC winds up on what it aims at - an area, or an entity it
% follows wherever it goes - and the team gets one action: a cast, without
% walking, by any companion. Then the blow falls on everyone in the struck
% area but the NPC. The answers are skills:
%   leave the area        teleport, dash, be hooked or pushed out (not
%                         against a blow that follows its target)
%   disjoint              a moment untouchable: the blow passes through
%   shielded              the shield takes the blow, and breaks
%   interrupt             a magic attack (kind(?ab, magic)) stops; a
%                         physical one cannot be stopped
% A companion may also take the blow: sacrifice is allowed. Only what a
% level declares mustSurvive(?x) may never be caught - no plan lets it.
% The zone a blow leaves (a cave-in's chasm) is terrain: it takes whoever
% is there, the NPC and the disjoint included. Whatever else stands in the
% struck area takes the blow: it is also a weapon to turn on other enemies.
% An NPC already winding up does not start another.
%
% Time. Every cast ticks a clock. Something done "for a moment"
% (moment(Atom) in ab_effects) lasts through the next cast by anyone, then
% is undone - never in the middle of a heavy attack's window.
%

% === Operators ===

opCast(?a, ?ab, ?e) :-
    del(), add().

opSpendMana(?a, ?n) :-
    decrease(mana(?a), ?n).

opUseUp(?a, ?ab) :-
    del(), add(spent(?a, ?ab)).

opWindUp(?npc, ?ab, ?x) :-
    del(), add(windingUp(?npc, ?ab, ?x)).

opBlow(?npc, ?ab, ?x, ?r) :-
    del(windingUp(?npc, ?ab, ?x)), add().

opMiss(?npc, ?ab, ?x) :-
    del(windingUp(?npc, ?ab, ?x)), add().

opTick(?a, ?c, ?n) :-
    del(clock(?c)), add(clock(?n)).

opFirstTick(?a) :-
    del(), add(clock(1)).

opEndMoment(?e, ?t, ?how, ?u) :-
    del(lasts(?e, ?t, ?how, ?u)), add().

% === Rules ===

% Any reason ?a cannot use ?ab on ?e right now.
unmet(?a, ?ab, ?e) :- requires(?ab, caster, ?t), not(has(?a, ?t)).
unmet(?a, ?ab, ?e) :- requires(?ab, target, ?t), not(has(?e, ?t)).
unmet(?a, ?ab, ?e) :- blockedBy(?ab, caster, ?t), has(?a, ?t).
unmet(?a, ?ab, ?e) :- blockedBy(?ab, target, ?t), has(?e, ?t).
unmet(?a, ?ab, ?e) :- spent(?a, ?ab).
unmet(?a, ?ab, ?e) :- manaCost(?ab, ?n), not(mana(?a, ?m)).
unmet(?a, ?ab, ?e) :- manaCost(?ab, ?n), mana(?a, ?m), <(?m, ?n).
unmet(?a, ?ab, ?e) :- kindOf(?ab, ?k), forbidden(?a, ?k).
unmet(?a, ?ab, ?e) :- \==(?a, ?e), not(region(?e)), not(receptive(?e, targeted)).

kindOf(?ab, ?k) :- kind(?ab, ?k).
kindOf(?ab, ranged) :- reach(?ab, ranged).

ready(?a, ?ab, ?e) :-
    knows(?a, ?ab), not(gone(?a)), not(gone(?e)), not(unmet(?a, ?ab, ?e)).

% Where ?a can use ?ab on something in ?r from: melee is the same area or
% the next one (a blocker holding a chokepoint can still be hit); ranged
% needs line of sight. It prefers staying put, then any area it can walk to.
inRange(melee, ?from, ?r) :- =(?from, ?r).
inRange(melee, ?from, ?r) :- dashEdge(?from, ?r).
inRange(near, ?from, ?r) :- blinkEdge(?from, ?r).
inRange(ranged, ?from, ?r) :- canTarget(?from, ?r).
spot(?a, ?ab, ?r, ?from) :- reach(?ab, self), at(?a, ?from).
spot(?a, ?ab, ?r, ?from) :- reach(?ab, ?k), \==(?k, self), at(?a, ?from), inRange(?k, ?from, ?r).
spot(?a, ?ab, ?r, ?from) :-
    reach(?ab, ?k), \==(?k, self), at(?a, ?cur), region(?from), inRange(?k, ?from, ?r),
    canReach(?a, ?cur, ?from).
% Where a wave around ?a reaches ?r from: ?r itself.
aroundSpot(?a, ?r, ?r) :- at(?a, ?cur), canReach(?a, ?cur, ?r).

% Heavy attacks: where a blow on ?x falls (nowhere if it follows an entity
% that disjointed or is gone), and whether it would down someone.
struck(?x, ?x) :- region(?x).
struck(?x, ?r) :- not(region(?x)), at(?x, ?r), not(gone(?x)), not(warded(?x, heavy)).
endangered(?x) :-
    struck(?x, ?r),
    first(and(at(?a, ?r), mustSurvive(?a), not(gone(?a)), not(safeFrom(?a)))).
% A companion stands where the blow will fall: the team may answer.
atStake(?x) :- struck(?x, ?r), first(and(at(?a, ?r), canAct(?a), not(gone(?a)))).
% Safe from a heavy blow: disjoint, or behind a shield.
safeFrom(?a) :- warded(?a, heavy).
safeFrom(?a) :- has(?a, shielded).
winding() :- first(windingUp(?n, ?ab, ?x)).
% Anything a companion could aim at in the window: a region or an entity.
aimable(?x) :- region(?x).
aimable(?x) :- at(?x, ?r).
windowAim(?a, ?ab, ?a) :- reach(?ab, self), ready(?a, ?ab, ?a).
windowAim(?a, ?ab, ?x) :-
    reach(?ab, ?k), \==(?k, self), at(?a, ?from), aimable(?x), \==(?x, ?a), locus(?x, ?rx),
    inRange(?k, ?from, ?rx), ready(?a, ?ab, ?x).

% === Methods ===
%
% No `else`: each cost branch negates the other, so backtracking can never
% pick the free branch of something that has a cost.

% ?a uses ?ab on ?e from wherever it reaches; a wave around the caster, from
% ?e's area.
cast(?a, ?ab, ?e) :-
    if(canAct(?a), ready(?a, ?ab, ?e), locus(?e, ?r), first(spot(?a, ?ab, ?r, ?from))),
    do(castFrom(?a, ?ab, ?e, ?from)).
cast(?a, ?ab, ?e) :-
    if(canAct(?a), \==(?a, ?e), reach(?ab, self), first(effect(?ab, around, ?x)),
       ready(?a, ?ab, ?a), locus(?e, ?r), first(aroundSpot(?a, ?r, ?from))),
    do(castFrom(?a, ?ab, ?a, ?from)).

% ?a uses ?ab on ?e from a chosen region (a push needs the right side).
castFrom(?a, ?ab, ?e, ?from) :-
    if(canAct(?a), ready(?a, ?ab, ?e)),
    do(walkTo(?a, ?from), useAbility(?a, ?ab, ?e)).

% Gates are checked again once there: walking may have changed the caster.
% Every cast ticks the clock, and ends the moments that are over.
useAbility(?a, ?ab, ?e) :-
    if(ready(?a, ?ab, ?e), reach(?ab, ?k), at(?a, ?from), locus(?e, ?r), inRange(?k, ?from, ?r)),
    do(tick(?a), payMana(?a, ?ab), useUp(?a, ?ab), opCast(?a, ?ab, ?e),
       applyAbility(?a, ?ab, ?e, react)).
useAbility(?a, ?ab, ?a) :-
    if(ready(?a, ?ab, ?a), reach(?ab, self)),
    do(tick(?a), payMana(?a, ?ab), useUp(?a, ?ab), opCast(?a, ?ab, ?a),
       applyAbility(?a, ?ab, ?a, react)).

tick(?a) :- if(clock(?c), is(?n, +(?c, 1))), do(opTick(?a, ?c, ?n), expire()).
tick(?a) :- if(not(clock(?c))), do(opFirstTick(?a), expire()).

% A moment granted or taken at clock ?u is undone once the clock passes ?u -
% but never inside a heavy attack's window.
over(?e, ?t, ?how, ?u) :- clock(?c), lasts(?e, ?t, ?how, ?u), <(?u, ?c).
expire() :- if(winding()), do().
expire() :- if(not(winding()), not(first(over(?e, ?t, ?h, ?u)))), do().
expire() :- if(not(winding()), first(over(?e, ?t, ?h, ?u))), do(expireAll()).
expireAll() :- allOf, if(over(?e, ?t, ?how, ?u)), do(undo(?e, ?t, ?how, ?u)).
undo(?e, ?t, grant, ?u) :- if(tag(?e, ?t)), do(opEndMoment(?e, ?t, grant, ?u), opRemove(?e, ?e, ?t)).
undo(?e, ?t, grant, ?u) :- if(not(tag(?e, ?t))), do(opEndMoment(?e, ?t, grant, ?u)).
undo(?e, ?t, remove, ?u) :-
    if(not(tag(?e, ?t)), not(gone(?e))), do(opEndMoment(?e, ?t, remove, ?u), opGrant(?e, ?e, ?t)).
undo(?e, ?t, remove, ?u) :- if(tag(?e, ?t)), do(opEndMoment(?e, ?t, remove, ?u)).
undo(?e, ?t, remove, ?u) :- if(not(tag(?e, ?t)), gone(?e)), do(opEndMoment(?e, ?t, remove, ?u)).

payMana(?a, ?ab) :- if(manaCost(?ab, ?n)), do(opSpendMana(?a, ?n)).
payMana(?a, ?ab) :- if(not(manaCost(?ab, ?n))), do().

useUp(?a, ?ab) :- if(once(?ab)), do(opUseUp(?a, ?ab)).
useUp(?a, ?ab) :- if(not(once(?ab))), do().

% === Heavy attacks ===

telegraph(?npc, ?ab, ?x) :-
    if(not(first(windingUp(?npc, ?a0, ?x0)))),
    do(opWindUp(?npc, ?ab, ?x), brace(?npc, ?x), landBlow(?npc, ?ab, ?x)).
telegraph(?npc, ?ab, ?x) :- if(first(windingUp(?npc, ?a0, ?x0))), do().

% The window: with a companion in the struck area the team may act (one
% cast, by anyone) or take it; with someone who must survive, it must act.
brace(?npc, ?x) :- if(not(atStake(?x)), not(endangered(?x))), do().
brace(?npc, ?x) :- if(atStake(?x), not(endangered(?x))), do().
brace(?npc, ?x) :- if(atStake(?x)), do(respond(?npc)).
brace(?npc, ?x) :- if(not(atStake(?x)), endangered(?x)), do(respond(?npc)).
respond(?npc) :-
    if(canAct(?a), not(gone(?a)), knows(?a, ?ab), windowAim(?a, ?ab, ?y)),
    do(useAbility(?a, ?ab, ?y)).

% The blow: interrupted (nothing left to land); gone or missed; or it falls
% on everyone in the struck area but the NPC - never on someone who must
% survive (no clause: that plan fails). Each one it falls on: a disjoint
% one is passed through (and its disjoint spent); a shielded one's shield
% breaks; anyone else takes the ability. Then what it does to the area
% itself (a spill) happens.
landBlow(?npc, ?ab, ?x) :- if(not(windingUp(?npc, ?ab, ?x))), do().
landBlow(?npc, ?ab, ?x) :- if(windingUp(?npc, ?ab, ?x), gone(?npc)), do(opMiss(?npc, ?ab, ?x)).
landBlow(?npc, ?ab, ?x) :-
    if(windingUp(?npc, ?ab, ?x), not(gone(?npc)), not(struck(?x, ?r))), do(opMiss(?npc, ?ab, ?x)).
landBlow(?npc, ?ab, ?x) :-
    if(windingUp(?npc, ?ab, ?x), not(gone(?npc)), struck(?x, ?r), not(endangered(?x))),
    do(opBlow(?npc, ?ab, ?x, ?r), blowAll(?npc, ?ab, ?r), applyAbility(?npc, ?ab, ?r, raw)).
blowAll(?npc, ?ab, ?r) :-
    if(first(and(at(?y, ?r), \==(?y, ?npc), not(gone(?y))))), do(blowEach(?npc, ?ab, ?r)).
blowAll(?npc, ?ab, ?r) :- if(not(first(and(at(?y, ?r), \==(?y, ?npc), not(gone(?y)))))), do().
blowEach(?npc, ?ab, ?r) :-
    allOf, if(at(?y, ?r), \==(?y, ?npc), not(gone(?y))), do(blowOn(?npc, ?ab, ?y)).
blowOn(?npc, ?ab, ?y) :- if(tag(?y, disjoint)), do(opRemove(?npc, ?y, disjoint)).
blowOn(?npc, ?ab, ?y) :- if(not(tag(?y, disjoint)), warded(?y, heavy)), do().
blowOn(?npc, ?ab, ?y) :-
    if(not(warded(?y, heavy)), has(?y, shielded)), do(opRemove(?npc, ?y, shielded)).
blowOn(?npc, ?ab, ?y) :-
    if(not(warded(?y, heavy)), not(has(?y, shielded))), do(applyAbility(?npc, ?ab, ?y, raw)).
