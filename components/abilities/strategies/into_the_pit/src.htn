% into_the_pit - push it where it cannot come back from
%
% The recipe: a region whose arrival stops ?e (a pit, a chasm), and a push
% that lands ?e there. Something immune to forced movement has to lose its
% footing first: a tag that suspends the immunity, put on it directly, or
% the frozen composite that bundles it (soak, then chill). A flyer is not
% taken by the pit: it has to be brought down first.

% === Methods ===

% It can be moved: push it in, or pull it across so it falls in on the way.
intoThePit(?e) :-
    if(receptive(?e, forcedMove), dropFor(?r, ?e)),
    do(sendInto(?e, ?r, none), confirmStopped(?e)).

% It cannot: knock it off balance first, then someone else pushes.
intoThePit(?e) :-
    if(not(receptive(?e, forcedMove)), dropFor(?r, ?e), suspends(?t, forcedMove),
       canAct(?p), first(canInflict(?p, ?ab, ?t, ?e))),
    do(inflictAs(?p, ?t, ?e), sendInto(?e, ?r, ?p), confirmStopped(?e)).

% A tag it wears holds it in place (armour): someone takes it off, someone
% else pushes.
intoThePit(?e) :-
    if(not(receptive(?e, forcedMove)), dropFor(?r, ?e),
       first(and(has(?e, ?w), wards(?w, forcedMove))), canUnset(?p, ?ab, ?w, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(?w, ?e), sendInto(?e, ?r, ?p), confirmStopped(?e)).

% It flies over the pit: someone brings it down (a net, a grounding bolt,
% a dispel), someone else pushes.
intoThePit(?e) :-
    if(holds(?e, flying), receptive(?e, forcedMove), dropFor(?r, ?e),
       canUnset(?p, ?ab, flying, ?e, ?aim)),
    do(cast(?p, ?ab, ?aim), ensureOff(flying, ?e), sendInto(?e, ?r, ?p), confirmStopped(?e)).

% It cannot: someone lays a field on it whose aura loosens it (a magnetic
% field takes its armour and its footing), someone else pushes.
intoThePit(?e) :-
    if(not(receptive(?e, forcedMove)), dropFor(?r, ?e), at(?e, ?er), auraOf(?z, ?t),
       suspends(?t, forcedMove), canAct(?p), knows(?p, ?ab), effect(?ab, target, spill(?z)),
       ready(?p, ?ab, ?er)),
    do(cast(?p, ?ab, ?er), sendInto(?e, ?r, ?p), confirmStopped(?e)).

% It cannot, and freezing unbalances it: soak, chill, push.
intoThePit(?e) :-
    if(not(receptive(?e, forcedMove)), dropFor(?r, ?e), suspends(frozen, forcedMove),
       receptive(?e, frozen), receptive(?e, chilled), supplier(?p, wet, ?e)),
    do(supply(?p, wet, ?e), inflict(chilled, ?e, ?p), sendInto(?e, ?r, ?p),
       confirmStopped(?e)).
