% passage - getting everyone through: around, over, or by moving what is in
% the way
%
% The movement recipes. A level lays out its route with progress(?r, ?n)
% (higher is further along) and names its obstacles; these recipes say how
% each kind is overcome, each in several ways:
%
%   reach(?a, ?r)   walk; or leap forward one link and carry on - a dash
%                   over a gap, a teleport through a wall, a hook to
%                   something anchored next door, a swap, or an ally who
%                   swaps you forward
%   openWay(?d)     a door opens for good when something weighs down its
%                   plate: someone steps on, or something is knocked on
%   span(?f)        a pit is filled by knocking a filler into it - or left
%   bridge(?a, ?b)  a gap is bridged by forcing a filler into it - or left,
%                   for everyone to leap
%   clear(?e)       a blocker is dropped, moved out of its chokepoint, or
%                   left for everyone to get past
%
% Leaps only go forward along the route, so every decomposition ends.

% === Rules ===

selfMover(?ab) :- effect(?ab, target, dash).
selfMover(?ab) :- effect(?ab, target, teleport).
anchorHook(?ab) :- effect(?ab, target, hook).
swapper(?ab) :- effect(?ab, target, swap).
ahead(?from, ?to) :- progress(?from, ?n1), progress(?to, ?n2), >(?n2, ?n1).

% ?a lands at ?land by casting ?ab at ?aim from ?from, a region it can walk
% to. Cheap tests first; the route search last.
leap(?a, ?ab, ?from, ?land, ?land) :-
    knows(?a, ?ab), selfMover(?ab), reach(?ab, ?k), at(?a, ?cur), progress(?land, ?n),
    ahead(?cur, ?land), progress(?from, ?m), inRange(?k, ?from, ?land),
    ready(?a, ?ab, ?land), canReach(?a, ?cur, ?from).
leap(?a, ?ab, ?from, ?x, ?land) :-
    knows(?a, ?ab), anchorHook(?ab), reach(?ab, ?k), at(?a, ?cur), at(?x, ?land),
    anchoredAgainst(?x), ahead(?cur, ?land), progress(?from, ?m), inRange(?k, ?from, ?land),
    ready(?a, ?ab, ?x), canReach(?a, ?cur, ?from).
leap(?a, ?ab, ?from, ?x, ?land) :-
    knows(?a, ?ab), swapper(?ab), reach(?ab, ?k), at(?a, ?cur), at(?x, ?land), \==(?x, ?a),
    ahead(?cur, ?land), not(anchoredAgainst(?x)), progress(?from, ?m),
    inRange(?k, ?from, ?land), ready(?a, ?ab, ?x), canReach(?a, ?cur, ?from).

% ?b, standing ahead at ?land, swaps ?a forward to it.
ferry(?a, ?b, ?ab, ?land) :-
    canAct(?b), \==(?b, ?a), knows(?b, ?ab), swapper(?ab), at(?b, ?land), at(?a, ?cur),
    ahead(?cur, ?land), reach(?ab, ?k), inRange(?k, ?land, ?cur), ready(?b, ?ab, ?a).

% The plate of a door; something that fills a gap.
filler(?x) :- tag(?x, filler), not(gone(?x)).
% ?x, at one end of the gap ?a-?b, knocked into it or pulled across by ?p.
fillsGap(?p, ?ab, ?from, ?aim, ?x, ?a, ?b) :-
    at(?x, ?a), knocks(?p, ?ab, ?from, ?aim, ?x, gap(?b)).
fillsGap(?p, ?ab, ?from, ?aim, ?x, ?a, ?b) :-
    at(?x, ?b), knocks(?p, ?ab, ?from, ?aim, ?x, gap(?a)).
fillsGap(?p, ?ab, ?from, ?aim, ?x, ?a, ?b) :-
    at(?x, ?a), bringing(?p, ?ab, ?from, ?aim, ?x, ?b, fall).
fillsGap(?p, ?ab, ?from, ?aim, ?x, ?a, ?b) :-
    at(?x, ?b), bringing(?p, ?ab, ?from, ?aim, ?x, ?a, fall).
% The door a plate opens.
plateOf(?p, ?d) :- feature(?r, ?p, ?ab), plate(?p), effect(?ab, target, open(?d)).
plateOf(?p, ?d) :- plateFor(?p, ?d).

% === Methods ===

reach(?a, ?r) :- if(), do(reachWithin(?a, ?r, 2)).

reachWithin(?a, ?r, ?n) :- if(canReachNow(?a, ?r)), do(walkTo(?a, ?r)).
reachWithin(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), leap(?a, ?ab, ?from, ?aim, ?land), is(?m, -(?n, 1))),
    do(castFrom(?a, ?ab, ?aim, ?from), reachWithin(?a, ?r, ?m)).
reachWithin(?a, ?r, ?n) :-
    if(not(canReachNow(?a, ?r)), >(?n, 0), ferry(?a, ?b, ?ab, ?land), is(?m, -(?n, 1))),
    do(castFrom(?b, ?ab, ?a, ?land), reachWithin(?a, ?r, ?m)).

% A door that latches: already open; someone stands on its plate; or
% something else is knocked onto it.
openWay(?d) :- if(open(?d)), do().
openWay(?d) :-
    if(not(open(?d)), plateOf(?p, ?d), feature(?r, ?p, ?ab), canAct(?a)),
    do(reach(?a, ?r), stepOn(?a, ?p), confirmOpen(?d)).
openWay(?d) :-
    if(not(open(?d)), plateOf(?p, ?d), first(knocks(?a, ?ab, ?from, ?aim, ?x, feature(?p)))),
    do(castFrom(?a, ?ab, ?aim, ?from), confirmOpen(?d)).
confirmOpen(?d) :- if(open(?d)), do().

% A pit: already filled; filled by knocking a filler into it; or left for
% everyone to walk around.
span(?f) :- if(filledFeature(?f)), do().
span(?f) :- if(not(filledFeature(?f))), do().
span(?f) :-
    if(not(filledFeature(?f)), filler(?x), first(knocks(?a, ?ab, ?from, ?aim, ?x, feature(?f)))),
    do(castFrom(?a, ?ab, ?aim, ?from), confirmFilled(?f)).
confirmFilled(?f) :- if(filledFeature(?f)), do().

% A gap between ?a and ?b: already bridged; bridged by a filler forced
% into it; or left for everyone to leap.
bridge(?a, ?b) :- if(bridgedGap(?a, ?b)), do().
bridge(?a, ?b) :- if(not(bridgedGap(?a, ?b))), do().
bridge(?a, ?b) :-
    if(not(bridgedGap(?a, ?b)), filler(?x), first(fillsGap(?p, ?ab, ?from, ?aim, ?x, ?a, ?b))),
    do(castFrom(?p, ?ab, ?aim, ?from), confirmBridged(?a, ?b)).
confirmBridged(?a, ?b) :- if(bridgedGap(?a, ?b)), do().

% A blocker: dropped for good, moved out of its doorway, or left.
clear(?e) :- if(neutralized(?e)), do().
clear(?e) :- if(not(neutralized(?e))), do(neutralize(?e)).
clear(?e) :- if(not(neutralized(?e))), do(dislodge(?e)).
clear(?e) :- if(not(neutralized(?e))), do().
