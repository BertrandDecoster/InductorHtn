% neutralize - take an enemy out of the fight
%
% The goal. Its methods are the recipes, as plain alternatives: every one
% that works is a different plan. Specialized recipes come first; the last
% is a generic one-step improvisation (Killzone's "the generic branch is
% always available"). Every recipe ends by confirming the simulated world,
% so a recipe the level's physics does not support simply finds no plan.
%
% A guard (shield, stealth, invulnerability) is its own step: take it off,
% then neutralize again. The recursion ends because unset/2 only succeeds
% once the guard is gone, and an enemy carries finitely many.

% === Rules ===

guardUp(?e, ?t) :- first(and(tag(?e, ?t), group(?t, guard))).

% === Methods ===

neutralize(?e) :- if(neutralized(?e)), do().
neutralize(?e) :- if(not(neutralized(?e)), guardUp(?e, ?t)), do(unset(?t, ?e), neutralize(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(exploit(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(intoThePit(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(conduct(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(shatter(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(ignite(?e)).
neutralize(?e) :- if(not(neutralized(?e))), do(improvise(?e)).

% One cast that stops it: a tag that stops it, or damage it is vulnerable to.
improvise(?e) :-
    if(stops(?e, ?t), canInflict(?a, ?ab, ?t, ?e)),
    do(cast(?a, ?ab, ?e), confirmStopped(?e)).
improvise(?e) :-
    if(vulnerable(?e, ?type), canStrike(?a, ?ab, ?type, ?e)),
    do(cast(?a, ?ab, ?e), confirmStopped(?e)).
