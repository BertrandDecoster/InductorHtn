% Combos: every way the companions can take an enemy out of the fight.

% =============================================================================
% Goal: a menu of strategies, one plan per strategy that works
% =============================================================================

defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(wetAndElectrify(?t), opApplyTag(dead, ?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(stunAndSlow(?t), opApplyTag(dead, ?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(oilAndBurn(?t), opApplyTag(dead, ?t)).

% =============================================================================
% Strategies: if() says what makes it possible, do() lists the states to reach
% =============================================================================

% Wet, then electrified.
wetAndElectrify(?t) :-
    if(enemy(?t), not(immune(?t, wet)), not(immune(?t, electrified))),
    do(applyTag(wet, ?t), applyTag(electrified, ?t)).

% Stunned and, at the same moment, hit by a second companion's slow skill.
stunAndSlow(?t) :-
    if(enemy(?t), not(immune(?t, stunned)),
       skillAppliesTag(?stun, stunned), skillHasTag(?slow, slow), \==(?stun, ?slow),
       companion(?a1), companion(?a2), \==(?a1, ?a2)),
    do(prepareToUseSkill(?a1, ?stun, ?t), prepareToUseSkill(?a2, ?slow, ?t),
       opSynchronize(?a1, ?a2),
       useSkillOnTarget(?a1, ?stun, ?t), useSkillOnTarget(?a2, ?slow, ?t)).

% Oily, then burning.
oilAndBurn(?t) :-
    if(enemy(?t), not(immune(?t, oily)), not(immune(?t, burning))),
    do(applyTag(oily, ?t), applyTag(burning, ?t)).

% =============================================================================
% Verbs: each method is one way to reach the state
% =============================================================================

% ?t has ?tag.
applyTag(?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
applyTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag))), do(applyTagNotPresent(?tag, ?t)).

% Way 1: a companion uses a skill that applies it.
applyTagNotPresent(?tag, ?t) :- if(companion(?a), skillAppliesTag(?s, ?tag)),
    do(prepareToUseSkill(?a, ?s, ?t), useSkillOnTarget(?a, ?s, ?t)).
% Way 2: ?t stands at a location that applies it, or a lurer brings it there.
applyTagNotPresent(?tag, ?t) :- if(locationCanApplyTag(?l, ?tag), at(?t, ?l)),
    do(useLocationToApplyTag(?l, ?tag, ?t)).
applyTagNotPresent(?tag, ?t) :- if(locationCanApplyTag(?l, ?tag), not(at(?t, ?l)), companion(?lurer)),
    do(bringEnemyTo(?lurer, ?t, ?l), useLocationToApplyTag(?l, ?tag, ?t)).
% Way 3: a non-companion that holds such a skill hits ?t: they already share a location, or a lurer brings them together.
applyTagNotPresent(?tag, ?t) :- if(hasSkill(?ag, ?s), skillAppliesTag(?s, ?tag), not(companion(?ag)), \==(?ag, ?t), at(?ag, ?l), at(?t, ?l)),
    do(useAgentSkillToApplyTag(?ag, ?s, ?t)).
applyTagNotPresent(?tag, ?t) :- if(hasSkill(?ag, ?s), skillAppliesTag(?s, ?tag), not(companion(?ag)), \==(?ag, ?t), at(?ag, ?l), not(at(?t, ?l)), companion(?lurer)),
    do(bringAgentsTogether(?lurer, ?t, ?ag), useAgentSkillToApplyTag(?ag, ?s, ?t)).

% The location's tag lands on ?t, who stands there.
useLocationToApplyTag(?l, ?tag, ?t) :- if(at(?t, ?l)), do(opApplyTag(?tag, ?t)).

% The non-companion ?ag, standing with ?t, uses its skill on it.
useAgentSkillToApplyTag(?ag, ?s, ?t) :- if(at(?ag, ?l), at(?t, ?l)), do(useSkillOnTarget(?ag, ?s, ?t)).

% ?a holds ?s and stands with ?t: already has it, or gets it from an object first.
prepareToUseSkill(?a, ?s, ?t) :- if(hasSkill(?a, ?s)), do(goToSameLocation(?a, ?t)).
prepareToUseSkill(?a, ?s, ?t) :- if(companion(?a), not(hasSkill(?a, ?s)), object(?o), canGetSkillFrom(?o, ?s)),
    do(goToSameLocation(?a, ?o), getSkillFrom(?a, ?o, ?s), goToSameLocation(?a, ?t)).

% ?a, standing at object ?o, learns ?s; it replaces their current skill, if any.
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), hasSkill(?a, ?old)), do(opSwapSkill(?a, ?old, ?s)).
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), not(hasSkill(?a, ?any))), do(opGetSkill(?a, ?s)).

% ?a, holding ?s and standing with ?t, uses it; its tags land on ?t.
useSkillOnTarget(?a, ?s, ?t) :- if(hasSkill(?a, ?s), at(?a, ?l), at(?t, ?l)), do(opUseSkill(?a, ?s, ?t), applySkillTags(?s, ?t)).

applySkillTags(?s, ?t) :- allOf, if(skillAppliesTag(?s, ?tag), not(hasTag(?t, ?tag)), not(immune(?t, ?tag))),
    do(opApplyTag(?tag, ?t)).
applySkillTags(?s, ?t) :- if(not(skillAppliesTag(?s, ?tag), not(hasTag(?t, ?tag)), not(immune(?t, ?tag)))),
    do().

% ?a stands where ?t is.
goToSameLocation(?a, ?t) :- if(at(?t, ?l)), do(goToLocation(?a, ?l)).

% ?a is at ?l; the engine finds the path. Enemies after ?a follow.
goToLocation(?a, ?l) :- if(at(?a, ?l)), do(opStayInLocation(?a)).
goToLocation(?a, ?l) :- if(location(?l), at(?a, ?from), \==(?from, ?l)),
    do(opMoveTo(?a, ?from, ?l), enemiesFollow(?a, ?from, ?l)).

enemiesFollow(?a, ?from, ?l) :- allOf, if(hasAggro(?e, ?a), at(?e, ?from), not(static(?e))), do(opAggroMoveTo(?e, ?from, ?l)).
enemiesFollow(?a, ?from, ?l) :- if(not(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)))), do().

% ?e is after ?a: already, instead of another target, or for the first time.
getAggro(?e, ?a) :- if(hasAggro(?e, ?a)), do(opTargetAlreadyAggroed(?e, ?a)).
getAggro(?e, ?a) :- if(hasAggro(?e, ?old), \==(?old, ?a)), do(opRemoveAggro(?e, ?old), opAggro(?e, ?a)).
getAggro(?e, ?a) :- if(not(hasAggro(?e, ?any))), do(opAggro(?e, ?a)).

% Enemy ?e is at ?l: the lurer walks to it, takes its aggro, and walks to ?l.
bringEnemyTo(?lurer, ?e, ?l) :- if(at(?e, ?l)), do(opEnemyAlreadyAtLocation(?e, ?l)).
bringEnemyTo(?lurer, ?e, ?l) :- if(enemy(?e), not(static(?e)), not(at(?e, ?l))),
    do(goToSameLocation(?lurer, ?e), getAggro(?e, ?lurer), goToLocation(?lurer, ?l)).

% ?a1 and ?a2 share a location: whichever can move is lured to the other.
bringAgentsTogether(?lurer, ?a1, ?a2) :- if(at(?a1, ?l), at(?a2, ?l)), do(opAgentsAlreadyTogether(?a1, ?a2)).
bringAgentsTogether(?lurer, ?a1, ?a2) :- if(not(static(?a1)), at(?a2, ?l), not(at(?a1, ?l))), do(bringEnemyTo(?lurer, ?a1, ?l)).
bringAgentsTogether(?lurer, ?a1, ?a2) :- if(static(?a1), at(?a1, ?l), not(at(?a2, ?l))), do(bringEnemyTo(?lurer, ?a2, ?l)).

% =============================================================================
% Operators: game actions
% =============================================================================

opMoveTo(?who, ?from, ?to) :- del(at(?who, ?from)), add(at(?who, ?to)).
opAggroMoveTo(?e, ?from, ?to) :- del(at(?e, ?from)), add(at(?e, ?to)).
opUseSkill(?a, ?s, ?t) :- del(), add().
opSynchronize(?a1, ?a2) :- del(), add().
opApplyTag(?tag, ?t) :- del(), add(hasTag(?t, ?tag)).
opAggro(?e, ?a) :- del(), add(hasAggro(?e, ?a)).
opRemoveAggro(?e, ?a) :- del(hasAggro(?e, ?a)), add().
opGetSkill(?a, ?s) :- del(), add(hasSkill(?a, ?s)).
opSwapSkill(?a, ?old, ?s) :- del(hasSkill(?a, ?old)), add(hasSkill(?a, ?s)).

% Already true: no state change, the plan shows it.
opStayInLocation(?a) :- del(), add().
opTagAlreadyOnTarget(?tag, ?t) :- del(), add().
opTargetAlreadyAggroed(?e, ?a) :- del(), add().
opEnemyAlreadyAtLocation(?e, ?l) :- del(), add().
opAgentsAlreadyTogether(?a1, ?a2) :- del(), add().

% =============================================================================
% Sample world
% =============================================================================

companion(player). companion(pyro).
enemy(gob). enemy(tower).
static(tower).
object(shrine).

location(camp). location(hut). location(lake). location(peak). location(kitchen). location(forge).
at(player, camp). at(pyro, camp).
at(gob, hut). at(tower, peak).
at(shrine, forge).

locationCanApplyTag(lake, wet).
locationCanApplyTag(kitchen, oily).

hasSkill(player, iceBlastSkill). skillAppliesTag(iceBlastSkill, stunned).
hasSkill(pyro, fireballSkill). skillAppliesTag(fireballSkill, burning). skillHasTag(fireballSkill, slow).
hasSkill(tower, lightningSkill). skillAppliesTag(lightningSkill, electrified).
canGetSkillFrom(shrine, fireballSkill).

goals(defeat(gob)).
