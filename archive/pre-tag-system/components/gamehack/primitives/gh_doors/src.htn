% gh_doors - a locked door opens when two companions stand on its two plates at the same moment.
% opSynchronizeOnPlates is played by the engine; opUnlock changes the state.

% === Signatures (for TYP001 linter) ===
signature(opSynchronizeOnPlates, [agent, agent, plate, plate]).
signature(opUnlock, [door]).
signature(opDoorAlreadyUnlocked, [door]).
signature(unlockDoor, [door]).

% === Operators ===

opSynchronizeOnPlates(?a1, ?a2, ?p1, ?p2) :- del(), add().
opUnlock(?d) :- del(locked(?d)), add().

% Already true: no state change, the plan shows it.
opDoorAlreadyUnlocked(?d) :- del(), add().

% === Methods ===

% ?d is not locked: two companions stand on its two plates together, or it already is.
unlockDoor(?d) :- if(locked(?d), plateOpens(?p1, ?d), plateOpens(?p2, ?d), \==(?p1, ?p2),
    companion(?a1), companion(?a2), \==(?a1, ?a2)),
    do(opSynchronizeOnPlates(?a1, ?a2, ?p1, ?p2), opUnlock(?d)).
unlockDoor(?d) :- if(not(locked(?d))), do(opDoorAlreadyUnlocked(?d)).
