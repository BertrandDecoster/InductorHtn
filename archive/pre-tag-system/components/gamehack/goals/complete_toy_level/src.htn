% complete_toy_level - goal of the M0 toy level: unlock door1, then defeat gob1.
% The enemy and the door are named because this goal belongs to one authored level.

% === Signatures (for TYP001 linter) ===
signature(completeToyLevel, []).

completeToyLevel() :- if(locked(door1), enemy(gob1)),
    do(unlockDoor(door1), defeat(gob1)).

completeToyLevel() :- if(not(locked(door1)), enemy(gob1)),
    do(defeat(gob1)).

completeToyLevel() :- if(not(enemy(gob1))),
    do().
