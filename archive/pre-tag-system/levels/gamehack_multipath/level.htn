% GameHack Multipath Level
% All three strategies work at once, and every way to apply a tag is exercised
% (a companion skill, a location, a non-companion skill). defeat(gob) returns many plans.

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, companionA).
type(agent, companionB).
type(agent, companionC).
type(agent, gob).
type(agent, teslaTower).
type(agent, iceElemental).

% Locations (named positions in the world)
type(location, arena).
type(location, forge).
type(location, glacier).
type(location, lakeShore).
type(location, sea).
type(location, volcano).

% Objects (grant skills)
type(object, volcanoShrine).
type(object, glacierShrine).
type(object, shoreShrine).

% Tags (status effects)
type(tag, wet).
type(tag, electrified).
type(tag, clean).
type(tag, stunned).
type(tag, burning).
type(tag, slow).

% Skills (abilities)
type(skill, waterSkill).
type(skill, fireballSkill).
type(skill, lightningSkill).
type(skill, iceBlastSkill).

% === Agents ===
companion(player).
companion(companionA).
companion(companionB).
companion(companionC).
enemy(gob).
enemy(teslaTower).
enemy(iceElemental).

% === Positions ===
at(player, arena).
at(companionA, arena).
at(companionB, forge).
at(companionC, glacier).
at(gob, arena).
at(teslaTower, lakeShore).
at(iceElemental, glacier).

% === Locations ===
location(arena).
location(forge).
location(glacier).
location(lakeShore).
location(sea).
location(volcano).

% === Environment: locations that apply tags ===
locationCanApplyTag(lakeShore, wet).
locationCanApplyTag(sea, wet).
locationCanApplyTag(glacier, stunned).

% === Static entities (cannot be lured) ===
static(teslaTower).

% === Skills currently held ===
hasSkill(companionA, waterSkill).
hasSkill(companionB, fireballSkill).
hasSkill(teslaTower, lightningSkill).
hasSkill(iceElemental, iceBlastSkill).

% === Skill -> tag mappings ===
skillAppliesTag(waterSkill, wet).
skillAppliesTag(waterSkill, clean).
skillAppliesTag(lightningSkill, electrified).
skillAppliesTag(fireballSkill, burning).
skillAppliesTag(iceBlastSkill, stunned).

% === Slow modifier on fireballSkill unlocks stunAndSlow ===
skillHasTag(fireballSkill, slow).

% === Objects that grant a skill ===
object(volcanoShrine).
at(volcanoShrine, volcano).
canGetSkillFrom(volcanoShrine, fireballSkill).
object(glacierShrine).
at(glacierShrine, glacier).
canGetSkillFrom(glacierShrine, iceBlastSkill).
object(shoreShrine).
at(shoreShrine, lakeShore).
canGetSkillFrom(shoreShrine, waterSkill).

% === Level Goal ===
goals(defeat(gob)).
