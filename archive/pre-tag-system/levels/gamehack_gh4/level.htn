% GameHack GH4 Level: GH4-style world state
% Two companions with direct skills (companionE: lightning, companionW: water)
% Only wetAndElectrify works (no stun or slow skill)

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, companionE).
type(agent, companionW).
type(agent, gob).
type(agent, mimic).
type(agent, electricityElemental).
type(agent, teslaTower).

% Locations (named positions in the world)
type(location, room).
type(location, inn).
type(location, hut).
type(location, mountain).
type(location, lake).
type(location, sea).

% Tags (status effects)
type(tag, wet).
type(tag, electrified).
type(tag, clean).
type(tag, stunned).
type(tag, burning).
type(tag, slow).

% Skills (abilities)
type(skill, lightningSkill).
type(skill, waterSkill).

% === Agents ===
companion(player).
companion(companionE).
companion(companionW).
enemy(gob).
enemy(mimic).
enemy(electricityElemental).
enemy(teslaTower).

% === Positions ===
at(player, room).
at(companionE, hut).
at(companionW, inn).
at(mimic, room).
at(gob, hut).
at(electricityElemental, mountain).
at(teslaTower, lake).

% === Locations ===
location(room).
location(inn).
location(hut).
location(mountain).
location(lake).
location(sea).

% === Environment ===
locationCanApplyTag(lake, wet).
locationCanApplyTag(sea, wet).

immune(electricityElemental, electrified).

static(teslaTower).

% === Skills ===
hasSkill(companionE, lightningSkill).
hasSkill(companionW, waterSkill).
hasSkill(teslaTower, lightningSkill).
hasSkill(electricityElemental, lightningSkill).

skillAppliesTag(lightningSkill, electrified).
skillAppliesTag(waterSkill, wet).
skillAppliesTag(waterSkill, clean).

% === Level Goal ===
goals(defeat(gob)).
