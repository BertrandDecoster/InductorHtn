companion(player). companion(mage).
at(player, gate). at(mage, gate).
knows(player, gust). knows(mage, hook). knows(mage, quake).
skillKind(gust, push). skillKind(hook, pull). skillKind(quake, quake). skillKind(jeer, taunt).
at(ogre, hall).
