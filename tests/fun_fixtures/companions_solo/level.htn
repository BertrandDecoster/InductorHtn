% FIXTURE: companions_solo
% Failure mode: the companions can win without the player.
% Must be flagged by: F6 (soloable_plans > 0) - a hard fail.
%
% Two genuinely distinct routes of reasonable length, so F1, F2 and F3 are
% satisfied. The problem is who does the work: every operator can bind to a
% companion, so most plans never involve the player at all. That breaks the
% "companions should not be able to solo the map" principle (GDD 3.6) and the
% "player is the conductor" pillar with it.

% === World ===
enemy(gob).
at(gob, hall).

ally(player).
ally(companionA).
ally(companionB).
at(player, hall).
at(companionA, hall).
at(companionB, hall).

hasSkill(companionA, wetSkill).
hasSkill(companionB, shockSkill).
hasSkill(companionA, ropeSkill).
hasSkill(companionB, pitSkill).
hasSkill(player, wetSkill).

% === Route A operators ===
opDouse(?a, ?t) :- del(), add(hasTag(?t, wet)).
opCharge(?a) :- del(), add(charged(?a)).
opDischarge(?a, ?t) :- del(), add(hasTag(?t, shocked)).

% === Route B operators ===
opDigPit(?a) :- del(), add(pitReady(?a)).
opSnare(?a, ?t) :- del(), add(hasTag(?t, snared)).
opTopple(?a, ?t) :- del(), add(hasTag(?t, fallen)).

% === Two routes, neither requiring the player ===
defeat(?t) :- if(enemy(?t)), do(theShockRoute(?t)).
defeat(?t) :- if(enemy(?t)), do(thePitRoute(?t)).

theShockRoute(?t) :-
    if(ally(?a1), ally(?a2), \==(?a1, ?a2),
       hasSkill(?a1, wetSkill), hasSkill(?a2, shockSkill)),
    do(opDouse(?a1, ?t), opCharge(?a2), opDischarge(?a2, ?t)).

thePitRoute(?t) :-
    if(ally(?a1), ally(?a2), \==(?a1, ?a2),
       hasSkill(?a1, pitSkill), hasSkill(?a2, ropeSkill)),
    do(opDigPit(?a1), opSnare(?a2, ?t), opTopple(?a1, ?t)).

goals(defeat(gob)).
