% FIXTURE: one_to_one - a matching exercise
% Burning skills beat the goblin, frost skills beat the imp, wind does nothing.
% Feasibility sits inside its band (four of ten pairs win) and nothing is
% mandatory, so the counts look healthy. `multi_use_factor` is the only
% metric that sees each pick solves exactly one blocker: the player is
% filling in a form, not finding a combination.

enemy(gob).
enemy(imp).
at(gob, hall).
at(imp, vault).

companion(player).
at(player, hall).

vulnerableTo(gob, burning).
vulnerableTo(imp, frozen).

skillAppliesTag(fireSkill, burning).
skillAppliesTag(emberSkill, burning).
skillAppliesTag(iceSkill, frozen).
skillAppliesTag(frostSkill, frozen).
skillAppliesTag(windSkill, gust).

% Default kit so the level itself is solvable; F4 strips it.
hasSkill(player, fireSkill).
hasSkill(player, iceSkill).

opReady(?a, ?t) :- del(), add(readied(?a, ?t)).
opStrike(?a, ?tag, ?t) :- del(), add(hasTag(?t, ?tag)).

defeat(?t) :-
    if(enemy(?t), vulnerableTo(?t, ?tag), companion(?a),
       hasSkill(?a, ?s), skillAppliesTag(?s, ?tag)),
    do(opReady(?a, ?t), opStrike(?a, ?tag, ?t)).

clearBoth :- if(), do(defeat(gob), defeat(imp)).

funChoiceSpace(kit, 2).
funChoice(kit, fireSkill).
funChoice(kit, emberSkill).
funChoice(kit, iceSkill).
funChoice(kit, frostSkill).
funChoice(kit, windSkill).
funChoiceFact(fireSkill, hasSkill(player, fireSkill)).
funChoiceFact(emberSkill, hasSkill(player, emberSkill)).
funChoiceFact(iceSkill, hasSkill(player, iceSkill)).
funChoiceFact(frostSkill, hasSkill(player, frostSkill)).
funChoiceFact(windSkill, hasSkill(player, windSkill)).
funBlocker(gob).
funBlocker(imp).
funBlockerGoal(gob, defeat(gob)).
funBlockerGoal(imp, defeat(imp)).

goals(clearBoth).
