% FIXTURE: one_shot
% Failure mode: a single operator wins.
% Must be flagged by: F3 (plan_length below the minimum; causal_depth 1).
%
% "Is 'I cast fireball and everyone dies' a satisfying plan?" - GDD 3.6.
% Three different fireballs do not fix it: each route is still one button, so
% F1 and F2 are satisfied while the thing the player actually does is trivial.

% === World ===
enemy(gob).
companion(player).
at(player, hall).
at(gob, hall).

hasSkill(player, fireballSkill).
hasSkill(player, lightningSkill).
hasSkill(player, meteorSkill).

% === Operators ===
opFireball(?a, ?t) :- del(), add(hasTag(?t, burning)).
opLightning(?a, ?t) :- del(), add(hasTag(?t, electrified)).
opMeteor(?a, ?t) :- del(), add(hasTag(?t, crushed)).

% === Three routes, one operator each ===
defeat(?t) :- if(enemy(?t), companion(?a), hasSkill(?a, fireballSkill)), do(opFireball(?a, ?t)).
defeat(?t) :- if(enemy(?t), companion(?a), hasSkill(?a, lightningSkill)), do(opLightning(?a, ?t)).
defeat(?t) :- if(enemy(?t), companion(?a), hasSkill(?a, meteorSkill)), do(opMeteor(?a, ?t)).

goals(defeat(gob)).
