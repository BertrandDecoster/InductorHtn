% Assembled level: gamehack_gh7

% === Component: gamehack/primitives/gh_tags ===
% gh_tags - a skill's tags land on its target, combining with the location tag it carries; arriving lands a location's tag.
% The physics: locationCombo facts, and agent/1 (every companion, neutral and enemy).

% === Signatures (for TYP001 linter) ===
signature(opApplyTag, [tag, agent]).
signature(opUseSkill, [agent, skill, agent]).
signature(opAddLocationTag, [tag, location]).
signature(opRemoveLocationTag, [tag, location]).
signature(opTagAlreadyOnTarget, [tag, agent]).
signature(useSkillOnTarget, [agent, skill, agent]).
signature(applySkillTags, [skill, agent]).
signature(landSkillTag, [tag, agent]).
signature(landTag, [tag, agent]).
signature(landLocationTag, [agent, location]).
signature(tagEveryoneAt, [tag, location]).
signature(defeatVulnerable, [agent, tag, tag]).
signature(defeatVulnerableAt, [tag, tag, location]).

% === The tags (levels don't redeclare them) ===
type(tag, wet). type(tag, oil). type(tag, ice). type(tag, burning).
type(tag, electrified). type(tag, chilled). type(tag, stunned). type(tag, dead).

% === Operators ===

opUseSkill(?a, ?s, ?t) :- del(), add().
opApplyTag(?tag, ?t) :- del(), add(hasTag(?t, ?tag)).
opAddLocationTag(?tag, ?l) :- del(), add(locationCanApplyTag(?l, ?tag)).
opRemoveLocationTag(?tag, ?l) :- del(locationCanApplyTag(?l, ?tag)), add().

% Already true: no state change, the plan shows it.
opTagAlreadyOnTarget(?tag, ?t) :- del(), add().

% === Methods ===

% ?a, holding ?s and standing with ?t, uses it; each of its tags lands on ?t.
useSkillOnTarget(?a, ?s, ?t) :- if(hasSkill(?a, ?s), at(?a, ?l), at(?t, ?l)), do(opUseSkill(?a, ?s, ?t), applySkillTags(?s, ?t)).

applySkillTags(?s, ?t) :- allOf, if(skillAppliesTag(?s, ?tag)), do(landSkillTag(?tag, ?t)).
applySkillTags(?s, ?t) :- if(not(skillAppliesTag(?s, ?tag))), do().

% A skill's tag lands on ?t, and combines with the location tag ?t carries.
% Electrified on a wet ?t in water: everyone there is electrified; the vulnerable are defeated.
landSkillTag(electrified, ?t) :- if(hasTag(?t, wet), at(?t, ?l), locationCanApplyTag(?l, wet)),
    do(tagEveryoneAt(electrified, ?l), defeatVulnerableAt(wet, electrified, ?l)).
% Electrified on a wet ?t out of the water: ?t alone.
landSkillTag(electrified, ?t) :- if(hasTag(?t, wet), at(?t, ?l), not(locationCanApplyTag(?l, wet))),
    do(landTag(electrified, ?t), defeatVulnerable(?t, wet, electrified)).
% Burning on an oiled ?t on the oil: the oil catches fire and everyone there burns; the vulnerable are defeated.
landSkillTag(burning, ?t) :- if(hasTag(?t, oil), at(?t, ?l), locationCanApplyTag(?l, oil)),
    do(opRemoveLocationTag(oil, ?l), opAddLocationTag(burning, ?l),
       tagEveryoneAt(burning, ?l), defeatVulnerableAt(oil, burning, ?l)).
% Burning on an oiled ?t off the oil: ?t alone.
landSkillTag(burning, ?t) :- if(hasTag(?t, oil), at(?t, ?l), not(locationCanApplyTag(?l, oil))),
    do(landTag(burning, ?t), defeatVulnerable(?t, oil, burning)).
% Chilled on a wet or iced ?t: ?t alone is stunned; if vulnerable, defeated.
landSkillTag(chilled, ?t) :- if(first(hasTag(?t, ?base), locationCombo(?base, chilled))),
    do(landTag(stunned, ?t), defeatVulnerable(?t, ?base, chilled)).
% No combo on ?t: the tag just lands.
landSkillTag(?tag, ?t) :- if(not(hasTag(?t, ?base), locationCombo(?base, ?tag))),
    do(landTag(?tag, ?t)).

% ?t has ?tag, unless it is immune.
landTag(?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag))), do(opApplyTag(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), immune(?t, ?tag)), do().

% ?x, arriving at ?l, gets the location's tag, if it has one, with its combo (oil walking into fire).
landLocationTag(?x, ?l) :- if(locationCanApplyTag(?l, ?tag)), do(landSkillTag(?tag, ?x)).
landLocationTag(?x, ?l) :- if(not(locationCanApplyTag(?l, ?tag))), do().

% Every agent at ?l gets ?tag: companions, neutrals and enemies alike.
tagEveryoneAt(?tag, ?l) :- allOf, if(agent(?a), at(?a, ?l)), do(landTag(?tag, ?a)).
tagEveryoneAt(?tag, ?l) :- if(not(agent(?a), at(?a, ?l))), do().

% An enemy vulnerable to this location combo is out of the fight.
defeatVulnerable(?e, ?base, ?tag) :- if(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead))), do(opApplyTag(dead, ?e)).
defeatVulnerable(?e, ?base, ?tag) :- if(not(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead)))), do().

defeatVulnerableAt(?base, ?tag, ?l) :- allOf, if(enemy(?e), at(?e, ?l)), do(defeatVulnerable(?e, ?base, ?tag)).
defeatVulnerableAt(?base, ?tag, ?l) :- if(not(enemy(?e), at(?e, ?l))), do().

% === The physics: which location tag combines with which skill tag ===

agent(?x) :- companion(?x).
agent(?x) :- neutral(?x).
agent(?x) :- enemy(?x).

locationCombo(wet, electrified).
locationCombo(oil, burning).
locationCombo(wet, chilled).
locationCombo(ice, chilled).


% === Component: gamehack/primitives/gh_movement ===
% gh_movement - one-step movement: an agent goes to any location, the engine finds the path.
% Enemies after the mover follow it; arriving lands the location's tag.
% Depends on: gh_tags (landLocationTag)

% === Signatures (for TYP001 linter) ===
signature(opMoveTo, [agent, location, location]).
signature(opAggroMoveTo, [agent, location, location]).
signature(opStayInLocation, [agent]).
signature(goToLocation, [agent, location]).
signature(goToSameLocation, [agent, agent]).
signature(enemiesFollow, [agent, location, location]).

% === Operators ===

opMoveTo(?who, ?from, ?to) :- del(at(?who, ?from)), add(at(?who, ?to)).
opAggroMoveTo(?e, ?from, ?to) :- del(at(?e, ?from)), add(at(?e, ?to)).

% Already true: no state change, the plan shows it.
opStayInLocation(?a) :- del(), add().

% === Methods ===

% ?a stands where ?t is.
goToSameLocation(?a, ?t) :- if(at(?t, ?l)), do(goToLocation(?a, ?l)).

% ?a is at ?l and has its tag; the engine finds the path. Enemies after ?a follow.
goToLocation(?a, ?l) :- if(at(?a, ?l)), do(opStayInLocation(?a)).
goToLocation(?a, ?l) :- if(location(?l), at(?a, ?from), \==(?from, ?l)),
    do(opMoveTo(?a, ?from, ?l), landLocationTag(?a, ?l), enemiesFollow(?a, ?from, ?l)).

% Every enemy after ?a that stood with it moves with it.
enemiesFollow(?a, ?from, ?l) :- allOf, if(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead))),
    do(opAggroMoveTo(?e, ?from, ?l), landLocationTag(?e, ?l)).
enemiesFollow(?a, ?from, ?l) :- if(not(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead)))), do().


% === Component: gamehack/primitives/gh_aggro ===
% gh_aggro - aggro and luring: an enemy takes a companion as its target and follows it.
% Depends on: gh_movement (goToLocation, goToSameLocation)

% === Signatures (for TYP001 linter) ===
signature(opAggro, [agent, agent]).
signature(opRemoveAggro, [agent, agent]).
signature(opTargetAlreadyAggroed, [agent, agent]).
signature(opEnemyAlreadyAtLocation, [agent, location]).
signature(getAggro, [agent, agent]).
signature(bringEnemyTo, [agent, agent, location]).

% === Operators ===

opAggro(?e, ?a) :- del(), add(hasAggro(?e, ?a)).
opRemoveAggro(?e, ?a) :- del(hasAggro(?e, ?a)), add().

% Already true: no state change, the plan shows it.
opTargetAlreadyAggroed(?e, ?a) :- del(), add().
opEnemyAlreadyAtLocation(?e, ?l) :- del(), add().

% === Methods ===

% ?e is after ?a: already, instead of another target, or for the first time.
getAggro(?e, ?a) :- if(hasAggro(?e, ?a)), do(opTargetAlreadyAggroed(?e, ?a)).
getAggro(?e, ?a) :- if(hasAggro(?e, ?old), \==(?old, ?a)), do(opRemoveAggro(?e, ?old), opAggro(?e, ?a)).
getAggro(?e, ?a) :- if(not(hasAggro(?e, ?any))), do(opAggro(?e, ?a)).

% Enemy ?e is at ?l: the lurer walks to it, takes its aggro, and walks to ?l.
bringEnemyTo(?lurer, ?e, ?l) :- if(at(?e, ?l)), do(opEnemyAlreadyAtLocation(?e, ?l)).
bringEnemyTo(?lurer, ?e, ?l) :- if(enemy(?e), not(static(?e)), not(at(?e, ?l))),
    do(goToSameLocation(?lurer, ?e), getAggro(?e, ?lurer), goToLocation(?lurer, ?l)).


% === Component: gamehack/primitives/gh_skills ===
% gh_skills - a companion holds a skill and stands with its target, getting the skill from an object first if needed;
% applyTag puts a tag on a target.
% Depends on: gh_movement (goToSameLocation), gh_tags (useSkillOnTarget), gh_aggro (bringEnemyTo)

% === Signatures (for TYP001 linter) ===
signature(opSwapSkill, [agent, skill, skill]).
signature(opGetSkill, [agent, skill]).
signature(prepareToUseSkill, [agent, skill, agent]).
signature(getSkillFrom, [agent, object, skill]).
signature(applyTag, [agent, tag, agent]).

% === Operators ===

opGetSkill(?a, ?s) :- del(), add(hasSkill(?a, ?s)).
opSwapSkill(?a, ?old, ?s) :- del(hasSkill(?a, ?old)), add(hasSkill(?a, ?s)).

% === Methods ===

% ?t has ?tag, by ?a's doing: already, with a skill that applies it, or lured onto a location that gives it.
applyTag(?a, ?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
applyTag(?a, ?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag)), skillAppliesTag(?s, ?tag)),
    do(prepareToUseSkill(?a, ?s, ?t), useSkillOnTarget(?a, ?s, ?t)).
applyTag(?a, ?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag)), locationCanApplyTag(?l, ?tag), not(at(?t, ?l))),
    do(bringEnemyTo(?a, ?t, ?l)).

% ?a holds ?s and stands with ?t: already has it, or gets it from an object first.
prepareToUseSkill(?a, ?s, ?t) :- if(hasSkill(?a, ?s)), do(goToSameLocation(?a, ?t)).
prepareToUseSkill(?a, ?s, ?t) :- if(companion(?a), not(hasSkill(?a, ?s)), object(?o), canGetSkillFrom(?o, ?s)),
    do(goToSameLocation(?a, ?o), getSkillFrom(?a, ?o, ?s), goToSameLocation(?a, ?t)).

% ?a, standing at object ?o, learns ?s; it replaces their current skill, if any.
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), hasSkill(?a, ?old)), do(opSwapSkill(?a, ?old, ?s)).
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), not(hasSkill(?a, ?any))), do(opGetSkill(?a, ?s)).


% === Component: gamehack/strategies/wet_and_freeze ===
% wet_and_freeze - the target is wet or iced (a lurer's doing), then chilled (a second companion's).
% Depends on: gh_skills (applyTag)

% === Signatures (for TYP001 linter) ===
signature(wetAndFreeze, [agent]).

% Wet or iced (a lurer's doing), then chilled (a second companion's).
wetAndFreeze(?t) :-
    if(enemy(?t), locationCombo(?base, chilled), vulnerableToLocationCombo(?t, ?base, chilled), not(hasTag(?t, ?base)), not(hasTag(?t, chilled)),
       companion(?lurer), companion(?caster), \==(?lurer, ?caster)),
    do(applyTag(?lurer, ?base, ?t), applyTag(?caster, chilled, ?t)).
% Already wet or iced: the caster alone chills it (fine: winning a level takes more than one combo).
wetAndFreeze(?t) :-
    if(enemy(?t), locationCombo(?base, chilled), vulnerableToLocationCombo(?t, ?base, chilled), hasTag(?t, ?base), not(hasTag(?t, chilled)),
       companion(?caster)),
    do(applyTag(?caster, chilled, ?t)).


% === Component: gamehack/strategies/oil_and_burn ===
% oil_and_burn - the target has oil (a lurer's doing), then is burning (a second companion's).
% Depends on: gh_skills (applyTag)

% === Signatures (for TYP001 linter) ===
signature(oilAndBurn, [agent]).

% Oil (a lurer's doing), then burning (a second companion's).
oilAndBurn(?t) :-
    if(enemy(?t), vulnerableToLocationCombo(?t, oil, burning), not(hasTag(?t, oil)), not(hasTag(?t, burning)),
       companion(?lurer), companion(?caster), \==(?lurer, ?caster)),
    do(applyTag(?lurer, oil, ?t), applyTag(?caster, burning, ?t)).
% Already has oil: the caster alone sets it burning (fine: winning a level takes more than one combo).
oilAndBurn(?t) :-
    if(enemy(?t), vulnerableToLocationCombo(?t, oil, burning), hasTag(?t, oil), not(hasTag(?t, burning)),
       companion(?caster)),
    do(applyTag(?caster, burning, ?t)).


% === Component: gamehack/strategies/stun_and_slow ===
% stun_and_slow - two companions: one stuns the target while the other's slow skill lands.
% Depends on: gh_tags (useSkillOnTarget), gh_skills (prepareToUseSkill), gh_movement

% === Signatures (for TYP001 linter) ===
signature(stunAndSlow, [agent]).
signature(opSynchronize, [agent, agent]).

% === Operators ===

opSynchronize(?a1, ?a2) :- del(), add().

% === Methods ===

% Stunned and, at the same moment, hit by a second companion's slow skill.
stunAndSlow(?t) :-
    if(enemy(?t), not(immune(?t, stunned)),
       skillAppliesTag(?stun, stunned), skillHasTag(?slow, slow), \==(?stun, ?slow),
       companion(?a1), companion(?a2), \==(?a1, ?a2)),
    do(prepareToUseSkill(?a1, ?stun, ?t), prepareToUseSkill(?a2, ?slow, ?t),
       opSynchronize(?a1, ?a2),
       useSkillOnTarget(?a1, ?stun, ?t), useSkillOnTarget(?a2, ?slow, ?t)).


% === Component: gamehack/goals/defeat ===
% defeat - goal: take an enemy out of the fight. A menu of strategies, one plan per strategy that works.
% The two location-combo strategies defeat a vulnerable enemy themselves; stunAndSlow ends it.

% === Signatures (for TYP001 linter) ===
signature(defeat, [agent]).

defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(wetAndFreeze(?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(oilAndBurn(?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(stunAndSlow(?t), landTag(dead, ?t)).


% === Level-specific content ===
% GameHack GH7 Level: GH7-style world state
% Three companions: companionI (iceBlast: stunned), companionF (fireball: burning, slow), the player (none).
% Shrines grant frostSkill (chilled), iceBlastSkill and fireballSkill. A wet lake and a kitchen with oil:
% wetAndFreeze, oilAndBurn and stunAndSlow all work.

% === Type Declarations (for TYP001 linter) ===

% Agents (companions and enemies)
type(agent, player).
type(agent, companionI).
type(agent, companionF).
type(agent, gob).
type(agent, mimic).
type(agent, electricityElemental).
type(agent, teslaTower).

% Locations (named positions in the world)
type(location, room).
type(location, inn).
type(location, hut).
type(location, mountain).
type(location, lake).
type(location, sea).
type(location, volcano).
type(location, kitchen).

% Objects (grant skills)
type(object, seaShrine).
type(object, mountainShrine).
type(object, volcanoShrine).

% Skills (abilities)
type(skill, iceBlastSkill).
type(skill, fireballSkill).
type(skill, lightningSkill).
type(skill, frostSkill).

% === Agents ===
companion(player).
companion(companionI).
companion(companionF).
enemy(gob).
enemy(mimic).
enemy(electricityElemental).
enemy(teslaTower).

% === Positions ===
at(player, room).
at(companionI, inn).
at(companionF, inn).
at(mimic, room).
at(gob, hut).
at(electricityElemental, mountain).
at(teslaTower, lake).

% === Locations ===
location(room).
location(inn).
location(hut).
location(mountain).
location(lake).
location(sea).
location(volcano).
location(kitchen).

% === Location tags ===
locationCanApplyTag(lake, wet).
locationCanApplyTag(kitchen, oil).
% Agents that start on a tagged location have its tag.
hasTag(teslaTower, wet).

immune(electricityElemental, electrified).

static(teslaTower).

% === Skills ===
hasSkill(companionI, iceBlastSkill).
hasSkill(companionF, fireballSkill).
hasSkill(teslaTower, lightningSkill).

skillHasTag(fireballSkill, slow).

skillAppliesTag(iceBlastSkill, stunned).
skillAppliesTag(fireballSkill, burning).
skillAppliesTag(lightningSkill, electrified).
skillAppliesTag(frostSkill, chilled).

% === Objects that grant a skill ===
object(seaShrine).
at(seaShrine, sea).
canGetSkillFrom(seaShrine, frostSkill).
object(mountainShrine).
at(mountainShrine, mountain).
canGetSkillFrom(mountainShrine, iceBlastSkill).
object(volcanoShrine).
at(volcanoShrine, volcano).
canGetSkillFrom(volcanoShrine, fireballSkill).

% === What defeats whom ===
vulnerableToLocationCombo(gob, wet, chilled).
vulnerableToLocationCombo(gob, oil, burning).

% === Level Goal ===
goals(defeat(gob)).