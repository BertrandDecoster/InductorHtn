% Assembled level: puzzle1

% === Component: primitives/locomotion ===
% locomotion - Primitive: agents walk, and the enemies after them follow.
% One step per move: the game engine finds the path (docs/authoring/vocabulary.md).

% === Signatures (for the TYP001 linter) ===
signature(goToLocation, [agent, location]).
signature(goToSameLocation, [agent, agent]).
signature(enemiesFollow, [agent, location, location]).
signature(opMoveTo, [agent, location, location]).
signature(opAggroMoveTo, [agent, location, location]).
signature(opStayInLocation, [agent]).

% ?a stands where ?t is.
goToSameLocation(?a, ?t) :- if(at(?t, ?l)), do(goToLocation(?a, ?l)).

% ?a is at ?l; the engine finds the path. Enemies after ?a follow.
goToLocation(?a, ?l) :- if(at(?a, ?l)), do(opStayInLocation(?a)).
goToLocation(?a, ?l) :- if(location(?l), at(?a, ?from), \==(?from, ?l)),
    do(opMoveTo(?a, ?from, ?l), enemiesFollow(?a, ?from, ?l)).

% The enemies after ?a move with it (not a static or a dead one).
enemiesFollow(?a, ?from, ?l) :- allOf, if(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead))), do(opAggroMoveTo(?e, ?from, ?l)).
enemiesFollow(?a, ?from, ?l) :- if(not(hasAggro(?e, ?a), at(?e, ?from), not(static(?e)), not(hasTag(?e, dead)))), do().

% === Operators ===
opMoveTo(?who, ?from, ?to) :- del(at(?who, ?from)), add(at(?who, ?to)).
opAggroMoveTo(?e, ?from, ?to) :- del(at(?e, ?from)), add(at(?e, ?to)).

% Already true: no state change, the plan shows it.
opStayInLocation(?a) :- del(), add().


% === Component: primitives/tags ===
% tags - Primitive: a skill's tag lands on an agent, with the combo of the location it stands on.

% === Signatures (for the TYP001 linter) ===
signature(landSkillTag, [tag, agent]).
signature(landTag, [tag, agent]).
signature(tagEveryoneAt, [tag, location]).
signature(defeatVulnerable, [agent, tag, tag]).
signature(defeatVulnerableAt, [tag, tag, location]).
signature(opApplyTag, [tag, agent]).
signature(opAddLocationTag, [tag, location]).
signature(opRemoveLocationTag, [tag, location]).
signature(opTagAlreadyOnTarget, [tag, agent]).

% A skill's tag lands on ?t, and combines with the tag of the location ?t stands on.
% Electrified in water: everyone there is electrified; the vulnerable are defeated.
landSkillTag(electrified, ?t) :- if(at(?t, ?l), locationCanApplyTag(?l, wet)),
    do(tagEveryoneAt(electrified, ?l), defeatVulnerableAt(wet, electrified, ?l)).
% Burning on oil: the oil catches fire and everyone there burns; the vulnerable are defeated.
landSkillTag(burning, ?t) :- if(at(?t, ?l), locationCanApplyTag(?l, oil)),
    do(opRemoveLocationTag(oil, ?l), opAddLocationTag(burning, ?l),
       tagEveryoneAt(burning, ?l), defeatVulnerableAt(oil, burning, ?l)).
% Chilled in water or on ice: ?t alone is stunned; if vulnerable, defeated.
landSkillTag(chilled, ?t) :- if(at(?t, ?l), locationCanApplyTag(?l, ?base), locationCombo(?base, chilled)),
    do(landTag(stunned, ?t), defeatVulnerable(?t, ?base, chilled)).
% No combo where ?t stands: the tag just lands.
landSkillTag(?tag, ?t) :- if(at(?t, ?l), not(locationCanApplyTag(?l, ?base), locationCombo(?base, ?tag))),
    do(landTag(?tag, ?t)).

% ?t has ?tag, unless it is immune.
landTag(?tag, ?t) :- if(hasTag(?t, ?tag)), do(opTagAlreadyOnTarget(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), not(immune(?t, ?tag))), do(opApplyTag(?tag, ?t)).
landTag(?tag, ?t) :- if(not(hasTag(?t, ?tag)), immune(?t, ?tag)), do().

% Every agent at ?l gets ?tag: companions, neutrals and enemies alike.
tagEveryoneAt(?tag, ?l) :- allOf, if(agent(?a), at(?a, ?l)), do(landTag(?tag, ?a)).
tagEveryoneAt(?tag, ?l) :- if(not(agent(?a), at(?a, ?l))), do().

% An enemy vulnerable to this location combo is out of the fight.
defeatVulnerable(?e, ?base, ?tag) :- if(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead))), do(opApplyTag(dead, ?e)).
defeatVulnerable(?e, ?base, ?tag) :- if(not(vulnerableToLocationCombo(?e, ?base, ?tag), not(hasTag(?e, dead)))), do().

defeatVulnerableAt(?base, ?tag, ?l) :- allOf, if(enemy(?e), at(?e, ?l)), do(defeatVulnerable(?e, ?base, ?tag)).
defeatVulnerableAt(?base, ?tag, ?l) :- if(not(enemy(?e), at(?e, ?l))), do().

% === Operators ===
opApplyTag(?tag, ?t) :- del(), add(hasTag(?t, ?tag)).
opAddLocationTag(?tag, ?l) :- del(), add(locationCanApplyTag(?l, ?tag)).
opRemoveLocationTag(?tag, ?l) :- del(locationCanApplyTag(?l, ?tag)), add().

% Already true: no state change, the plan shows it.
opTagAlreadyOnTarget(?tag, ?t) :- del(), add().

% === The physics: which location tag combines with which skill tag ===
agent(?x) :- companion(?x).
agent(?x) :- neutral(?x).
agent(?x) :- enemy(?x).

locationCombo(wet, electrified).
locationCombo(oil, burning).
locationCombo(wet, chilled).
locationCombo(ice, chilled).

% === Tag words ===
type(tag, wet).
type(tag, oil).
type(tag, ice).
type(tag, burning).
type(tag, electrified).
type(tag, chilled).
type(tag, stunned).
type(tag, dead).


% === Component: primitives/aggro ===
% aggro - Primitive: enemies take a target, and a lurer brings an enemy somewhere.
% Depends on: locomotion (goToLocation; the enemies after the lurer follow it).

% === Signatures (for the TYP001 linter) ===
signature(getAggro, [agent, agent]).
signature(bringEnemyTo, [agent, agent, location]).
signature(opAggro, [agent, agent]).
signature(opRemoveAggro, [agent, agent]).
signature(opTargetAlreadyAggroed, [agent, agent]).
signature(opEnemyAlreadyAtLocation, [agent, location]).

% ?e is after ?a: already, instead of another target, or for the first time.
getAggro(?e, ?a) :- if(hasAggro(?e, ?a)), do(opTargetAlreadyAggroed(?e, ?a)).
getAggro(?e, ?a) :- if(hasAggro(?e, ?old), \==(?old, ?a)), do(opRemoveAggro(?e, ?old), opAggro(?e, ?a)).
getAggro(?e, ?a) :- if(not(hasAggro(?e, ?any))), do(opAggro(?e, ?a)).

% Enemy ?e is at ?l: the lurer walks to it, takes its aggro, and walks to ?l.
bringEnemyTo(?lurer, ?e, ?l) :- if(at(?e, ?l)), do(opEnemyAlreadyAtLocation(?e, ?l)).
bringEnemyTo(?lurer, ?e, ?l) :- if(enemy(?e), not(static(?e)), not(at(?e, ?l))),
    do(goToSameLocation(?lurer, ?e), getAggro(?e, ?lurer), goToLocation(?lurer, ?l)).

% === Operators ===
opAggro(?e, ?a) :- del(), add(hasAggro(?e, ?a)).
opRemoveAggro(?e, ?a) :- del(hasAggro(?e, ?a)), add().

% Already true: no state change, the plan shows it.
opTargetAlreadyAggroed(?e, ?a) :- del(), add().
opEnemyAlreadyAtLocation(?e, ?l) :- del(), add().


% === Component: primitives/skills ===
% skills - Primitive: a companion gets a skill, stands with its target and uses it.
% Depends on: locomotion (goToSameLocation), tags (landSkillTag).

% === Signatures (for the TYP001 linter) ===
signature(prepareToUseSkill, [agent, skill, agent]).
signature(getSkillFrom, [agent, object, skill]).
signature(useSkillOnTarget, [agent, skill, agent]).
signature(applySkillTags, [skill, agent]).
signature(opUseSkill, [agent, skill, agent]).
signature(opGetSkill, [agent, skill]).
signature(opSwapSkill, [agent, skill, skill]).

% ?a holds ?s and stands with ?t: already has it, or gets it from an object first.
prepareToUseSkill(?a, ?s, ?t) :- if(hasSkill(?a, ?s)), do(goToSameLocation(?a, ?t)).
prepareToUseSkill(?a, ?s, ?t) :- if(companion(?a), not(hasSkill(?a, ?s)), object(?o), canGetSkillFrom(?o, ?s)),
    do(goToSameLocation(?a, ?o), getSkillFrom(?a, ?o, ?s), goToSameLocation(?a, ?t)).

% ?a, standing at object ?o, learns ?s; it replaces their current skill, if any.
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), hasSkill(?a, ?old)), do(opSwapSkill(?a, ?old, ?s)).
getSkillFrom(?a, ?o, ?s) :- if(at(?o, ?l), at(?a, ?l), not(hasSkill(?a, ?any))), do(opGetSkill(?a, ?s)).

% ?a, holding ?s and standing with ?t, uses it; each of its tags lands on ?t.
useSkillOnTarget(?a, ?s, ?t) :- if(hasSkill(?a, ?s), at(?a, ?l), at(?t, ?l)), do(opUseSkill(?a, ?s, ?t), applySkillTags(?s, ?t)).

applySkillTags(?s, ?t) :- allOf, if(skillAppliesTag(?s, ?tag)), do(landSkillTag(?tag, ?t)).
applySkillTags(?s, ?t) :- if(not(skillAppliesTag(?s, ?tag))), do().

% === Operators ===
opUseSkill(?a, ?s, ?t) :- del(), add().
opGetSkill(?a, ?s) :- del(), add(hasSkill(?a, ?s)).
opSwapSkill(?a, ?old, ?s) :- del(hasSkill(?a, ?old)), add(hasSkill(?a, ?s)).


% === Component: strategies/wet_and_freeze ===
% wet_and_freeze - Strategy: a lurer brings an enemy into water or onto ice; a second companion chills it there.
% Depends on: aggro (bringEnemyTo), skills (prepareToUseSkill, useSkillOnTarget).

% === Signatures (for the TYP001 linter) ===
signature(wetAndFreeze, [agent]).

% A lurer brings ?t into water or onto ice; a second companion chills it there.
wetAndFreeze(?t) :-
    if(enemy(?t), locationCanApplyTag(?l, ?base), vulnerableToLocationCombo(?t, ?base, chilled), not(at(?t, ?l)),
       skillAppliesTag(?cold, chilled),
       companion(?lurer), companion(?caster), \==(?lurer, ?caster)),
    do(bringEnemyTo(?lurer, ?t, ?l),
       prepareToUseSkill(?caster, ?cold, ?t), useSkillOnTarget(?caster, ?cold, ?t)).
% Already standing there: the caster alone chills it (fine: winning a level takes more than one combo).
wetAndFreeze(?t) :-
    if(enemy(?t), at(?t, ?l), locationCanApplyTag(?l, ?base), vulnerableToLocationCombo(?t, ?base, chilled),
       skillAppliesTag(?cold, chilled), companion(?caster)),
    do(prepareToUseSkill(?caster, ?cold, ?t), useSkillOnTarget(?caster, ?cold, ?t)).


% === Component: strategies/oil_and_burn ===
% oil_and_burn - Strategy: a lurer brings an enemy onto oil; a second companion sets it burning there.
% Depends on: aggro (bringEnemyTo), skills (prepareToUseSkill, useSkillOnTarget).

% === Signatures (for the TYP001 linter) ===
signature(oilAndBurn, [agent]).

% A lurer brings ?t onto oil; a second companion sets it burning there.
oilAndBurn(?t) :-
    if(enemy(?t), locationCanApplyTag(?l, oil), vulnerableToLocationCombo(?t, oil, burning), not(at(?t, ?l)),
       skillAppliesTag(?fire, burning),
       companion(?lurer), companion(?caster), \==(?lurer, ?caster)),
    do(bringEnemyTo(?lurer, ?t, ?l),
       prepareToUseSkill(?caster, ?fire, ?t), useSkillOnTarget(?caster, ?fire, ?t)).
% Already standing on the oil: the caster alone sets it burning (fine: winning a level takes more than one combo).
oilAndBurn(?t) :-
    if(enemy(?t), at(?t, ?l), locationCanApplyTag(?l, oil), vulnerableToLocationCombo(?t, oil, burning),
       skillAppliesTag(?fire, burning), companion(?caster)),
    do(prepareToUseSkill(?caster, ?fire, ?t), useSkillOnTarget(?caster, ?fire, ?t)).


% === Component: goals/defeat ===
% defeat - Goal: an enemy is out of the fight. A menu of strategies, one plan per strategy that works.
% Depends on: wet_and_freeze, oil_and_burn. The location combo each one lands defeats the enemy.

% === Signatures (for the TYP001 linter) ===
signature(defeat, [agent]).

defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(wetAndFreeze(?t)).
defeat(?t) :- if(enemy(?t), not(hasTag(?t, dead))), do(oilAndBurn(?t)).


% === Component: goals/clear_location ===
% clear_location - Goal: every enemy at a location is out of the fight.
% Depends on: defeat.

% === Signatures (for the TYP001 linter) ===
signature(clearLocation, [location]).

clearLocation(?l) :- allOf, if(enemy(?e), at(?e, ?l), not(hasTag(?e, dead))), do(defeat(?e)).
clearLocation(?l) :- if(not(enemy(?e), at(?e, ?l), not(hasTag(?e, dead)))), do().


% === Level-specific content ===
% Puzzle 1: The Grease Trap
% An introductory puzzle for oilAndBurn and wetAndFreeze: two guards hold the generator room.
% One must be lured onto the oil and set burning, the other into the water and chilled; then
% both companions reach the exit.
% Depends on: locomotion, tags, aggro, skills, oil_and_burn, wet_and_freeze, defeat, clear_location

% === Goal ===

completePuzzle :- if(), do(clearLocation(generator), reachExit).

% Every companion reaches the exit.
reachExit :- allOf, if(companion(?c)), do(goToLocation(?c, exit)).

% === World ===

%    [storage]     [generator]
%         \           /  |
%           [main]      |
%             |         |
%        [corridor]-----+
%             |
%          [exit]
location(main). location(storage). location(generator). location(corridor). location(exit).

linked(main, storage). linked(storage, main).
linked(main, generator). linked(generator, main).
linked(main, corridor). linked(corridor, main).
linked(corridor, exit). linked(exit, corridor).
linked(corridor, generator). linked(generator, corridor).

companion(player). companion(arcanist).
at(player, main). at(arcanist, main).

enemy(guard1). enemy(guard2).
at(guard1, generator). at(guard2, generator).
vulnerableToLocationCombo(guard1, oil, burning).
vulnerableToLocationCombo(guard2, wet, chilled).

% An oil pool in the storage, a leak in the corridor.
locationCanApplyTag(storage, oil).
locationCanApplyTag(corridor, wet).

hasSkill(player, igniteSkill). skillAppliesTag(igniteSkill, burning).
hasSkill(arcanist, frostSkill). skillAppliesTag(frostSkill, chilled).

% === Type Declarations (for the TYP001 linter) ===
type(agent, player). type(agent, arcanist). type(agent, guard1). type(agent, guard2).
type(location, main). type(location, storage). type(location, generator). type(location, corridor). type(location, exit).
type(skill, igniteSkill). type(skill, frostSkill).

goals(completePuzzle).